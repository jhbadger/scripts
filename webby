class Line:
    """One display line: styled spans plus image placements.

    places: tuple of (img, row, rows, cols, col) - this line shows row `row`
    (0-based) of an image that is `rows` x `cols` cells, starting at column
    `col` of the line.
    """
    __slots__ = ("spans", "places", "anchors", "w")

    def __init__(self, spans, places=(), anchors=()):
        self.spans = spans
        self.places = places
        self.anchors = anchors
        self.w = sum(sw(t) for t, _ in spans)

    @property
    def text(self):
        return "".join(t for t, _ in self.spans)

    @property
    def blank(self):
        return not self.places and not self.text.strip()


def indent(line, n, prefix=None):
    sp = [prefix if prefix else (" " * n, PLAIN)] + line.spans
    pl = tuple((p[0], p[1], p[2], p[3], p[4] + n) for p in line.places)
    return Line(sp, pl, line.anchors)


def hjoin(cells, left=None, sep=None, right=None):
    """Join columns of lines side by side. cells = [(lines, width), ...]."""
    height = max((len(ls) for ls, _ in cells), default=0)
    out = []
    for i in range(height):
        spans, places, anch, x = [], [], [], 0
        if left:
            spans.append(left)
            x += sw(left[0])
        for k, (ls, wd) in enumerate(cells):
            if k and sep:
                spans.append(sep)
                x += sw(sep[0])
            ln = ls[i] if i < len(ls) else None
            pad = wd
            if ln:
                spans.extend(ln.spans)
                places.extend((p[0], p[1], p[2], p[3], p[4] + x) for p in ln.places)
                anch.extend(ln.anchors)
                pad = wd - ln.w
            if pad > 0:
                spans.append((" " * pad, PLAIN))
            x += wd
        if right:
            spans.append(right)
        out.append(Line(spans, tuple(places), tuple(anch)))
    return out


def wrap(atoms, w, align=None):
    """Greedy word wrap. atoms: ('w', text, style) | ('s', ' ', style) | ('br', '', style)."""
    w = max(w, 1)
    lines = []
    cur, curw = [], 0
    grp, gw = [], 0

    def end():
        nonlocal cur, curw
        while cur and cur[-1][2]:
            cur.pop()
        spans = merge([(t, s) for t, s, _ in cur])
        ln = Line(spans)
        if align in ("center", "right") and ln.w < w:
            pad = (w - ln.w) // 2 if align == "center" else w - ln.w
            if pad > 0:
                ln = Line([(" " * pad, PLAIN)] + spans)
        lines.append(ln)
        cur, curw = [], 0

    def put():
        nonlocal grp, gw, curw
        if not grp:
            return
        if curw and curw + gw > w:
            end()
        if gw <= w:
            for t, s in grp:
                cur.append((t, s, False))
            curw += gw
        else:                                   # word longer than the line
            for t, s in grp:
                for ch in t:
                    c = cw(ch)
                    if curw + c > w and curw:
                        end()
                    cur.append((ch, s, False))
                    curw += c
        grp, gw = [], 0

    for kind, text, st in atoms:
        if kind == "w":
            grp.append((text, st))
            gw += sw(text)
        elif kind == "s":
            put()
            if cur and not cur[-1][2] and curw < w:
                cur.append((" ", st, True))
                curw += 1
        else:
            put()
            end()
    put()
    if any(not c[2] for c in cur):
        end()
    return lines


class Flow:
    """A block formatting context: collects inline atoms and finished lines."""

    def __init__(self, w, align=None, pre=False):
        self.w = max(w, 1)
        self.align = align
        self.pre = pre
        self.pre_start = False
        self.lines = []
        self.atoms = []
        self.gap = False
        self.pending = []       # anchor names waiting for the next line
        self.xl = None          # character translation (sup/sub)

    def text(self, s, st):
        if self.xl:
            s = s.translate(self.xl)
        if self.pre:
            if self.pre_start:
                self.pre_start = False
                if s.startswith("\n"):
                    s = s[1:]
            for i, part in enumerate(s.split("\n")):
                if i:
                    self.atoms.append(("br", "", st))
                if part:
                    self.atoms.append(("w", part.expandtabs(8), st))
            return
        for m in RE_TOK.finditer(s):
            tok = m.group()
            if tok[0] in " \t\n\r\f":
                self.atoms.append(("s", " ", st))
            else:
                self.atoms.append(("w", tok, st))

    def flush(self):
        if self.atoms:
            lines = wrap(self.atoms, self.w, self.align)
            self.atoms = []
            self._push(lines)

    def add(self, lines, margin=False):
        self.flush()
        self._push(lines, margin)

    def _push(self, lines, margin=False):
        if not lines:
            return
        if (margin or self.gap) and self.lines and not self.lines[-1].blank:
            self.lines.append(Line([]))
        if self.pending:
            l0 = lines[0]
            lines[0] = Line(l0.spans, l0.places, tuple(l0.anchors) + tuple(self.pending))
            self.pending = []
        self.lines.extend(lines)
        self.gap = margin


RE_TOK = re.compile(r"[ \t\n\r\f]+|[^ \t\n\r\f]+")
SUPMAP = str.maketrans("0123456789+-=()ni", "⁰¹²³⁴⁵⁶⁷⁸⁹⁺⁻⁼⁽⁾ⁿⁱ")
SUBMAP = str.maketrans("0123456789+-=()", "₀₁₂₃₄₅₆₇₈₉₊₋₌₍₎")

