def load_page(url, post=None, referer=None):
    if url.startswith("about:"):
        name, _, query = (url[6:].split("#")[0] or "home").partition("?")
        args = urllib.parse.parse_qs(query)
        if name == "bookmarks" and args.get("remove"):
            STORE.remove_bookmark(args["remove"][0])
        elif name == "history" and args.get("clear"):
            STORE.clear_history()
        src = {"home": lambda: ABOUT_HOME.replace("<!--BOOKMARKS-->", STORE.home_bookmarks()),
               "help": lambda: ABOUT_HELP, "blank": lambda: "",
               "bookmarks": STORE.bookmarks_html, "history": STORE.history_html}.get(name)
        if src is None:
            raise ValueError("unknown page " + url)
        src = src()
        b = parse_html(src)
        return Page(url, b.root, b.title, src.encode(), "text/html")
    resp = fetch(url, post, referer)
    page = make_page(resp)
    page.status = resp.status
    return page


