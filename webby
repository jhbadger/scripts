class Page:
    def __init__(self, url, dom, title="", raw=b"", ctype="", base=None, refresh=None):
        self.url = url
        self.dom = dom
        self.title = title.strip()
        self.raw = raw
        self.ctype = ctype
        self.base = urllib.parse.urljoin(url, base) if base else url
        self.refresh = refresh
        self.imgs = {}
        self.fields = {}
        self.links = {}
        self.anchors = {}
        self.download = None
        self.error = False
        self.css = None             # Stylesheet (None: no CSS)
        self.css_slots = []         # parsed rule lists, document order (None = still loading)
        self.css_links = []         # [(slot, url)] external sheets to fetch
        self.reader_of = None       # set on a reader-mode clone: the original page
        self.reader = None          # cached reader-mode clone
        self._id = 0

    @property
    def root(self):
        return self.reader_of or self

    def next_id(self):
        self._id += 1
        return self._id

    def image(self, url, request):
        im = self.imgs.get(url)
        if im is None:
            im = self.imgs[url] = Img(url, self)
        if im.state == "new":
            request(im)
        return im


class Store:
    """Bookmarks (JSON) and browsing history (TSV) under ~/.config/webby."""

    def __init__(self, private=False):
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
        self.dir = os.path.join(base, "webby")
        self.bm_path = os.path.join(self.dir, "bookmarks.json")
        self.hist_path = os.path.join(self.dir, "history.tsv")
        self.private = private
        self.loaded = False
        self.bookmarks = []         # [url, title]
        self.history = []           # [timestamp, url, title]

    def load(self):
        if self.loaded:
            return
        self.loaded = True
        try:
            with open(self.bm_path, encoding="utf-8") as f:
                self.bookmarks = [[str(u), str(t)] for u, t in json.load(f)]
        except (OSError, ValueError, TypeError):
            self.bookmarks = []
        try:
            with open(self.hist_path, encoding="utf-8", errors="replace") as f:
                for line in f:
                    p = line.rstrip("\n").split("\t", 2)
                    if len(p) == 3 and p[0].isdigit():
                        self.history.append([int(p[0]), p[1], p[2]])
        except OSError:
            pass
        if len(self.history) > 5000:
            self.history = self.history[-3000:]
            self.write(self.hist_path, "".join("%d\t%s\t%s\n" % tuple(h) for h in self.history))

    def write(self, path, data):
        try:
            os.makedirs(self.dir, exist_ok=True)
            tmp = path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(data)
            os.replace(tmp, path)
        except OSError:
            pass

    def visit(self, url, title):
        self.load()
        if self.private:
            return
        title = " ".join(title.split())
        entry = [int(time.time()), url, title]
        self.history.append(entry)
        try:
            os.makedirs(self.dir, exist_ok=True)
            with open(self.hist_path, "a", encoding="utf-8") as f:
                f.write("%d\t%s\t%s\n" % tuple(entry))
        except OSError:
            pass

    def is_bookmarked(self, url):
        self.load()
        return any(b[0] == url for b in self.bookmarks)

    def toggle_bookmark(self, url, title):
        """Add or remove; returns True when the page is now bookmarked."""
        self.load()
        if self.is_bookmarked(url):
            self.remove_bookmark(url)
            return False
        self.bookmarks.append([url, " ".join(title.split())])
        self.write(self.bm_path, json.dumps(self.bookmarks, indent=1))
        return True

    def remove_bookmark(self, url):
        self.load()
        self.bookmarks = [b for b in self.bookmarks if b[0] != url]
        self.write(self.bm_path, json.dumps(self.bookmarks, indent=1))

    def clear_history(self):
        self.load()
        self.history = []
        self.write(self.hist_path, "")

    def suggest(self, q, limit=6):
        """Bookmarks and history entries matching every word of q, best first."""
        self.load()
        words = q.lower().split()
        if not words:
            return []
        info = {}
        for ts, url, title in self.history:
            e = info.setdefault(url, [0, 0, title])
            e[0] += 1
            e[1] = ts
            e[2] = title or e[2]
        marked = {b[0] for b in self.bookmarks}
        for url, title in self.bookmarks:
            info.setdefault(url, [0, 0, title])
        scored = []
        for url, (count, ts, title) in info.items():
            hay = (url + " " + title).lower()
            if all(w in hay for w in words):
                scored.append(((url in marked, count, ts), url, title))
        scored.sort(reverse=True)
        return [(u, t) for _, u, t in scored[:limit]]

    def home_bookmarks(self):
        self.load()
        if not self.bookmarks:
            return ""
        rows = "".join('<li><a href="%s">%s</a></li>' % (
            html.escape(u, True), html.escape(t or u)) for u, t in self.bookmarks[:12])
        return "<h2>Bookmarks</h2><ul>%s</ul>" % rows

    def bookmarks_html(self):
        self.load()
        if not self.bookmarks:
            return "<h1>Bookmarks</h1><p>No bookmarks yet. Press <b>B</b> on a page to add one.</p>"
        rows = "".join(
            '<li><a href="%s">%s</a><br>%s <a href="about:bookmarks?remove=%s">[remove]</a></li>' % (
                html.escape(u, True), html.escape(t or u), html.escape(u),
                html.escape(urllib.parse.quote_plus(u), True)) for u, t in self.bookmarks)
        return "<h1>Bookmarks</h1><ul>%s</ul>" % rows

    def history_html(self):
        self.load()
        rows, last = [], None
        for ts, url, title in reversed(self.history):
            if url == last:
                continue
            last = url
            rows.append('<li>%s <a href="%s">%s</a></li>' % (
                time.strftime("%Y-%m-%d %H:%M", time.localtime(ts)),
                html.escape(url, True), html.escape(title or url)))
            if len(rows) >= 300:
                break
        if not rows:
            return "<h1>History</h1><p>Nothing yet.</p>"
        return ('<h1>History</h1><p><a href="about:history?clear=1">Clear history</a></p><ul>%s</ul>'
                % "".join(rows))


