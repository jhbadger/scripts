def parse_color(v):
    v = v.strip().lower()
    if v in NAMED_COLORS:
        return NAMED_COLORS[v]
    if v.startswith("#"):
        h = v[1:]
        try:
            if len(h) in (3, 4):
                return tuple(int(c * 2, 16) for c in h[:3])
            if len(h) in (6, 8):
                return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
        except ValueError:
            return None
        return None
    m = re.match(r"(rgba?|hsla?)\(\s*([^)]*)\)", v)
    if not m:
        return None
    nums = re.findall(r"-?[\d.]+%?", m.group(2))
    if len(nums) < 3:
        return None
    if len(nums) >= 4 and re.search(r"(^|[\s,/])0(\.0+)?%?\s*$", m.group(2)):
        return None                                 # fully transparent
    try:
        if m.group(1).startswith("rgb"):
            return tuple(max(0, min(255, round(float(x[:-1]) * 2.55 if x.endswith("%") else float(x))))
                         for x in nums[:3])
        h = float(nums[0]) / 360.0
        sat = float(nums[1].rstrip("%")) / 100
        lig = float(nums[2].rstrip("%")) / 100
        return tuple(round(c * 255) for c in colorsys.hls_to_rgb(h % 1.0, lig, sat))
    except ValueError:
        return None


def term_color(rgb):
    """Foreground SGR for an (r, g, b) colour, nudged to stay readable on the terminal theme."""
    r, g, b = rgb
    luma = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255
    if THEME_DARK and luma < 0.45:
        t = (0.5 - luma) / (1 - luma)
        r, g, b = (round(c + (255 - c) * t) for c in (r, g, b))
    elif not THEME_DARK and luma > 0.6:
        k = 0.5 / luma
        r, g, b = (round(c * k) for c in (r, g, b))
    if max(r, g, b) - min(r, g, b) < 16:
        gray = (r + g + b) / 3
        idx = 16 if gray < 8 else 231 if gray > 248 else 232 + round((gray - 8) / 247 * 23)
    else:
        idx = 16 + 36 * round(r / 255 * 5) + 6 * round(g / 255 * 5) + round(b / 255 * 5)
    return "38;5;%d" % idx


def split_top(s, sep):
    """Split on sep, ignoring separators inside parentheses or quotes."""
    out, depth, quote, start = [], 0, "", 0
    for i, ch in enumerate(s):
        if quote:
            if ch == quote:
                quote = ""
        elif ch in "\"'":
            quote = ch
        elif ch == "(":
            depth += 1
        elif ch == ")":
            depth = max(0, depth - 1)
        elif ch == sep and not depth:
            out.append(s[start:i])
            start = i + 1
    out.append(s[start:])
    return out


def parse_decls(text):
    out = []
    for d in split_top(text, ";"):
        p, _, v = d.partition(":")
        p, v = p.strip().lower(), v.strip()
        if not p or not v:
            continue
        imp = bool(RE_IMPORTANT.search(v))
        if imp:
            v = RE_IMPORTANT.sub("", v)
        if p.startswith("--") or p in KEEP_PROPS:
            out.append((p, v, imp))
        elif p == "font":
            toks = v.lower().split()
            if "italic" in toks or "oblique" in toks:
                out.append(("font-style", "italic", imp))
            for tk in toks:
                if tk in ("bold", "bolder") or (tk.isdigit() and len(tk) == 3):
                    out.append(("font-weight", tk, imp))
        elif p == "list-style" and "none" in v.lower().split():
            out.append(("list-style-type", "none", imp))
    return out


class Compound:
    __slots__ = ("tag", "id", "classes", "attrs", "pseudos", "nots")

