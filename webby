def unesc(name):
    return re.sub(r"\\(.)", r"\1", name)


def parse_compound(s, i):
    c, sp, n, start = Compound(), [0, 0, 0], len(s), i
    while i < n and s[i] not in " \t\n>+~,)":
        ch = s[i]
        if ch == "*":
            i += 1
        elif ch in ".#":
            m = RE_IDENT.match(s, i + 1)
            if not m:
                return None
            name, i = unesc(m.group()), m.end()
            if ch == ".":
                c.classes.append(name)
                sp[1] += 1
            else:
                c.id = name
                sp[0] += 1
        elif ch == "[":
            j = s.find("]", i)
            m = RE_ATTR.match(s[i + 1:j]) if j > 0 else None
            if not m:
                return None
            c.attrs.append((m.group(1).lower(), m.group(2) or "", (m.group(3) or "").strip("\"'"),
                            (m.group(4) or "").lower() == "i"))
            sp[1] += 1
            i = j + 1
        elif ch == ":":
            if s.startswith("::", i):
                return None
            m = RE_IDENT.match(s, i + 1)
            if not m:
                return None
            name, i = m.group().lower(), m.end()
            if name == "not" and s[i:i + 1] == "(":
                depth, j = 0, i
                while j < n:
                    depth += (s[j] == "(") - (s[j] == ")")
                    if depth == 0:
                        break
                    j += 1
                for part in split_top(s[i + 1:j], ","):
                    part = part.strip()
                    r = parse_compound(part, 0)
                    if not r or r[1] != len(part):
                        return None
                    c.nots.append(r[0])
                    sp = [a + b for a, b in zip(sp, r[2])]
                i = j + 1
            elif name in PSEUDO_OK:
                c.pseudos.append(name)
                sp[1] += 1
            else:
                return None
        else:
            m = RE_IDENT.match(s, i)
            if not m:
                return None
            c.tag = m.group().lower()
            sp[2] += 1
            i = m.end()
    if i == start:
        return None
    return c, i, sp


def parse_selector(sel):
    s, i, n = sel.strip(), 0, len(sel.strip())
    parts, comb, spec = [], " ", [0, 0, 0]
    while i < n:
        r = parse_compound(s, i)
        if not r:
            return None
        c, i, sp = r
        parts.append((comb, c))
        spec = [a + b for a, b in zip(spec, sp)]
        j = i
        while j < n and s[j] in " \t\n":
            j += 1
        if j >= n:
            break
        if s[j] in ">+~":
            comb = s[j]
            j += 1
            while j < n and s[j] in " \t\n":
                j += 1
        elif j > i:
            comb = " "
        else:
            return None
        i = j
    return (parts, tuple(spec)) if parts else None


def media_ok(prelude):
    q = prelude.lower()
    for alt in q.split(","):
        if RE_MEDIA_BAD.search(alt):
            continue
        ok = True
        for kind, val, unit in RE_MEDIA_W.findall(alt):
            px = float(val) * (16 if unit != "px" else 1)
            if (kind == "min" and px > CSS_VW) or (kind == "max" and px < CSS_VW):
                ok = False
        if ok:
            return True
    return False


class Rule:
    __slots__ = ("parts", "spec", "decls", "order")


def parse_css(text):
    """Parse a stylesheet into a list of Rule objects (unsupported selectors are dropped)."""
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    rules = []

    def block(s):
        i, n = 0, len(s)
        while i < n:
            ib, isc = s.find("{", i), s.find(";", i)
            if ib < 0 and isc < 0:
                break
            if isc >= 0 and (ib < 0 or isc < ib):          # e.g. @import ...;
                i = isc + 1
                continue
            depth, j = 1, ib + 1
            for m in RE_BRACE.finditer(s, ib + 1):
                depth += 1 if m.group() == "{" else -1
                if depth == 0:
                    j = m.end()
                    break
            else:
                j = n
            prelude, body = s[i:ib].strip(), s[ib + 1:max(ib + 1, j - 1)]
            i = j
            if prelude.startswith("@"):
                name = prelude[1:].split(None, 1)[0].lower() if len(prelude) > 1 else ""
                if (name == "media" and media_ok(prelude[6:])) or name in ("supports", "layer"):
                    block(body)
                continue
            if "{" in body:
                body = RE_NESTED.sub("", body)
            decls = parse_decls(body)
            if not decls:
                continue
            for sel in split_top(prelude, ","):
                ps = parse_selector(sel)
                if ps:
                    r = Rule()
                    r.parts, r.spec, r.decls, r.order = ps[0], ps[1], decls, 0
                    rules.append(r)

    block(text)
    return rules


class Stylesheet:
    def __init__(self, slots):
        self.idx = collections.defaultdict(list)
        self.vars = {}
        self.memo = {}
        self.sib = {}
        order = 0
        for rules in slots:
            for r in rules or ():
                r.order = order
                order += 1
                c = r.parts[-1][1]
                if c.id:
                    key = ("#", c.id)
                elif c.classes:
                    key = (".", c.classes[0])
                elif c.tag:
                    key = ("t", c.tag)
                else:
                    key = "*"
                self.idx[key].append(r)
                if len(r.parts) == 1 and (("root" in c.pseudos) or c.tag in ("html", "body")
                                          or (key == "*" and not c.attrs)):
                    for p, v, _ in r.decls:
                        if p.startswith("--"):
                            self.vars[p] = v

    def subst(self, val):
        for _ in range(4):
            new = RE_VAR.sub(lambda m: self.vars.get(m.group(1), (m.group(2) or "").strip()), val)
            if new == val:
                break
            val = new
        return val

    def siblings(self, node):
        p = node.parent
        if p is None:
            return [node], {id(node): 0}
        e = self.sib.get(id(p))
        if e is None:
            lst = [c for c in p.children if c.tag is not None]
            e = self.sib[id(p)] = (lst, {id(c): i for i, c in enumerate(lst)})
        return e

    def cmatch(self, c, node):
        a = node.attrs
        if c.tag and c.tag != node.tag:
            return False
        if c.id and a.get("id") != c.id:
            return False
        if c.classes:
            have = (a.get("class") or "").split()
            if any(k not in have for k in c.classes):
                return False
        for name, op, val, ci in c.attrs:
            if name not in a:
                return False
            if not op:
                continue
            have = a[name]
            if ci:
                have, val = have.lower(), val.lower()
            if op == "=" and have != val:
                return False
            if op == "~=" and val not in have.split():
                return False
            if op == "|=" and not (have == val or have.startswith(val + "-")):
                return False
            if op == "^=" and not (val and have.startswith(val)):
                return False
            if op == "$=" and not (val and have.endswith(val)):
                return False
            if op == "*=" and not (val and val in have):
                return False
        for ps in c.pseudos:
            if ps in ("first-child", "last-child", "only-child"):
                lst, pos = self.siblings(node)
                i = pos.get(id(node), 0)
                if ps == "first-child" and i != 0:
                    return False
                if ps == "last-child" and i != len(lst) - 1:
                    return False
                if ps == "only-child" and len(lst) != 1:
                    return False
            elif ps == "root":
                if node.tag != "html":
                    return False
            elif ps in ("link", "any-link"):
                if node.tag not in ("a", "area") or "href" not in a:
                    return False
            elif ps == "empty":
                if node.children:
                    return False
        for nc in c.nots:
            if self.cmatch(nc, node):
                return False
        return True

    def chain(self, parts, i, node):
        comb, c = parts[i]
        if not self.cmatch(c, node):
            return False
        if i == 0:
            return True
        if comb == ">":
            p = node.parent
            return p is not None and p.tag != "#root" and self.chain(parts, i - 1, p)
        if comb == " ":
            p = node.parent
            while p is not None and p.tag != "#root":
                if self.chain(parts, i - 1, p):
                    return True
                p = p.parent
            return False
        lst, pos = self.siblings(node)
        k = pos.get(id(node), 0)
        if comb == "+":
            return k > 0 and self.chain(parts, i - 1, lst[k - 1])
        return any(self.chain(parts, i - 1, lst[j]) for j in range(k))      # "~"

    def compute(self, node):
        """Cascaded declarations that apply to node: {property: value}."""
        k = id(node)
        out = self.memo.get(k)
        if out is not None:
            return out
        a = node.attrs
        cands = []
        if a.get("id"):
            cands += self.idx.get(("#", a["id"]), ())
        for cls in (a.get("class") or "").split():
            cands += self.idx.get((".", cls), ())
        cands += self.idx.get(("t", node.tag), ())
        cands += self.idx.get("*", ())
        matched = [r for r in cands if self.chain(r.parts, len(r.parts) - 1, node)]
        matched.sort(key=lambda r: (r.spec, r.order))
        out, imp = {}, {}
        for r in matched:
            for p, v, im in r.decls:
                if not p.startswith("--"):
                    (imp if im else out)[p] = v
        if a.get("style"):
            for p, v, im in parse_decls(a["style"]):
                if not p.startswith("--"):
                    (imp if im else out)[p] = v
        out.update(imp)
        for p, v in out.items():
            if "var(" in v:
                out[p] = self.subst(v)
        self.memo[k] = out
        return out


def css_px(v):
    m = re.match(r"\s*(-?[\d.]+)\s*(px|em|rem|%)?", v or "")
    if not m:
        return None
    try:
        x = float(m.group(1))
    except ValueError:
        return None
    return x * 16 if m.group(2) in ("em", "rem") else x


def css_hidden(cs):
    """True when the declarations make an element invisible (display:none, off-screen, ...)."""
    if cs.get("display", "").lower() == "none":
        return True
    if cs.get("visibility", "").lower() in ("hidden", "collapse"):
        return True
    op = cs.get("opacity")
    if op:
        try:
            if float(op) <= 0:
                return True
        except ValueError:
            pass
    if cs.get("position", "").lower() in ("absolute", "fixed"):
        for p in ("left", "top"):
            px = css_px(cs.get(p))
            if px is not None and px <= -500:
                return True
    ti = css_px(cs.get("text-indent"))
    if ti is not None and ti <= -900:
        return True
    clip_ = cs.get("clip", "").replace(" ", "").lower()
    if clip_ in ("rect(0,0,0,0)", "rect(0px,0px,0px,0px)", "rect(1px,1px,1px,1px)"):
        return True
    if "inset(50%)" in cs.get("clip-path", "").replace(" ", ""):
        return True
    w, h = css_px(cs.get("width")), css_px(cs.get("height"))
    if (w is not None and h is not None and w <= 1 and h <= 1
            and cs.get("overflow", "").lower() == "hidden"):
        return True
    return False


def init_css(page, items):
    """Parse inline <style> blocks now; remember external sheets to fetch later."""
    slots, links = [], []
    for kind, val, media in items:
        if media and re.search(r"print|speech", media, re.I):
            continue
        if kind == "style":
            slots.append(parse_css(val))
        else:
            slots.append(None)
            links.append((len(slots) - 1, urllib.parse.urljoin(page.base, val.strip())))
    page.css_slots, page.css_links = slots, links[:12]
    page.css = Stylesheet(slots) if any(slots) else None


def fetch_stylesheets(page):
    """Download page.css_links (in parallel) and rebuild page.css. Safe to call from a thread."""
    def get(item):
        idx, url = item
        try:
            r = fetch(url, referer=page.url, limit=600000, timeout=10, accept="text/css,*/*;q=0.1")
            if r.status and r.status < 400:
                return idx, decode_body(r.body, r.headers)
        except Exception:
            pass
        return idx, None
    with concurrent.futures.ThreadPoolExecutor(4) as ex:
        for idx, text in ex.map(get, page.css_links):
            if text:
                page.css_slots[idx] = parse_css(text)
    page.css_links = []
    page.css = Stylesheet(page.css_slots) if any(page.css_slots) else None


