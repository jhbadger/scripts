class Resp:
    __slots__ = ("url", "status", "ctype", "headers", "body")

    def __init__(self, url, status, ctype, headers, body):
        self.url, self.status, self.ctype, self.headers, self.body = url, status, ctype, headers, body


def make_opener(insecure=False):
    ctx = ssl.create_default_context()
    # Python 3.13+ enables strict X.509 checks, which reject many real-world
    # chains (e.g. CA certs without an Authority Key Identifier, proxy CAs).
    ctx.verify_flags &= ~ssl.VERIFY_X509_STRICT
    if insecure:
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    elif not ctx.cert_store_stats().get("x509_ca"):
        for f in ("/etc/ssl/cert.pem", "/etc/ssl/certs/ca-certificates.crt",
                  "/opt/homebrew/etc/openssl@3/cert.pem", "/usr/local/etc/openssl/cert.pem"):
            if os.path.exists(f):
                try:
                    ctx.load_verify_locations(f)
                    break
                except (OSError, ssl.SSLError):
                    pass
    jar = http.cookiejar.CookieJar()
    return urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar),
                                       urllib.request.HTTPSHandler(context=ctx))


OPENER = None


def safe_url(url):
    """Percent-encode non-ASCII characters (and IDN hosts) so urllib accepts the URL."""
    url = re.sub(r"[\s\x00-\x1f]+", "", url) if "\n" in url or "\t" in url else url.strip()
    p = urllib.parse.urlsplit(url)
    host = p.hostname or ""
    netloc = p.netloc
    try:
        host.encode("ascii")
    except UnicodeEncodeError:
        try:
            ihost = host.encode("idna").decode("ascii")
            netloc = netloc.replace(host, ihost)
        except UnicodeError:
            pass
    q = lambda s, safe: urllib.parse.quote(s, safe=safe)
    return urllib.parse.urlunsplit((p.scheme, netloc, q(p.path, "/%:@!$&'()*+,;=~-._"),
                                    q(p.query, "=&%+/?:@!$'()*,;~-._"), ""))


def decompress(body, enc):
    enc = (enc or "").lower()
    try:
        if enc == "gzip" or body[:2] == b"\x1f\x8b":
            return zlib.decompress(body, 16 + zlib.MAX_WBITS)
        if enc == "deflate":
            try:
                return zlib.decompress(body)
            except zlib.error:
                return zlib.decompress(body, -zlib.MAX_WBITS)
    except zlib.error:
        pass
    return body


def fetch(url, post=None, referer=None, timeout=20, limit=MAX_PAGE,
          accept="text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"):
    global OPENER
    if OPENER is None:
        OPENER = make_opener()
    p = urllib.parse.urlsplit(url)
    if p.scheme in ("http", "https"):
        h = {"User-Agent": UA, "Accept": accept, "Accept-Language": "en-US,en;q=0.8",
             "Accept-Encoding": "gzip, deflate"}
        if referer:
            h["Referer"] = referer
        if post is not None:
            h["Content-Type"] = "application/x-www-form-urlencoded"
        req = urllib.request.Request(safe_url(url), data=post, headers=h)
        try:
            r = OPENER.open(req, timeout=timeout)
        except urllib.error.HTTPError as e:
            r = e
        with r:
            body = r.read(limit + 1)
            hd = r.headers
            final = r.geturl()
            status = getattr(r, "status", None) or r.getcode()
        if len(body) > limit:
            body = body[:limit]
        body = decompress(body, hd.get("Content-Encoding"))
        ctype = (hd.get("Content-Type") or "").split(";")[0].strip().lower()
        return Resp(final, status, ctype, hd.get("Content-Type") or "", body)
    if p.scheme == "file":
        path = urllib.request.url2pathname(p.path)
        if os.path.isdir(path):
            return Resp(url, 200, "text/html", "", dir_listing(path).encode())
        with open(path, "rb") as f:
            body = f.read(limit)
        ctype = mimetypes.guess_type(path)[0] or ""
        if not ctype and path.lower().endswith((".md", ".txt", ".py", ".c", ".h")):
            ctype = "text/plain"
        return Resp(url, 200, ctype, ctype, body)
    if p.scheme == "data":
        head, _, payload = url[5:].partition(",")
        if head.endswith(";base64"):
            body = base64.b64decode(urllib.parse.unquote(payload) + "===")
            head = head[:-7]
        else:
            body = urllib.parse.unquote_to_bytes(payload)
        ctype = head.split(";")[0] or "text/plain"
        return Resp(url, 200, ctype, head, body)
    raise ValueError("unsupported URL scheme: %s" % (p.scheme or url))


def dir_listing(path):
    rows = ["<h1>Index of %s</h1><ul>" % html.escape(path)]
    if path != "/":
        rows.append('<li><a href="..">..</a></li>')
    for name in sorted(os.listdir(path), key=str.lower):
        full = os.path.join(path, name)
        suffix = "/" if os.path.isdir(full) else ""
        rows.append('<li><a href="%s">%s</a></li>' % (
            html.escape(urllib.parse.quote(name) + suffix, True), html.escape(name + suffix)))
    rows.append("</ul>")
    return "".join(rows)


def decode_body(body, ctype_header):
    enc = None
    m = re.search(r"charset=[\"']?([\w\-]+)", ctype_header or "", re.I)
    if m:
        enc = m.group(1)
    if body.startswith(b"\xef\xbb\xbf"):
        enc = "utf-8-sig"
    elif not enc:
        m = re.search(rb"<meta[^>]+charset=[\"']?\s*([\w\-]+)", body[:4096], re.I)
        if m:
            enc = m.group(1).decode("ascii", "replace")
    if enc:
        try:
            codecs.lookup(enc)
            return body.decode(enc, "replace").translate(CTRL)
        except (LookupError, UnicodeError):
            pass
    try:
        return body.decode("utf-8").translate(CTRL)
    except UnicodeDecodeError:
        return body.decode("cp1252", "replace").translate(CTRL)


