CSI_KEYS = {"A": "up", "B": "down", "C": "right", "D": "left", "H": "home", "F": "end", "Z": "btab"}
SS3_KEYS = dict(CSI_KEYS, P="f1", Q="f2", R="f3", S="f4")
TILDE_KEYS = {"1": "home", "2": "ins", "3": "del", "4": "end", "5": "pgup", "6": "pgdn",
              "7": "home", "8": "end", "11": "f1", "15": "f5"}
KITTY_DELETE = "\x1b_Ga=d,d=a,q=2\x1b\\"
KITTY_FREE = "\x1b_Ga=d,d=A,q=2\x1b\\"


def normalize_url(s):
    s = s.strip()
    if not s:
        return None
    if re.match(r"^[a-zA-Z][a-zA-Z0-9+.\-]*://", s) or s.startswith(("about:", "data:", "file:", "mailto:")):
        return s
    p = os.path.expanduser(s)
    if os.path.exists(p):
        return pathlib.Path(os.path.abspath(p)).as_uri()
    if " " in s or ("." not in s and ":" not in s and s != "localhost"):
        return SEARCH_URL + urllib.parse.quote_plus(s)
    host = s.split("/")[0].split(":")[0]
    local = host == "localhost" or re.match(r"^[\d.]+$", host) or host.endswith(".local")
    return ("http://" if local else "https://") + s


STATE_FIELDS = ("hist", "hpos", "page", "lines", "links", "targets", "top", "focus", "hover",
                "query", "matches", "match_list", "mi", "pending", "refreshes")


def blank_state():
    return dict(hist=[], hpos=-1, page=None, lines=[], links={}, targets=[], top=0, focus=None,
                hover=None, query="", matches={}, match_list=[], mi=-1, pending=None, refreshes=0)


class Tab:
    def __init__(self):
        self.state = blank_state()      # saved view state while the tab is in the background


class Browser:
    def __init__(self, gfx="auto", maxwidth=110, insecure=False, css=True):
        self.gfx = gfx                  # auto | probe | kitty | iterm | none
        self.maxwidth = maxwidth
        self.insecure = insecure
        self.fd = sys.stdin.fileno()
        self.rows, self.cols = 24, 80
        self.cellw, self.cellh = 8, 16
        self.xoff = 0
        self.images_on = False
        self.hist, self.hpos = [], -1
        self.page = None
        self.lines, self.links, self.targets = [], {}, []
        self.top = 0
        self.focus = self.hover = None
        self.msg = ""
        self.query, self.matches, self.match_list, self.mi = "", {}, [], -1
        self.pending = None
        self.gen = 0
        self.visited = set()
        self.quit = False
        self.overlay = None
        self.cursor_shown = False
        self.panel = None
        self.prev_frame = None
        self.prev_places = None
        self.layout_due = 0
        self.resized = False
        self.refreshes = 0
        self.title_set = None
        self.ibuf = b""
        self.keyq = collections.deque()
        self.events = queue.Queue()
        self.imgq = queue.Queue()
        self.workers = []
        self.tabs = [Tab()]
        self.cur = 0
        self.bg = False                 # True while updating a background tab
        self.css_on = css
        self.panel_cursor = None
        self.tab_ranges = []
        self.wake_r, self.wake_w = os.pipe()
        os.set_blocking(self.wake_r, False)
        os.set_blocking(self.wake_w, False)

    # -- tabs ----------------------------------------------------------------

    @property
    def ctop(self):
        """Rows used above the page: tab strip (when >1 tab) plus the toolbar."""
        return 2 if len(self.tabs) > 1 else 1

    @property
    def vh(self):
        return max(1, self.rows - 1 - self.ctop)

    def snapshot(self):
        st = self.tabs[self.cur].state
        for f in STATE_FIELDS:
            st[f] = getattr(self, f)

    def restore(self, tab):
        for f in STATE_FIELDS:
            setattr(self, f, tab.state[f])

    def switch(self, i):
        self.snapshot()
        self.cur = i
        self.restore(self.tabs[i])

    def after_switch(self):
        self.layout(keep=False)
        self.top = max(0, min(self.top, self.max_top()))
        self.set_title(self.page.title if self.page else "")
        self.panel = None
        self.invalidate()

    def switch_to(self, i):
        if 0 <= i < len(self.tabs) and i != self.cur:
            self.switch(i)
            self.after_switch()

    def new_tab(self, url="about:home", background=False, referer=None):
        old = self.cur
        self.snapshot()
        self.tabs.append(Tab())
        self.switch(len(self.tabs) - 1)
        self.navigate(url, referer=referer)
        if background:
            self.switch(old)
        self.after_switch()

    def close_tab(self, i=None):
        i = self.cur if i is None else i
        if len(self.tabs) == 1:
            self.quit = True
            return
        if i == self.cur:
            self.tabs.pop(i)
            self.cur = min(i, len(self.tabs) - 1)
            self.restore(self.tabs[self.cur])
        else:
            self.snapshot()
            self.tabs.pop(i)
            if i < self.cur:
                self.cur -= 1
        self.after_switch()

    def tab_label(self, i):
        if i == self.cur:
            page, pend = self.page, self.pending
        else:
            st = self.tabs[i].state
            page, pend = st["page"], st["pending"]
        if page is not None and not (pend and not page.title):
            t = page.title or page.url
        elif pend:
            t = "Loading..."
        else:
            t = "New tab"
        return " ".join(t.split())

    def tabstrip(self):
        n = len(self.tabs)
        per = max(8, min(24, self.cols // n))
        parts, ranges, x = [], [], 0
        for i in range(n):
            if i == self.cur:
                fg, bg = "38;5;255", "48;5;24"
            else:
                fg, bg = "38;5;248", "48;5;234"
            inner = clip(" %d %s" % (i + 1, self.tab_label(i)), per - 3)
            inner += " " * (per - 3 - sw(inner))
            parts.append(sgr((0, fg, bg, None)) + inner + " ✕ ")
            ranges.append((x, x + per, i))
            x += per
        self.tab_ranges = ranges
        rest = max(0, self.cols - x)
        return "".join(parts) + sgr((0, None, "48;5;234", None)) + " " * rest + "\x1b[0m"

    # -- terminal ----------------------------------------------------------

    def out(self, s):
        sys.stdout.write(s)
        sys.stdout.flush()

    def term_size(self):
        try:
            r, c, xp, yp = struct.unpack("4H", fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8))
        except OSError:
            r, c, xp, yp = 0, 0, 0, 0
        if not r or not c:
            sz = shutil.get_terminal_size()
            r, c = sz.lines, sz.columns
        return r, c, xp, yp

    def update_size(self):
        r, c, xp, yp = self.term_size()
        self.rows, self.cols = max(r, 5), max(c, 20)
        if xp and yp:
            self.cellw, self.cellh = max(1, round(xp / c)), max(1, round(yp / r))
        mw = self.maxwidth
        self.width = self.cols if mw <= 0 else min(self.cols, mw)
        self.xoff = (self.cols - self.width) // 2

    def detect_gfx(self):
        env = os.environ
        if self.gfx in ("kitty", "iterm", "none"):
            return self.gfx
        if env.get("TMUX") or env.get("STY"):
            return "none"
        tp, term = env.get("TERM_PROGRAM", ""), env.get("TERM", "")
        if tp in ("iTerm.app", "WezTerm", "mintty") or env.get("LC_TERMINAL") == "iTerm2":
            return "iterm"
        if "kitty" in term or env.get("KITTY_WINDOW_ID") or tp == "ghostty" or "ghostty" in term:
            return "kitty"
        return "probe"

    def probe(self):
        """Ask the terminal about kitty graphics support and its cell size."""
        need_cell = not any(self.term_size()[2:])
        q = "\x1b_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\x1b\\" + ("\x1b[16t" if need_cell else "") + "\x1b[c"
        self.out(q)
        data, end = b"", time.time() + 0.6
        while time.time() < end:
            r, _, _ = select.select([self.fd], [], [], max(0, end - time.time()))
            if not r:
                break
            data += os.read(self.fd, 4096)
            if re.search(rb"\x1b\[\?[\d;]*c", data):
                break
        m = re.search(rb"\x1b\[6;(\d+);(\d+)t", data)
        if m:
            self.cellh, self.cellw = int(m.group(1)) or 16, int(m.group(2)) or 8
        return "kitty" if b"_Gi=31;OK" in data else "none"

    def setup(self):
        self.old_tio = termios.tcgetattr(self.fd)
        tty.setraw(self.fd)
        atexit.register(self.teardown)
        self.update_size()
        mode = self.detect_gfx()
        if mode == "probe":
            mode = self.probe()
        self.gfx = mode
        self.images_on = mode in ("kitty", "iterm")
        self.out("\x1b[22;0t\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1003h\x1b[?1006h\x1b[?2004h")
        signal.signal(signal.SIGWINCH, self.on_winch)

    def teardown(self):
        if getattr(self, "old_tio", None) is None:
            return
        try:
            self.out((KITTY_FREE if self.gfx == "kitty" else "") +
                     "\x1b[?2004l\x1b[?1006l\x1b[?1003l\x1b[?1000l\x1b[?25h\x1b[0m\x1b[?1049l\x1b[23;0t")
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_tio)
        except Exception:
            pass
        self.old_tio = None

    def on_winch(self, *_):
        self.resized = True
        self.post(None)

    def post(self, ev):
        if ev is not None:
            self.events.put(ev)
        try:
            os.write(self.wake_w, b"x")
        except (BlockingIOError, OSError):
            pass

    def set_title(self, title):
        t = title or ""
        if t != self.title_set:
            self.title_set = t
            self.out("\x1b]2;webby%s\x07" % (" - " + t.replace("\x07", "").replace("\x1b", "") if t else ""))

    # -- input ---------------------------------------------------------------

    def parse_input(self, data):
        b = self.ibuf + data
        i, n, keys = 0, len(b), self.keyq
        while i < n:
            c = b[i]
            if c == 0x1B:
                if i + 1 >= n:
                    break
                nx = b[i + 1]
                if nx == 0x5B:
                    j = i + 2
                    while j < n and not (0x40 <= b[j] <= 0x7E):
                        j += 1
                    if j >= n:
                        break
                    params, fin = b[i + 2:j].decode("latin1"), chr(b[j])
                    if params == "200" and fin == "~":
                        end = b.find(b"\x1b[201~", j + 1)
                        if end < 0:
                            break
                        keys.append(("paste", b[j + 1:end].decode("utf-8", "replace")))
                        i = end + 6
                        continue
                    i = j + 1
                    if params.startswith("<") and fin in "Mm":
                        try:
                            bb, x, y = (int(v) for v in params[1:].split(";"))
                            keys.append(("mouse", bb, x, y, fin))
                        except ValueError:
                            pass
                        continue
                    parts = params.split(";")
                    mod = ""
                    if len(parts) > 1 and parts[1].isdigit():
                        m = int(parts[1]) - 1
                        mod = ("alt-" if m & 2 else "") + ("ctrl-" if m & 4 else "")
                    name = TILDE_KEYS.get(parts[0]) if fin == "~" else CSI_KEYS.get(fin)
                    if name:
                        keys.append(mod + name)
                elif nx == 0x4F:
                    if i + 2 >= n:
                        break
                    name = SS3_KEYS.get(chr(b[i + 2]))
                    i += 3
                    if name:
                        keys.append(name)
                else:
                    keys.append("alt-" + chr(nx))
                    i += 2
            else:
                if c in (13, 10):
                    keys.append("enter")
                elif c == 9:
                    keys.append("tab")
                elif c in (8, 127):
                    keys.append("bs")
                elif c < 32:
                    keys.append("ctrl-" + chr(c + 96))
                else:
                    ln = 1 if c < 0x80 else 2 if c >> 5 == 6 else 3 if c >> 4 == 14 else 4 if c >> 3 == 30 else 1
                    if i + ln > n:
                        break
                    keys.append(b[i:i + ln].decode("utf-8", "replace"))
                    i += ln - 1
                i += 1
        self.ibuf = b[i:]

    def next_key(self):
        """Wait for a key/mouse event. Returns None when something else needs a redraw."""
        while True:
            if self.keyq:
                return self.keyq.popleft()
            timeout = None
            if self.layout_due:
                timeout = max(0.0, self.layout_due - time.time())
            if self.ibuf:
                timeout = 0.05 if timeout is None else min(timeout, 0.05)
            try:
                r, _, _ = select.select([self.fd, self.wake_r], [], [], timeout)
            except InterruptedError:
                continue
            redraw = False
            if self.wake_r in r:
                try:
                    os.read(self.wake_r, 4096)
                except BlockingIOError:
                    pass
                redraw = self.process_events()
            if self.fd in r:
                data = os.read(self.fd, 65536)
                if not data:
                    self.quit = True
                    return None
                self.parse_input(data)
            elif not r and self.ibuf:
                if self.ibuf == b"\x1b":
                    self.keyq.append("esc")
                self.ibuf = b""
            if self.layout_due and time.time() >= self.layout_due:
                self.layout_due = 0
                self.layout()
                redraw = True
            if self.keyq:
                return self.keyq.popleft()
            if redraw:
                return None

    def process_events(self):
        changed = False
        while True:
            try:
                ev = self.events.get_nowait()
            except queue.Empty:
                break
            if ev[0] == "page":
                self.on_page(ev[1], ev[2], ev[3])
                changed = True
            elif ev[0] == "img":
                if self.page is not None and ev[1].page is self.page.root:
                    self.layout_due = self.layout_due or time.time() + 0.25
            elif ev[0] == "css":
                if self.page is not None and ev[1] is self.page.root:
                    self.layout_due = self.layout_due or time.time() + 0.05
        if self.resized:
            self.resized = False
            self.update_size()
            self.layout()
            self.invalidate()
            changed = True
        return changed

    # -- loading -------------------------------------------------------------

    def save_scroll(self):
        if 0 <= self.hpos < len(self.hist):
            self.hist[self.hpos]["top"] = self.top

    def navigate(self, url, post=None, mode="push", referer=None):
        url = (url or "").strip()
        if not url:
            return
        base, frag = urllib.parse.urldefrag(url)
        scheme = urllib.parse.urlsplit(base).scheme.lower()
        if scheme not in ("http", "https", "file", "about", "data"):
            self.msg = "Can't open %s: links" % (scheme or "this")
            return
        if (frag and post is None and mode == "push" and self.page and
                base == urllib.parse.urldefrag(self.page.url)[0]):
            self.save_scroll()
            del self.hist[self.hpos + 1:]
            self.hist.append({"url": url, "page": self.page, "post": None, "top": self.top})
            self.hpos = len(self.hist) - 1
            self.jump(frag)
            return
        self.save_scroll()
        self.gen += 1
        gen = self.gen
        self.pending = {"gen": gen, "url": url, "post": post, "mode": mode, "frag": frag}
        threading.Thread(target=self.load_thread,
                         args=(gen, base, post, referer, self.tabs[self.cur]), daemon=True).start()

    def load_thread(self, gen, url, post, referer, tab):
        try:
            page = load_page(url, post, referer)
        except Exception as e:                  # network errors, bad URLs, ...
            page = error_page(url, e)
        self.post(("page", gen, page, tab))

    def on_page(self, gen, page, tab):
        if tab not in self.tabs:
            return
        idx = self.tabs.index(tab)
        if idx == self.cur:
            return self._on_page(gen, page)
        old = self.cur                      # result for a background tab
        self.switch(idx)
        self.bg = True
        try:
            self._on_page(gen, page)
        finally:
            self.bg = False
            self.switch(old)

    def _on_page(self, gen, page):
        pend = self.pending
        if not pend or pend["gen"] != gen:
            return
        self.pending = None
        mode, frag = pend["mode"], pend["frag"]
        entry = {"url": page.url, "page": page, "post": pend["post"], "top": 0}
        if mode == "inplace" and 0 <= self.hpos < len(self.hist):
            entry["top"] = self.hist[self.hpos]["top"]
            entry["url"] = self.hist[self.hpos]["url"]
            self.hist[self.hpos] = entry
        elif mode == "replace" and self.hist:
            self.hist[self.hpos] = entry
        else:
            del self.hist[self.hpos + 1:]
            self.hist.append(entry)
            self.hpos = len(self.hist) - 1
        for e in self.hist[:-15]:
            e["page"] = None
        if len(self.hist) > 100:
            del self.hist[:-100]
            self.hpos = len(self.hist) - 1
        self.visited.add(urllib.parse.urldefrag(page.url)[0])
        if not page.error and not page.url.startswith("about:"):
            STORE.visit(page.url, page.title)
        self.show(page, entry["top"], frag)
        if page.css_links and self.css_on:
            threading.Thread(target=self.css_thread, args=(page,), daemon=True).start()
        if page.refresh and page.refresh[0] <= 5 and self.refreshes < 5:
            self.refreshes += 1
            self.navigate(urllib.parse.urljoin(page.url, page.refresh[1]), mode="replace")
        else:
            self.refreshes = 0

    def css_thread(self, page):
        try:
            fetch_stylesheets(page)
        except Exception:
            page.css_links = []
        self.post(("css", page))

    def show(self, page, top=0, frag=None):
        self.clear_gfx()
        self.page = page
        self.top = top
        self.focus = self.hover = None
        self.query, self.matches, self.match_list, self.mi = "", {}, [], -1
        self.layout(keep=False)
        if frag:
            self.jump(frag)
        else:
            self.top = max(0, min(self.top, self.max_top()))
        if not self.bg:
            self.set_title(page.title)
        self.invalidate()

    def go(self, delta):
        pos = self.hpos + delta
        if not 0 <= pos < len(self.hist):
            return
        self.save_scroll()
        self.hpos = pos
        e = self.hist[pos]
        self.pending = None
        if e["page"] is not None:
            self.show(e["page"], e["top"], urllib.parse.urldefrag(e["url"])[1] or None)
        else:
            self.navigate(e["url"], e["post"], mode="inplace")

    def reload(self):
        if self.page and self.hist:
            e = self.hist[self.hpos]
            self.navigate(e["url"], e["post"], mode="inplace")

    def jump(self, frag):
        a = self.page.anchors
        idx = a.get(frag, a.get(urllib.parse.unquote(frag)))
        if frag in ("", "top"):
            idx = 0 if idx is None else idx
        if idx is not None:
            self.top = min(idx, self.max_top())
        else:
            self.msg = "Anchor #%s not found" % frag

    # -- images --------------------------------------------------------------

    def queue_image(self, im):
        if im.state != "new":
            return
        im.state = "loading"
        self.imgq.put(im)
        if not self.workers:
            for _ in range(4):
                t = threading.Thread(target=self.img_worker, daemon=True)
                t.start()
                self.workers.append(t)

    def img_worker(self):
        while True:
            im = self.imgq.get()
            live = {id(p.root) for p in [self.page] + [t.state["page"] for t in self.tabs] if p}
            if id(im.page) not in live:         # user already left that page
                im.state = "new"
                continue
            try:
                data = fetch_image(im.url, im.page.url)
                info = sniff_image(data)
                if info and self.gfx == "kitty" and info[0] != "png":
                    data = convert_to_png(data)
                    info = sniff_image(data) if data else None
                if info and info[1] > 0 and info[2] > 0:
                    im.data, (im.fmt, im.w, im.h) = data, info
                    im.state = "ok"
                else:
                    im.state = "fail"
            except Exception:
                im.state = "fail"
            self.post(("img", im))

    def clear_gfx(self):
        if self.gfx == "kitty" and not self.bg:
            self.out(KITTY_FREE)
        hists = [self.hist] + [t.state["hist"] for t in self.tabs]
        for h in hists:
            for e in h:
                if e["page"]:
                    for im in e["page"].imgs.values():
                        im.sent = False
        self.prev_places = None

    # -- layout --------------------------------------------------------------

    def max_top(self):
        return max(0, len(self.lines) - self.vh)

    def layout(self, keep=True):
        p = self.page
        if not p:
            return
        anchor = self.top_anchor() if keep else None
        try:
            r = Renderer(p, self.width, (self.cellw, self.cellh), self.images_on,
                         self.queue_image, self.visited, self.rows,
                         p.root.css if self.css_on else None)
            self.lines = r.render()
        except Exception as e:
            self.lines = [Line([("Rendering failed: %s: %s" % (e.__class__.__name__, e), PLAIN)])]
        p.anchors = {}
        for i, l in enumerate(self.lines):
            for name in l.anchors:
                p.anchors.setdefault(name, i)
        self.links = p.links
        self.targets, last = [], None
        for li, l in enumerate(self.lines):
            for _, s in l.spans:
                if s[3] is not None and s[3] != last:
                    self.targets.append((li, s[3]))
                    last = s[3]
        if anchor:
            self.restore_anchor(anchor)
        self.top = max(0, min(self.top, self.max_top()))
        if self.query:
            self.search(self.query, quiet=True)

    def top_anchor(self):
        ls, i = self.lines, self.top
        while i < len(ls) and ls[i].blank:
            i += 1
        if i >= len(ls):
            return None
        t = ls[i].text
        return (i - self.top, t, sum(1 for l in ls[:i] if l.text == t))

    def restore_anchor(self, a):
        off, t, nth = a
        c = 0
        for i, l in enumerate(self.lines):
            if l.text == t:
                if c == nth:
                    self.top = max(0, i - off)
                    return
                c += 1

    def invalidate(self):
        self.prev_frame = None
        self.prev_places = None

    # -- drawing -------------------------------------------------------------

    def render_line(self, ln, li):
        hl = self.matches.get(li)
        fr, hv = self.focus, self.hover
        parts, pos = [], 0
        for t, s in ln.spans:
            ref = s[3]
            if ref is not None and (ref == fr or ref == hv):
                s = (s[0] | R, s[1], s[2], ref)
            if hl:
                segs, cur = [], 0
                for a, b in hl:
                    a -= pos
                    b -= pos
                    if b <= 0 or a >= len(t):
                        continue
                    a, b = max(a, 0), min(b, len(t))
                    if a > cur:
                        segs.append((t[cur:a], s))
                    segs.append((t[a:b], sty(s, 0, fg="30", bg="43")))
                    cur = b
                if cur < len(t):
                    segs.append((t[cur:], s))
                for tt, ss in segs:
                    parts.append(sgr(ss) + tt)
            else:
                parts.append(sgr(s) + t)
            pos += len(t)
        return "".join(parts) + "\x1b[0m"

    def bar(self, text, fg, bg):
        text = clip(text, self.cols)
        return sgr((0, fg, bg, None)) + text + " " * (self.cols - sw(text)) + "\x1b[0m"

    def toolbar(self):
        def seg(t, fg):
            return sgr((0, fg, BAR_BG, None)) + t
        canb, canf = self.hpos > 0, self.hpos < len(self.hist) - 1
        s = (seg(" ← ", "38;5;255" if canb else "38;5;240") +
             seg(" → ", "38;5;255" if canf else "38;5;240") +
             seg(" ✕ " if self.pending else " ⟳ ", "38;5;255") +
             seg(" ⌂ ", "38;5;255") + seg("│ ", "38;5;244"))
        url = self.pending["url"] if self.pending else (self.page.url if self.page else "")
        url = clip(url, max(self.cols - 14, 1))
        return s + seg(url + " " * max(0, self.cols - 14 - sw(url)), "38;5;117") + "\x1b[0m"

    def statusbar(self):
        vh = self.vh
        if not self.lines or len(self.lines) <= vh:
            pos = "All"
        elif self.top == 0:
            pos = "Top"
        elif self.top >= self.max_top():
            pos = "Bot"
        else:
            pos = "%d%%" % (100 * self.top // self.max_top())
        flags = ""
        if self.page and self.page.reader_of:
            flags += " reader"
        if self.page and STORE.is_bookmarked(self.page.url):
            flags += " ★"
        right = " %s%s%s " % (pos, flags, " img" if self.images_on else "")
        left = self.msg
        if not left:
            ref = self.hover or self.focus
            if ref and ref[0] == "l":
                left = self.links.get(ref, "")
            elif ref:
                f = self.page.fields.get(ref[1]) if self.page else None
                left = ("%s field %s" % (f.typ, f.name or "")) if f else ""
        if not left and self.pending:
            left = "Loading %s ..." % self.pending["url"]
        if not left and self.page:
            left = self.page.title or ""
        left = clip(" " + left, max(self.cols - sw(right), 1))
        text = left + " " * max(0, self.cols - sw(left) - sw(right)) + right
        return sgr((0, "38;5;252", STATUS_BG, None)) + text + "\x1b[0m"

    def draw(self):
        rows, cols = self.rows, self.cols
        vh = self.vh
        ctop = self.ctop
        frame = [self.tabstrip()] if ctop == 2 else []
        frame.append(self.toolbar())
        places = {}
        pad = " " * self.xoff
        for i in range(vh):
            li = self.top + i
            if li < len(self.lines):
                ln = self.lines[li]
                frame.append(pad + self.render_line(ln, li))
                for im, k, tot, nc, col in ln.places:
                    key = (id(im), col, i - k)
                    e = places.get(key)
                    if e:
                        e[3] = k
                    else:
                        places[key] = [im, i, k, k, tot, nc, col]
            else:
                frame.append("")
        frame.append(self.statusbar())
        if self.panel:
            base, plines = self.panel
            for i, s in enumerate(plines):
                if 0 <= base + i < len(frame) - 1:
                    frame[base + i] = s
            places = {}
        cursor = self.panel_cursor
        if self.overlay:
            row, label, text, curcol = self.overlay
            frame[row] = self.bar(label + text, "38;5;255", "48;5;24")
            cursor = (row + 1, curcol + 1)
        plist = sorted((id(e[0]), e[1], e[2], e[3], e[6], e[5], e[4]) for e in places.values())
        by_id = {id(e[0]): e[0] for e in places.values()}
        newp = tuple(plist)
        out = []
        force = self.prev_frame is None or len(self.prev_frame) != len(frame)
        if newp != self.prev_places:
            if self.gfx == "kitty":
                out.append(KITTY_DELETE)
            elif self.gfx == "iterm":
                force = True
        for i, s in enumerate(frame):
            if force or self.prev_frame[i] != s:
                out.append("\x1b[%d;1H%s\x1b[0m\x1b[K" % (i + 1, s))
        if newp != self.prev_places or force:
            for iid, row, k0, k1, col, nc, tot in plist:
                im = by_id[iid]
                srow, scol = row + ctop + 1, col + self.xoff + 1
                if self.gfx == "kitty":
                    if not im.sent:
                        out.append(self.kitty_send(im))
                        im.sent = True
                    y0 = round(k0 * im.h / tot)
                    y1 = round((k1 + 1) * im.h / tot)
                    out.append("\x1b[%d;%dH\x1b_Ga=p,i=%d,x=0,y=%d,w=%d,h=%d,c=%d,r=%d,C=1,q=2\x1b\\" % (
                        srow, scol, im.id, y0, im.w, max(1, y1 - y0), nc, k1 - k0 + 1))
                elif self.gfx == "iterm" and k0 == 0 and k1 == tot - 1:
                    out.append("\x1b[%d;%dH%s" % (srow, scol, self.iterm_seq(im, nc, tot)))
        changed = bool(out)
        if cursor:
            out.append("\x1b[%d;%dH\x1b[?25h" % cursor)
        else:
            out.append("\x1b[?25l")
        self.prev_frame, self.prev_places = frame, newp
        if changed or cursor or self.cursor_shown:
            self.out("\x1b[?2026h" + "".join(out) + "\x1b[?2026l")
        self.cursor_shown = bool(cursor)

    def kitty_send(self, im):
        b = base64.b64encode(im.data).decode("ascii")
        chunks = [b[i:i + 4096] for i in range(0, len(b), 4096)] or [""]
        out = []
        for i, c in enumerate(chunks):
            m = 1 if i < len(chunks) - 1 else 0
            if i == 0:
                out.append("\x1b_Ga=t,f=100,i=%d,q=2,m=%d;%s\x1b\\" % (im.id, m, c))
            else:
                out.append("\x1b_Gm=%d,q=2;%s\x1b\\" % (m, c))
        return "".join(out)

    def iterm_seq(self, im, cols, rows):
        key = (cols, rows)
        s = im.cache.get(key)
        if s is None:
            s = "\x1b]1337;File=inline=1;size=%d;width=%d;height=%d;preserveAspectRatio=1:%s\x07" % (
                len(im.data), cols, rows, base64.b64encode(im.data).decode("ascii"))
            im.cache = {key: s}
        return s

    # -- input handling ------------------------------------------------------

    def scroll(self, n):
        self.top = max(0, min(self.top + n, self.max_top()))

    def ref_at(self, x, y):
        li = self.top + y - self.ctop
        if not self.ctop <= y <= self.rows - 2 or li >= len(self.lines):
            return None
        col, c = x - self.xoff, 0
        for t, s in self.lines[li].spans:
            wd = sw(t)
            if c <= col < c + wd:
                return s[3]
            c += wd
        return None

    def handle_mouse(self, b, x, y, kind):
        x -= 1
        y -= 1
        if b & 64:
            self.scroll(-3 if (b & 3) == 0 else 3 if (b & 3) == 1 else 0)
        elif b & 32:
            if (b & 3) == 3:
                self.hover = self.ref_at(x, y)
        elif kind == "M" and (b & 3) == 1:                   # middle click
            if self.ctop == 2 and y == 0:
                for x0, x1, i in self.tab_ranges:
                    if x0 <= x < x1:
                        self.close_tab(i)
                        break
            else:
                ref = self.ref_at(x, y)
                if ref and ref[0] == "l" and self.links.get(ref):
                    self.new_tab(self.links[ref], background=True,
                                 referer=self.page.url if self.page else None)
                    self.msg = "Opened in background tab"
        elif kind == "M" and (b & 3) == 0:
            if self.ctop == 2 and y == 0:
                for x0, x1, i in self.tab_ranges:
                    if x0 <= x < x1:
                        if x >= x1 - 3:
                            self.close_tab(i)
                        else:
                            self.switch_to(i)
                        break
            elif y == self.ctop - 1:
                if x < 3:
                    self.go(-1)
                elif x < 6:
                    self.go(1)
                elif x < 9:
                    if self.pending:
                        self.pending, self.gen = None, self.gen + 1
                        self.msg = "Cancelled"
                    else:
                        self.reload()
                elif x < 12:
                    self.navigate("about:home")
                else:
                    self.goto_prompt()
            else:
                ref = self.ref_at(x, y)
                if ref:
                    self.focus = ref
                    self.activate(ref)

    def goto_prompt(self):
        cur = self.page.url if self.page and not self.page.url.startswith("about:") else ""
        s = self.prompt(" Go: ", cur, row=self.ctop - 1, suggest=STORE.suggest)
        if s:
            url = normalize_url(s)
            if url:
                self.navigate(url, referer=None)

    def handle_key(self, k):
        self.msg = ""
        if isinstance(k, tuple):
            if k[0] == "mouse":
                self.handle_mouse(*k[1:])
            return
        vh = self.vh
        if self.page and self.page.url == "about:help" and k in ("q", "esc"):
            if self.hpos > 0:                   # leave the help page, don't quit
                self.go(-1)
            else:
                self.navigate("about:home")
        elif k in ("q", "ctrl-q"):
            self.quit = True
        elif k in ("t", "ctrl-t"):
            self.new_tab()
            self.goto_prompt()
        elif k in ("x", "ctrl-w"):
            self.close_tab()
        elif k in ("]", "["):
            self.switch_to((self.cur + (1 if k == "]" else -1)) % len(self.tabs))
        elif len(k) == 1 and k in "123456789":
            self.switch_to(int(k) - 1)
        elif k == "T":
            ref = self.focus or self.hover
            if ref and ref[0] == "l" and self.links.get(ref):
                self.new_tab(self.links[ref], background=True,
                             referer=self.page.url if self.page else None)
                self.msg = "Opened in background tab"
            else:
                self.msg = "Focus a link first (Tab), then press T"
        elif k == "B":
            if self.page and not self.page.error:
                url = self.page.url
                self.msg = ("Bookmarked: " if STORE.toggle_bookmark(url, self.page.title)
                            else "Removed bookmark: ") + (self.page.title or url)
        elif k == "M":
            self.navigate("about:bookmarks")
        elif k == "H":
            self.navigate("about:history")
        elif k == "l":
            self.link_list()
        elif k == "R":
            self.reader_mode()
        elif k == "C":
            self.css_on = not self.css_on
            self.layout()
            self.msg = "CSS %s" % ("on" if self.css_on else "off")
            p = self.page.root if self.page else None
            if self.css_on and p and p.css_links:
                threading.Thread(target=self.css_thread, args=(p,), daemon=True).start()
        elif k == "ctrl-c":
            if self.pending:
                self.pending, self.gen = None, self.gen + 1
                self.msg = "Cancelled"
            else:
                self.quit = True
        elif k in ("j", "down", "ctrl-n"):
            self.scroll(1)
        elif k in ("k", "up", "ctrl-p"):
            self.scroll(-1)
        elif k in (" ", "pgdn", "ctrl-f", "ctrl-d"):
            self.scroll(vh - 1 if k != "ctrl-d" else vh // 2)
        elif k in ("pgup", "ctrl-b", "ctrl-u"):
            self.scroll(-(vh - 1) if k != "ctrl-u" else -(vh // 2))
        elif k in ("home",):
            self.top = 0
        elif k in ("end", "G"):
            self.top = self.max_top()
        elif k == "enter":
            if self.focus:
                self.activate(self.focus)
            else:
                self.scroll(1)
        elif k in ("b", "left", "bs", "alt-left"):
            self.go(-1)
        elif k in ("f", "right", "alt-right"):
            self.go(1)
        elif k in ("r", "f5", "ctrl-r"):
            self.reload()
        elif k == "h":
            self.navigate("about:home")
        elif k in ("g", "o", "ctrl-l"):
            self.goto_prompt()
        elif k in ("tab", "btab"):
            self.tab(1 if k == "tab" else -1)
        elif k == "/":
            s = self.prompt("/", self.query)
            if s:
                self.search(s)
        elif k in ("n", "N"):
            self.next_match(1 if k == "n" else -1)
        elif k == "i":
            if self.gfx in ("kitty", "iterm"):
                self.images_on = not self.images_on
                self.invalidate()
                if self.gfx == "kitty":
                    self.out(KITTY_DELETE)
                self.layout()
                self.msg = "Images %s" % ("on" if self.images_on else "off")
            else:
                self.msg = "This terminal can't show images (try --images=kitty|iterm)"
        elif k == "d":
            self.save_page()
        elif k in ("?", "f1"):
            self.navigate("about:help")
        elif k == "esc":
            if self.pending:
                self.pending, self.gen = None, self.gen + 1
                self.msg = "Cancelled"
            self.focus = self.hover = None
            self.query, self.matches, self.match_list = "", {}, []

    def tab(self, d):
        if not self.targets:
            return
        refs = [r for _, r in self.targets]
        vh = self.vh
        if self.focus in refs:
            i = (refs.index(self.focus) + d) % len(refs)
        elif d > 0:
            i = next((j for j, (li, _) in enumerate(self.targets) if li >= self.top), 0)
        else:
            i = next((j for j in range(len(refs) - 1, -1, -1) if self.targets[j][0] < self.top + vh),
                     len(refs) - 1)
        self.focus = refs[i]
        li = self.targets[i][0]
        if li < self.top or li >= self.top + vh:
            self.top = max(0, min(li - vh // 3, self.max_top()))

    # -- search ---------------------------------------------------------------

    def search(self, q, quiet=False):
        self.query = q
        ql = q.lower()
        self.matches, self.match_list = {}, []
        for li, l in enumerate(self.lines):
            t = l.text.lower()
            start = 0
            while True:
                j = t.find(ql, start)
                if j < 0:
                    break
                self.matches.setdefault(li, []).append((j, j + len(ql)))
                self.match_list.append(li)
                start = j + max(len(ql), 1)
        if quiet:
            return
        if not self.match_list:
            self.msg = "Not found: " + q
            return
        self.mi = next((i for i, li in enumerate(self.match_list) if li >= self.top), 0)
        self.show_match()

    def next_match(self, d):
        if not self.match_list:
            self.msg = "No search - press / first"
            return
        self.mi = (self.mi + d) % len(self.match_list)
        self.show_match()

    def show_match(self):
        li = self.match_list[self.mi]
        vh = self.vh
        if not self.top <= li < self.top + vh:
            self.top = max(0, min(li - vh // 3, self.max_top()))
        self.msg = "Match %d of %d" % (self.mi + 1, len(self.match_list))

    # -- activating things -----------------------------------------------------

    def activate(self, ref):
        if ref[0] == "l":
            url = self.links.get(ref)
            if url:
                if url.startswith("mailto:"):
                    self.msg = url
                else:
                    self.navigate(url, referer=self.page.url if self.page else None)
            return
        f = self.page.fields.get(ref[1]) if self.page else None
        if not f or f.disabled:
            return
        typ = f.typ
        if typ == "textarea":
            v = self.edit_text(f.name or "textarea", f.value)
            if v is not None:
                f.value = v
                self.layout()
        elif typ in TEXT_TYPES:
            v = self.prompt("%s: " % (f.name or typ), f.value, secret=typ == "password")
            if v is not None:
                f.value = v
                self.layout()
                if typ != "textarea" and f.form:
                    self.submit(f.form)
        elif typ == "checkbox":
            f.checked = not f.checked
            self.layout()
        elif typ == "radio":
            for g in self.page.fields.values():
                if g.typ == "radio" and g.name == f.name and g.form is f.form:
                    g.checked = False
            f.checked = True
            self.layout()
        elif typ == "select":
            if f.options:
                i = self.choose([o[1] or "(blank)" for o in f.options], f.sel, f.name or "select")
                if i is not None:
                    f.sel = i
                    self.layout()
        elif typ in ("submit", "image"):
            if f.form:
                self.submit(f.form, f)
            else:
                self.msg = "Button is not part of a form"
        elif typ == "file":
            self.msg = "File upload is not supported"

    def submit(self, form, button=None):
        pairs = []
        for f in form.fields:
            if not f.name or f.disabled:
                continue
            if f.typ in ("submit", "image", "button", "reset"):
                if f is button:
                    pairs.append((f.name, f.value))
            elif f.typ in ("checkbox", "radio"):
                if f.checked:
                    pairs.append((f.name, f.value))
            elif f.typ == "select":
                if f.options:
                    pairs.append((f.name, f.options[f.sel][0]))
            elif f.typ == "textarea":
                pairs.append((f.name, f.value.replace("\r", "").replace("\n", "\r\n")))
            else:
                pairs.append((f.name, f.value))
        action = urllib.parse.urljoin(self.page.base, form.action) if form.action else self.page.url
        action = urllib.parse.urldefrag(action)[0]
        data = urllib.parse.urlencode(pairs)
        ref = self.page.url
        if form.method == "post":
            self.navigate(action, post=data.encode(), referer=ref)
        else:
            self.navigate(action.split("?")[0] + "?" + data, referer=ref)

    def save_page(self):
        p = self.page
        if not p or not p.raw:
            self.msg = "Nothing to save"
            return
        name = p.download or os.path.basename(urllib.parse.unquote(urllib.parse.urlsplit(p.url).path)) or "page.html"
        if "." not in name and p.ctype == "text/html":
            name += ".html"
        name = re.sub(r"[^\w.\- ]", "_", name) or "download"
        d = os.path.expanduser("~/Downloads")
        if not os.path.isdir(d):
            d = os.getcwd()
        path, n = os.path.join(d, name), 1
        while os.path.exists(path):
            stem, ext = os.path.splitext(name)
            path = os.path.join(d, "%s-%d%s" % (stem, n, ext))
            n += 1
        try:
            with open(path, "wb") as f:
                f.write(p.raw)
            self.msg = "Saved " + path
        except OSError as e:
            self.msg = "Save failed: %s" % e

    # -- prompts and menus -------------------------------------------------------

    def prompt(self, label, text="", row=None, secret=False, suggest=None):
        """One-line editor. With `suggest`, shows completions: Tab/Down/Up pick one."""
        row = self.rows - 1 if row is None else row
        buf, pos = list(text), len(text)
        sugg, ssel, last, filled = [], -1, text, False
        try:
            while True:
                s = "".join(buf)
                shown = "•" * len(s) if secret else s
                avail = max(self.cols - sw(label) - 1, 1)
                start = max(0, pos - avail + 1)
                self.overlay = (row, label, shown[start:start + avail], sw(label) + sw(shown[start:pos]))
                if sugg:
                    lines = []
                    for i, (u, t) in enumerate(sugg):
                        fg, bg = ("30", "47") if i == ssel else ("38;5;252", "48;5;237")
                        lines.append(self.bar("  " + u + ("   " + t if t else ""), fg, bg))
                    self.panel = (row + 1, lines)
                else:
                    self.panel = None
                self.draw()
                k = self.next_key()
                if k is None:
                    if self.quit:
                        return None
                    continue
                if isinstance(k, tuple):
                    if k[0] == "paste":
                        ins = list(k[1].replace("\n", " ").replace("\r", ""))
                        buf[pos:pos] = ins
                        pos += len(ins)
                    else:
                        continue
                elif k == "enter":
                    return s
                elif k in ("esc", "ctrl-c", "ctrl-g"):
                    return None
                elif sugg and k in ("tab", "down", "up", "btab"):
                    ssel = (ssel + (1 if k in ("tab", "down") else -1)) % len(sugg)
                    buf = list(sugg[ssel][0])
                    pos, filled = len(buf), True
                elif k == "bs":
                    if pos:
                        del buf[pos - 1]
                        pos -= 1
                elif k in ("del", "ctrl-d"):
                    if pos < len(buf):
                        del buf[pos]
                elif k in ("left", "ctrl-b"):
                    pos = max(0, pos - 1)
                elif k in ("right", "ctrl-f"):
                    pos = min(len(buf), pos + 1)
                elif k in ("home", "ctrl-a"):
                    pos = 0
                elif k in ("end", "ctrl-e"):
                    pos = len(buf)
                elif k == "ctrl-u":
                    del buf[:pos]
                    pos = 0
                elif k == "ctrl-k":
                    del buf[pos:]
                elif k == "ctrl-w":
                    j = pos
                    while j and buf[j - 1] == " ":
                        j -= 1
                    while j and buf[j - 1] != " ":
                        j -= 1
                    del buf[j:pos]
                    pos = j
                elif len(k) == 1 and k >= " ":
                    buf.insert(pos, k)
                    pos += 1
                now = "".join(buf)
                if now != last:
                    last = now
                    if filled:
                        filled = False
                    else:
                        ssel = -1
                        sugg = suggest(now) if suggest and now.strip() else []
        finally:
            self.overlay = None
            self.panel = None
            self.invalidate()

    def choose(self, items, cur=0, title="", filt=False):
        """Pick from a list; returns the index in `items` or None. filt: type to filter."""
        sel, flt = cur, ""
        try:
            while True:
                low = flt.lower()
                view = [i for i, t in enumerate(items) if low in t.lower()] if flt else list(range(len(items)))
                sel = max(0, min(sel, len(view) - 1))
                n = min(len(view), max(self.rows - 6, 1))
                start = max(0, min(sel - n // 2, len(view) - n))
                hdr = " " + title + ("   filter: " + flt + "_" if filt else "") + "   (Enter selects, Esc cancels)"
                lines = [self.bar(hdr, "38;5;255", "48;5;24")]
                for j in range(start, start + n):
                    fg, bg = ("30", "47") if j == sel else ("38;5;252", "48;5;237")
                    lines.append(self.bar(" " + ("▶ " if j == sel else "  ") + items[view[j]], fg, bg))
                if not view:
                    lines.append(self.bar("   (no matches)", "38;5;245", "48;5;237"))
                base = self.rows - 1 - len(lines)
                self.panel = (base, lines)
                self.draw()
                k = self.next_key()
                if k is None:
                    if self.quit:
                        return None
                    continue
                if isinstance(k, tuple):
                    if k[0] != "mouse":
                        continue
                    b = k[1]
                    if b & 64:
                        sel += -3 if (b & 3) == 0 else 3
                    elif k[4] == "M" and (b & 3) == 0 and not b & 32:
                        j = k[3] - 1 - (base + 1) + start
                        if start <= j < start + n:
                            return view[j]
                    continue
                if k in ("esc", "ctrl-c"):
                    return None
                if k == "enter":
                    return view[sel] if view else None
                if k in ("down", "ctrl-n") or (not filt and k in ("j", "tab")):
                    sel += 1
                elif k in ("up", "ctrl-p") or (not filt and k in ("k", "btab")):
                    sel -= 1
                elif k == "pgdn":
                    sel += n
                elif k == "pgup":
                    sel -= n
                elif k == "home":
                    sel = 0
                elif k == "end":
                    sel = len(view) - 1
                elif not filt and k == "q":
                    return None
                elif filt and k == "bs":
                    flt, sel = flt[:-1], 0
                elif filt and k == "ctrl-u":
                    flt, sel = "", 0
                elif filt and len(k) == 1 and k >= " ":
                    flt, sel = flt + k, 0
        finally:
            self.panel = None
            self.invalidate()

    def edit_text(self, title, text):
        """Full-area multi-line editor for textareas. Ctrl-S saves, Esc cancels."""
        lines = text.split("\n") or [""]
        r = c = top = hs = 0
        try:
            while True:
                h = self.vh
                body = max(1, h - 1)
                width = max(1, self.cols - 1)
                c = min(c, len(lines[r]))
                top = max(0, min(top, r), r - body + 1)
                hs = max(0, c - width + 1) if c >= width else 0
                plines = [self.bar(" %s - Ctrl-S saves, Esc cancels" % title, "38;5;255", "48;5;24")]
                for i in range(body):
                    li = top + i
                    plines.append(self.bar(lines[li][hs:hs + width] if li < len(lines) else "~",
                                           "38;5;252" if li < len(lines) else "38;5;240", "48;5;235"))
                self.panel = (self.ctop, plines)
                self.panel_cursor = (self.ctop + 2 + (r - top), sw(lines[r][hs:c]) + 1)
                self.draw()
                k = self.next_key()
                if k is None:
                    if self.quit:
                        return None
                    continue
                if isinstance(k, tuple):
                    if k[0] == "paste":
                        parts = k[1].replace("\r\n", "\n").replace("\r", "\n").split("\n")
                        tail = lines[r][c:]
                        lines[r] = lines[r][:c] + parts[0]
                        for p in parts[1:]:
                            r += 1
                            lines.insert(r, p)
                        c = len(lines[r])
                        lines[r] += tail
                    elif k[0] == "mouse":
                        b = k[1]
                        if b & 64:
                            r = max(0, min(len(lines) - 1, r + (-3 if (b & 3) == 0 else 3)))
                        elif k[4] == "M" and (b & 3) == 0 and not b & 32:
                            i = k[3] - 1 - (self.ctop + 1)
                            if 0 <= i < body:
                                r = min(len(lines) - 1, top + i)
                                c = min(len(lines[r]), hs + max(0, k[2] - 1))
                    continue
                if k == "ctrl-s":
                    return "\n".join(lines)
                if k in ("esc", "ctrl-c", "ctrl-g"):
                    return None
                ln = lines[r]
                if k == "enter":
                    lines[r:r + 1] = [ln[:c], ln[c:]]
                    r, c = r + 1, 0
                elif k == "bs":
                    if c:
                        lines[r] = ln[:c - 1] + ln[c:]
                        c -= 1
                    elif r:
                        c = len(lines[r - 1])
                        lines[r - 1] += ln
                        del lines[r]
                        r -= 1
                elif k in ("del", "ctrl-d"):
                    if c < len(ln):
                        lines[r] = ln[:c] + ln[c + 1:]
                    elif r + 1 < len(lines):
                        lines[r] += lines.pop(r + 1)
                elif k in ("left", "ctrl-b"):
                    if c:
                        c -= 1
                    elif r:
                        r -= 1
                        c = len(lines[r])
                elif k in ("right", "ctrl-f"):
                    if c < len(ln):
                        c += 1
                    elif r + 1 < len(lines):
                        r, c = r + 1, 0
                elif k in ("up", "ctrl-p"):
                    r = max(0, r - 1)
                elif k in ("down", "ctrl-n"):
                    r = min(len(lines) - 1, r + 1)
                elif k == "pgup":
                    r = max(0, r - body)
                elif k == "pgdn":
                    r = min(len(lines) - 1, r + body)
                elif k in ("home", "ctrl-a"):
                    c = 0
                elif k in ("end", "ctrl-e"):
                    c = len(ln)
                elif k == "ctrl-k":
                    lines[r] = ln[:c]
                elif k == "ctrl-u":
                    lines[r] = ln[c:]
                    c = 0
                elif k == "tab":
                    lines[r] = ln[:c] + "    " + ln[c:]
                    c += 4
                elif len(k) == 1 and k >= " ":
                    lines[r] = ln[:c] + k + ln[c:]
                    c += 1
        finally:
            self.panel = None
            self.panel_cursor = None
            self.invalidate()

    def link_list(self):
        order, texts = [], {}
        for l in self.lines:
            for t, st in l.spans:
                ref = st[3]
                if ref is not None and ref[0] == "l":
                    if ref not in texts:
                        texts[ref] = ""
                        order.append(ref)
                    texts[ref] += t
        if not order:
            self.msg = "No links on this page"
            return
        items = ["%3d  %s   %s" % (i + 1, clip(" ".join(texts[r].split()) or "(no text)", 45),
                                   self.links.get(r, "")) for i, r in enumerate(order)]
        i = self.choose(items, 0, "Links", filt=True)
        if i is not None:
            self.focus = order[i]
            self.activate(order[i])

    def reader_mode(self):
        p = self.page
        if not p:
            return
        if p.reader_of:
            target = p.reader_of
        else:
            if p.reader is None:
                p.reader = make_reader(p) or False
            if not p.reader:
                self.msg = "Couldn't find article text on this page"
                return
            target = p.reader
        self.page = target
        self.top = 0
        self.focus = self.hover = None
        self.query, self.matches, self.match_list = "", {}, []
        self.layout(keep=False)
        self.invalidate()
        self.msg = "Reader mode on (R to leave)" if target.reader_of else "Reader mode off"

    # -- main loop ---------------------------------------------------------------

    def run(self, start):
        self.setup()
        try:
            self.navigate(start)
            while not self.quit:
                self.draw()
                k = self.next_key()
                if k is not None:
                    self.handle_key(k)
        finally:
            self.teardown()


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def dump(url, width, css=True):
    page = load_page(url)
    if css and page.css_links:
        fetch_stylesheets(page)
    r = Renderer(page, width, (8, 16), False, None, set(), 24, page.css if css else None)
    for l in r.render():
        print(l.text.rstrip())


def main():
    global OPENER
    ap = argparse.ArgumentParser(prog="webby", description="A dependency-free terminal web browser.")
    ap.add_argument("url", nargs="*", help="URL, file path, or search words (default: about:home)")
    ap.add_argument("--images", choices=["auto", "kitty", "iterm", "none"],
                    default=os.environ.get("WEBBY_IMAGES", "auto"),
                    help="image protocol (default: auto-detect)")
    ap.add_argument("--no-images", action="store_true", help="same as --images=none")
    ap.add_argument("-w", "--width", type=int, default=110,
                    help="maximum text width, 0 for full width (default 110)")
    ap.add_argument("--no-css", action="store_true", help="ignore stylesheets")
    ap.add_argument("--theme", choices=["auto", "dark", "light"], default="auto",
                    help="terminal background, used to keep CSS colours readable (default: auto)")
    ap.add_argument("--private", action="store_true", help="don't record browsing history")
    ap.add_argument("--insecure", action="store_true", help="don't verify TLS certificates")
    ap.add_argument("--dump", action="store_true", help="print the rendered page as text and exit")
    ap.add_argument("--version", action="version", version="webby " + VERSION)
    args = ap.parse_args()
    OPENER = make_opener(args.insecure)
    STORE.private = args.private
    global THEME_DARK
    theme = args.theme
    if theme == "auto":
        bgc = os.environ.get("COLORFGBG", "").split(";")[-1]
        theme = "light" if bgc in ("7", "15") else "dark"
    THEME_DARK = theme == "dark"
    target = " ".join(args.url).strip()
    url = normalize_url(target) if target else "about:home"
    if args.dump or not (sys.stdin.isatty() and sys.stdout.isatty()):
        width = args.width if args.width > 0 else shutil.get_terminal_size().columns
        try:
            dump(url, width if args.width else 80, not args.no_css)
        except Exception as e:
            sys.exit("webby: %s" % e)
        return
    gfx = "none" if args.no_images else args.images
    Browser(gfx, args.width, args.insecure, not args.no_css).run(url)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
