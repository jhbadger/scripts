READER_SKIP = frozenset("nav aside footer form button select textarea input iframe dialog".split())
RE_JUNK = re.compile(r"(^|[\s_-])(comments?|sidebar|footer|nav|navbar|menu|share|sharing|social|"
                     r"promo|adverts?|ads?|cookie|banner|popup|modal|related|newsletter|subscribe)"
                     r"([\s_-]|$)", re.I)


def link_density(node):
    total = len(node.text_content().strip()) or 1
    linked, stack = 0, [node]
    while stack:
        x = stack.pop()
        if x.tag == "a":
            linked += len(x.text_content().strip())
        elif x.tag is not None and x.tag not in SKIP:
            stack.extend(x.children)
    return linked / total


def make_reader(page):
    """Return a clone of page showing only its main article, or None."""
    scores = {}
    stack = [page.dom]
    while stack:
        n = stack.pop()
        for c in n.children:
            if c.tag is None or c.tag in SKIP:
                continue
            stack.append(c)
            if c.tag in ("p", "pre", "blockquote"):
                text = c.text_content().strip()
                if len(text) < 25:
                    continue
                sc = 1 + text.count(",") + min(len(text) // 100, 3)
                anc = c.parent
                for depth in range(3):
                    if anc is None or anc.tag == "#root":
                        break
                    ent = scores.setdefault(id(anc), [anc, 0.0])
                    ent[1] += sc / (1, 2, 4)[depth]
                    anc = anc.parent
    best, best_score = None, 0.0
    ranked = sorted(scores.values(), key=lambda e: -e[1])[:8]
    for node, sc in ranked:
        if node.tag in ("article", "main"):
            sc += 15
        sc *= 1 - link_density(node)
        if sc > best_score:
            best, best_score = node, sc
    if best is None or best_score < 8:
        return None
    root = Node("#root")
    kids = []
    title = page.title
    if title and not any(x.tag == "h1" for x in best.children):
        h1 = Node("h1")
        h1.children.append(Node(None, text=title))
        kids.append(h1)
    kids.append(best)
    root.children = kids
    clone = Page(page.url, root, page.title, page.raw, page.ctype)
    clone.base = page.base
    clone.imgs, clone.fields, clone.links = page.imgs, page.fields, page.links
    clone.css, clone.css_slots = page.css, page.css_slots
    clone._id = page._id + 100000
    clone.reader_of = page
    return clone


