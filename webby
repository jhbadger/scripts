# Text width and styles
# ---------------------------------------------------------------------------

CTRL = dict.fromkeys(list(range(0, 9)) + list(range(11, 32)) + list(range(127, 160)))
_wcache = {}


def cw(ch):
    """Display width of one character."""
    w = _wcache.get(ch)
    if w is None:
        if ord(ch) < 32:
            w = 0
        elif unicodedata.category(ch) in ("Mn", "Me", "Cf"):
            w = 0
        elif unicodedata.east_asian_width(ch) in "WF":
            w = 2
        else:
            w = 1
        _wcache[ch] = w
    return w


def sw(s):
    return sum(cw(c) for c in s)


def clip(s, n):
    """Cut s to display width n (adds an ellipsis when it was shortened)."""
    if sw(s) <= n:
        return s
    out, w = [], 0
    for ch in s:
        c = cw(ch)
        if w + c > n - 1:
            break
        out.append(ch)
        w += c
    return "".join(out) + "…" if n > 0 else ""


# style = (flags, fg, bg, ref); fg/bg are SGR parameter strings; ref is the
# click target: ("l", id) for a link, ("f", id) for a form field.
B, I, U, R, D, S = 1, 2, 4, 8, 16, 32
PLAIN = (0, None, None, None)
KEEP = object()
LINK_FG, VISITED_FG, CODE_FG = "38;5;75", "38;5;140", "38;5;180"
DIM_ST = (0, "38;5;244", None, None)
FIELD_BG = "48;5;238"
BAR_BG, STATUS_BG = "48;5;236", "48;5;238"


def sty(st, add=0, fg=KEEP, bg=KEEP, ref=KEEP):
    return (st[0] | add, st[1] if fg is KEEP else fg,
            st[2] if bg is KEEP else bg, st[3] if ref is KEEP else ref)


_sgr = {}


def sgr(st):
    key = st[:3]
    s = _sgr.get(key)
    if s is None:
        f, fg, bg = key
        p = ["0"]
        for bit, code in ((B, "1"), (D, "2"), (I, "3"), (U, "4"), (R, "7"), (S, "9")):
            if f & bit:
                p.append(code)
        if fg:
            p.append(fg)
        if bg:
            p.append(bg)
        s = _sgr[key] = "\x1b[" + ";".join(p) + "m"
    return s


def merge(spans):
    out = []
    for t, s in spans:
        if not t:
            continue
        if out and out[-1][1] == s:
            out[-1] = (out[-1][0] + t, s)
        else:
            out.append((t, s))
    return out


