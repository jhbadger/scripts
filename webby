def sniff_image(d):
    """Return (format, width, height) or None, from the file header."""
    try:
        if d[:8] == b"\x89PNG\r\n\x1a\n":
            w, h = struct.unpack(">II", d[16:24])
            return "png", w, h
        if d[:6] in (b"GIF87a", b"GIF89a"):
            w, h = struct.unpack("<HH", d[6:10])
            return "gif", w, h
        if d[:2] == b"\xff\xd8":
            i = 2
            while i + 9 < len(d):
                if d[i] != 0xFF:
                    i += 1
                    continue
                m = d[i + 1]
                if m == 0xFF:
                    i += 1
                    continue
                if m in (0xD8, 0x01) or 0xD0 <= m <= 0xD7:
                    i += 2
                    continue
                if m in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                    h, w = struct.unpack(">HH", d[i + 5:i + 9])
                    return "jpeg", w, h
                i += 2 + struct.unpack(">H", d[i + 2:i + 4])[0]
        if d[:4] == b"RIFF" and d[8:12] == b"WEBP":
            c = d[12:16]
            if c == b"VP8 ":
                w, h = struct.unpack("<HH", d[26:30])
                return "webp", w & 0x3FFF, h & 0x3FFF
            if c == b"VP8L":
                b = struct.unpack("<I", d[21:25])[0]
                return "webp", (b & 0x3FFF) + 1, ((b >> 14) & 0x3FFF) + 1
            if c == b"VP8X":
                return ("webp", int.from_bytes(d[24:27], "little") + 1,
                        int.from_bytes(d[27:30], "little") + 1)
        if d[:2] == b"BM":
            w, h = struct.unpack("<ii", d[18:26])
            return "bmp", w, abs(h)
    except (struct.error, IndexError):
        pass
    return None


def convert_to_png(data):
    """Convert any image to PNG with whatever tool is available (or None)."""
    tools = []
    for exe, args in (("magick", ["-", "png:-"]), ("convert", ["-", "png:-"])):
        p = shutil.which(exe)
        if p:
            tools.append([p] + args)
    for cmd in tools:
        try:
            r = subprocess.run(cmd, input=data, capture_output=True, timeout=20)
            if r.returncode == 0 and r.stdout[:4] == b"\x89PNG":
                return r.stdout
        except (OSError, subprocess.SubprocessError):
            pass
    sips = shutil.which("sips")
    if sips:
        try:
            with tempfile.TemporaryDirectory() as td:
                src, dst = os.path.join(td, "in"), os.path.join(td, "out.png")
                with open(src, "wb") as f:
                    f.write(data)
                subprocess.run([sips, "-s", "format", "png", src, "--out", dst],
                               capture_output=True, timeout=20)
                with open(dst, "rb") as f:
                    out = f.read()
                if out[:4] == b"\x89PNG":
                    return out
        except (OSError, subprocess.SubprocessError):
            pass
    return None


