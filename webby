VOID = frozenset("area base br col embed hr img input link meta param source track wbr".split())
INLINE = frozenset("a abbr b bdi bdo big cite code data dfn em font i kbd label mark nobr q s "
                   "samp small span strike strong sub sup time tt u var".split())
PCLOSE = frozenset("address article aside blockquote center details dir div dl fieldset "
                   "figcaption figure footer form h1 h2 h3 h4 h5 h6 header hr main menu nav "
                   "ol p pre section table ul li dd dt".split())
HEADTAGS = frozenset("title meta link script style base noscript template head html".split())
IMPLIED = {
    "li": (frozenset(["li"]), frozenset(["ul", "ol", "menu", "dir"])),
    "dt": (frozenset(["dt", "dd"]), frozenset(["dl"])),
    "dd": (frozenset(["dt", "dd"]), frozenset(["dl"])),
    "tr": (frozenset(["tr"]), frozenset(["table", "thead", "tbody", "tfoot"])),
    "td": (frozenset(["td", "th"]), frozenset(["tr", "table"])),
    "th": (frozenset(["td", "th"]), frozenset(["tr", "table"])),
    "thead": (frozenset(["thead", "tbody", "tfoot"]), frozenset(["table"])),
    "tbody": (frozenset(["thead", "tbody", "tfoot"]), frozenset(["table"])),
    "tfoot": (frozenset(["thead", "tbody", "tfoot"]), frozenset(["table"])),
    "option": (frozenset(["option"]), frozenset(["select", "datalist"])),
    "optgroup": (frozenset(["option", "optgroup"]), frozenset(["select"])),
}
TABLEISH = frozenset("table tr td th thead tbody tfoot caption".split())
BARRIERS = frozenset(["table", "td", "th", "caption"])


class Node:
    __slots__ = ("tag", "attrs", "children", "parent", "text", "data")

    def __init__(self, tag, attrs=None, text=None):
        self.tag = tag
        self.attrs = attrs or {}
        self.children = []
        self.parent = None
        self.text = text
        self.data = None            # persistent state (field / link id)

    def add(self, c):
        c.parent = self
        self.children.append(c)

    def text_content(self):
        if self.tag is None:
            return self.text
        out, stack = [], list(reversed(self.children))
        while stack:
            x = stack.pop()
            if x.tag is None:
                out.append(x.text)
            elif x.tag not in SKIP:
                stack.extend(reversed(x.children))
        return "".join(out)


class Builder(html.parser.HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.root = Node("#root")
        self.stack = [self.root]
        self.title = ""
        self.base = None
        self.refresh = None
        self.css_items = []         # ["style", text, media] / ["link", href, media]

    def close_p(self):
        st = self.stack
        for i in range(len(st) - 1, 0, -1):
            t = st[i].tag
            if t == "p":
                del st[i:]
                return
            if t not in INLINE:
                return

    def implied(self, closes, barriers):
        st = self.stack
        for i in range(len(st) - 1, 0, -1):
            t = st[i].tag
            if t in closes:
                del st[i:]
                return
            if t in barriers:
                return

    def handle_starttag(self, tag, attrs):
        a = {}
        for k, v in attrs:
            a.setdefault(k, v or "")
        st = self.stack
        if tag not in HEADTAGS:
            while len(st) > 1 and st[-1].tag == "head":
                st.pop()
        if tag == "body":
            while len(st) > 1 and st[-1].tag not in ("html",):
                st.pop()
        if tag in ("html", "body") and any(n.tag == tag for n in st):
            return
        if tag in PCLOSE:
            self.close_p()
        imp = IMPLIED.get(tag)
        if imp:
            self.implied(*imp)
        if tag == "base" and a.get("href") and not self.base:
            self.base = a["href"]
        elif tag == "meta" and a.get("http-equiv", "").lower() == "refresh":
            m = re.match(r"\s*(\d+(?:\.\d+)?)\s*(?:[;,]\s*(?:url\s*=\s*)?['\"]?(.*?)['\"]?\s*)?$",
                         a.get("content", ""), re.I)
            if m and m.group(2):
                self.refresh = (float(m.group(1)), m.group(2))
        if tag == "link" and a.get("href") and "stylesheet" in a.get("rel", "").lower().split() \
                and "alternate" not in a.get("rel", "").lower().split():
            self.css_items.append(["link", a["href"], a.get("media", "")])
        elif tag == "style":
            self.css_items.append(["style", "", a.get("media", "")])
        n = Node(tag, a)
        self.stack[-1].add(n)
        if tag not in VOID:
            self.stack.append(n)

    def handle_endtag(self, tag):
        if tag in VOID or tag in ("html", "body"):
            return
        st = self.stack
        if tag == "table":
            barrier = ()
        elif tag in TABLEISH:
            barrier = ("table",)
        else:
            barrier = BARRIERS
        for i in range(len(st) - 1, 0, -1):
            t = st[i].tag
            if t == tag:
                del st[i:]
                return
            if t in barrier:
                return

    def handle_data(self, data):
        top = self.stack[-1]
        if top.tag == "title":
            self.title += data
        elif top.tag == "style":
            for it in reversed(self.css_items):
                if it[0] == "style":
                    it[1] += data
                    break
        elif top.tag == "script":
            return
        elif data:
            top.add(Node(None, text=data))


def parse_html(text):
    b = Builder()
    try:
        b.feed(text)
        b.close()
    except Exception:
        pass
    return b


def text_dom(text):
    root = Node("#root")
    pre = Node("pre")
    root.add(pre)
    pre.add(Node(None, text=text))
    return root


