def make_page(resp, url=None):
    url = url or resp.url
    ctype, body = resp.ctype, resp.body
    head = body[:512].lstrip().lower()
    if ctype in ("", "text/plain", "application/octet-stream") and (
            head.startswith(b"<!doctype html") or head.startswith(b"<html")):
        ctype = "text/html"
    if ctype.startswith("image/") and ctype != "image/svg+xml" or (
            not ctype and sniff_image(body)):
        b = parse_html('<img src="%s" alt="[image]">' % html.escape(url, True))
        p = Page(url, b.root, os.path.basename(urllib.parse.urlsplit(url).path) or "image",
                 body, ctype)
        return p
    if ctype in ("text/html", "application/xhtml+xml"):
        b = parse_html(decode_body(body, resp.headers))
        page = Page(url, b.root, b.title, body, ctype, b.base, b.refresh)
        init_css(page, b.css_items)
        return page
    if ctype.startswith("text/") or ctype in (
            "application/json", "application/xml", "application/javascript", "image/svg+xml",
            "application/rss+xml", "application/atom+xml", "application/x-sh"):
        return Page(url, text_dom(decode_body(body, resp.headers)), url, body, ctype)
    name = os.path.basename(urllib.parse.unquote(urllib.parse.urlsplit(url).path)) or "download"
    b = parse_html("<h1>Download</h1><p>%s</p><p>Type: %s, size: %d bytes</p>"
                   "<p>Press <b>d</b> to save it to your Downloads folder.</p>" % (
                       html.escape(name), html.escape(ctype or "unknown"), len(body)))
    p = Page(url, b.root, name, body, ctype)
    p.download = name
    return p


