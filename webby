TEXT_TYPES = frozenset(["text", "search", "email", "url", "tel", "password", "number", "date",
                        "datetime-local", "time", "month", "week", "color", "range", ""])


def num(v, default=0):
    try:
        return int(str(v).strip().rstrip("%px"))
    except (ValueError, TypeError):
        return default


def alloc(cmin, cmax, avail):
    """Choose column widths between min and max content widths."""
    n = len(cmin)
    if sum(cmax) <= avail:
        return list(cmax)
    if avail < n:
        return [1] * n
    if sum(cmin) >= avail:
        tot = sum(cmin)
        wid = [max(1, c * avail // tot) for c in cmin]
    else:
        extra = avail - sum(cmin)
        diff = [mx - mn for mn, mx in zip(cmin, cmax)]
        tot = sum(diff) or 1
        wid = [mn + extra * d // tot for mn, d in zip(cmin, diff)]
    left = avail - sum(wid)
    order = sorted(range(n), key=lambda i: -(cmax[i] - wid[i]))
    k = 0
    while left > 0 and n:
        i = order[k % n]
        if wid[i] < cmax[i] or sum(wid) < avail:
            wid[i] += 1
            left -= 1
        k += 1
        if k > 10 * n + 1000:
            break
    while sum(wid) > avail:
        i = wid.index(max(wid))
        wid[i] -= 1
    return wid


class Renderer:
    def __init__(self, page, width, cell, images, request, visited, term_rows, css=None):
        self.page = page
        self.width = width
        self.cell = cell
        self.images = images
        self.request = request
        self.visited = visited
        self.term_rows = term_rows
        self.links = page.links
        self.memo = {}
        self.minmemo = {}
        self.list_depth = 0
        self.form = None
        self.reader = page.reader_of is not None
        self.css = css
        self.tt = None              # active text-transform
        self.inline_mode = 0        # >0 while laying out an inline flex row

    # -- driver ------------------------------------------------------------

    def render(self):
        fl = Flow(self.width)
        self.walk(self.page.dom, PLAIN, fl)
        fl.flush()
        return fl.lines

    def resolve(self, href):
        href = re.sub(r"[\r\n\t]", "", href.strip())
        if href.startswith("data:"):
            return href
        return urllib.parse.urljoin(self.page.base, href)

    def hidden(self, a):
        return "hidden" in a or (a.get("style") and RE_HIDDEN.search(a["style"]))

    def cs(self, n):
        return self.css.compute(n) if self.css else None

    def align(self, n, fl):
        cs = self.cs(n)
        al = cs.get("text-align") if cs else None
        al = al or n.attrs.get("align")
        if not al and n.attrs.get("style"):
            m = RE_TA.search(n.attrs["style"])
            al = m.group(1) if m else None
        if al:
            al = al.lower()
            if al in ("center", "middle", "-webkit-center", "-moz-center"):
                return "center"
            if al == "right":
                return "right"
            return "left"
        return fl.align

    def sub_block(self, n, st, w, align, pre=False):
        f = Flow(w, align, pre)
        self.walk(n, st, f)
        f.flush()
        return f.lines

    def cell_lines(self, cell, st, w, align):
        k = (id(cell), w, align)
        r = self.memo.get(k)
        if r is None:
            r = self.memo[k] = self.sub_block(cell, st, w, align)
        return r

    def walk(self, node, st, fl):
        for ch in node.children:
            if ch.tag is None:
                fl.text(self.tt_apply(ch.text) if self.tt else ch.text, st)
            else:
                self.element(ch, st, fl)

    def tt_apply(self, s):
        if self.tt == "uppercase":
            return s.upper()
        if self.tt == "lowercase":
            return s.lower()
        return re.sub(r"(^|\s)(\S)", lambda m: m.group(1) + m.group(2).upper(), s)

    # -- elements ----------------------------------------------------------

    def apply_style(self, st, cs, t):
        """Apply inherited-style CSS properties (weight, slant, decoration, colour) to st."""
        f, fg = st[0], st[1]
        inlink = st[3] is not None
        v = cs.get("font-weight", "").lower()
        if v:
            if v in ("bold", "bolder") or (v.isdigit() and int(v) >= 600):
                f |= B
            elif v in ("normal", "lighter") or v.isdigit():
                f &= ~B
        v = cs.get("font-style", "").lower()
        if v in ("italic", "oblique"):
            f |= I
        elif v == "normal":
            f &= ~I
        td = (cs.get("text-decoration-line") or cs.get("text-decoration") or "").lower()
        if td:
            if "line-through" in td:
                f |= S
            if "underline" in td:
                f |= U
            elif "none" in td and not inlink and t != "a":
                f &= ~(U | S)
        v = cs.get("color")
        if v and not inlink:
            rgb = parse_color(v)
            if rgb:
                fg = term_color(rgb)
        return (f, fg, st[2], st[3])

    def element(self, n, st, fl):
        t = n.tag
        a = n.attrs
        if t in SKIP or self.hidden(a):
            return
        cs = self.cs(n)
        if cs:
            if css_hidden(cs):
                return
            st = self.apply_style(st, cs, t)
        if self.reader and (t in READER_SKIP or RE_JUNK.search(
                (a.get("class") or "") + " " + (a.get("id") or ""))) and n not in self.page.dom.children:
            return
        nm = a.get("id") or (a.get("name") if t == "a" else None)
        if nm:
            fl.pending.append(nm)
        old = self.tt
        if cs and "text-transform" in cs:
            v = cs["text-transform"].lower()
            self.tt = v if v in ("uppercase", "lowercase", "capitalize") else None
        try:
            self.element2(n, st, fl, cs)
        finally:
            self.tt = old

    def skipped(self, n):
        if n.tag in SKIP or self.hidden(n.attrs):
            return True
        cs = self.cs(n)
        return bool(cs and css_hidden(cs))

    def flex_inline(self, n, cs):
        """Can this flex row be shown as one line of short items (e.g. a nav bar)?"""
        if cs.get("flex-direction", "row").lower().startswith("column"):
            return False
        kids = [c for c in n.children if c.tag is not None and not self.skipped(c)]
        if not 1 <= len(kids) <= 30:
            return False
        for c in kids:
            if len(c.text_content().strip()) > 80:
                return False
            stack = list(c.children)
            while stack:
                x = stack.pop()
                if x.tag in HEAVY:
                    return False
                stack.extend(x.children)
        return True

    def flex_row(self, n, st, fl):
        self.inline_mode += 1
        first = True
        try:
            for ch in n.children:
                if ch.tag is None:
                    if ch.text.strip():
                        fl.text(ch.text, st)
                    continue
                if self.skipped(ch):
                    continue
                if not first:
                    fl.atoms.extend([("s", " ", st), ("w", "·", DIM_ST), ("s", " ", st)])
                first = False
                self.element(ch, st, fl)
        finally:
            self.inline_mode -= 1

    def element2(self, n, st, fl, cs):
        t = n.tag
        disp = cs.get("display", "").lower() if cs else ""
        if disp:
            if disp in ("flex", "inline-flex") and self.flex_inline(n, cs):
                return self.flex_row(n, st, fl)
            if disp in INLINEISH and t in BLOCKY:
                return self.walk(n, st, fl)
            if disp in BLOCKISH and t in INLINEY:
                f = Flow(fl.w, fl.align)
                self.dispatch(n, st, f, cs)
                f.flush()
                return fl.add(f.lines)
        if cs and t in BLOCKY and t != "pre" and cs.get("white-space", "").lower() in (
                "pre", "pre-wrap", "break-spaces"):
            return self.t_pre(n, st, fl)
        if self.inline_mode and t in BLOCKY:
            return self.walk(n, st, fl)
        self.dispatch(n, st, fl, cs)

    def dispatch(self, n, st, fl, cs):
        t = n.tag
        css_color = bool(cs and "color" in cs)
        if t in STYLE_TAGS:
            add, fg = STYLE_TAGS[t]
            st = sty(st, add, fg=fg) if (fg and st[3] is None and not css_color) else sty(st, add)
            if cs:
                st = self.apply_style(st, cs, t)
            return self.walk(n, st, fl)
        if t in HEADINGS:
            fg = HEADINGS[t]
            st2 = sty(st, B, fg=fg) if (fg and st[3] is None and not css_color) else sty(st, B)
            if cs:
                st2 = self.apply_style(st2, cs, t)
            return fl.add(self.sub_block(n, st2, fl.w, self.align(n, fl)), margin=True)
        h = getattr(self, "t_" + t, None)
        if h:
            return h(n, st, fl)
        if t in BLOCK:
            return fl.add(self.sub_block(n, st, fl.w, self.align(n, fl)))
        self.walk(n, st, fl)

    def t_br(self, n, st, fl):
        fl.atoms.append(("br", "", st))

    def t_center(self, n, st, fl):
        fl.add(self.sub_block(n, st, fl.w, "center"))

    def t_a(self, n, st, fl):
        href = (n.attrs.get("href") or "").strip()
        if href and not href.lower().startswith("javascript:"):
            url = self.resolve(href)
            if n.data is None:
                n.data = self.page.next_id()
            ref = ("l", n.data)
            self.links[ref] = url
            vis = urllib.parse.urldefrag(url)[0] in self.visited
            st = sty(st, U, fg=VISITED_FG if vis else LINK_FG, ref=ref)
        self.walk(n, st, fl)

    def t_p(self, n, st, fl):
        fl.add(self.sub_block(n, st, fl.w, self.align(n, fl)), margin=True)

    def t_div(self, n, st, fl):
        fl.add(self.sub_block(n, st, fl.w, self.align(n, fl)))

    def t_sup(self, n, st, fl):
        old, fl.xl = fl.xl, SUPMAP
        self.walk(n, st, fl)
        fl.xl = old

    def t_sub(self, n, st, fl):
        old, fl.xl = fl.xl, SUBMAP
        self.walk(n, st, fl)
        fl.xl = old

    def t_q(self, n, st, fl):
        fl.text("“", st)
        self.walk(n, st, fl)
        fl.text("”", st)

    def t_math(self, n, st, fl):
        fl.text(n.attrs.get("alttext") or n.text_content(), st)

    def t_hr(self, n, st, fl):
        fl.add([Line([("─" * fl.w, DIM_ST)])], margin=True)

    def t_blockquote(self, n, st, fl):
        sub = self.sub_block(n, st, max(fl.w - 2, 1), fl.align)
        fl.add([indent(l, 2, ("│ ", DIM_ST)) for l in sub], margin=True)

    def t_pre(self, n, st, fl):
        f = Flow(fl.w, None, pre=True)
        f.pre_start = True
        self.walk(n, st, f)
        f.flush()
        fl.add(f.lines, margin=True)

    def t_dl(self, n, st, fl):
        fl.add(self.sub_block(n, st, fl.w, fl.align), margin=True)

    def t_dt(self, n, st, fl):
        fl.add(self.sub_block(n, sty(st, B), fl.w, fl.align))

    def t_dd(self, n, st, fl):
        sub = self.sub_block(n, st, max(fl.w - 4, 1), fl.align)
        fl.add([indent(l, 4) for l in sub])

    def t_figcaption(self, n, st, fl):
        fl.add(self.sub_block(n, sty(st, I), fl.w, self.align(n, fl)))

    def t_summary(self, n, st, fl):
        fl.add(self.sub_block(n, sty(st, B), fl.w, fl.align))

    def t_fieldset(self, n, st, fl):
        fl.add(self.sub_block(n, st, fl.w, fl.align), margin=True)

    def t_iframe(self, n, st, fl):
        src = n.attrs.get("src")
        if src and not src.startswith(("about:", "javascript:")):
            self.placeholder(n, st, fl, "frame: " + (n.attrs.get("title") or src), src)

    def t_video(self, n, st, fl):
        src = n.attrs.get("src")
        if not src:
            for ch in n.children:
                if ch.tag == "source" and ch.attrs.get("src"):
                    src = ch.attrs["src"]
                    break
        self.placeholder(n, st, fl, "video", src)

    t_audio = t_video

    def placeholder(self, n, st, fl, label, src):
        if src:
            if n.data is None:
                n.data = self.page.next_id()
            ref = ("l", n.data)
            self.links[ref] = self.resolve(src)
            st = sty(st, U, fg=LINK_FG, ref=ref)
        fl.text("[" + label + "]", st)

    # lists

    def t_ul(self, n, st, fl):
        ordered = n.tag == "ol"
        items = [c for c in n.children if c.tag == "li"]
        start = num(n.attrs.get("start"), 1)
        if ordered and n.attrs.get("reversed") is not None:
            start = num(n.attrs.get("start"), len(items))
        nums, k = [], start
        for li in items:
            k = num(li.attrs.get("value"), k)
            nums.append(k)
            k += 1
        mw = max([len(str(x)) for x in nums] + [1]) + 2 if ordered else 2
        cs_ul = self.cs(n)
        plain = bool(cs_ul and cs_ul.get("list-style-type", "").lower() == "none")
        out = Flow(fl.w, fl.align)
        i = 0
        for ch in n.children:
            if ch.tag == "li" and not self.hidden(ch.attrs):
                marker = ("%*d. " % (mw - 2, nums[i])) if ordered else (
                    "•◦▪"[self.list_depth % 3] + " ")
                i += 1
                if ch.attrs.get("id"):
                    out.pending.append(ch.attrs["id"])
                cs_li = self.cs(ch)
                if cs_li and css_hidden(cs_li):
                    continue
                if cs_li and cs_li.get("display", "").lower() in INLINEISH:
                    out.text(" ", st)
                    self.walk(ch, self.styled(ch, st, cs_li), out)
                elif plain or (cs_li and cs_li.get("list-style-type", "").lower() == "none"):
                    out.add(self.item(ch, self.styled(ch, st, cs_li), fl.w, "", 0))
                else:
                    out.add(self.item(ch, self.styled(ch, st, cs_li), fl.w, marker, mw))
            elif ch.tag is None:
                out.text(ch.text, st)
            else:
                self.element(ch, st, out)
        out.flush()
        fl.add(out.lines, margin=self.list_depth == 0)

    t_ol = t_menu = t_dir = t_ul

    def styled(self, n, st, cs):
        return self.apply_style(st, cs, n.tag) if cs else st

    def t_li(self, n, st, fl):
        fl.add(self.item(n, st, fl.w, "• ", 2))

    def item(self, n, st, w, marker, mw):
        self.list_depth += 1
        sub = self.sub_block(n, st, max(w - mw, 1), None)
        self.list_depth -= 1
        if not sub:
            sub = [Line([])]
        out = []
        for i, l in enumerate(sub):
            out.append(indent(l, mw, (marker, DIM_ST) if i == 0 else None))
        return out

    # images

    def t_img(self, n, st, fl):
        a = n.attrs
        alt = (a.get("alt") or "").strip()
        src = (a.get("data-src") or a.get("data-lazy-src") or a.get("data-original")
               or a.get("src") or "").strip()
        if not src:
            ss = a.get("srcset") or a.get("data-srcset") or ""
            src = ss.split(",")[0].strip().split(" ")[0] if ss else ""
        inlink = st[3] is not None
        label = alt or ("image" if inlink else "")
        if src and self.images:
            im = self.page.image(self.resolve(src), self.request)
            if im.state == "ok" and im.w >= 20 and im.h >= 20:
                fl.add(self.image_block(im, st, fl.w, fl.align))
                return
            if im.state == "ok" and not inlink:
                label = alt if (alt and len(alt) < 40) else ""
        if label:
            fl.text("[" + label + "]", st if inlink else sty(st, D))

    def image_block(self, im, st, w, align):
        cwp, chp = self.cell
        nc = max(1, -(-im.w // cwp))
        nr = max(1, -(-im.h // chp))
        maxr = max(4, int(self.term_rows * 0.7))
        s = min(1.0, w / nc, maxr / nr)
        nc, nr = max(1, int(nc * s)), max(1, int(nr * s))
        pad = 0
        if align == "center":
            pad = max(0, (w - nc) // 2)
        elif align == "right":
            pad = max(0, w - nc)
        lines = []
        for k in range(nr):
            spans = ([(" " * pad, PLAIN)] if pad else []) + [(" " * nc, st)]
            lines.append(Line(spans, ((im, k, nr, nc, pad),)))
        return lines

    # forms

    def t_form(self, n, st, fl):
        if n.data is None:
            n.data = Form(n.attrs)
        prev, self.form = self.form, n.data
        fl.add(self.sub_block(n, st, fl.w, fl.align))
        self.form = prev

    def get_field(self, n):
        f = n.data
        if f is not None:
            return f
        a = n.attrs
        t = n.tag
        if t == "input":
            typ = (a.get("type") or "text").lower()
        elif t == "button":
            typ = (a.get("type") or "submit").lower()
        else:
            typ = "select" if t == "select" else "textarea"
        f = Field(self.page.next_id(), typ, a.get("name"), self.form)
        f.disabled = "disabled" in a
        if t == "textarea":
            v = n.text_content()
            f.value = v[1:] if v.startswith("\n") else v
        elif t == "select":
            for o in self.options(n):
                f.options.append([o.attrs.get("value", o.text_content().strip()),
                                  " ".join(o.text_content().split())])
                if "selected" in o.attrs:
                    f.sel = len(f.options) - 1
        else:
            f.value = a.get("value", "on" if typ in ("checkbox", "radio") else "")
            f.checked = "checked" in a
        if self.form is not None:
            self.form.fields.append(f)
        n.data = f
        self.page.fields[f.id] = f
        return f

    def options(self, n):
        out = []
        for c in n.children:
            if c.tag == "option":
                out.append(c)
            elif c.tag == "optgroup":
                out.extend(self.options(c))
        return out

    def t_input(self, n, st, fl):
        f = self.get_field(n)
        typ = f.typ
        if typ == "hidden":
            return
        base = sty(st, ref=("f", f.id))
        w = fl.w
        if typ in ("submit", "button", "reset", "image"):
            label = f.value or n.attrs.get("alt") or {"reset": "Reset", "button": "Button"}.get(typ, "Submit")
            text = "[ " + label + " ]"
            style = sty(base, B, fg="38;5;255", bg="48;5;24")
        elif typ == "checkbox":
            text, style = ("[x]" if f.checked else "[ ]"), sty(base, 0, fg="38;5;255", bg=FIELD_BG)
        elif typ == "radio":
            text, style = ("(*)" if f.checked else "( )"), sty(base, 0, fg="38;5;255", bg=FIELD_BG)
        elif typ == "file":
            text, style = "[ choose file ]", sty(base, 0, fg="38;5;255", bg=FIELD_BG)
        elif typ in TEXT_TYPES:
            size = max(5, min(num(n.attrs.get("size"), 20), 40, max(w - 4, 5)))
            val = "•" * len(f.value) if typ == "password" else f.value
            if val:
                style = sty(base, 0, fg="38;5;255", bg=FIELD_BG)
            else:
                val = n.attrs.get("placeholder", "")
                style = sty(base, 0, fg="38;5;245", bg=FIELD_BG)
            val = val.replace("\n", " ")
            text = "[" + self.fit(val, size) + "]"
        else:
            return
        fl.atoms.append(("w", text, style))

    def fit(self, val, size):
        """Pad/clip val to exactly `size` display columns."""
        val = clip(val, size) if sw(val) > size else val
        return val + " " * (size - sw(val))

    def t_button(self, n, st, fl):
        f = self.get_field(n)
        base = sty(st, ref=("f", f.id))
        label = " ".join(n.text_content().split()) or f.value or "Button"
        fl.atoms.append(("w", "[ " + label + " ]", sty(base, B, fg="38;5;255", bg="48;5;24")))

    def t_select(self, n, st, fl):
        f = self.get_field(n)
        label = f.options[f.sel][1] if f.options else ""
        text = "[ " + clip(label, 30) + " ▾ ]"
        fl.atoms.append(("w", text, sty(st, 0, fg="38;5;255", bg=FIELD_BG, ref=("f", f.id))))

    def t_textarea(self, n, st, fl):
        f = self.get_field(n)
        size = max(8, min(num(n.attrs.get("cols"), 30), 60, max(fl.w - 4, 8)))
        nrows = max(2, min(num(n.attrs.get("rows"), 3), 6))
        style = sty(st, 0, fg="38;5;255", bg=FIELD_BG, ref=("f", f.id))
        vals = f.value.split("\n")
        out = []
        for i in range(nrows):
            v = vals[i] if i < len(vals) else ""
            if i == nrows - 1 and len(vals) > nrows:
                v += " …"
            out.append(Line([("[" + self.fit(v, size) + "]", style)]))
        fl.add(out)

    # tables

    def t_table(self, n, st, fl):
        lines = self.table(n, st, fl.w, fl.align)
        if lines is None:
            return self.walk(n, st, fl)
        fl.add(lines, margin=True)

    def min_width(self, node):
        k = id(node)
        m = self.minmemo.get(k)
        if m is None:
            m = 1
            stack = [node]
            while stack:
                x = stack.pop()
                if x.tag is None:
                    for word in x.text.split():
                        m = max(m, sw(word))
                elif x.tag not in SKIP:
                    if x.tag == "img":
                        m = max(m, 8)
                    stack.extend(x.children)
            m = self.minmemo[k] = min(m, 40)
        return m

    def table(self, n, st, w, align):
        trs, caption = [], [None]

        def collect(node):
            for c in node.children:
                if c.tag == "tr":
                    trs.append(c)
                elif c.tag in ("thead", "tbody", "tfoot"):
                    collect(c)
                elif c.tag == "caption":
                    caption[0] = c

        collect(n)
        cells, occ = [], set()
        for r, tr in enumerate(trs):
            c = 0
            for cell in tr.children:
                if cell.tag not in ("td", "th") or self.hidden(cell.attrs):
                    continue
                while (r, c) in occ:
                    c += 1
                cs = max(1, min(num(cell.attrs.get("colspan"), 1), 50))
                rs = max(1, min(num(cell.attrs.get("rowspan"), 1), 50))
                cells.append((r, c, cell, cs, rs))
                for dr in range(rs):
                    for dc in range(cs):
                        occ.add((r + dr, c + dc))
                c += cs
        if not cells:
            return None
        ncols = max(c for _, c in occ) + 1
        if len(cells) == 1 and ncols == 1:
            return self.sub_block(cells[0][2], st, w, self.align(cells[0][2], Flow(w, align)))
        bordered = (num(n.attrs.get("border"), 0) > 0 or
                    any(c[2].tag == "th" for c in cells))
        sepw, edge = (3, 4) if bordered else (2, 0)

        def cstyle(cell):
            return sty(st, B) if cell.tag == "th" else st

        cmin, cmax = [1] * ncols, [1] * ncols
        measured = []
        for r, c, cell, cs, rs in cells:
            lines = self.cell_lines(cell, cstyle(cell), BIG, None)
            mx = max([l.w for l in lines] + [0])
            mn = min(self.min_width(cell), max(mx, 1))
            measured.append((mn, mx))
            if cs == 1:
                cmin[c] = max(cmin[c], mn)
                cmax[c] = max(cmax[c], mx)
        for (r, c, cell, cs, rs), (mn, mx) in zip(cells, measured):
            if cs > 1:
                for arr, need in ((cmin, mn), (cmax, mx)):
                    have = sum(arr[c:c + cs]) + sepw * (cs - 1)
                    if need > have:
                        add = need - have
                        for k in range(cs):
                            arr[c + k] += add // cs + (1 if k < add % cs else 0)
        for i in range(ncols):
            cmax[i] = max(cmax[i], cmin[i])
        avail = w - edge - sepw * (ncols - 1)
        widths = alloc(cmin, cmax, avail)

        starts = collections.defaultdict(dict)
        for r, c, cell, cs, rs in cells:
            starts[r][c] = (cell, cs)
        out = []
        dim = DIM_ST
        left = right = sep = None
        if bordered:
            left, sep, right = ("│ ", dim), (" │ ", dim), (" │", dim)
        else:
            sep = ("  ", PLAIN)

        def rule(l, m, r_):
            return Line([(l + m.join("─" * (x + 2) for x in widths) + r_, dim)])

        if caption[0] is not None:
            out.extend(self.sub_block(caption[0], sty(st, B), w, "center"))
        if bordered:
            out.append(rule("┌", "┬", "┐"))
        header_done = False
        for r in range(len(trs)):
            row = starts.get(r, {})
            parts, j = [], 0
            while j < ncols:
                if j in row:
                    cell, cs = row[j]
                    wd = sum(widths[j:j + cs]) + sepw * (cs - 1)
                    al = self.align(cell, Flow(wd, "center" if cell.tag == "th" else None))
                    parts.append((self.cell_lines(cell, cstyle(cell), wd, al), wd))
                    j += cs
                else:
                    parts.append(([], widths[j]))
                    j += 1
            rl = hjoin(parts, left, sep, right)
            out.extend(rl)
            if (bordered and not header_done and row and
                    all(c[0].tag == "th" for c in row.values())):
                nxt = starts.get(r + 1, {})
                if not (nxt and all(c[0].tag == "th" for c in nxt.values())):
                    out.append(rule("├", "┼", "┤"))
                    header_done = True
        if bordered:
            out.append(rule("└", "┴", "┘"))
        return out


