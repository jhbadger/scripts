DOUBLE_CLICK_S = 0.35
DRAG_THRESHOLD = 7
MIN_DOWN_STEP = 9
MIN_UP_STEP = 17


class Klondike:
    def __init__(self, root):
        self.root = root
        self.sound = Sound()
        saved = load_saved()
        self.sound.muted = bool(saved.get("muted"))
        self.pref_draw = 3 if saved.get("draw") == 3 else 1

        root.title("Klondike Solitaire")
        root.configure(bg=PANEL)
        root.minsize(420, 400)
        root.geometry("900x720")

        top = tk.Frame(root, bg=PANEL)
        top.pack(fill="x")
        tk.Label(top, text="Klondike Solitaire", bg=PANEL, fg=ACCENT,
                 font=("Helvetica", 16, "bold")).pack(side="left", padx=10,
                                                       pady=6)
        self.status = tk.Label(top, bg=PANEL, fg=INK_DIM,
                               font=("Helvetica", 12))
        self.status.pack(side="left", padx=10)
        self.stats = tk.Label(top, bg=PANEL, fg=INK_DIM,
                              font=("Helvetica", 12))
        self.stats.pack(side="right", padx=10)

        bar = tk.Frame(root, bg=PANEL)
        bar.pack(side="bottom", fill="x")
        self.btn = {}
        for key, label, cmd in (("undo", "Undo", self.undo),
                                ("draw", "Draw 1", self.toggle_draw_mode),
                                ("auto", "Auto", self.auto_complete),
                                ("mute", "Sound: on", self.toggle_mute),
                                ("new", "New Game", self.new_game)):
            b = tk.Button(bar, text=label, command=cmd, width=9,
                          highlightbackground=PANEL)
            b.pack(side="left", expand=True, pady=6)
            self.btn[key] = b

        self.canvas = tk.Canvas(root, bg=FELT, highlightthickness=0)
        self.canvas.pack(fill="both", expand=True)

        self.game = None
        self.history = []          # list of (game, moves) for Undo
        self.moves = 0
        self.selected = None       # {"type", "col", "idx", "suit"}
        self.selected_at = 0.0
        self.auto_running = False
        self.dealing = False
        self.press = None          # pending click/drag: {x, y, candidate}
        self.drag = None           # active drag: {candidate, x, y}
        self.won_shown = False
        self.geom = None

        c = self.canvas
        c.bind("<ButtonPress-1>", self.on_press)
        c.bind("<B1-Motion>", self.on_motion)
        c.bind("<ButtonRelease-1>", self.on_release)
        c.bind("<Configure>", lambda e: self.render())
        for keys, fn in ((("u", "U", "Control-z", "Command-z"), self.undo),
                         (("n", "N"), self.new_game),
                         (("d", "D"), self.toggle_draw_mode),
                         (("a", "A"), self.auto_complete),
                         (("m", "M"), self.toggle_mute),
                         (("q", "Q"), self.quit)):
            for k in keys:
                root.bind(f"<{k}>", lambda e, fn=fn: fn())
        root.protocol("WM_DELETE_WINDOW", self.quit)

        try:
            g = game_from_json(saved["game"])
            if is_won(g):
                raise ValueError("finished")
            self.game = g
            self.history = [(game_from_json(h), m)
                            for h, m in saved.get("history", [])]
            self.moves = saved.get("moves", 0)
            self.render()
        except (KeyError, TypeError, ValueError, IndexError):
            self.game = create_game(self.pref_draw)   # placeholder while dealing
            self.start_deal(self.pref_draw)

    # ── Dealing ──

    def start_deal(self, draw):
        self.dealing = True
        self.selected = None
        self.won_shown = False
        result = {}

        def work():
            result["deal"] = deal_solvable_game(draw)

        threading.Thread(target=work, daemon=True).start()
        self.render()
        self.poll_deal(result)

    def poll_deal(self, result):
        if "deal" not in result:
            self.root.after(50, self.poll_deal, result)
            return
        self.game, _verified, _attempts = result["deal"]
        self.dealing = False
        self.history = []
        self.moves = 0
        self.render()
        self.sound.play("deal")

    # ── Layout ──

    def compute_layout(self):
        c = self.canvas
        W, H = max(c.winfo_width(), 100), max(c.winfo_height(), 100)
        pitch = W / 7
        gap = max(5.0, min(22.0, pitch * 0.38))
        cw = pitch - gap
        # Keep room for the top row plus a reasonably deep tableau
        cw = min(cw, (H - 3 * gap) / 3.4 / 1.4)
        ch = cw * 1.4
        x0 = (W - 7 * cw - 6 * gap) / 2
        colx = [x0 + i * (cw + gap) for i in range(7)]
        top_y = gap * 0.8
        tab_y = top_y + ch + gap
        avail = max(ch, H - tab_y - 8)

        pref_down = max(ch * 0.16, MIN_DOWN_STEP)
        pref_up = max(ch * 0.34, MIN_UP_STEP)

        def steps(pile, down, up):
            tops = [0.0]
            for i in range(1, len(pile)):
                tops.append(tops[-1] + (up if pile[i][2] else down))
            return tops

        tab = self.game["tableau"]
        needed = max([ch] + [ch + steps(p, pref_down, pref_up)[-1]
                             for p in tab if p])
        scale = 1.0
        if needed > avail and needed > ch:
            scale = max(0.15, (avail - ch) / (needed - ch))
        down = max(pref_down * scale, MIN_DOWN_STEP)
        up = max(pref_up * scale, MIN_UP_STEP)
        tops = [steps(p, down, up) if p else [] for p in tab]
        self.geom = {"W": W, "H": H, "cw": cw, "ch": ch, "gap": gap,
                     "colx": colx, "top_y": top_y, "tab_y": tab_y,
                     "tops": tops}
        return self.geom

    def waste_positions(self):
        g = self.geom
        w = self.game["waste"]
        fan = min(len(w), 3 if self.game["draw"] == 3 else 1)
        start = len(w) - fan
        return [(i, g["colx"][1] + g["cw"] * 0.18 * (i - start))
                for i in range(start, len(w))]

    def foundation_x(self, suit):
        return self.geom["colx"][3 + suit]

    # ── Drawing ──

    def round_rect(self, x, y, w, h, r, **kw):
        pts = (x + r, y, x + w - r, y, x + w, y, x + w, y + r,
               x + w, y + h - r, x + w, y + h, x + w - r, y + h,
               x + r, y + h, x, y + h, x, y + h - r, x, y + r, x, y)
        return self.canvas.create_polygon(pts, smooth=True, **kw)

    def draw_slot(self, x, y, glyph="", tags=()):
        g = self.geom
        self.round_rect(x, y, g["cw"], g["ch"], g["cw"] * 0.08, fill="",
                        outline=SLOT, width=2, tags=tags)
        if glyph:
            self.canvas.create_text(x + g["cw"] / 2, y + g["ch"] / 2,
                                    text=glyph, fill=SLOT, tags=tags,
                                    font=("Helvetica",
                                          -int(g["cw"] * 0.42)))

    def draw_card(self, card, x, y, selected=False, tags=()):
        c, g = self.canvas, self.geom
        cw, ch = g["cw"], g["ch"]
        r = cw * 0.08
        outline = SEL if selected else CARD_EDGE
        width = 3 if selected else 1
        if not card[2]:
            self.round_rect(x, y, cw, ch, r, fill=BACK_A, outline=outline,
                            width=width, tags=tags)
            m = cw * 0.1
            self.round_rect(x + m, y + m, cw - 2 * m, ch - 2 * m, r * 0.6,
                            fill="", outline=BACK_B, width=2, tags=tags)
            cx, cy, d = x + cw / 2, y + ch / 2, cw * 0.18
            c.create_polygon(cx, cy - d * 1.4, cx + d, cy, cx, cy + d * 1.4,
                             cx - d, cy, fill=BACK_B, outline="", tags=tags)
            return
        self.round_rect(x, y, cw, ch, r, fill=CARD_FACE, outline=outline,
                        width=width, tags=tags)
        suit, rank, _ = card
        color = RED if is_red(suit) else BLACK
        sym, name = SUIT_SYMBOLS[suit], RANK_NAMES[rank]
        rank_font = ("Helvetica", -max(8, int(cw * 0.30)), "bold")
        suit_font = ("Helvetica", -max(8, int(cw * 0.26)))
        pad = cw * 0.07
        c.create_text(x + pad, y + pad * 0.6, text=name, anchor="nw",
                      fill=color, font=rank_font, tags=tags)
        c.create_text(x + cw - pad, y + pad * 0.6, text=sym, anchor="ne",
                      fill=color, font=suit_font, tags=tags)
        c.create_text(x + cw / 2, y + ch * 0.6, text=sym, fill=color,
                      font=("Helvetica", -max(10, int(cw * 0.5))), tags=tags)
        c.create_text(x + cw - pad, y + ch - pad * 0.6, text=name,
                      anchor="se", fill=color, font=rank_font, tags=tags)

    def is_selected(self, typ, col=None, idx=None, suit=None):
        s = self.selected
        if not s or s["type"] != typ:
            return False
        if typ == "tableau":
            return s["col"] == col and idx >= s["idx"]
        if typ == "foundation":
            return s["suit"] == suit
        return True

    def render(self):
        if self.game is None:
            return
        self.drag = None
        c = self.canvas
        c.delete("all")
        g = self.compute_layout()
        game = self.game
        cw, ch, top_y = g["cw"], g["ch"], g["top_y"]

        # Stock
        x = g["colx"][0]
        if game["stock"]:
            self.draw_card(game["stock"][-1], x, top_y)
        else:
            self.draw_slot(x, top_y, "↺" if game["waste"] else "")

        # Waste (top three fanned in draw-3 mode)
        if not game["waste"]:
            self.draw_slot(g["colx"][1], top_y)
        last = len(game["waste"]) - 1
        for i, x in self.waste_positions():
            sel = i == last and self.is_selected("waste")
            self.draw_card(game["waste"][i], x, top_y, sel,
                           tags=("waste",) if i == last else ())

        # Foundations
        for suit in range(4):
            x = self.foundation_x(suit)
            pile = game["foundations"][suit]
            if pile:
                self.draw_card(pile[-1], x, top_y,
                               self.is_selected("foundation", suit=suit),
                               tags=(f"f{suit}",))
            else:
                self.draw_slot(x, top_y, SUIT_SYMBOLS[suit])

        # Tableau
        for col, pile in enumerate(game["tableau"]):
            x = g["colx"][col]
            if not pile:
                self.draw_slot(x, g["tab_y"])
            for i, card in enumerate(pile):
                self.draw_card(card, x, g["tab_y"] + g["tops"][col][i],
                               self.is_selected("tableau", col, i),
                               tags=(f"t{col}", f"t{col}_{i}"))

        self.render_chrome()
        if is_won(game) and not self.auto_running:
            self.draw_win_overlay()

    def render_chrome(self):
        game = self.game
        if self.dealing:
            text, color = "Shuffling a solvable deal…", INK_DIM
        elif is_won(game):
            text, color = "You win!", WIN
        elif self.selected:
            text, color = "Click a pile to move the selected card", INK_DIM
        else:
            text, color = "Click or drag a card to move it", INK_DIM
        self.status.config(text=text, fg=color)
        self.stats.config(text=f"Moves: {self.moves}")
        busy = self.dealing or self.auto_running

        def able(key, ok):
            self.btn[key].config(state="normal" if ok else "disabled")

        able("undo", not busy and bool(self.history))
        able("draw", not busy)
        able("auto", not busy and can_auto_complete(game)
             and not is_won(game))
        able("new", not self.dealing)
        self.btn["draw"].config(text=f"Draw {game['draw']}")
        self.btn["mute"].config(
            text="Sound: off" if self.sound.muted else "Sound: on")
        if self.dealing:
            g = self.geom
            self.canvas.create_rectangle(0, 0, g["W"], g["H"], fill=FELT,
                                         outline="")
            self.canvas.create_text(g["W"] / 2, g["H"] / 2, fill=INK,
                                    text="Shuffling a solvable deal…",
                                    font=("Helvetica", 20))

    def draw_win_overlay(self):
        c, g = self.canvas, self.geom
        cx, cy = g["W"] / 2, g["H"] / 2
        self.round_rect(cx - 160, cy - 80, 320, 160, 16, fill=PANEL,
                        outline=ACCENT, width=2, tags="win")
        c.create_text(cx, cy - 40, text="You win!", fill=WIN,
                      font=("Helvetica", 28, "bold"), tags="win")
        c.create_text(cx, cy, text=f"Solved in {self.moves} moves.",
                      fill=INK_DIM, font=("Helvetica", 14), tags="win")
        self.round_rect(cx - 70, cy + 25, 140, 36, 10, fill=ACCENT,
                        outline="", tags=("win", "winbtn"))
        c.create_text(cx, cy + 43, text="New Game", fill="#1c1410",
                      font=("Helvetica", 14, "bold"), tags=("win", "winbtn"))

    # ── Hit testing ──

    def hit(self, x, y):
        """What pile (and card) is under (x, y), or None."""
        g = self.geom
        if g is None:
            return None
        cw, ch, gap = g["cw"], g["ch"], g["gap"]
        half = gap / 2
        if g["top_y"] - half <= y <= g["top_y"] + ch + half:
            for col, kind in ((0, "stock"), (1, "waste")):
                x0 = g["colx"][col]
                x1 = x0 + cw
                if kind == "waste":
                    pos = self.waste_positions()
                    if pos:
                        x1 = pos[-1][1] + cw
                if x0 - half <= x <= x1 + half:
                    return {"type": kind}
            for suit in range(4):
                x0 = self.foundation_x(suit)
                if x0 - half <= x <= x0 + cw + half:
                    return {"type": "foundation", "suit": suit}
            return None
        if y < g["tab_y"] - half:
            return None
        for col in range(7):
            x0 = g["colx"][col]
            if x0 - half <= x <= x0 + cw + half:
                idx = None
                tops = g["tops"][col]
                dy = y - g["tab_y"]
                for i in range(len(tops) - 1, -1, -1):
                    if tops[i] <= dy < tops[i] + ch:
                        idx = i
                        break
                return {"type": "tableau", "col": col, "idx": idx}
        return None

    def selectable(self, info):
        game = self.game
        if not info:
            return None
        if info["type"] == "waste":
            return {"type": "waste"} if game["waste"] else None
        if info["type"] == "foundation":
            if not game["foundations"][info["suit"]]:
                return None
            return {"type": "foundation", "suit": info["suit"]}
        if info["type"] == "tableau":
            idx = info["idx"]
            if idx is None:
                return None
            pile = game["tableau"][info["col"]]
            if not pile[idx][2] or idx < face_up_run_start(pile):
                return None
            return {"type": "tableau", "col": info["col"], "idx": idx}
        return None

    def candidate_tag(self, cand):
        if cand["type"] == "waste":
            return ["waste"]
        if cand["type"] == "foundation":
            return [f"f{cand['suit']}"]
        n = len(self.game["tableau"][cand["col"]])
        return [f"t{cand['col']}_{i}" for i in range(cand["idx"], n)]

    # ── Moves ──

    def will_flip(self, sel):
        if sel["type"] != "tableau" or sel["idx"] == 0:
            return False
        return not self.game["tableau"][sel["col"]][sel["idx"] - 1][2]

    def attempt_move(self, sel, info):
        """Returns (new game or None, went_to_foundation, flipped)."""
        game, flipped = self.game, self.will_flip(sel)
        if info["type"] == "foundation":
            if sel["type"] == "waste":
                return move_waste_to_foundation(game), True, False
            if sel["type"] == "tableau":
                return move_tableau_to_foundation(game, sel["col"]), True, \
                    flipped
        elif info["type"] == "tableau":
            to = info["col"]
            if sel["type"] == "waste":
                return move_waste_to_tableau(game, to), False, False
            if sel["type"] == "tableau":
                return move_tableau_to_tableau(game, sel["col"], sel["idx"],
                                               to), False, flipped
            if sel["type"] == "foundation":
                return move_foundation_to_tableau(game, sel["suit"], to), \
                    False, False
        return None, False, False

    def commit(self, nxt, sound=None, flipped=False):
        self.history.append((self.game, self.moves))
        self.game = nxt
        self.moves += 1
        self.selected = None
        self.render()
        if sound:
            self.sound.play(sound)
        if flipped:
            self.root.after(90, self.sound.play, "flip")
        self.check_win()

    def check_win(self):
        if is_won(self.game) and not self.won_shown:
            self.won_shown = True
            self.root.after(200, self.sound.play, "win")

    def stock_click(self):
        game = self.game
        recycle = not game["stock"] and bool(game["waste"])
        nxt = draw_from_stock(game)
        if not nxt:
            return
        self.selected = None
        self.history.append((game, self.moves))
        self.game = nxt
        self.render()
        self.sound.play("recycle" if recycle else "deal")

    def pile_click(self, info):
        if self.dealing or self.auto_running or is_won(self.game) or not info:
            return
        if info["type"] == "stock":
            self.stock_click()
            return
        sel = self.selected
        if sel:
            same = (
                (sel["type"] == "waste" and info["type"] == "waste")
                or (sel["type"] == "foundation" and info["type"] == "foundation"
                    and sel["suit"] == info["suit"])
                or (sel["type"] == "tableau" and info["type"] == "tableau"
                    and sel["col"] == info["col"]
                    and sel["idx"] == info["idx"]))
            if same:
                if time.monotonic() - self.selected_at < DOUBLE_CLICK_S:
                    nxt = None
                    if sel["type"] == "waste":
                        nxt = move_waste_to_foundation(self.game)
                    elif sel["type"] == "tableau":
                        nxt = move_tableau_to_foundation(self.game,
                                                         sel["col"])
                    if nxt:
                        self.commit(nxt, "foundation", self.will_flip(sel))
                        return
                self.selected = None
                self.render()
                return
            # Another card in the same column: reselect a different run
            if (sel["type"] == "tableau" and info["type"] == "tableau"
                    and sel["col"] == info["col"]):
                self.select(info)
                self.render()
                return
            nxt, to_fnd, flipped = self.attempt_move(sel, info)
            if nxt:
                self.commit(nxt, "foundation" if to_fnd else "place", flipped)
                return
            self.sound.play("invalid")
            if not self.select(info):
                self.selected = None
            self.render()
            return
        self.select(info)
        self.render()

    def select(self, info):
        cand = self.selectable(info)
        if not cand:
            return False
        self.selected = cand
        self.selected_at = time.monotonic()
        return True

    # ── Mouse ──

    def on_press(self, ev):
        if self.dealing or self.auto_running:
            self.press = None
            return
        if is_won(self.game):
            hits = self.canvas.find_overlapping(ev.x, ev.y, ev.x, ev.y)
            if any("winbtn" in self.canvas.gettags(i) for i in hits):
                self.new_game()
            self.press = None
            return
        cand = self.selectable(self.hit(ev.x, ev.y))
        self.press = {"x": ev.x, "y": ev.y, "cand": cand}

    def on_motion(self, ev):
        p = self.press
        if not p:
            return
        if not self.drag:
            if (not p["cand"] or math.hypot(ev.x - p["x"], ev.y - p["y"])
                    < DRAG_THRESHOLD):
                return
            for tag in self.candidate_tag(p["cand"]):
                self.canvas.addtag_withtag("drag", tag)
            self.canvas.tag_raise("drag")
            self.drag = {"cand": p["cand"], "x": p["x"], "y": p["y"]}
        d = self.drag
        self.canvas.move("drag", ev.x - d["x"], ev.y - d["y"])
        d["x"], d["y"] = ev.x, ev.y

    def on_release(self, ev):
        p, self.press = self.press, None
        if self.drag:
            cand = self.drag["cand"]
            self.drag = None
            target = self.hit(ev.x, ev.y)
            nxt, to_fnd, flipped = (self.attempt_move(cand, target)
                                    if target else (None, False, False))
            if nxt:
                self.commit(nxt, "foundation" if to_fnd else "place", flipped)
            else:
                self.sound.play("invalid")
                self.render()
            return
        if p and math.hypot(ev.x - p["x"], ev.y - p["y"]) <= DRAG_THRESHOLD:
            self.pile_click(self.hit(ev.x, ev.y))

    # ── Commands ──

    def undo(self):
        if self.dealing or self.auto_running or not self.history:
            return
        self.game, self.moves = self.history.pop()
        self.selected = None
        self.won_shown = False
        self.render()
        self.sound.play("undo")

    def new_game(self):
        if self.dealing:
            return
        self.auto_running = False
        self.start_deal(self.game["draw"])

    def toggle_draw_mode(self):
        if self.dealing or self.auto_running:
            return
        self.game = dict(self.game, draw=3 if self.game["draw"] == 1 else 1)
        self.pref_draw = self.game["draw"]
        self.render()

    def toggle_mute(self):
        self.sound.muted = not self.sound.muted
        self.render_chrome()

    def auto_complete(self):
        if (self.dealing or self.auto_running or is_won(self.game)
                or not can_auto_complete(self.game)):
            return
        self.auto_running = True
        self.history.append((self.game, self.moves))
        self.selected = None
        self.render()
        self.auto_step(0)

    def auto_step(self, i):
        if not self.auto_running:
            return
        move = find_auto_move(self.game)
        if not move:
            self.auto_running = False
            self.moves += 1
            self.render()
            self.check_win()
            return
        self.game = apply_auto_move(self.game, move)
        self.sound.play(f"auto{min(i, 4)}")
        self.render()
        self.root.after(110, self.auto_step, i + 1)

    def save(self):
        data = {"draw": self.pref_draw, "muted": self.sound.muted}
        if self.game and not self.dealing and not is_won(self.game):
            data["game"] = game_to_json(self.game)
            data["history"] = [(game_to_json(h), m) for h, m in self.history]
            data["moves"] = self.moves
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        if self.auto_running:
            # Finish the auto-complete instantly so the save is consistent
            while (move := find_auto_move(self.game)):
                self.game = apply_auto_move(self.game, move)
        self.save()
        self.root.destroy()


# ------------------------------------------------ icon / macOS app bundle

ICON_NAME = "tkklondike"
ICON_DOC_EXTS = []


def icon_rr(x, y, x0, y0, x1, y1, r):
    """True inside the rounded rectangle (x0,y0)-(x1,y1) with corner radius r."""
    cx = min(max(x, x0 + r), x1 - r)
    cy = min(max(y, y0 + r), y1 - r)
    return math.hypot(x - cx, y - cy) <= r


ICON_BG = (18, 104, 58)


def icon_heart(x, y, cx, cy, s):
    u, v = (x - cx) / s, (cy - y) / s
    return (u * u + v * v - 1) ** 3 - u * u * v ** 3 <= 0


def icon_art(x, y):
    if icon_rr(x, y, 0.24, 0.10, 0.76, 0.90, 0.07):
        if not icon_rr(x, y, 0.255, 0.115, 0.745, 0.885, 0.06):
            return (40, 40, 40)
        if (icon_heart(x, y, 0.5, 0.52, 0.17) or
                icon_heart(x, y, 0.33, 0.21, 0.04) or
                icon_heart(x, y, 0.67, 0.79, 0.04)):
            return (214, 40, 50)
        return (250, 250, 245)
    return ICON_BG


def icon_sample(x, y):
    """RGB of the icon at (x, y) in the unit square, or None (transparent)."""
    if not icon_rr(x, y, 0.0, 0.0, 1.0, 1.0, 0.2):
        return None
    return icon_art(x, y)


def icon_render_png(size):
    n = 4 if size <= 256 else 2
    rows = []
    for py in range(size):
        row = bytearray([0])                     # PNG filter type 0
        for px in range(size):
            ra = ga = ba = aa = 0
            for sy in range(n):
                for sx in range(n):
                    c = icon_sample((px + (sx + 0.5) / n) / size,
                                    (py + (sy + 0.5) / n) / size)
                    if c:
                        ra += c[0]
                        ga += c[1]
                        ba += c[2]
                        aa += 1
            if aa:
                row += bytes((ra // aa, ga // aa, ba // aa,
                              255 * aa // (n * n)))
            else:
                row += b"\0\0\0\0"
        rows.append(bytes(row))

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
    return (b"\x89PNG\r\n\x1a\n" +
            chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 6, 0, 0, 0)) +
            chunk(b"IDAT", zlib.compress(b"".join(rows), 9)) +
            chunk(b"IEND", b""))


# ICNS entry types holding PNG data, with the pixel size of each
ICON_ICNS_TYPES = [(b"icp4", 16), (b"icp5", 32), (b"ic11", 32), (b"ic12", 64),
                   (b"ic07", 128), (b"ic13", 256), (b"ic08", 256),
                   (b"ic14", 512), (b"ic09", 512)]


def icon_make_icns():
    """An .icns file written directly (no iconutil needed)."""
    pngs = {}
    body = b""
    for tag, size in ICON_ICNS_TYPES:
        if size not in pngs:
            pngs[size] = icon_render_png(size)
        body += tag + struct.pack(">I", len(pngs[size]) + 8) + pngs[size]
    return b"icns" + struct.pack(">I", len(body) + 8) + body


def icon_build_app(dest):
    """Build a macOS <name>.app bundle (with icon) in dest."""
    app = os.path.join(dest, ICON_NAME + ".app")
    if os.path.exists(app):
        shutil.rmtree(app)
    macos = os.path.join(app, "Contents", "MacOS")
    res = os.path.join(app, "Contents", "Resources")
    os.makedirs(macos)
    os.makedirs(res)
    shutil.copy(os.path.abspath(__file__), os.path.join(res, ICON_NAME + ".py"))
    launcher = os.path.join(macos, ICON_NAME)
    with open(launcher, "w") as fh:
        fh.write('#!/bin/sh\nexec "%s" "$(dirname "$0")/../Resources/%s.py" '
                 '"$@"\n' % (sys.executable, ICON_NAME))
    os.chmod(launcher, 0o755)
    with open(os.path.join(res, ICON_NAME + ".icns"), "wb") as fh:
        fh.write(icon_make_icns())
    info = {
        "CFBundleName": ICON_NAME,
        "CFBundleDisplayName": ICON_NAME,
        "CFBundleIdentifier": "org.badgerjh." + ICON_NAME,
        "CFBundleExecutable": ICON_NAME,
        "CFBundleIconFile": ICON_NAME,
        "CFBundlePackageType": "APPL",
        "CFBundleShortVersionString": "1.0",
        "NSHighResolutionCapable": True,
    }
    if ICON_DOC_EXTS:
        info["CFBundleDocumentTypes"] = [{
            "CFBundleTypeName": ICON_NAME + " file",
            "CFBundleTypeRole": "Viewer",
            "CFBundleTypeExtensions": ICON_DOC_EXTS}]
    with open(os.path.join(app, "Contents", "Info.plist"), "wb") as fh:
        plistlib.dump(info, fh)
    return app


def icon_args(args):
    """Handle --build-app [DIR] and --icon-png SIZE [OUT]; True if handled."""
    if args[:1] == ["--build-app"]:
        print(icon_build_app(args[1] if len(args) > 1 else
                             os.path.dirname(os.path.abspath(__file__))))
        return True
    if args[:1] == ["--icon-png"] and len(args) >= 2:
        with open(args[2] if len(args) > 2 else ICON_NAME + ".png", "wb") as fh:
            fh.write(icon_render_png(int(args[1])))
        return True
    return False


def set_window_icon(root):
