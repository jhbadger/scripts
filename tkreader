def watchdog(root):
    """With TKREADER_DEBUG set: dump every thread's stack if the UI stalls for 4s."""
    import faulthandler
    import threading
    beat = [time.time()]

    def tick():
        beat[0] = time.time()
        root.after(500, tick)

    def watch():
        reported = False
        while True:
            time.sleep(1)
            stalled = time.time() - beat[0] > 4
            if stalled and not reported:
                print("tkreader: UI stalled for 4s; stack follows", file=sys.stderr, flush=True)
                faulthandler.dump_traceback(file=sys.stderr, all_threads=True)
            reported = stalled
    tick()
    threading.Thread(target=watch, daemon=True).start()


