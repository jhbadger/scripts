def load_state():
    try:
        with open(SAVE_FILE) as fh:
            st = json.load(fh)
        if isinstance(st, dict):
            st.setdefault("prefs", {})
            st.setdefault("books", {})
            return st
    except (OSError, ValueError):
        pass
    return {"prefs": {}, "books": {}}


def save_state(st):
    try:
        tmp = SAVE_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(st, fh, indent=1)
        os.replace(tmp, SAVE_FILE)
    except OSError:
        pass


def pick_family(candidates, available, fallback):
    for name in candidates:
        if name in available:
            return name
    return fallback


def scale_ratio(f):
    """Best (zoom, subsample) integer pair for shrinking an image by factor f < 1."""
    best, err = (1, max(1, math.ceil(1 / f))), abs(1 / max(1, math.ceil(1 / f)) - f)
    for z in (2, 3):
        for s in range(z + 1, 13):
            e = abs(z / s - f)
            if e < err - 1e-9:
                best, err = (z, s), e
    return best


