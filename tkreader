# ---------------------------------------------------------------- EPUB access

def local(tag):
    return tag.rsplit('}', 1)[-1] if isinstance(tag, str) else ''


def decode(data):
    if data.startswith(b'\xef\xbb\xbf'):
        data = data[3:]
    try:
        return data.decode('utf-8')
    except UnicodeDecodeError:
        return data.decode('cp1252', 'replace')


class NavParser(HTMLParser):
    """Extracts (depth, text, href) from an EPUB3 <nav epub:type="toc">."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.in_toc = False
        self.depth = 0
        self.entries = []
        self.href = None
        self.text = []

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == 'nav' and 'toc' in (a.get('epub:type') or a.get('type') or ''):
            self.in_toc = True
        elif self.in_toc and tag == 'ol':
            self.depth += 1
        elif self.in_toc and tag == 'a' and a.get('href') is not None:
            self.href, self.text = a['href'], []

    def handle_endtag(self, tag):
        if tag == 'nav':
            self.in_toc = False
        elif self.in_toc and tag == 'ol':
            self.depth -= 1
        elif self.in_toc and tag == 'a' and self.href is not None:
            title = ' '.join(''.join(self.text).split())
            self.entries.append((max(0, self.depth - 1), title, self.href))
            self.href = None

    def handle_data(self, data):
        if self.href is not None:
            self.text.append(data)


class Book:
    def __init__(self, path):
        self.path = path
        self.z = zipfile.ZipFile(path)
        self.names = {n.lower(): n for n in self.z.namelist()}
        container = ET.fromstring(self.read('META-INF/container.xml'))
        opf_path = next(e.get('full-path') for e in container.iter()
                        if local(e.tag) == 'rootfile')
        self.opf_dir = posixpath.dirname(opf_path)
        opf = ET.fromstring(self.read(opf_path))
        self.title = os.path.basename(path)
        manifest, spine, toc_id = {}, [], None
        for e in opf.iter():
            t = local(e.tag)
            if t == 'title' and self.title == os.path.basename(path) and e.text:
                self.title = e.text.strip()
            elif t == 'item':
                manifest[e.get('id')] = (self.resolve(self.opf_dir, e.get('href', '')),
                                         e.get('media-type', ''), e.get('properties', ''))
            elif t == 'itemref':
                spine.append(e.get('idref'))
            elif t == 'spine':
                toc_id = e.get('toc')
        self.chapters = [manifest[i][0] for i in spine if i in manifest]
        self.index = {p: i for i, p in enumerate(self.chapters)}
        self.toc = self._load_toc(manifest, toc_id)
        self.chapter_title = {}
        for _, title, path, _frag in self.toc:
            self.chapter_title.setdefault(path, title)

    @staticmethod
    def resolve(base_dir, href):
        href = unquote(href.split('#', 1)[0].split('?', 1)[0])
        return posixpath.normpath(posixpath.join(base_dir, href)) if href else ''

    def read(self, path):
        name = path if path in self.z.namelist() else self.names.get(path.lower())
        return self.z.read(name) if name else None

    def _load_toc(self, manifest, toc_id):
        raw = []  # (depth, title, path, frag)
        nav = next((v for v in manifest.values() if 'nav' in v[2].split()), None)
        ncx = manifest.get(toc_id) or next(
            (v for v in manifest.values() if v[1] == 'application/x-dtbncx+xml'), None)
        try:
            if nav and self.read(nav[0]):
                p = NavParser()
                p.feed(decode(self.read(nav[0])))
                base = posixpath.dirname(nav[0])
                for depth, title, href in p.entries:
                    raw.append((depth, title, self.resolve(base, href or nav[0]),
                                href.partition('#')[2] if href else ''))
            if not raw and ncx and self.read(ncx[0]):
                base = posixpath.dirname(ncx[0])

                def walk(el, depth):
                    for c in el:
                        if local(c.tag) != 'navPoint':
                            continue
                        title = src = None
                        for d in c:
                            if local(d.tag) == 'navLabel':
                                title = ' '.join(''.join(d.itertext()).split())
                            elif local(d.tag) == 'content':
                                src = d.get('src', '')
                        if src is not None:
                            raw.append((depth, title or '', self.resolve(base, src),
                                        unquote(src.partition('#')[2])))
                        walk(c, depth + 1)
                root = ET.fromstring(self.read(ncx[0]))
                for m in root.iter():
                    if local(m.tag) == 'navMap':
                        walk(m, 0)
        except Exception:
            raw = []
        toc = [e for e in raw if e[2] in self.index]
        if not toc:
            toc = [(0, 'Section %d' % (i + 1), p, '') for i, p in enumerate(self.chapters)]
        return toc



# ------------------------------------------------- MathML -> Unicode text boxes
# A Box is a block of equal-width text lines with a baseline row, so fractions,
# matrices and scripts can be laid out in 2-D (display math) or flattened to a
# single line (inline math). Italic/bold use the \x01-\x04 style markers.

class N:
    __slots__ = ('tag', 'attrs', 'kids')

    def __init__(self, tag, attrs):
        self.tag, self.attrs, self.kids = tag, attrs, []


def elems(n):
    return [k for k in n.kids if isinstance(k, N)]


def ntext(n):
    return ''.join(k if isinstance(k, str) else ntext(k) for k in n.kids)


_INVIS = dict.fromkeys(map(ord, '\u2061\u2062\u2063\u2064'))
_MARK = re.compile(r'[\x01-\x04]')


def clean(s):
    return ' '.join(s.translate(_INVIS).replace('\xa0', ' ').split())


def unmark(s):
    return _MARK.sub('', s)


class Ctx:
    def __init__(self, linear=False, tight=False, upright=False):
        self.linear, self.tight, self.upright = linear, tight, upright

    def sub(self, **kw):
        c = Ctx(self.linear, self.tight, self.upright)
        for k, v in kw.items():
            setattr(c, k, v)
        return c


class Box:
    def __init__(self, lines, base=0):
        lines = lines or ['']
        self.w = max(vlen(l) for l in lines)
        self.lines = [l + ' ' * (self.w - vlen(l)) for l in lines]
        self.base, self.h = base, len(lines)

    def is_space(self):
        return self.h == 1 and self.w > 0 and not unmark(self.lines[0]).strip()


def tbox(t):
    return Box([t])


def hcat(boxes):
    boxes = [b for b in boxes if b.w or b.h > 1]
    if not boxes:
        return tbox('')
    asc = max(b.base for b in boxes)
    desc = max(b.h - 1 - b.base for b in boxes)
    lines = []
    for r in range(asc + desc + 1):
        row = []
        for b in boxes:
            i = r - (asc - b.base)
            row.append(b.lines[i] if 0 <= i < b.h else ' ' * b.w)
        lines.append(''.join(row))
    return Box(lines, asc)


def centered(b, w, align='center'):
    left = {'left': 0, 'right': w - b.w}.get(align, (w - b.w) // 2)
    return Box([' ' * left + l + ' ' * (w - b.w - left) for l in b.lines], b.base)


def _pairs(src, dst):
    assert len(src) == len(dst)
    return dict(zip(src, dst))


SUPM = _pairs('0123456789+-=()abcdefghijklmnoprstuvwxyzABDEGHIJKLMNOPRTUWβγδθφχ',
              '⁰¹²³⁴⁵⁶⁷⁸⁹⁺⁻⁼⁽⁾ᵃᵇᶜᵈᵉᶠᵍʰⁱʲᵏˡᵐⁿᵒᵖʳˢᵗᵘᵛʷˣʸᶻᴬᴮᴰᴱᴳᴴᴵᴶᴷᴸᴹᴺᴼᴾᴿᵀᵁᵂᵝᵞᵟᶿᵠᵡ')
SUPM.update({'⊤': 'ᵀ', '*': '*', '∗': '*', '′': '′'})
SUBM = _pairs('0123456789+-=()aehijklmnoprstuvxβγρφχ',
              '₀₁₂₃₄₅₆₇₈₉₊₋₌₍₎ₐₑₕᵢⱼₖₗₘₙₒₚᵣₛₜᵤᵥₓᵦᵧᵨᵩᵪ')
COMB = {'¯': '\u0305', '‾': '\u0305', '―': '\u0305', '^': '\u0302', 'ˆ': '\u0302',
        '~': '\u0303', '˜': '\u0303', '→': '\u20d7', '˙': '\u0307', '¨': '\u0308',
        'ˇ': '\u030c', '´': '\u0301', '`': '\u0300'}
FENCE = {'(': '⎛⎜⎝', ')': '⎞⎟⎠', '[': '⎡⎢⎣', ']': '⎤⎥⎦', '{': '⎧⎪⎩', '}': '⎫⎪⎭',
         '|': '│││', '‖': '║║║'}
REL = set('=≠≈≡<>≤≥≪≫∈∉∋⊂⊃⊆⊇⊄→←↔⇒⇐⇔⟹⟸⟶↦∝∼≃≅≜≔:∣∥⊥⊨⊢≲≳≺≻') | {
    ':=', '<=', '>=', '!=', '->', '=>'}
BIN = set('+-−±∓×÷⋅·∗∘⊙⊕⊗⊖∪∩∧∨⊎∖*')
CLOSE = set(')]}⟩⌉⌋|‖')
BIGOPS = set('∑∏∐∫∬∭∮⋃⋂⋁⋀⨁⨂')


def mapped(b, table):
    if b is None:
        return ''
    if b.h != 1:
        return None
    t = unmark(b.lines[0]).rstrip().replace('−', '-')
    return ''.join(table[c] for c in t) if all(c in table for c in t) else None


def balanced(s):
    if not (s.startswith('(') and s.endswith(')')):
        return False
    depth = 0
    for i, ch in enumerate(s):
        depth += (ch == '(') - (ch == ')')
        if depth == 0 and i < len(s) - 1:
            return False
    return True


def atom(b):
    s = b.lines[0] if b.h == 1 else ' '.join(l.strip() for l in b.lines)
    p = unmark(s).strip()
    return s if (len(p) == 1 or re.fullmatch(r"[\w.′']+", p) or balanced(p)) else '(' + s + ')'


def r_tok(n, c):
    return tbox(clean(ntext(n)))


def r_mi(n, c):
    s = clean(ntext(n))
    upright = c.upright or n.attrs.get('mathvariant') == 'normal'
    if len(s) == 1 and s.isalpha() and ord(s) < 0x10000 and not upright:
        s = '\x03' + s + '\x04'
    return tbox(s)


def r_mtext(n, c):
    return tbox(' '.join(ntext(n).replace('\xa0', ' ').translate(_INVIS).split()).join(
        [' ' if ntext(n)[:1].isspace() else '', ' ' if ntext(n)[-1:].isspace() else '']))


def r_mspace(n, c):
    m = re.match(r'[\d.]+', n.attrs.get('width', ''))
    return tbox(' ') if m and float(m.group(0)) >= 0.15 else tbox('')


def fence_box(ch, asc, desc):
    h = asc + desc + 1
    if h == 1 or ch not in FENCE:
        return tbox(ch)
    top, mid, bot = FENCE[ch]
    lines = [top] + [mid] * (h - 2) + [bot]
    if ch in '{}' and h >= 3:
        lines[h // 2] = '⎨' if ch == '{' else '⎬'
    return Box(lines, asc)


def opname(k):
    if k.tag in ('mi', 'mo'):
        return clean(ntext(k))
    if k.tag in ('msub', 'msup', 'msubsup', 'munder', 'mover', 'munderover'):
        e = elems(k)
        return opname(e[0]) if e else ''
    return ''


def r_row(n, c):
    kids = elems(n)
    if not kids:
        return tbox('')
    texts = [clean(ntext(k)) if k.tag == 'mo' else
             (opname(k) if k.tag in ('mover', 'munder', 'munderover')
              and opname(k) in REL else None) for k in kids]
    stretch = [not c.linear and k.tag == 'mo' and k.attrs.get('stretchy') == 'true'
               and texts[i] in FENCE for i, k in enumerate(kids)]
    boxes = [None if stretch[i] else render(k, c) for i, k in enumerate(kids)]
    real = [b for b in boxes if b]
    asc = max((b.base for b in real), default=0)
    desc = max((b.h - 1 - b.base for b in real), default=0)
    for i, k in enumerate(kids):
        if stretch[i]:
            boxes[i] = fence_box(texts[i], asc, desc)
    out = []

    def push(b):
        if b.is_space() and out and out[-1].is_space():
            return
        out.append(b)

    last = len(kids) - 1
    for i, (k, b) in enumerate(zip(kids, boxes)):
        s = texts[i]
        padl = padr = False
        if s is not None and not c.tight:
            if s in REL:
                padl, padr = i > 0, i < last
            elif s in BIN:
                prev = kids[i - 1] if i else None
                padl = padr = (prev is not None and i < last and not (
                    prev.tag == 'mo' and texts[i - 1] not in CLOSE))
            elif s in (',', ';'):
                padr = i < last
        if padl:
            push(tbox(' '))
        push(b)
        if padr:
            push(tbox(' '))
        if c.linear and not c.tight and k.tag == 'mfrac' and i < last and texts[i + 1] is None:
            push(tbox(' '))
        if not c.tight:
            nm = opname(k)
            if nm and (nm in BIGOPS or (len(nm) >= 2 and nm.isalpha())):
                j = i + 1
                while j <= last and texts[j] == '':
                    j += 1
                if j <= last:
                    first = unmark(boxes[j].lines[0])[:1]
                    if first and first not in ' ([{⟨,;.)':
                        push(tbox(' '))
    return hcat(out)


def r_first(n, c):
    e = [k for k in elems(n) if not k.tag.startswith('annotation')]
    return render(e[0], c) if e else tbox('')


def r_mstyle(n, c):
    v = n.attrs.get('mathvariant')
    b = r_row(n, c.sub(upright=True) if v else c)
    if v and v.startswith('bold') and b.h == 1 and re.search('[A-Za-z]', unmark(b.lines[0])):
        b = tbox('\x01' + b.lines[0] + '\x02')
    return b


def r_phantom(n, c):
    b = r_row(n, c)
    return Box([re.sub(r'[^ ]', ' ', unmark(l)) for l in b.lines], b.base)


def r_frac(n, c):
    e = elems(n)
    num, den = render(e[0], c), render(e[1], c)
    bar = n.attrs.get('linethickness') != '0'
    if c.linear:
        if not bar:
            return tbox('(%s %s)' % (num.lines[0], den.lines[0]))
        return tbox(atom(num) + '/' + atom(den))
    w = max(num.w, den.w) + 2
    lines = [centered(num, w).lines, ['─' * w] if bar else [], centered(den, w).lines]
    flat = [l for part in lines for l in part]
    return Box(flat, num.h)


def r_sqrt(n, c):
    b = r_row(n, c)
    if c.linear:
        return tbox('√' + atom(b))
    if b.h == 1 and b.w <= 1:
        return tbox('√' + b.lines[0])
    top = ' ' + '‾' * b.w
    rad = ['√' if i == b.base else ' ' for i in range(b.h)]
    return hcat([Box([top] + rad, b.base + 1), Box([' '] + b.lines, b.base + 1)])


def r_root(n, c):
    e = elems(n)
    inner = r_sqrt(_wrap(e[0]), c)
    idx = render(e[1], c.sub(tight=True)) if len(e) > 1 else None
    m = mapped(idx, SUPM) if idx else ''
    pre = tbox(m) if m is not None else tbox('(' + unmark(idx.lines[0]) + ')')
    return hcat([pre, inner])


def _wrap(node):
    w = N('mrow', {})
    w.kids = [node]
    return w


def attach(base, sub, sup, c):
    ms, mp = mapped(sub, SUBM), mapped(sup, SUPM)
    if ms is not None and mp is not None:
        return hcat([base, tbox(ms + mp)])
    if c.linear:
        def part(b, m, mark):
            if b is None:
                return ''
            return m if m is not None else mark + atom(b)
        return hcat([base, tbox(part(sub, ms, '_') + part(sup, mp, '^'))])
    bh = base.h
    items = []
    if sup:
        items.append((0 if bh > 1 else -sup.h, sup))
    if sub:
        items.append((bh - sub.h if bh > 1 else 1, sub))
    lo = min([0] + [s for s, _ in items])
    hi = max([bh - 1] + [s + b.h - 1 for s, b in items])
    w = max(b.w for _, b in items)
    rows = [' ' * w] * (hi - lo + 1)
    for s, b in items:
        for i, l in enumerate(b.lines):
            rows[s - lo + i] = l + ' ' * (w - b.w)
    return hcat([base, Box(rows, base.base - lo)])


def r_script(n, c):
    e = elems(n)
    ct = c.sub(tight=True)
    base = render(e[0], c)
    r = [render(k, ct) for k in e[1:]]
    if n.tag == 'msub':
        return attach(base, r[0], None, c)
    if n.tag == 'msup':
        return attach(base, None, r[0], c)
    return attach(base, r[0], r[1], c)


def add_accent(b, comb):
    if b.h != 1:
        return None
    s, out, seen = b.lines[0], [], 0
    vis = [i for i, ch in enumerate(s) if ch > '\x04' and not ch.isspace()]
    targets = set(vis) if comb == '\u0305' else set(vis[-1:])
    for i, ch in enumerate(s):
        out.append(ch + (comb if i in targets else ''))
    return Box([''.join(out)], 0) if vis else None


def r_limits(n, c):
    e = elems(n)
    ct = c.sub(tight=True)
    base = render(e[0], c)
    under = over = None
    if n.tag == 'munder':
        under = render(e[1], ct)
    elif n.tag == 'mover':
        over = render(e[1], ct)
    else:
        under, over = render(e[1], ct), render(e[2], ct)
    if over is not None and under is None and over.h == 1:
        ot = clean(ntext(e[1]))
        comb = COMB.get(ot) or (ot if len(ot) == 1 and unicodedata.combining(ot) else None)
        acc = add_accent(base, comb) if comb else None
        if acc:
            return acc
    if c.linear:
        return attach(base, under, over, c)
    parts = [p for p in (over, base, under) if p is not None]
    w = max(p.w for p in parts)
    lines = [l for p in parts for l in centered(p, w).lines]
    return Box(lines, (over.h if over else 0) + base.base)


def r_table(n, c):
    rows = []
    for tr in elems(n):
        cells = elems(tr)
        if tr.tag == 'mlabeledtr':
            cells = cells[1:]
        rows.append(cells)
    if not rows:
        return tbox('')
    tab_align = (n.attrs.get('columnalign') or 'center').split()
    if c.linear:
        return tbox('; '.join(' '.join(render(td, c).lines[0] for td in r) for r in rows))
    grid = [[render(td, c) for td in r] for r in rows]
    ncol = max(len(r) for r in grid)
    widths = [max((r[j].w for r in grid if j < len(r)), default=0) for j in range(ncol)]
    gap = 1 if len(set(tab_align)) > 1 or 'right' in tab_align else 2
    rowboxes = []
    for r, cells in zip(grid, rows):
        parts = []
        for j in range(ncol):
            if j >= len(r):
                parts.append(tbox(' ' * widths[j]))
                continue
            al = cells[j].attrs.get('columnalign') or tab_align[min(j, len(tab_align) - 1)]
            parts.append(centered(r[j], widths[j], al))
            if j < ncol - 1:
                parts.append(tbox(' ' * gap))
        rowboxes.append(hcat(parts))
    spaced = any(b.h > 1 for b in rowboxes)
    lines = []
    for i, b in enumerate(rowboxes):
        if i and spaced:
            lines.append(' ' * b.w)
        lines.extend(b.lines)
    w = max(b.w for b in rowboxes)
    return Box([l + ' ' * (w - vlen(l)) for l in lines], (len(lines) - 1) // 2)


def r_fenced(n, c):
    op, cl = n.attrs.get('open', '('), n.attrs.get('close', ')')
    seps = n.attrs.get('separators', ',').split() or [',']
    kids = elems(n)

    def mo(s, stretchy=False):
        m = N('mo', {'stretchy': 'true'} if stretchy else {})
        m.kids = [s]
        return m
    row = N('mrow', {})
    row.kids = [mo(op, True)]
    for i, k in enumerate(kids):
        if i:
            row.kids.append(mo(seps[min(i - 1, len(seps) - 1)]))
        row.kids.append(k)
    row.kids.append(mo(cl, True))
    return r_row(row, c)


RENDER = {
    'mi': r_mi, 'mn': r_tok, 'mo': r_tok, 'ms': r_tok, 'mtext': r_mtext, 'mspace': r_mspace,
    'mrow': r_row, 'math': r_first, 'semantics': r_first, 'mstyle': r_mstyle,
    'mphantom': r_phantom, 'mfrac': r_frac, 'msqrt': r_sqrt, 'mroot': r_root,
    'msub': r_script, 'msup': r_script, 'msubsup': r_script,
    'munder': r_limits, 'mover': r_limits, 'munderover': r_limits,
    'mtable': r_table, 'mfenced': r_fenced,
}


def render(n, c):
    return RENDER.get(n.tag, r_row)(n, c)


def trim_lines(lines):
    lines = [l.rstrip() for l in lines]
    while lines and not unmark(lines[0]).strip():
        lines.pop(0)
    while lines and not unmark(lines[-1]).strip():
        lines.pop()
    lead = min((vlen(l) - vlen(l.lstrip()) for l in lines if unmark(l).strip()), default=0)
    return [l[lead:] for l in lines]


def tex_fallback(root):
    def find(n):
        for k in elems(n):
            if k.tag == 'annotation' and 'tex' in k.attrs.get('encoding', ''):
                return ntext(k)
            r = find(k)
            if r:
                return r
    return ' '.join((find(root) or ntext(root)).split())



# ------------------------------------------------------- XHTML -> text blocks

BLOCK = {'p', 'div', 'section', 'article', 'aside', 'header', 'footer', 'main', 'nav',
         'figure', 'figcaption', 'blockquote', 'ul', 'ol', 'li', 'dl', 'dt', 'dd', 'table',
         'tr', 'pre', 'body', 'address', 'details', 'summary', 'caption', 'tbody', 'thead',
         'tfoot', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6'}
HEADINGS = {'h1', 'h2', 'h3', 'h4', 'h5', 'h6'}
SKIP = {'script', 'style', 'head', 'title'}
BOLD = HEADINGS | {'b', 'strong', 'th', 'dt'}
ITAL = {'i', 'em', 'cite', 'var', 'dfn'}
# inline style markers inside text: \x01/\x02 bold on/off, \x03/\x04 italic on/off,
# \x05 non-breaking space


class Extractor(HTMLParser):
    """Produces blocks: ('p'|'li'|'row', text, indent, prefix, pre, align),
    ('img', src, alt), ('hr',), ('anchor', id)."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.blocks, self.buf, self.anchors = [], [], []
        self.mstack = []
        self.links, self.cur_link, self.heading = [], None, 0
        self.skip = self.pre = self.bq = self.bold = self.ital = self.cell = 0
        self.lists = []
        self.prefix = self.align = None
        self.kind = 'p'

    def flush(self):
        text = ''.join(self.buf)
        self.buf = []
        if self.bold:
            self.buf.append('\x01')
        if self.ital:
            self.buf.append('\x03')
        if self.cur_link is not None:
            self.buf.append('\x06%d\x07' % self.cur_link)
        if not re.sub(r'\x06\d+\x07|[\x01-\x05\x08\x10-\x13\s]', '', text):
            return
        indent = self.bq * 4 + len(self.lists) * 3
        if self.prefix:
            indent = max(indent, 3)
        self.emit_anchors()
        self.blocks.append(('li' if self.prefix else self.kind, text, indent, self.prefix,
                            bool(self.pre), self.align, self.heading))
        self.prefix = self.align = None
        self.heading = 0
        self.kind = 'p'

    def finish_math(self):
        root, self.mstack = self.mstack[0], []
        block = root.attrs.get('display') == 'block'
        try:
            lines = trim_lines(render(root, Ctx(linear=not block, upright=bool(self.ital))).lines)
        except Exception:
            lines = [tex_fallback(root)]
        if block:
            self.flush()
            self.emit_anchors()
            self.blocks.append(('math', root))
        else:
            self.buf.append(' '.join(lines).replace(' ', '\x05'))

    def emit_anchors(self):
        self.blocks.extend(('anchor', i) for i in self.anchors)
        self.anchors = []

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag in SKIP:
            self.skip += 1
            return
        if self.skip:
            return
        if self.mstack:
            node = N(tag, a)
            self.mstack[-1].kids.append(node)
            self.mstack.append(node)
            return
        if tag == 'math':
            self.mstack = [N('math', a)]
            return
        if tag in BLOCK:
            self.flush()
        if a.get('id'):
            self.anchors.append(a['id'])
        if tag == 'br':
            self.buf.append('\n')
        elif tag in ('img', 'image'):
            src = a.get('src') or a.get('xlink:href') or a.get('href')
            if src:
                self.flush()
                self.emit_anchors()
                self.blocks.append(('img', src, a.get('alt', '')))
        elif tag == 'hr':
            self.emit_anchors()
            self.blocks.append(('hr',))
        elif tag in ('ul', 'ol'):
            try:
                start = int(a.get('start', 1)) - 1
            except ValueError:
                start = 0
            self.lists.append([tag, start])
        elif tag == 'li':
            if self.lists and self.lists[-1][0] == 'ol':
                self.lists[-1][1] += 1
                self.prefix = '%d.' % self.lists[-1][1]
            else:
                self.prefix = '•'
        elif tag == 'blockquote':
            self.bq += 1
        elif tag == 'pre':
            self.pre += 1
        elif tag == 'tr':
            self.kind, self.cell = 'row', 0
        elif tag in ('td', 'th'):
            if self.cell:
                self.buf.append(' │ ')
            self.cell += 1
        elif tag in HEADINGS:
            self.heading = int(tag[1])
            self.align = 'center' if tag in ('h1', 'h2') else None
        elif tag == 'a' and a.get('href') is not None:
            self.cur_link = len(self.links)
            self.links.append(a['href'])
            self.buf.append('\x06%d\x07' % self.cur_link)
        elif tag == 'sup':
            self.buf.append('\x10')
        elif tag == 'sub':
            self.buf.append('\x12')
        if tag in BOLD:
            self.bold += 1
            if self.bold == 1:
                self.buf.append('\x01')
        if tag in ITAL:
            self.ital += 1
            if self.ital == 1:
                self.buf.append('\x03')

    def handle_endtag(self, tag):
        if tag in SKIP:
            self.skip = max(0, self.skip - 1)
            return
        if self.skip:
            return
        if self.mstack:
            if tag == 'math':
                self.finish_math()
            else:
                for i in range(len(self.mstack) - 1, 0, -1):
                    if self.mstack[i].tag == tag:
                        del self.mstack[i:]
                        break
            return
        if tag in BOLD and self.bold:
            self.bold -= 1
            if not self.bold:
                self.buf.append('\x02')
        if tag in ITAL and self.ital:
            self.ital -= 1
            if not self.ital:
                self.buf.append('\x04')
        if tag == 'a' and self.cur_link is not None:
            self.buf.append('\x08')
            self.cur_link = None
        elif tag == 'sup':
            self.buf.append('\x11')
        elif tag == 'sub':
            self.buf.append('\x13')
        if tag in BLOCK:
            self.flush()
        if tag in ('li', 'tr') or tag in HEADINGS:
            self.heading = 0
            self.prefix = self.align = None
            self.kind = 'p'
        if tag == 'blockquote':
            self.bq = max(0, self.bq - 1)
        elif tag == 'pre':
            self.pre = max(0, self.pre - 1)
        elif tag in ('ul', 'ol') and self.lists:
            self.lists.pop()

    def handle_data(self, data):
        if self.skip:
            return
        if self.mstack:
            self.mstack[-1].kids.append(data)
            return
        data = data.replace('\xa0', '\x05')
        if not self.pre:
            data = re.sub(r'[ \t\r\n\f\v]+', ' ', data)
        self.buf.append(data)



def vlen(s):
    n = 0
    for c in s:
        if c == '\x05':
            n += 1
        elif c < '\x05':
            continue
        elif unicodedata.category(c) in ('Mn', 'Me', 'Cf'):
            continue
        else:
            n += 2 if unicodedata.east_asian_width(c) in 'WF' else 1
    return n



# ------------------------------------------------------------- image helpers

def image_size(d):
    try:
        if d.startswith(PNG_SIG):
            return struct.unpack('>II', d[16:24])
        if d[:3] == b'GIF':
            return struct.unpack('<HH', d[6:10])
        if d[:2] == b'\xff\xd8':
            i = 2
            while i + 9 < len(d):
                if d[i] != 0xFF:
                    i += 1
                    continue
                m = d[i + 1]
                if m in (0xD8, 0x01) or 0xD0 <= m <= 0xD7:
                    i += 2
                    continue
                if 0xC0 <= m <= 0xCF and m not in (0xC4, 0xC8, 0xCC):
                    h, w = struct.unpack('>HH', d[i + 5:i + 9])
                    return w, h
                i += 2 + struct.unpack('>H', d[i + 2:i + 4])[0]
        if d[:4] == b'RIFF' and d[8:12] == b'WEBP':
            if d[12:16] == b'VP8X':
                return (int.from_bytes(d[24:27], 'little') + 1,
                        int.from_bytes(d[27:30], 'little') + 1)
            if d[12:16] == b'VP8 ':
                w, h = struct.unpack('<HH', d[26:30])
                return w & 0x3FFF, h & 0x3FFF
            if d[12:16] == b'VP8L':
                bits = int.from_bytes(d[21:25], 'little')
                return (bits & 0x3FFF) + 1, ((bits >> 14) & 0x3FFF) + 1
    except Exception:
        pass
    return None


def to_png(data):
    with tempfile.TemporaryDirectory() as d:
        src, dst = os.path.join(d, 'in'), os.path.join(d, 'out.png')
        with open(src, 'wb') as f:
            f.write(data)
        for cmd in (['sips', '-s', 'format', 'png', src, '--out', dst],
                    ['magick', src, dst], ['convert', src, dst]):
            if shutil.which(cmd[0]):
                try:
                    subprocess.run(cmd, capture_output=True, timeout=30, check=True)
                    with open(dst, 'rb') as f:
                        return f.read()
                except Exception:
                    continue
    return None





# ------------------------------------------------ MathML -> Tk canvas typesetting
# Display equations are laid out as boxes (width, ascent, descent, draw callback)
# and drawn on a small Canvas embedded in the text.  Fonts, colours and sizes come
# from the reader, so equations follow the theme and the text size.

class MathFonts:
    def __init__(self, family):
        self.family = family
        self._cache = {}

    def font(self, px, bold, ital):
        key = (px, bold, ital)
        if key not in self._cache:
            self._cache[key] = tkfont.Font(
                family=self.family, size=-px, weight='bold' if bold else 'normal',
                slant='italic' if ital else 'roman')
        return self._cache[key]

    def measure(self, px, bold, ital, s):
        return self.font(px, bold, ital).measure(s)

    def metrics(self, px, bold, ital):
        f = self.font(px, bold, ital)
        return f.metrics('ascent'), f.metrics('descent')


class MCtx:
    def __init__(self, fonts, px, fg, display=True, tight=False, upright=False,
                 bold=False, depth=0):
        self.fonts, self.px, self.fg = fonts, px, fg
        self.display, self.tight, self.upright = display, tight, upright
        self.bold, self.depth = bold, depth

    def sub(self, **kw):
        c = MCtx(self.fonts, self.px, self.fg, self.display, self.tight,
                 self.upright, self.bold, self.depth)
        for k, v in kw.items():
            setattr(c, k, v)
        return c

    def script(self):
        return self.sub(px=max(6, round(self.px * (0.72 if self.depth == 0 else 0.6))),
                        tight=True, display=False, depth=self.depth + 1)

    @property
    def axis(self):
        return self.px * 0.27


class MBox:
    __slots__ = ('w', 'asc', 'desc', 'draw', 'txt', 'space')

    def __init__(self, w=0, asc=0, desc=0, draw=None, txt='', space=False):
        self.w, self.asc, self.desc, self.txt, self.space = w, asc, desc, txt, space
        self.draw = draw or (lambda c, x, y: None)


def demath(ch):
    """Mathematical alphanumeric -> (plain character, bold, italic)."""
    if ch == 'ℎ':
        return 'h', False, True
    if not 0x1D400 <= ord(ch) <= 0x1D7FF:
        return ch, False, False
    words = unicodedata.name(ch, '').split()
    if any(w in ('SCRIPT', 'FRAKTUR', 'DOUBLE-STRUCK', 'MONOSPACE') for w in words):
        return ch, False, False
    bold, ital = 'BOLD' in words, 'ITALIC' in words
    rest = [w for w in words[1:] if w not in ('BOLD', 'ITALIC', 'SANS-SERIF')]
    names = []
    if rest and rest[0] in ('CAPITAL', 'SMALL'):
        letter = ' '.join(rest[1:])
        names = ['LATIN %s LETTER %s' % (rest[0], letter),
                 'GREEK %s LETTER %s' % (rest[0], letter)]
    elif rest and rest[0] == 'DIGIT':
        names = ['DIGIT ' + ' '.join(rest[1:])]
    else:
        names = [' '.join(rest), 'GREEK ' + ' '.join(rest)]
    for name in names:
        try:
            return unicodedata.lookup(name), bold, ital
        except KeyError:
            continue
    return ch, bold, ital


def m_tok(ctx, s, bold, ital, scale=1.0):
    px = max(5, round(ctx.px * scale))
    f = ctx.fonts
    w = f.measure(px, bold, ital, s)
    ra, rd = f.metrics(px, bold, ital)
    fnt, fg = f.font(px, bold, ital), ctx.fg

    def draw(c, x, y):
        c.create_text(x, y - ra, text=s, anchor='nw', font=fnt, fill=fg)
    return MBox(w + (px * 0.05 if ital else 0), ra * 0.9, rd * 0.9, draw, s)


def m_hcat(boxes):
    boxes = [b for b in boxes if b.w or b.asc or b.desc]
    if not boxes:
        return MBox()

    def draw(c, x, y):
        for b in boxes:
            b.draw(c, x, y)
            x += b.w
    return MBox(sum(b.w for b in boxes), max(b.asc for b in boxes),
                max(b.desc for b in boxes), draw, ''.join(b.txt for b in boxes))


def m_space(w):
    return MBox(w, 0, 0, None, '', True)


def m_text(ctx, s, bold=False, ital=False, scale=1.0):
    if not s:
        return MBox()
    runs = []
    for ch in s:
        base, b, i = demath(ch)
        st = (bold or b, ital or i)
        if runs and runs[-1][1] == st:
            runs[-1][0] += base
        else:
            runs.append([base, st])
    return m_hcat([m_tok(ctx, t, st[0], st[1], scale) for t, st in runs])


def m_shift(b, dy, asc=None, desc=None):
    """Same box drawn dy lower (positive = down); asc/desc override the extents."""
    return MBox(b.w, b.asc if asc is None else asc, b.desc if desc is None else desc,
                lambda c, x, y: b.draw(c, x, y + dy), b.txt, b.space)


def mr_tok(n, c):
    return m_text(c, clean(ntext(n)), bold=c.bold)


def mr_mi(n, c):
    s = clean(ntext(n))
    ital = (len(s) == 1 and s.isalpha() and ord(s) < 0x10000 and not c.upright
            and n.attrs.get('mathvariant') != 'normal')
    return m_text(c, s, bold=c.bold, ital=ital)


def mr_mo(n, c):
    s = clean(ntext(n))
    if s in BIGOPS and c.display and not c.tight:
        b = m_text(c, s, bold=c.bold, scale=1.7 if s in '∫∬∭∮' else 1.35)
        h = b.asc + b.desc
        return m_shift(b, (b.asc - b.desc) / 2 - c.axis, c.axis + h / 2, h / 2 - c.axis)
    return m_text(c, s, bold=c.bold)


def mr_mtext(n, c):
    return m_text(c, ntext(n).replace('\xa0', ' ').translate(_INVIS), bold=c.bold)


def mr_mspace(n, c):
    m = re.match(r'(-?[\d.]+)\s*(em|ex|px)?', n.attrs.get('width', ''))
    if not m:
        return MBox()
    v = float(m.group(1)) * {'em': c.px, 'ex': c.px * 0.5, 'px': 1}.get(m.group(2) or 'em')
    return m_space(max(0, v))


FENCE_DRAW = set('()[]{}|‖')


def m_fence(c, ch, asc, desc):
    h, px = asc + desc, c.px
    if h < 1.3 * px or ch not in FENCE_DRAW:
        return m_text(c, ch, bold=c.bold)
    w = {'(': .34, ')': .34, '[': .3, ']': .3, '{': .42, '}': .42, '|': .2, '‖': .32}[ch] * px
    fg, th = c.fg, max(1.2, px * 0.07)

    def draw(cv, x, y):
        top, bot = y - asc, y + desc
        mid = (top + bot) / 2
        right = ch in ')]}'

        def fx(u):                      # u in 0..1 from the outer edge
            return x + (w * (1 - u) if right else w * u)
        kw = dict(fill=fg, width=th, capstyle='round', joinstyle='round')
        if ch in '()':
            cv.create_line(fx(.85), top, fx(.2), top + h * .28, fx(.2), bot - h * .28,
                           fx(.85), bot, smooth=True, splinesteps=24, **kw)
        elif ch in '[]':
            cv.create_line(fx(.85), top, fx(.2), top, fx(.2), bot, fx(.85), bot, **kw)
        elif ch in '{}':
            cv.create_line(fx(.85), top, fx(.55), top + h * .1, fx(.5), top + h * .38,
                           fx(.1), mid, fx(.5), bot - h * .38, fx(.55), bot - h * .1,
                           fx(.85), bot, smooth=True, splinesteps=24, **kw)
        elif ch == '|':
            cv.create_line(x + w / 2, top, x + w / 2, bot, **kw)
        else:
            cv.create_line(x + w * .3, top, x + w * .3, bot, **kw)
            cv.create_line(x + w * .7, top, x + w * .7, bot, **kw)
    return MBox(w, asc, desc, draw, ch)


def mr_row(n, c):
    kids = elems(n)
    if not kids:
        return MBox()
    texts = [clean(ntext(k)) if k.tag == 'mo' else
             (opname(k) if k.tag in ('mover', 'munder', 'munderover')
              and opname(k) in REL else None) for k in kids]
    stretch = [k.tag == 'mo' and k.attrs.get('stretchy') == 'true' and texts[i] in FENCE
               for i, k in enumerate(kids)]
    boxes = [None if stretch[i] else mr(k, c) for i, k in enumerate(kids)]
    real = [b for b in boxes if b is not None]
    asc = max([b.asc for b in real] + [c.px * .75])
    desc = max([b.desc for b in real] + [c.px * .22])
    for i in range(len(kids)):
        if stretch[i]:
            boxes[i] = m_fence(c, texts[i], asc, desc)
    out, em, last = [], c.px, len(kids) - 1

    def space(w):
        if out and out[-1].space:
            if out[-1].w < w:
                out[-1] = m_space(w)
        else:
            out.append(m_space(w))
    for i, (k, b) in enumerate(zip(kids, boxes)):
        s = texts[i]
        padl = padr = 0
        if s is not None and not c.tight:
            if s in REL:
                padl, padr = (.28 * em if i > 0 else 0), (.28 * em if i < last else 0)
            elif s in BIN:
                prev = kids[i - 1] if i else None
                if (prev is not None and i < last and
                        not (prev.tag == 'mo' and texts[i - 1] not in CLOSE)):
                    padl = padr = .22 * em
            elif s in (',', ';') and i < last:
                padr = .17 * em
        if padl:
            space(padl)
        if b.space:
            space(b.w)
        else:
            out.append(b)
        if padr:
            space(padr)
        if not c.tight:
            if k.tag == 'mfrac' and i < last and texts[i + 1] is None:
                space(.12 * em)
            nm = opname(k)
            if nm and (nm in BIGOPS or (len(nm) >= 2 and nm.isalpha())):
                j = i + 1
                while j <= last and texts[j] == '':
                    j += 1
                if j <= last:
                    first = boxes[j].txt[:1]
                    if first not in ('(', '[', '{', '⟨', ',', ';', '.', ')'):
                        space(.17 * em)
    return m_hcat(out)


def mr_first(n, c):
    e = [k for k in elems(n) if not k.tag.startswith('annotation')]
    return mr(e[0], c) if e else MBox()


def mr_mstyle(n, c):
    v = n.attrs.get('mathvariant')
    if v:
        c = c.sub(upright=True, bold=c.bold or v.startswith('bold'))
    if n.attrs.get('displaystyle') == 'false':
        c = c.sub(display=False)
    return mr_row(n, c)


def mr_phantom(n, c):
    b = mr_row(n, c)
    return MBox(b.w, b.asc, b.desc, None, '', True)


def mr_frac(n, c):
    e = elems(n)
    cc = c.sub(px=round(c.px * (1 if c.depth == 0 else .78)), depth=c.depth + 1,
               display=False)
    num, den = mr(e[0], cc), mr(e[1], cc)
    bar = n.attrs.get('linethickness') not in ('0', '0px')
    ax, th, gap, pad = c.axis, max(1.0, c.px * .06), c.px * .16, c.px * .12
    w = max(num.w, den.w) + 2 * pad
    asc = ax + th / 2 + gap + num.asc + num.desc
    desc = den.asc + den.desc + gap + th / 2 - ax
    fg = c.fg

    def draw(cv, x, y):
        yb = y - ax
        num.draw(cv, x + (w - num.w) / 2, yb - th / 2 - gap - num.desc)
        den.draw(cv, x + (w - den.w) / 2, yb + th / 2 + gap + den.asc)
        if bar:
            cv.create_line(x + pad / 2, yb, x + w - pad / 2, yb, fill=fg, width=th)
    return MBox(w, asc, desc, draw)


def mr_sqrt(n, c, index=None):
    b = mr_row(n, c)
    px, fg = c.px, c.fg
    th, gap = max(1.0, px * .06), px * .12
    asc, desc = b.asc + gap + th * 1.5, b.desc
    h = asc + desc
    rw = max(px * .55, h * .3)
    ix = index.w - rw * .55 if index is not None and index.w > rw * .55 else 0
    w = ix + rw + b.w + px * .12

    def draw(cv, x, y):
        top, bot = y - asc + th, y + desc
        x0 = x + ix
        cv.create_line(x0, bot - h * .42, x0 + rw * .22, bot - h * .5, x0 + rw * .5, bot,
                       x0 + rw, top, x0 + rw + b.w + px * .1, top, fill=fg, width=th * 1.2,
                       joinstyle='miter')
        b.draw(cv, x0 + rw + px * .04, y)
        if index is not None:
            index.draw(cv, x, y - h * .45)
    return MBox(w, asc, desc, draw)


def mr_root(n, c):
    e = elems(n)
    wrapper = N('mrow', {})
    wrapper.kids = [e[0]]
    idx = mr(e[1], c.script()) if len(e) > 1 else None
    return mr_sqrt(wrapper, c, idx)


def m_attach(c, base, sub, sup):
    px = c.px
    ex = px * .05
    raise_ = max(px * .4, base.asc * .72) if sup else 0
    drop = max(px * .22, base.desc * .9 + (sub.asc * .25 if sub else 0)) if sub else 0
    if sub and sup and raise_ + drop < sup.desc + sub.asc + px * .15:
        drop = sup.desc + sub.asc + px * .15 - raise_
    w = base.w + ex + max(sup.w if sup else 0, sub.w if sub else 0)
    asc = max(base.asc, raise_ + (sup.asc if sup else 0))
    desc = max(base.desc, drop + (sub.desc if sub else 0))

    def draw(cv, x, y):
        base.draw(cv, x, y)
        if sup:
            sup.draw(cv, x + base.w + ex, y - raise_)
        if sub:
            sub.draw(cv, x + base.w + ex, y + drop)
    return MBox(w, asc, desc, draw, base.txt)


def mr_script(n, c):
    e = elems(n)
    base = mr(e[0], c)
    sc = c.script()
    r = [mr(k, sc) for k in e[1:]]
    if n.tag == 'msub':
        return m_attach(c, base, r[0], None)
    if n.tag == 'msup':
        return m_attach(c, base, None, r[0])
    return m_attach(c, base, r[0], r[1])


def m_accent(c, kind, base):
    px, fg = c.px, c.fg
    ah = px * .16
    w = base.w

    def draw(cv, x, y):
        top = y - base.asc - px * .05
        base.draw(cv, x, y)
        mx = x + w / 2
        kw = dict(fill=fg, width=max(1.0, px * .06), capstyle='round', joinstyle='round')
        if kind == 'bar':
            cv.create_line(x + px * .05, top - ah / 2, x + w - px * .05, top - ah / 2, **kw)
        elif kind == 'hat':
            cv.create_line(mx - px * .17, top - ah * .1, mx, top - ah, mx + px * .17,
                           top - ah * .1, **kw)
        elif kind == 'tilde':
            cv.create_line(mx - px * .18, top - ah * .3, mx - px * .08, top - ah * .9,
                           mx + px * .08, top - ah * .3, mx + px * .18, top - ah * .9,
                           smooth=True, **kw)
        elif kind == 'vec':
            cv.create_line(mx - px * .2, top - ah / 2, mx + px * .2, top - ah / 2, **kw)
            cv.create_line(mx + px * .1, top - ah, mx + px * .2, top - ah / 2, mx + px * .1,
                           top, **kw)
        elif kind == 'dot':
            r = px * .035
            cv.create_oval(mx - r, top - ah / 2 - r, mx + r, top - ah / 2 + r, fill=fg,
                           outline=fg)
        else:
            for dx in (-px * .08, px * .08):
                r = px * .035
                cv.create_oval(mx + dx - r, top - ah / 2 - r, mx + dx + r, top - ah / 2 + r,
                               fill=fg, outline=fg)
    return MBox(w, base.asc + px * .05 + ah, base.desc, draw, base.txt)


ACCENT_KIND = {'¯': 'bar', '‾': 'bar', '―': 'bar', '\u0305': 'bar', '\u0304': 'bar',
               '^': 'hat', 'ˆ': 'hat', '\u0302': 'hat', '~': 'tilde', '˜': 'tilde',
               '\u0303': 'tilde', '→': 'vec', '\u20d7': 'vec', '˙': 'dot', '\u0307': 'dot',
               '¨': 'ddot', '\u0308': 'ddot'}


def mr_limits(n, c):
    e = elems(n)
    base = mr(e[0], c)
    sc = c.script()
    under = over = None
    if n.tag == 'munder':
        under = mr(e[1], sc)
    elif n.tag == 'mover':
        over = mr(e[1], sc)
    else:
        under, over = mr(e[1], sc), mr(e[2], sc)
    if over is not None and under is None:
        kind = ACCENT_KIND.get(clean(ntext(e[1])))
        if kind:
            return m_accent(c, kind, base)
    if not c.display and not c.tight:
        return m_attach(c, base, under, over)
    gap = c.px * .12
    w = max(b.w for b in (base, under, over) if b is not None)
    asc = base.asc + (over.asc + over.desc + gap if over else 0)
    desc = base.desc + (under.asc + under.desc + gap if under else 0)

    def draw(cv, x, y):
        base.draw(cv, x + (w - base.w) / 2, y)
        if over:
            over.draw(cv, x + (w - over.w) / 2, y - base.asc - gap - over.desc)
        if under:
            under.draw(cv, x + (w - under.w) / 2, y + base.desc + gap + under.asc)
    return MBox(w, asc, desc, draw, base.txt)


def mr_table(n, c):
    rows = []
    for tr in elems(n):
        cells = elems(tr)
        rows.append(cells[1:] if tr.tag == 'mlabeledtr' else cells)
    if not rows:
        return MBox()
    tab_align = (n.attrs.get('columnalign') or 'center').split()
    cc = c.sub(display=False)
    grid = [[mr(td, cc) for td in r] for r in rows]
    ncol = max(len(r) for r in grid)
    widths = [max((r[j].w for r in grid if j < len(r)), default=0) for j in range(ncol)]
    aligned = len(set(tab_align)) > 1 or 'right' in tab_align
    cgap = c.px * (.4 if aligned else 1.1)
    rgap = c.px * .45
    rasc = [max([b.asc for b in r] + [c.px * .6]) for r in grid]
    rdesc = [max([b.desc for b in r] + [c.px * .2]) for r in grid]
    total = sum(rasc) + sum(rdesc) + rgap * (len(grid) - 1)
    w = sum(widths) + cgap * (ncol - 1)
    asc, desc = total / 2 + c.axis, total / 2 - c.axis

    def draw(cv, x, y):
        yy = y - asc
        for r, cells, ra, rd in zip(grid, rows, rasc, rdesc):
            xx = x
            for j in range(ncol):
                if j < len(r):
                    al = cells[j].attrs.get('columnalign') or tab_align[min(j, len(tab_align) - 1)]
                    off = {'left': 0, 'right': widths[j] - r[j].w}.get(al, (widths[j] - r[j].w) / 2)
                    r[j].draw(cv, xx + off, yy + ra)
                xx += widths[j] + cgap
            yy += ra + rd + rgap
    return MBox(w, asc, desc, draw)


def mr_fenced(n, c):
    op, cl = n.attrs.get('open', '('), n.attrs.get('close', ')')
    seps = n.attrs.get('separators', ',').split() or [',']

    def mo(s, stretchy=False):
        m = N('mo', {'stretchy': 'true'} if stretchy else {})
        m.kids = [s]
        return m
    row = N('mrow', {})
    row.kids = [mo(op, True)]
    for i, k in enumerate(elems(n)):
        if i:
            row.kids.append(mo(seps[min(i - 1, len(seps) - 1)]))
        row.kids.append(k)
    row.kids.append(mo(cl, True))
    return mr_row(row, c)


MRENDER = {
    'mi': mr_mi, 'mn': mr_tok, 'mo': mr_mo, 'ms': mr_tok, 'mtext': mr_mtext,
    'mspace': mr_mspace, 'mrow': mr_row, 'math': mr_first, 'semantics': mr_first,
    'mstyle': mr_mstyle, 'mphantom': mr_phantom, 'mfrac': mr_frac, 'msqrt': mr_sqrt,
    'mroot': mr_root, 'msub': mr_script, 'msup': mr_script, 'msubsup': mr_script,
    'munder': mr_limits, 'mover': mr_limits, 'munderover': mr_limits,
    'mtable': mr_table, 'mfenced': mr_fenced,
}


def mr(n, c):
    return MRENDER.get(n.tag, mr_row)(n, c)


def build_math(root, fonts, px, fg, maxw):
    """Typeset a <math> tree, shrinking it until it fits maxw (if it can)."""
    box = None
    for scale in (1.0, .88, .77, .67, .58):
        box = mr(root, MCtx(fonts, max(6, round(px * scale)), fg))
        if box.w <= maxw:
            break
    return box


def sips_scale(data, width):
    """PNG of data resized to the given width with macOS `sips`, or None."""
    if not shutil.which("sips"):
        return None
    with tempfile.TemporaryDirectory() as d:
        src, dst = os.path.join(d, "in"), os.path.join(d, "out.png")
        with open(src, "wb") as fh:
            fh.write(data)
        try:
            subprocess.run(["sips", "--resampleWidth", str(int(width)), "-s", "format", "png",
                            src, "--out", dst], capture_output=True, timeout=60, check=True)
            with open(dst, "rb") as fh:
                return fh.read()
        except Exception:
            return None


