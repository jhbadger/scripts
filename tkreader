    def font(self, scale=1.0, bold=False, ital=False, mono=False):
        key = (round(scale, 3), bold, ital, mono, self.prefs["family"], self.prefs["size"])
        f = self.fonts.get(key)
        if f is None:
            f = tkfont.Font(
                family=self.mono_family if mono else self.prefs["family"],
                size=-max(5, round(self.px * scale * (0.9 if mono else 1))),
                weight="bold" if bold else "normal", slant="italic" if ital else "roman")
            self.fonts[key] = f
        return f

    def ftag(self, scale, bold, ital, mono, script=0):
        name = "f:%.2f:%d%d%d:%d" % (scale, bold, ital, mono, script)
        if name not in self.ftags:
            opts = {"font": self.font(scale * (0.72 if script else 1), bold, ital, mono)}
            if script:
                opts["offset"] = round(self.px * scale * (0.38 if script > 0 else -0.18))
            self.text.tag_configure(name, **opts)
            self.ftags.add(name)
        return name

    def ptag(self, lm1=0, lm2=0, justify="left", sp1=0, sp3=0, tabs=None, bg=None):
        name = "p:%d:%d:%s:%d:%d:%s:%s" % (lm1, lm2, justify, sp1, sp3, tabs, bg)
        if name not in self.ftags:
            opts = dict(lmargin1=lm1, lmargin2=lm2, justify=justify, spacing1=sp1,
                        spacing3=sp3)
            if tabs:
                opts["tabs"] = (tabs,)
            if bg:
                opts["background"] = bg
            self.text.tag_configure(name, **opts)
            self.ftags.add(name)
        return name

