        self.find_count.pack(side="left", padx=6)
        ttk.Button(f, text="Close", command=self.hide_find).pack(side="right")
        self.find_entry.bind("<Return>", lambda e: self.find_next(True))
        self.find_entry.bind("<Shift-Return>", lambda e: self.find_next(False))
        self.find_entry.bind("<Escape>", lambda e: self.hide_find())
        self.var_find.trace_add("write", lambda *a: self.schedule_find())

    def build_sidebar(self):
        fr = ttk.Frame(self.main)
        self.side = fr
        self.tree = ttk.Treeview(fr, show="tree", selectmode="browse")
        sb = ttk.Scrollbar(fr, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=sb.set)
        self.tree.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        self.tree.bind("<ButtonRelease-1>", self.on_toc_click)
        self.tree.bind("<Return>", self.on_toc_click)
        self.toc_items = {}

    def build_text(self):
        fr = ttk.Frame(self.main)
        self.text_frame = fr
        self.text = tk.Text(fr, wrap="word", width=1, height=1, padx=40, pady=18, relief="flat",
                            borderwidth=0, highlightthickness=0, cursor="arrow",
                            insertwidth=0, undo=False, state="disabled", takefocus=True)
        self.vsb = ttk.Scrollbar(fr, orient="vertical", command=self.text.yview)
        self.text.configure(yscrollcommand=self.on_yscroll)
        self.vsb.pack(side="right", fill="y")
        self.text.pack(side="left", fill="both", expand=True)
        self.main.add(fr, minsize=300, stretch="always")
        t = self.text
        t.tag_configure("link", underline=True)
        t.tag_configure("dim")
        t.tag_configure("hit")
        t.tag_configure("cur")
        t.tag_bind("link", "<Enter>", lambda e: t.configure(cursor="hand2"))
        t.tag_bind("link", "<Leave>", lambda e: t.configure(cursor="arrow"))
        t.bind("<Button-1>", lambda e: t.focus_set(), add="+")
        self.popup = tk.Menu(t, tearoff=0)
        self.popup.add_command(label="Copy", command=self.copy)
        self.popup.add_command(label="Select All", command=self.select_all)
        for seq in ("<Button-2>", "<Button-3>", "<Control-Button-1>"):
            t.bind(seq, self.show_popup)
        k = self.bind_keys
        k(t, ["<space>", "<Next>"], self.page_down)
        k(t, ["<Shift-space>", "<Prior>", "<BackSpace>"], self.page_up)
        k(t, ["<Down>", "<j>"], lambda: self.scroll(1))
        k(t, ["<Up>", "<k>"], lambda: self.scroll(-1))
        k(t, ["<Home>", "<g>"], lambda: t.yview_moveto(0))
        k(t, ["<End>", "<G>"], lambda: t.yview_moveto(1))
        k(t, ["<Right>", "<n>"], lambda: self.step(1))
        k(t, ["<Left>", "<p>"], lambda: self.step(-1))
        k(t, ["<slash>"], self.show_find)
        k(t, ["<t>"], self.toggle_sidebar)
        k(t, ["<Escape>"], self.hide_find)

    def show_popup(self, e):
        self.text.focus_set()
        self.popup.entryconfigure(0, state="normal" if self.text.tag_ranges("sel") else "disabled")
        self.popup.tk_popup(e.x_root, e.y_root)
        return "break"

    def on_copy_key(self, e):
        if self.root.focus_get() in (self.text, None):
            self.copy()
            return "break"
        return None

    def on_select_all_key(self, e):
        if self.root.focus_get() in (self.text, None):
            self.select_all()
            return "break"
        return None

    def select_all(self):
        self.text.tag_add("sel", "1.0", "end-1c")

    def selection_text(self):
        """The selected text; equations come out as their TeX source, images as
        their alt text."""
        t = self.text
        try:
            first, last = t.index("sel.first"), t.index("sel.last")
        except tk.TclError:
            return ""
        out = []
        for kind, val, _ in t.dump(first, last, text=True, window=True, image=True):
            if kind == "text":
                out.append(val)
            elif kind == "window" and val in self.win_math:
                out.append("\n" + tex_fallback(self.win_math[val]) + "\n")
            elif kind == "image":
                out.append("[Image: %s]" % self.img_alts.get(val, ""))
        return "".join(out).replace("\xa0", " ")

    def copy(self):
        text = self.selection_text()
        if not text:
            self.status.set("Nothing selected to copy.")
            return
        self.root.clipboard_clear()
        self.root.clipboard_append(text)
        self.status.set("Copied %d characters." % len(text))

    def scroll(self, n):
        self.text.yview_scroll(n * 2, "units")

    def page_down(self):
        if self.text.yview()[1] >= 0.9999:
            self.step(1)
        else:
            self.text.yview_scroll(1, "pages")

    def page_up(self):
        if self.text.yview()[0] <= 0.0001:
            if self.ci > 0:
                self.goto(self.ci - 1, end=True)
        else:
            self.text.yview_scroll(-1, "pages")

    def on_yscroll(self, first, last):
        self.vsb.set(first, last)
        if self.book:
            pct = round(float(last) * 100)
            self.status.set("Chapter %d of %d  \u00b7  %d%%" % (
                self.ci + 1, len(self.book.chapters), pct))

    def set_sidebar(self, show):
        self.prefs["sidebar"] = bool(show)
        self.var_sidebar.set(bool(show))
        shown = str(self.side) in [str(p) for p in self.main.panes()]
        if show and not shown:
            self.main.add(self.side, before=self.text_frame, minsize=160, width=260,
                          stretch="never")
        elif not show and shown:
            self.main.forget(self.side)

    def toggle_sidebar(self):
        self.set_sidebar(not self.prefs["sidebar"])

    # ---- appearance -------------------------------------------------------

    def apply_theme(self, rerender=True):
        th = self.theme = THEMES.get(self.prefs["theme"], THEMES["Light"])
        t = self.text
        t.configure(bg=th["bg"], fg=th["fg"], selectbackground=th["sel"],
                    selectforeground=th["fg"], inactiveselectbackground=th["sel"],
                    spacing2=round(self.px * 0.22))
        t.tag_configure("link", foreground=th["link"])
        t.tag_configure("dim", foreground=th["dim"])
        t.tag_configure("hit", background=th["hit"])
        t.tag_configure("cur", background=th["cur"])
        try:
            st = ttk.Style()
            st.configure("Treeview", background=th["bg"], fieldbackground=th["bg"],
                         foreground=th["fg"], font=(self.ui_family, 12))
            st.map("Treeview", background=[("selected", th["sel"])],
                   foreground=[("selected", th["fg"])])
        except tk.TclError:
            pass
        if rerender and self.book:
            self.rerender()

    def change_theme(self):
        self.prefs["theme"] = self.var_theme.get()
        self.apply_theme()

    def change_family(self):
        self.prefs["family"] = self.var_family.get()
        self.math_family = pick_family(MATH, self.avail, self.prefs["family"])
        self.apply_theme()

    def change_measure(self):
        self.prefs["measure"] = self.var_measure.get()
        self.rerender()

    def zoom(self, d):
        size = self.default_size if d == 0 else self.prefs["size"] + d
        self.prefs["size"] = max(8, min(40, size))
        self.apply_theme()

    def choose_font(self):
        top = tk.Toplevel(self.root)
        top.title("Choose font")
        top.transient(self.root)
        var = tk.StringVar()
        ttk.Entry(top, textvariable=var).pack(fill="x", padx=8, pady=(8, 4))
        lb = tk.Listbox(top, height=18, width=40, exportselection=False)
        lb.pack(fill="both", expand=True, padx=8)
        names = sorted(f for f in self.avail if not f.startswith("@"))

        def fill(*a):
            lb.delete(0, "end")
            q = var.get().lower()
            for n in names:
                if q in n.lower():
                    lb.insert("end", n)
        var.trace_add("write", fill)
        fill()

        def ok(*a):
            sel = lb.curselection()
            if sel:
                self.var_family.set(lb.get(sel[0]))
                self.change_family()
            top.destroy()
        lb.bind("<Double-Button-1>", ok)
        row = ttk.Frame(top)
        row.pack(fill="x", padx=8, pady=8)
        ttk.Button(row, text="Cancel", command=top.destroy).pack(side="right")
        ttk.Button(row, text="Use font", command=ok).pack(side="right", padx=6)

    def show_help(self):
        doc = __doc__
        messagebox.showinfo("tkreader", doc[doc.index("Reading"):doc.index("The reading")].rstrip())

    # ---- files ------------------------------------------------------------

    def open_dialog(self):
        init = os.path.dirname(self.book.path) if self.book else os.path.expanduser("~")
        path = filedialog.askopenfilename(
            parent=self.root, initialdir=init,
            filetypes=[("EPUB books", "*.epub"), ("All files", "*")])
        if path:
            self.load(path)

    def update_recent_menu(self):
        m = self.recent_menu
        m.delete(0, "end")
        recent = [p for p in self.prefs["recent"] if os.path.exists(p)]
        for p in recent:
            m.add_command(label=os.path.basename(p), command=lambda p=p: self.load(p))
        if not recent:
            m.add_command(label="(none)", state="disabled")

    def load(self, path):
        path = os.path.abspath(path)
        try:
            book = Book(path)
            if not book.chapters:
                raise ValueError("no readable chapters")
        except Exception as e:
            messagebox.showerror("tkreader", "Cannot open %s:\n%s" % (path, e))
            return
        self.remember_position()
        self.book, self.cache, self.plain = book, {}, {}
        self.history = []
        self.photo_cache = {}
        self.prefs["last"] = path
        self.prefs["recent"] = ([path] + [p for p in self.prefs["recent"] if p != path])[:10]
        self.update_recent_menu()
        self.root.title("tkreader - " + book.title)
        self.fill_toc()
        saved = self.state["books"].get(os.path.realpath(path), {})
        ci = saved.get("chapter", 0)
        ci = ci if isinstance(ci, int) and 0 <= ci < len(book.chapters) else 0
        pos = saved.get("pos") if isinstance(saved.get("pos"), str) else None
        self.render(ci, pos=pos, remember=False)

    def fill_toc(self):
        self.tree.delete(*self.tree.get_children())
        self.toc_items = {}
        parents = {}
        for i, (depth, title, path, frag) in enumerate(self.book.toc):
            parent = parents.get(depth - 1, "") if depth else ""
            iid = self.tree.insert(parent, "end", text=title or "(untitled)", open=depth < 1)
            parents[depth] = iid
            self.toc_items[iid] = (self.book.index[path], frag)

    def on_toc_click(self, e):
        """Open the contents entry that was clicked (or chosen with Return).

        Only real user actions navigate: selecting an entry from code (sync_toc)
        never does, so rendering cannot trigger itself through the tree."""
        if e.type == tk.EventType.ButtonRelease:
            if "indicator" in self.tree.identify_element(e.x, e.y):
                return
            iid = self.tree.identify_row(e.y)
            if iid:
                self.tree.selection_set(iid)
        else:
            sel = self.tree.selection()
            iid = sel[0] if sel else ""
        if iid in self.toc_items:
            ci, frag = self.toc_items[iid]
            self.goto(ci, frag, push=True)
            self.text.focus_set()

    def sync_toc(self):
        """Highlight the contents entry for the current chapter."""
        sel = self.tree.selection()
        if sel and self.toc_items.get(sel[0], (None,))[0] == self.ci:
            return
        for iid, (ci, frag) in self.toc_items.items():
            if ci == self.ci:
                self.tree.selection_set(iid)
                self.tree.see(iid)
                return

    def remember_position(self):
        if not self.book:
            return
        key = os.path.realpath(self.book.path)
        self.state["books"][key] = {"chapter": self.ci, "pos": self.text.index("@0,0")}

    def autosave(self):
        self.save()
        self.root.after(20000, self.autosave)

    def save(self):
        self.remember_position()
        if self.root.winfo_ismapped() and self.root.winfo_width() > 200:
            self.prefs["geometry"] = self.root.geometry().split("+")[0]
        self.state["prefs"] = self.prefs
        save_state(self.state)

    def quit(self):
        self.save()
        self.root.destroy()

    # ---- navigation -------------------------------------------------------

    def step(self, d):
        if self.book and 0 <= self.ci + d < len(self.book.chapters):
            self.goto(self.ci + d)

    def goto(self, ci, frag=None, push=False, end=False, pos=None):
        if not self.book:
            return
        if push:
            self.history.append((self.ci, self.text.index("@0,0")))
            del self.history[:-50]
        self.render(ci, frag=frag, pos=pos, end=end)

    def back(self):
        if self.history:
            ci, pos = self.history.pop()
            self.render(ci, pos=pos)

    def follow(self, idx):
        href = self.cur_links[idx] if idx < len(self.cur_links) else ""
        if not href:
            return
        if re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*:", href):
            if messagebox.askyesno("Open link", "Open this address in your browser?\n\n" + href,
                                   parent=self.root):
                webbrowser.open(href)
            return
        path, _, frag = href.partition("#")
        if path:
            target = Book.resolve(posixpath.dirname(self.book.chapters[self.ci]), path)
        else:
            target = self.book.chapters[self.ci]
        if target in self.book.index:
            self.goto(self.book.index[target], unquote(frag), push=True)
        else:
            self.status.set("Link target not found in this book: " + href)

    # ---- rendering --------------------------------------------------------

    def chapter(self, ci):
        if ci not in self.cache:
            data = self.book.read(self.book.chapters[ci])
            p = Extractor()
            if data is not None:
                p.feed(decode(data))
                p.flush()
            self.cache[ci] = (p.blocks, p.links)
        return self.cache[ci]

    def geometry(self):
        """Column width and the pixel padding that centres it."""
        t = self.text
        width = max(t.winfo_width(), 700)
        colw = min(width - 48, self.font().measure("n" * MEASURES.get(
            self.prefs["measure"], 70)))
        pad = max(24, (width - colw) // 2)
        return colw, pad, max(t.winfo_height(), 500)

    def rerender(self):
        if self.book:
            self.render(self.ci, pos=self.text.index("@0,0"), remember=False)

    def on_configure(self, e):
        if self._resize_job:
            self.root.after_cancel(self._resize_job)
        self._resize_job = self.root.after(250, self.resized)

    def resized(self):
        self._resize_job = None
        if not self.book:
            return
        colw, pad, height = self.geometry()
        if self._layout_key != (colw, pad, height // 80):
            self.rerender()

    def clear(self):
        t = self.text
        t.configure(state="normal")
        t.delete("1.0", "end")
        for w in self.widgets:
            try:
                w.destroy()
            except tk.TclError:
                pass
        self.widgets, self.photos = [], []
        self.win_math, self.img_alts = {}, {}
        for name in list(self.ftags):
            t.tag_delete(name)
        self.ftags = set()
        for tag in t.tag_names():
            if tag.startswith("l:"):
                t.tag_delete(tag)
        for m in t.mark_names():
            if m.startswith("a:"):
                t.mark_unset(m)
        self.mathfonts = MathFonts(self.math_family)

    def show_welcome(self):
        t = self.text
        self.clear()
        t.tag_configure("welcome", justify="center", font=self.font(1.4),
                        spacing1=120, foreground=self.theme["dim"])
        t.insert("end", "tkreader\n", "welcome")
        t.tag_configure("welcome2", justify="center", font=self.font(1.0),
                        spacing1=14, foreground=self.theme["dim"])
        t.insert("end", "File \u2192 Open... (Ctrl-O) to choose an EPUB", "welcome2")
        t.configure(state="disabled")

    def render(self, ci, frag=None, pos=None, end=False, remember=True):
        if remember and self.book and self.ci != ci:
            self.remember_position()
        started = time.time()
        self.ci = ci
        self.render_keys = []
        blocks, links = self.chapter(ci)
        self.cur_links = links
        t = self.text
        self.clear()
        colw, pad, height = self.geometry()
        self._layout_key = (colw, pad, height // 80)
        t.configure(padx=pad)
        px = self.px
        normal_gap, tight_gap = round(px * 0.75), round(px * 0.15)
        ch = self.font().measure("n")
        prev = None
        for b in blocks:
            k = b[0]
            if k == "anchor":
                name = "a:" + b[1]
                t.mark_set(name, "end-1c")
                t.mark_gravity(name, "left")
                continue
            gap = 0 if prev is None else (
                tight_gap if (k == prev and k in ("li", "row")) else normal_gap)
            if k == "hr":
                self.put_rule(colw, gap)
            elif k == "img":
                self.put_image(b[1], b[2], colw, height, gap)
            elif k == "math":
                self.put_math(b[1], colw, gap)
            else:
                self.put_block(b, gap, ch)
            prev = k
        t.tag_raise("hit")
        t.tag_raise("cur")
        t.tag_raise("link")
        t.tag_raise("sel")
        t.configure(state="disabled")
        title = self.book.chapter_title.get(self.book.chapters[ci], "")
        self.var_title.set("%s   \u2014   %s" % (self.book.title, title) if title
                           else self.book.title)
        self.sync_toc()
        self.root.update_idletasks()
        if end:
            t.yview_moveto(1.0)
        elif frag and "a:" + frag in t.mark_names():
            t.yview("a:" + frag)
        elif pos:
            try:
                t.yview(pos)
            except tk.TclError:
                t.yview_moveto(0)
        else:
            t.yview_moveto(0)
        self.on_yscroll(*t.yview())
        self.queue_images()
        dbg("render chapter %d: %d blocks, %.2fs" % (ci, len(blocks), time.time() - started))
        if self.find_frame.winfo_ismapped() and self.var_find.get():
            self.highlight()
        t.focus_set()

    def runs(self, text, scale, bold_base, mono):
        """Yield (string, tags) for text carrying style/link markers."""
        bold = ital = sup = sub = 0
        link = None
        for tok in MARK_RE.split(text):
            if not tok:
                continue
            c = tok[0]
            if c == "\x06":
                link = int(tok[1:-1])
            elif c == "\x08":
                link = None
            elif c == "\x01":
                bold += 1
            elif c == "\x02":
                bold = max(0, bold - 1)
            elif c == "\x03":
                ital += 1
            elif c == "\x04":
                ital = max(0, ital - 1)
            elif c == "\x10":
                sup += 1
            elif c == "\x11":
                sup = max(0, sup - 1)
            elif c == "\x12":
                sub += 1
            elif c == "\x13":
                sub = max(0, sub - 1)
            elif c == "\x05":
                yield "\xa0", self.run_tags(scale, bold or bold_base, ital, mono, sup, sub, link)
            else:
                cur = ""
                style = (False, False)
                for chn in tok:
                    base, mb, mi = demath(chn)
                    if (mb, mi) != style and cur:
                        yield cur, self.run_tags(scale, bold or bold_base or style[0],
                                                 ital or style[1], mono, sup, sub, link)
                        cur = ""
                    style = (mb, mi)
                    cur += base
                if cur:
                    yield cur, self.run_tags(scale, bold or bold_base or style[0],
                                             ital or style[1], mono, sup, sub, link)

    def run_tags(self, scale, bold, ital, mono, sup, sub, link):
        script = 1 if sup else (-1 if sub else 0)
        tags = [self.ftag(scale, bool(bold), bool(ital), mono, script)]
        if link is not None:
            name = "l:%d" % link
            if name not in self.ftags:
                self.text.tag_configure(name)
                self.text.tag_bind(name, "<Button-1>", lambda e, i=link: self.follow(i))
                self.ftags.add(name)
            tags += ["link", name]
        return tuple(tags)

    def put_block(self, b, gap, ch):
        _, text, indent, prefix, pre, align, heading = b
        t = self.text
        scale = HSCALE.get(heading, 1.0) if heading else 1.0
        sp1, sp3 = gap, 0
        if heading:
            sp1 = gap + round(self.px * 0.5 * scale) if gap else 0
            sp3 = round(self.px * 0.2)
        lm2 = round(indent * ch * 0.8)
        lm1, tabs = lm2, None
        if prefix:
            lm1 = max(0, lm2 - round(self.font().measure(prefix + " ")))
            tabs = lm2
            text = prefix + "\t" + text
        if pre:
            lm1 = lm2 = lm2 + round(self.px * 0.6)
        ptag = self.ptag(lm1, lm2, "center" if align == "center" else "left", sp1, sp3,
                         tabs, self.theme["code"] if pre else None)
        start = t.index("end-1c")
        segs = text.split("\n")
        while segs and not STRIP_RE.sub("", segs[-1]).strip():
            segs.pop()
        for i, seg in enumerate(segs):
            if i:
                t.insert("end", "\n")
            if pre:
                seg = seg.expandtabs(4)
            for s, tags in self.runs(seg, scale, bool(heading), bool(pre)):
                t.insert("end", s, tags)
        t.insert("end", "\n")
        t.tag_add(ptag, start, "end-1c")

    def put_rule(self, colw, gap):
        t = self.text
        start = t.index("end-1c")
        fr = tk.Frame(t, height=1, width=round(colw * 0.5), bg=self.theme["rule"])
        self.widgets.append(fr)
        t.window_create("end", window=fr)
        t.insert("end", "\n")
        t.tag_add(self.ptag(0, 0, "center", gap + round(self.px * 0.3), round(self.px * 0.3)),
                  start, "end-1c")

    def forward_wheel(self, w):
        def wheel(e):
            d = e.delta
            n = -d if abs(d) < 120 else -d // 120
            self.text.yview_scroll(n, "units")
            return "break"
        w.bind("<MouseWheel>", wheel)
        w.bind("<Button-4>", lambda e: self.text.yview_scroll(-3, "units"))
        w.bind("<Button-5>", lambda e: self.text.yview_scroll(3, "units"))
        w.bind("<Button-1>", lambda e: self.text.focus_set())

    def put_image(self, src, alt, colw, height, gap):
        t = self.text
        path = Book.resolve(posixpath.dirname(self.book.chapters[self.ci]), src)
        entry = self.image_entry(path, colw, round(height * 0.9))
        start = t.index("end-1c")
        ptag = self.ptag(0, 0, "center", gap, 0)
        if entry:
            t.image_create("end", image=entry["img"])
            self.img_alts[str(entry["img"])] = alt or posixpath.basename(path)
        else:
            label = alt or posixpath.basename(path)
            t.insert("end", "[Image: %s]" % label, (self.ftag(0.9, False, True, False), "dim"))
        t.insert("end", "\n")
        t.tag_add(ptag, start, "end-1c")

    def image_entry(self, path, maxw, maxh):
        """A cache entry {img, ready, ...} for the image scaled to fit, or None.

        Big images are not decoded here: a blank image of the final size is
        shown at once and filled in later, one image per idle tick, so a
        chapter full of large figures never freezes the window."""
        key = (path, maxw, maxh)
        if key in self.photo_cache:
            e = self.photo_cache[key]
            if e and not e["ready"]:
                self.render_keys.append(key)
            return e
        e = None
        data = self.book.read(path)
        if data:
            size = image_size(data)
            if size is None or (len(data) < 120000 and size[0] * size[1] < 2_000_000):
                img = self.make_scaled(data, maxw, maxh)
                e = {"img": img, "ready": True} if img is not None else None
            else:
                w, h = size
                f = min(1.0, maxw / max(w, 1), maxh / max(h, 1))
                if f >= 0.995:
                    dw, dh, s = w, h, 1
                elif shutil.which("sips"):
                    dw, dh, s = max(1, round(w * f)), max(1, round(h * f)), 0
                else:
                    s = math.ceil(1 / f)
                    dw, dh = math.ceil(w / s), math.ceil(h / s)
                e = {"img": tk.PhotoImage(width=dw, height=dh), "ready": False,
                     "path": path, "w": dw, "sub": s}
                self.render_keys.append(key)
        self.photo_cache[key] = e
        return e

    def make_scaled(self, data, maxw, maxh):
        """Decode and shrink a small image synchronously."""
        img = self.make_photo(data)
        if img is None:
            return None
        w, h = img.width(), img.height()
        f = min(1.0, maxw / max(w, 1), maxh / max(h, 1))
        if f < 0.995:
            z, s = scale_ratio(f)
            if z > 1 and w * z * h * z > 4_000_000:
                z, s = 1, math.ceil(1 / f)
            big = img.zoom(z) if z > 1 else img
            img = big.subsample(s) if s > 1 else big
        return img

    def queue_images(self):
        new = self.render_keys
        self.img_queue = new + [k for k in self.img_queue if k not in new]
        if self.img_queue and not self.img_job:
            self.img_job = self.root.after(20, self.img_step)

    def img_step(self):
        self.img_job = None
        while self.img_queue:
            key = self.img_queue.pop(0)
            e = self.photo_cache.get(key)
            if not e or e["ready"]:
                continue
            started = time.time()
            try:
                self.fill_image(e)
            except Exception as ex:
                dbg("image %s failed: %r" % (e["path"], ex))
            e["ready"] = True
            dbg("image %s: %.2fs" % (e["path"], time.time() - started))
            break
        if self.img_queue:
            self.img_job = self.root.after(15, self.img_step)

    def fill_image(self, e):
        data = self.book.read(e["path"])
        dst, call = e["img"], self.root.tk.call
        png = sips_scale(data, e["w"]) if e["sub"] == 0 else None
        if png:
            real = tk.PhotoImage(data=base64.b64encode(png))
            call(str(dst), "copy", str(real), "-shrink")
            return
        full = self.make_photo(data)
        if full is None:
            return
        s = e["sub"] or max(1, math.ceil(full.width() / e["w"]))
        call(str(dst), "copy", str(full), "-subsample", s, s, "-shrink")

    def make_photo(self, data):
        try:
            return tk.PhotoImage(data=base64.b64encode(data))
        except tk.TclError:
            pass
        if b"<svg" in data[:4000]:
            try:
                return tk.PhotoImage(data=data.decode("utf-8", "replace"), format="svg")
            except tk.TclError:
                pass
        png = to_png(data)
        if png:
            try:
                return tk.PhotoImage(data=base64.b64encode(png))
            except tk.TclError:
                pass
        return None

    def put_math(self, root, colw, gap):
        t = self.text
        start = t.index("end-1c")
        ptag = self.ptag(0, 0, "center", gap + round(self.px * 0.15), round(self.px * 0.15))
        th = self.theme
        try:
            box = build_math(root, self.mathfonts, self.px, th["fg"], colw)
            padx, pady = 6, 4
            cv = tk.Canvas(t, width=math.ceil(box.w) + 2 * padx,
                           height=math.ceil(box.asc + box.desc) + 2 * pady,
                           bg=th["bg"], highlightthickness=0, borderwidth=0)
            box.draw(cv, padx, pady + box.asc)
            self.widgets.append(cv)
            self.win_math[str(cv)] = root
            self.forward_wheel(cv)
            t.window_create("end", window=cv, align="center")
        except Exception:
            try:
                lines = trim_lines(render(root, Ctx(linear=False)).lines)
            except Exception:
                lines = [tex_fallback(root)]
            for i, line in enumerate(lines):
                if i:
                    t.insert("end", "\n")
                for s, tags in self.runs(line, 1.0, False, True):
                    t.insert("end", s, tags)
        t.insert("end", "\n")
        t.tag_add(ptag, start, "end-1c")

    # ---- searching --------------------------------------------------------

    def show_find(self):
        if not self.book:
            return
        if not self.find_frame.winfo_ismapped():
            self.find_frame.pack(side="bottom", fill="x", before=self.main)
        self.find_entry.focus_set()
        self.find_entry.selection_range(0, "end")
        self.highlight()

    def hide_find(self):
        if self.find_frame.winfo_ismapped():
            self.find_frame.pack_forget()
        self.text.tag_remove("hit", "1.0", "end")
        self.text.tag_remove("cur", "1.0", "end")
        self.find_count.configure(text="")
        self.text.focus_set()

    def schedule_find(self):
        if self._find_job:
            self.root.after_cancel(self._find_job)
        self._find_job = self.root.after(180, self.find_changed)

    def find_changed(self):
        self._find_job = None
        self.highlight()
        if self.nhits:
            hit = self.search_here(self.text.index("@0,0"), True) or self.search_here("1.0", True)
            if hit:
                self.show_hit(*hit)

    def highlight(self):
        t = self.text
        t.tag_remove("hit", "1.0", "end")
        t.tag_remove("cur", "1.0", "end")
        self.nhits = 0
        q = self.var_find.get()
        if not q or not self.book:
            self.find_count.configure(text="")
            return
        cnt, idx = tk.IntVar(), "1.0"
        while self.nhits < 5000:
            idx = t.search(q, idx, "end", nocase=not self.var_case.get(), count=cnt)
            if not idx or not cnt.get():
                break
            end = "%s+%dc" % (idx, cnt.get())
            t.tag_add("hit", idx, end)
            idx = end
            self.nhits += 1
        self.find_count.configure(
            text="%s in this chapter" % (("%d match%s" % (self.nhits, "" if self.nhits == 1
                                                          else "es")) if self.nhits else "no match"))

    @staticmethod
    def norm(s):
        return " ".join(STRIP_RE.sub("", s).replace("\xa0", " ").lower().split())

    def chapter_plain(self, ci):
        if ci not in self.plain:
            blocks, _ = self.chapter(ci)
            self.plain[ci] = self.norm(" ".join(
                b[1] for b in blocks if b[0] in ("p", "li", "row")))
        return self.plain[ci]

    def show_hit(self, idx, n):
        t = self.text
        t.tag_remove("cur", "1.0", "end")
        t.tag_add("cur", idx, "%s+%dc" % (idx, n))
        t.see(idx)
        t.mark_set("insert", idx)

    def search_here(self, start, forward):
        cnt = tk.IntVar()
        idx = self.text.search(self.var_find.get(), start, "end" if forward else "1.0",
                               backwards=not forward, nocase=not self.var_case.get(),
                               count=cnt)
        return (idx, cnt.get()) if idx and cnt.get() else None

    def find_next(self, forward=True):
        q = self.var_find.get()
        if not q or not self.book:
            return
        t = self.text
        if t.tag_ranges("cur"):
            start = t.index("cur.last") if forward else t.index("cur.first")
        else:
            start = t.index("@0,0") if forward else t.index("@0,%d" % t.winfo_height())
        hit = self.search_here(start, forward)
        if hit:
            self.show_hit(*hit)
            return
        qn = self.norm(q)
        n = len(self.book.chapters)
        for step in range(1, n + 1):
            ci = (self.ci + (step if forward else -step)) % n
            if qn and qn not in self.chapter_plain(ci):
                continue
            self.render(ci)
            self.highlight()
            hit = self.search_here("1.0" if forward else "end", forward)
            if hit:
                self.show_hit(*hit)
                return
        self.find_count.configure(text="not found")


