class App:
    def __init__(self, root, path=None):
        self.root = root
        root.title("tkgenome")
        try:
            self._icon = tk.PhotoImage(data=ICON_PNG)
            root.iconphoto(True, self._icon)
        except tk.TclError:
            pass
        try:        # macOS: files opened via the app bundle / Finder
            root.createcommand("::tk::mac::OpenDocument",
                               lambda *files: self.load(files[0]))
        except tk.TclError:
            pass
        root.geometry("1380x860")
        self.records = []
        self.scope = None
        self.vis_feats = []
        self.sel = []
        self.primary = None
        self.mark = None
        self.sort_col = None
        self.sort_rev = False
        self.circle = None
        self.strip = None
        self._syncing = False
        self._loading = False
        self._search_job = None

        self.show_plus = tk.BooleanVar(value=True)
        self.show_minus = tk.BooleanVar(value=True)
        self.show_gc = tk.BooleanVar(value=True)
        self.show_skew = tk.BooleanVar(value=True)
        self.show_legend = tk.BooleanVar(value=True)
        self.color_var = tk.StringVar(value=list(MODES)[0])

        self.build_menu()
        self.build_toolbars()

        self.status = tk.StringVar(value="Open a GenBank file (Ctrl-O).")
        ttk.Label(root, textvariable=self.status, anchor="w", padding=(6, 3),
                  relief="sunken").pack(side="bottom", fill="x")

        pw = tk.PanedWindow(root, orient="horizontal", sashrelief="raised",
                            sashwidth=6)
        pw.pack(fill="both", expand=True)

        lp = tk.PanedWindow(pw, orient="vertical", sashrelief="raised",
                            sashwidth=6)
        pw.add(lp, minsize=320, stretch="always")
        self.canvas = tk.Canvas(lp, bg="white", highlightthickness=0,
                                width=640, height=560)
        lp.add(self.canvas, minsize=220, stretch="always")
        self.strip_c = tk.Canvas(lp, bg="#fafafa", highlightthickness=0,
                                 width=640, height=STRIP_H)
        lp.add(self.strip_c, minsize=110, height=STRIP_H, stretch="never")

        rp = tk.PanedWindow(pw, orient="vertical", sashrelief="raised",
                            sashwidth=6)
        pw.add(rp, minsize=320, stretch="always")
        rp.add(self.build_table(rp), minsize=120, stretch="always")
        rp.add(self.build_seqpane(rp), minsize=100, height=250,
               stretch="never")

        self.circle = CircleView(self, self.canvas)
        self.strip = StripView(self, self.strip_c)
        self.update_ring_states()
        self.circle.draw()

        if path:
            root.after(50, lambda: self.load(path))

    # -- widgets -----------------------------------------------------

    def build_menu(self):
        root = self.root
        mb = tk.Menu(root)
        fm = tk.Menu(mb, tearoff=0)
        fm.add_command(label="Open...", accelerator="Ctrl-O",
                       command=self.open_dialog)
        fm.add_separator()
        fm.add_command(label="Export figure (SVG, vector)...", command=self.export_svg)
        fm.add_command(label="Export map as PostScript...",
                       command=self.export_ps)
        fm.add_command(label="Export table as TSV...", command=self.export_tsv)
        fm.add_separator()
        fm.add_command(label="Quit", accelerator="Ctrl-Q",
                       command=root.destroy)
        mb.add_cascade(label="File", menu=fm)
        vm = tk.Menu(mb, tearoff=0)
        vm.add_command(label="Zoom in", command=lambda: self.circle.zoom_by(1.4))
        vm.add_command(label="Zoom out",
                       command=lambda: self.circle.zoom_by(1 / 1.4))
        vm.add_command(label="Reset view", command=self.reset_views)
        vm.add_separator()
        vm.add_command(label="Rotate selection to top",
                       command=self.rotate_to_top)
        vm.add_command(label="Reset rotation", command=self.reset_rotation)
        mb.add_cascade(label="View", menu=vm)
        root.config(menu=mb)
        for seq in ("<Control-o>", "<Command-o>"):
            root.bind(seq, lambda e: self.open_dialog())
        for seq in ("<Control-q>", "<Command-q>"):
            root.bind(seq, lambda e: root.destroy())

