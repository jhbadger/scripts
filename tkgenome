def func_class(f):
    if f.cls is None:
        idx = len(FUNC_CLASSES) - 1
        if f.type in RNA_TYPES:
            idx = 0
        elif f.pseudo:
            idx = 1
        else:
            for i in range(2, len(FUNC_CLASSES) - 1):
                if FUNC_CLASSES[i][2].search(f.ann):
                    idx = i
                    break
        f.cls = idx
    return f.cls


def col_type_strand(f):
    c = COL_TYPE.get(f.type)
    if c is None:
        return COL_OTHER
    return c[0] if f.strand > 0 else c[1]


def col_strand(f):
    return "#2f6fd0" if f.strand > 0 else "#e8892b"


def col_func(f):
    return FUNC_CLASSES[func_class(f)][1]


def col_pseudo(f):
    if f.type in RNA_TYPES:
        return "#2e9e48"
    if f.pseudo:
        return "#8d6e63"
    if f.type == "CDS":
        return "#9e9e9e" if func_class(f) == len(FUNC_CLASSES) - 2 \
            else "#2f6fd0"
    return COL_OTHER


