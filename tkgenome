    def build_table(self, parent):
        fr = ttk.Frame(parent)
        self.tree = ttk.Treeview(fr, columns=[c[0] for c in COLUMNS],
                                 show="headings", selectmode="extended")
        for key, title, width, anchor in COLUMNS:
            self.tree.heading(key, text=title,
                              command=lambda k=key: self.sort_by(k))
            self.tree.column(key, width=width, anchor=anchor,
                             stretch=(key == "ann"))
        ys = ttk.Scrollbar(fr, orient="vertical", command=self.tree.yview)
        xs = ttk.Scrollbar(fr, orient="horizontal", command=self.tree.xview)
        self.tree.configure(yscrollcommand=ys.set, xscrollcommand=xs.set)
        self.tree.grid(row=0, column=0, sticky="nsew")
        ys.grid(row=0, column=1, sticky="ns")
        xs.grid(row=1, column=0, sticky="ew")
        fr.rowconfigure(0, weight=1)
        fr.columnconfigure(0, weight=1)
        self.tree.bind("<<TreeviewSelect>>", self.on_tree_select)
        return fr

    def build_seqpane(self, parent):
        fr = ttk.Frame(parent)
        head = ttk.Frame(fr)
        head.pack(fill="x")
        self.seq_label = ttk.Label(head, text="Selected feature(s)")
        self.seq_label.pack(side="left", padx=4)
        ttk.Button(head, text="Save...", command=self.save_seq).pack(
            side="right", padx=2)
        ttk.Button(head, text="Copy", command=self.copy_seq).pack(
            side="right", padx=2)
        self.nb = ttk.Notebook(fr)
        self.nb.pack(fill="both", expand=True)
        self.texts = []
        for name in ("Nucleotide", "Protein", "Qualifiers"):
            tab = ttk.Frame(self.nb)
            t = tk.Text(tab, wrap="char", height=8, state="disabled",
                        font=("Courier", 10))
            sb = ttk.Scrollbar(tab, command=t.yview)
            t.configure(yscrollcommand=sb.set)
            t.grid(row=0, column=0, sticky="nsew")
            sb.grid(row=0, column=1, sticky="ns")
            tab.rowconfigure(0, weight=1)
            tab.columnconfigure(0, weight=1)
            self.nb.add(tab, text=name)
            self.texts.append(t)
        return fr

    # -- colour / legend ---------------------------------------------

    def feat_color(self, f):
        return MODES[self.color_var.get()][0](f)

    def legend_entries(self):
        return MODES[self.color_var.get()][1]

    # -- loading -----------------------------------------------------

    def open_dialog(self):
        path = filedialog.askopenfilename(
            title="Open GenBank file",
            filetypes=[("GenBank", "*.gb *.gbk *.gbff *.genbank *.gz"),
                       ("All files", "*")])
        if path:
            self.load(path)

    def load(self, path):
        try:
            records = [r for r in parse_genbank(path) if r.length]
        except Exception as e:
            messagebox.showerror("tkgenome", "Could not read %s:\n%s"
                                 % (path, e))
            return
        if not records:
            messagebox.showerror("tkgenome",
                                 "No GenBank records found in " + path)
            return
        self.records = records
        if len(records) > 1:
            names = ["All records (%d)" % len(records)] + [
                "%s  %s (%s bp)" % (r.name, r.definition[:40],
                                    format(r.length, ",")) for r in records]
            self.rec_box.configure(values=names)
            self.rec_var.set(names[0])
            self.rec_box.grid()
        else:
            self.rec_box.grid_remove()
        self.root.title("tkgenome - " + path.replace("\\", "/").rsplit("/", 1)[-1])
        self.set_scope(records)

    def pick_record(self, _e=None):
        i = self.rec_box.current()
        if i == 0:
            self.set_scope(self.records)
        elif i > 0:
            self.set_scope([self.records[i - 1]])

    def set_scope(self, recs):
        self.scope = Scope(recs)
        self.sel, self.primary, self.mark = [], None, None
        self.circle.reset_all()
        self.strip.reset()
        types = sorted({f.type for f in self.scope.features
                        if f.type != "source"})
        self._loading = True
        if self._search_job:
            self.root.after_cancel(self._search_job)
            self._search_job = None
        self.type_box.configure(values=[FILTER_DEFAULT, FILTER_ALL] + types)
        self.type_var.set(FILTER_DEFAULT)
        self.search_var.set("")
        self._loading = False
        cols = [c[0] for c in COLUMNS]
        if len(recs) == 1:
            cols.remove("rec")
        self.tree.configure(displaycolumns=cols)
        self.update_ring_states()
        self.refresh()

    def update_ring_states(self):
        has = bool(self.scope and self.scope.seq)
        for cb in (self.cb_gc, self.cb_skew):
            cb.configure(state="normal" if has else "disabled")

    # -- table / filtering -------------------------------------------

    def search_changed(self, *_):
        if self._loading:
            return
        if self._search_job:
            self.root.after_cancel(self._search_job)
        self._search_job = self.root.after(250, self.refresh)

    def show_help(self):
        messagebox.showinfo("Filter syntax", __doc__.split(
            "Filter box syntax", 1)[1].split("\n", 1)[1].strip("\n"))

    def refresh(self):
        self._search_job = None
        sc = self.scope
        if sc is None:
            return
        want = self.type_var.get()
        feats = sc.features

        def keep(f):
            if f.type == "source":
                return False
            if want == FILTER_DEFAULT:
                return f.type != "gene"
            if want == FILTER_ALL:
                return True
            return f.type == want

        vis = [f for f in feats if keep(f)]
        if want == FILTER_DEFAULT and not vis:
            vis = [f for f in feats if f.type != "source"]
        q = self.search_var.get().strip()
        if q:
            pred = parse_query(q)
            vis = [f for f in vis if pred(f)]
        self.vis_feats = vis
        self.assign_lanes()

        multi = len(sc.records) > 1
        self._syncing = True
        try:
            self.tree.delete(*self.tree.get_children())
            for f in vis:
                self.tree.insert("", "end", iid=str(f.idx), values=(
                    f.id, f.rec.name if multi else "", f.type, f.start, f.end,
                    f.length, "+" if f.strand > 0 else "-", f.ann))
            if self.sort_col:
                self.sort_by(self.sort_col, toggle=False)
            have = set(self.tree.get_children())
            self.sel = [i for i in self.sel if str(i) in have]
            if self.primary not in self.sel:
                self.primary = self.sel[-1] if self.sel else None
            self.tree.selection_set([str(i) for i in self.sel])
        finally:
            self._syncing = False
        self.update_status()
        self.update_seq()
        self.redraw_all()

    def assign_lanes(self):
        L = self.scope.length
        for strand in (1, -1):
            ends = [-1e18, -1e18, -1e18]
            fs = sorted((f for f in self.vis_feats if f.strand == strand),
                        key=lambda f: f.gmin)
            for f in fs:
                if len(f.gsegs) > 1 and f.gmax - f.gmin > L / 2:
                    f.lane = 0
                    continue
                lane = 2
                for i in range(3):
                    if ends[i] < f.gmin:
                        lane = i
                        break
                ends[lane] = max(ends[lane], f.gmax)
                f.lane = lane

    def sort_by(self, col, toggle=True):
        if toggle:
            self.sort_rev = (self.sort_col == col) and not self.sort_rev
        self.sort_col = col
        items = []
        for iid in self.tree.get_children():
            v = self.tree.set(iid, col)
            items.append((int(v) if col in NUMERIC else v.lower(),
                          int(iid), iid))
        items.sort(reverse=self.sort_rev)
        for pos, (_, _, iid) in enumerate(items):
            self.tree.move(iid, "", pos)

    # -- selection ---------------------------------------------------

    def on_tree_select(self, _e=None):
        if self._syncing:
            return
        ids = [int(i) for i in self.tree.selection()]
        foc = self.tree.focus()
        prim = int(foc) if foc and int(foc) in ids else \
            (ids[-1] if ids else None)
        self.set_selection(ids, prim, source="tree")

    def click_feature(self, idx, add, source="circle"):
        if idx is None:
            if not add:
                self.set_selection([], None, source)
            return
        if add:
            ids = list(self.sel)
            if idx in ids:
                ids.remove(idx)
            else:
                ids.append(idx)
            prim = idx if idx in ids else (ids[-1] if ids else None)
        else:
            ids, prim = [idx], idx
        self.set_selection(ids, prim, source)

    def set_selection(self, ids, primary, source="app"):
        self.sel, self.primary = list(ids), primary
        if source != "tree":
            self._syncing = True
            try:
                self.tree.selection_set([str(i) for i in ids
                                         if self.tree.exists(str(i))])
                if primary is not None and self.tree.exists(str(primary)):
                    self.tree.focus(str(primary))
                    self.tree.see(str(primary))
            finally:
                self._syncing = False
        self.circle.draw_highlight()
        if primary is not None and source != "strip":
            self.center_strip(self.scope.features[primary])
        else:
            self.strip.schedule()
        self.update_status()
        self.update_seq()

    def center_strip(self, f, fit=False):
        s, e = f.gsegs[0]
        if len(f.gsegs) > 1 and f.gmax - f.gmin <= self.scope.length / 2:
            s, e = f.gmin, f.gmax
        ext = e - s + 1
        cur = self.strip.w1 - self.strip.w0
        wd = max(ext * 1.6, 500.0) if fit else max(cur, ext * 1.6)
        mid = (s + e) / 2.0
        self.strip.set_window(mid - wd / 2, mid + wd / 2)

    def update_status(self):
        sc = self.scope
        if sc is None:
            return
        if self.primary is None:
            self.status.set("%d features shown   (%s)" % (
                len(self.vis_feats), fmt_bp(sc.length)))
            return
        f = sc.features[self.primary]
        q = f.qual
        bits = ["%s %s" % (f.type, f.id), f.loc[:160], fmt_bp(f.length)]
        if q.get("gene"):
            bits.append("gene " + q["gene"])
        if f.ann:
            bits.append(f.ann)
        if len(self.sel) > 1:
            bits.append("%d selected" % len(self.sel))
        self.status.set("  |  ".join(bits))

    def show_tip(self, c, x, y, idx):
        f = self.scope.features[idx]
        head = "%s  [%s]  %d..%d (%s)  %s" % (
            f.id, f.type, f.start, f.end, "+" if f.strand > 0 else "-",
            fmt_bp(f.length))
        lines = [head]
        if len(self.scope.records) > 1:
            lines.append("record " + f.rec.name)
        if f.qual.get("gene"):
            lines.append("gene " + f.qual["gene"])
        if f.ann:
            lines.append(f.ann[:100])
        t = c.create_text(x + 14, y + 14, text="\n".join(lines), anchor="nw",
                          font=("Helvetica", 9), fill="#000000", tags="tip")
        bx = c.bbox(t)
        dx = min(0, c.winfo_width() - bx[2] - 4)
        dy = min(0, c.winfo_height() - bx[3] - 4)
        if dx or dy:
            c.move(t, dx, dy)
            bx = c.bbox(t)
        r = c.create_rectangle(bx[0] - 3, bx[1] - 2, bx[2] + 3, bx[3] + 2,
                               fill="#ffffe0", outline="#888888", tags="tip")
        c.tag_lower(r, t)

    # -- redraw ------------------------------------------------------

    def redraw_map(self):
        self.circle.schedule()

    def redraw_all(self):
        self.circle.schedule()
        self.strip.schedule()

    def reset_views(self):
        self.circle.reset_view()
        self.strip.reset()

    def rotate_to_top(self):
        sc = self.scope
        if sc is None:
            return
        if self.primary is not None:
            s, e = sc.features[self.primary].gsegs[0]
            pos = (s + e) / 2.0
        elif self.mark is not None:
            pos = self.mark
        else:
            return
        self.circle.rot = pos % sc.length
        self.circle.schedule()

    def reset_rotation(self):
        self.circle.rot = 0.0
        self.circle.schedule()

    # -- go to -------------------------------------------------------

    def goto(self):
        sc = self.scope
        t = self.goto_var.get().strip()
        if sc is None or not t:
            return
        num = r"(\d+(?:\.\d+)?)\s*([kKmM]?)"
        m = re.fullmatch(num + r"(?:\s*(?:\.\.|-|:)\s*" + num + ")?",
                         t.replace(",", ""))
        if m:
            def val(a, u):
                return float(a) * {"": 1, "k": 1e3, "m": 1e6}[u.lower()]
            a = val(m.group(1), m.group(2))
            b = val(m.group(3), m.group(4)) if m.group(3) else None
            self.mark = min(max(a, 0), sc.length)
            if b is None:
                cur = self.strip.w1 - self.strip.w0
                self.strip.set_window(a - cur / 2, a + cur / 2)
            else:
                pad = max(100.0, abs(b - a) * 0.1)
                self.strip.set_window(min(a, b) - pad, max(a, b) + pad)
            self.circle.schedule()
            self.strip.schedule()
            self.status.set("position %s" % format(int(a), ","))
            return
        low = t.lower()
        hit = None
        for f in sc.features:
            if f.type == "source":
                continue
            if low in (f.id.lower(), qget(f, "gene").lower(),
                       qget(f, "locus_tag").lower(),
                       qget(f, "old_locus_tag").lower()):
                hit = f
                break
        if hit is None:
            for f in sc.features:
                if f.type != "source" and low in f.hay:
                    hit = f
                    break
        if hit is None:
            self.status.set("Not found: " + t)
            return
        if hit not in self.vis_feats:
            self.type_var.set(FILTER_ALL)
            self.search_var.set("")
            self.refresh()
        self.set_selection([hit.idx], hit.idx)
        self.center_strip(hit, fit=True)

    # -- sequence pane -----------------------------------------------

    def seq_texts(self):
        sc = self.scope
        feats = [sc.features[i] for i in self.sel[:MAX_SEQ_FEATURES]] \
            if sc else []
        nt, prot = [], []
        for f in feats:
            head = "%s %s %s:%d..%d(%s)" % (f.id, f.type, f.rec.name, f.start,
                                            f.end, "+" if f.strand > 0 else "-")
            s = nt_of(f)
            nt.append(">%s %s\n%s" % (head, f.ann, wrap(s.upper()))
                      if s else ">%s\n(no sequence in file)" % head)
            pr = protein_of(f)
            if pr:
                aa, computed = pr
                prot.append(">%s %s [%d aa]%s\n%s" % (
                    f.id, f.ann, len(aa), " (computed)" if computed else "",
                    wrap(aa)))
        qual = ""
        if feats:
            f = sc.features[self.primary] if self.primary is not None \
                else feats[-1]
            qual = "%s  %s\n\n" % (f.type, f.loc)
            for name, val in f.quals:
                qual += textwrap.fill(
                    "/%s=%s" % (name, val) if val else "/" + name, 90,
                    subsequent_indent="    ") + "\n"
        note = ("\n(showing first %d of %d)" % (MAX_SEQ_FEATURES, len(self.sel))
                if len(self.sel) > MAX_SEQ_FEATURES else "")
        return (("\n".join(nt) + note if nt else
                 "Select a feature to see its sequence."),
                ("\n".join(prot) + note if prot else
                 "No protein-coding feature selected."),
                qual or "Select a feature to see its qualifiers.")

    def update_seq(self):
        for t, s in zip(self.texts, self.seq_texts()):
            t.configure(state="normal")
            t.delete("1.0", "end")
            t.insert("1.0", s)
            t.configure(state="disabled")
        n = len(self.sel)
        self.seq_label.configure(
            text="%d feature%s selected" % (n, "" if n == 1 else "s"))

    def current_seq_text(self):
        t = self.texts[self.nb.index(self.nb.select())]
        return t.get("1.0", "end").rstrip("\n")

    def copy_seq(self):
        self.root.clipboard_clear()
        self.root.clipboard_append(self.current_seq_text())

    def save_seq(self):
        path = filedialog.asksaveasfilename(
            defaultextension=".fasta", title="Save sequence",
            filetypes=[("FASTA", "*.fasta *.fa"), ("Text", "*.txt"),
                       ("All files", "*")])
        if path:
            self.write(path, self.current_seq_text() + "\n")

    # -- exports -----------------------------------------------------

    def write(self, path, text):
        try:
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(text)
        except OSError as e:
            messagebox.showerror("tkgenome", "Could not write %s:\n%s"
                                 % (path, e))

    def export_svg(self):
        if self.scope is None:
            return
        path = filedialog.asksaveasfilename(
            defaultextension=".svg", title="Export figure as SVG",
            filetypes=[("SVG", "*.svg")])
        if not path:
            return
        p = SVGPainter(1000, 1000)
        g = Geo(self.scope, 500, 500, 380, self.circle.rot)
        render_circle(p, self, g)
        render_highlight(p, self, g)
        if self.show_legend.get():
            render_legend(p, self, 14, 20)
        self.write(path, p.svg())

    def export_ps(self):
        if self.scope is None:
            return
        path = filedialog.asksaveasfilename(
            defaultextension=".ps", title="Export map as PostScript",
            filetypes=[("PostScript", "*.ps")])
        if path:
            try:
                self.canvas.postscript(file=path, colormode="color")
            except tk.TclError as e:
                messagebox.showerror("tkgenome", str(e))

    def export_tsv(self):
        if self.scope is None:
            return
        path = filedialog.asksaveasfilename(
            defaultextension=".tsv", title="Export table as TSV",
            filetypes=[("TSV", "*.tsv"), ("All files", "*")])
        if not path:
            return
        rows = ["record\tid\ttype\tstart\tend\tstrand\tlength\tannotation"]
        for iid in self.tree.get_children():
            f = self.scope.features[int(iid)]
            rows.append("\t".join(str(x) for x in (
                f.rec.name, f.id, f.type, f.start, f.end,
                "+" if f.strand > 0 else "-", f.length, f.ann)))
        self.write(path, "\n".join(rows) + "\n")


def main():
    root = tk.Tk()
    App(root, sys.argv[1] if len(sys.argv) > 1 else None)
    root.mainloop()


if __name__ == "__main__":
    main()
