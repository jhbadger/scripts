# ------------------------------------------------------- filter-box query

CMP_RE = re.compile(r"^(len|start|end)(>=|<=|>|<|=)(\d+)$", re.I)
OPS = {">": lambda a, b: a > b, "<": lambda a, b: a < b,
       ">=": lambda a, b: a >= b, "<=": lambda a, b: a <= b,
       "=": lambda a, b: a == b}


def qget(f, col):
    v = f.qual.get(col)
    if v is None:
        for k, val in f.qual.items():
            if k.lower() == col:
                return val
        return ""
    return v


def parse_query(text):
    """Return a predicate f -> bool for the filter-box syntax."""
    try:
        toks = shlex.split(text)
    except ValueError:
        toks = text.split()
    preds = []
    for t in toks:
        neg = t.startswith("!") and len(t) > 1
        if neg:
            t = t[1:]
        m = CMP_RE.match(t)
        if m:
            key, op, val = m.group(1).lower(), OPS[m.group(2)], int(m.group(3))
            attr = {"len": "length", "start": "start", "end": "end"}[key]
            fn = (lambda f, a=attr, o=op, v=val: o(getattr(f, a), v))
        elif ":" in t:
            col, _, val = t.partition(":")
            col, val = col.lower(), val.lower()
            if col == "type":
                fn = (lambda f, v=val: f.type.lower() == v)
            elif col == "strand":
                want = 1 if val in ("+", "plus", "fwd", "1") else -1
                fn = (lambda f, w=want: f.strand == w)
            elif col == "id":
                fn = (lambda f, v=val: v in f.id.lower())
            elif col == "rec":
                fn = (lambda f, v=val: v in f.rec.name.lower())
            elif col in ("ann", "annotation"):
                fn = (lambda f, v=val: v in f.ann.lower())
            else:
                fn = (lambda f, c=col, v=val: v in qget(f, c).lower())
        else:
            low = t.lower()
            fn = (lambda f, v=low: v in f.hay)
        preds.append((neg, fn))
    return lambda f: all(fn(f) != neg for neg, fn in preds)


# ----------------------------------------------------------- number format

def fmt_bp(n):
    n = float(n)
    if n >= 1e6:
        return "%.2f Mb" % (n / 1e6)
    if n >= 1e3:
        return "%.1f kb" % (n / 1e3)
    return "%d bp" % n


def nice_step(raw):
    raw = max(raw, 1.0)
    mag = 10 ** math.floor(math.log10(raw))
    for m in (1, 2, 5, 10):
        if m * mag >= raw:
            return m * mag


def fmt_tick(pos, step):
    if pos == 0:
        return "0"
    if step >= 1e6:
        u, name = 1e6, "Mb"
    elif step >= 1e3:
        u, name = 1e3, "kb"
    else:
        return "%d" % pos
    dec = max(0, int(math.ceil(-math.log10(step / u) - 1e-9)))
    return "%.*f %s" % (dec, pos / u, name)


# ---------------------------------------------------------------- painters

class Painter:
    """Draws on a Tk canvas.  Angles are degrees clockwise from the top."""

    def __init__(self, canvas):
        self.c = canvas

    def arc(self, cx, cy, r, a0, a1, color, width, tags=("map",)):
        self.c.create_arc(cx - r, cy - r, cx + r, cy + r, start=90 - a0,
                          extent=-(a1 - a0), style="arc", outline=color,
                          width=width, tags=tags)

    def line(self, x0, y0, x1, y1, color, width=1, tags=("map",)):
        self.c.create_line(x0, y0, x1, y1, fill=color, width=width, tags=tags)

    def rect(self, x0, y0, x1, y1, fill, tags=("map",)):
        self.c.create_rectangle(x0, y0, x1, y1, fill=fill, outline="",
                                tags=tags)

    def text(self, x, y, s, color="#000000", size=10, anchor="center",
             bold=False, tags=("map",)):
        self.c.create_text(x, y, text=s, fill=color, anchor=anchor,
                           font=("Helvetica", size,
                                 "bold" if bold else "normal"), tags=tags)


class SVGPainter:
    def __init__(self, w, h):
        self.w, self.h = w, h
        self.o = []

    def arc(self, cx, cy, r, a0, a1, color, width, tags=None):
        ext = a1 - a0
        if ext >= 359.9:
            self.o.append('<circle cx="%.2f" cy="%.2f" r="%.2f" fill="none" '
                          'stroke="%s" stroke-width="%.2f"/>'
                          % (cx, cy, r, color, width))
            return

        def pt(a):
            t = math.radians(a)
            return cx + r * math.sin(t), cy - r * math.cos(t)
        x0, y0 = pt(a0)
        x1, y1 = pt(a1)
        self.o.append('<path d="M%.2f %.2f A%.2f %.2f 0 %d 1 %.2f %.2f" '
                      'fill="none" stroke="%s" stroke-width="%.2f"/>'
                      % (x0, y0, r, r, 1 if ext > 180 else 0, x1, y1,
                         color, width))

    def line(self, x0, y0, x1, y1, color, width=1, tags=None):
        self.o.append('<line x1="%.2f" y1="%.2f" x2="%.2f" y2="%.2f" '
                      'stroke="%s" stroke-width="%.2f"/>'
                      % (x0, y0, x1, y1, color, width))

    def rect(self, x0, y0, x1, y1, fill, tags=None):
        self.o.append('<rect x="%.2f" y="%.2f" width="%.2f" height="%.2f" '
                      'fill="%s"/>' % (x0, y0, x1 - x0, y1 - y0, fill))

    def text(self, x, y, s, color="#000000", size=10, anchor="center",
             bold=False, tags=None):
        ta = ("middle" if anchor == "center" else
              "start" if "w" in anchor else "end" if "e" in anchor
              else "middle")
        self.o.append('<text x="%.2f" y="%.2f" fill="%s" font-size="%.1f" '
                      'font-family="Helvetica,Arial,sans-serif" '
                      'font-weight="%s" text-anchor="%s" '
                      'dominant-baseline="central">%s</text>'
                      % (x, y, color, size * 1.33,
                         "bold" if bold else "normal", ta, xml_escape(s)))

    def svg(self):
        return ('<?xml version="1.0" encoding="UTF-8"?>\n'
                '<svg xmlns="http://www.w3.org/2000/svg" width="%d" '
                'height="%d" viewBox="0 0 %d %d">\n'
                '<rect width="100%%" height="100%%" fill="white"/>\n%s\n'
                '</svg>\n' % (self.w, self.h, self.w, self.h,
                              "\n".join(self.o)))


# ------------------------------------------------------- circular map core

class Geo:
    """Geometry of the circular map for one drawing."""

    def __init__(self, scope, cx, cy, r0, rot, rect=None):
        self.scope = scope
        self.cx, self.cy, self.r0, self.rot, self.rect = cx, cy, r0, rot, rect
        self.L = float(scope.length)
        self.k = 360.0 / self.L
        self.lw = max(4.0, min(40.0, r0 * 0.05))     # feature ring thickness
        self.off = self.lw * 0.6 + 1                 # ring offset from r0
        self.H = self.lw * 2.0                       # GC track height
        self.gc_c = r0 - self.off - self.lw / 2 - 6 - self.H / 2
        self.sk_c = self.gc_c - self.H - 6
        self.inner = self.sk_c - self.H / 2

    def ang(self, pos):
        return (pos - self.rot) * self.k

    def xy(self, a, r):
        t = math.radians(a)
        return self.cx + r * math.sin(t), self.cy - r * math.cos(t)

    def inview(self, x, y, m=40):
        rc = self.rect
        return (rc is None or
                (rc[0] - m <= x <= rc[2] + m and rc[1] - m <= y <= rc[3] + m))

    def arc_vis(self, a0, a1, r):
        if self.rect is None:
            return True
        n = int(r * math.radians(a1 - a0) / 150.0) + 2
        if n > 40:
            return True
        return any(self.inview(*self.xy(a0 + (a1 - a0) * j / n, r))
                   for j in range(n + 1))

    def ring_r(self, strand):
        return self.r0 + self.off if strand > 0 else self.r0 - self.off


def title_lines(scope, inner):
    return textwrap.wrap(scope.title, max(10, int(inner * 1.7 / 7.0)))[:3]


def render_circle(p, app, g):
    sc = g.scope
    L, k, r0, lw, off = g.L, g.k, g.r0, g.lw, g.off

    def ring_line(r, color, width=1):
        for j in range(36):
            if g.arc_vis(j * 10.0, j * 10.0 + 10.0, r):
                p.arc(g.cx, g.cy, r, j * 10.0, j * 10.0 + 10.0, color, width)

    ring_line(r0, "#999999")

    # ticks
    step = nice_step(L * 55 / (2 * math.pi * r0))
    rt = r0 + off + lw / 2
    pos = 0
    while pos < L - step * 0.25:
        a = g.ang(pos)
        x1, y1 = g.xy(a, rt + 2)
        if g.inview(x1, y1):
            x2, y2 = g.xy(a, rt + 9)
            x3, y3 = g.xy(a, rt + 24)
            p.line(x1, y1, x2, y2, "#555555")
            p.text(x3, y3, fmt_tick(pos, step), "#555555", 9)
        pos += step

    # record boundaries
    if len(sc.bounds) > 1:
        for _, o, _ in sc.bounds:
            a = g.ang(o)
            x1, y1 = g.xy(a, r0 - off - lw)
            if g.inview(x1, y1):
                x2, y2 = g.xy(a, r0 + off + lw + 4)
                p.line(x1, y1, x2, y2, "#000000", 2)

    # GC content and GC skew rings
    if sc.seq and (app.show_gc.get() or app.show_skew.get()):
        nb, gcv, mean, dev, sk, sdev = sc.gc_bins()
        for on, rc, name in ((app.show_gc.get(), g.gc_c, "gc"),
                             (app.show_skew.get(), g.sk_c, "skew")):
            if not on:
                continue
            ring_line(rc, "#d0d0d0")
            bw = max(1.0, 2 * math.pi * rc / nb)
            for i in range(nb):
                a = g.ang((i + 0.5) * L / nb)
                x0, y0 = g.xy(a, rc)
                if not g.inview(x0, y0):
                    continue
                if name == "gc":
                    d = max(-1.0, min(1.0, (gcv[i] - mean) / dev))
                    col = "#444444" if d >= 0 else "#999999"
                else:
                    d = max(-1.0, min(1.0, sk[i] / sdev))
                    col = "#2e9e48" if d >= 0 else "#8e44ad"
                x1, y1 = g.xy(a, rc + d * g.H / 2)
                p.line(x0, y0, x1, y1, col, bw)

    # features
    colour = app.feat_color
    for f in app.vis_feats:
        if f.strand > 0:
            if not app.show_plus.get():
                continue
        elif not app.show_minus.get():
            continue
        r = g.ring_r(f.strand)
        mind = math.degrees(1.5 / max(r, 1.0))
        col = colour(f)
        for s, e in f.gsegs:
            a0 = g.ang(s - 1)
            a1 = a0 + min(359.9, max(mind, (e - s + 1) * k))
            if g.arc_vis(a0, a1, r):
                p.arc(g.cx, g.cy, r, a0, a1, col, lw)

    # position marker (from "Go to")
    if app.mark is not None:
        a = g.ang(app.mark)
        x1, y1 = g.xy(a, r0 - off - lw - 4)
        if g.inview(x1, y1):
            x2, y2 = g.xy(a, r0 + off + lw + 10)
            p.line(x1, y1, x2, y2, "#1e8e3e", 2)

    # centre text
    if g.inview(g.cx, g.cy, 0) and g.inner > 20:
        tl = title_lines(sc, g.inner)
        rows = ([(t, 11, True, "#222222") for t in tl] +
                [("%s bp" % format(sc.length, ","), 9, False, "#555555"),
                 ("%d features shown" % len(app.vis_feats), 9, False,
                  "#555555"),
                 ("outer: + strand   inner: - strand", 8, False, "#777777")])
        y = g.cy - len(rows) * 7.5 + 7
        for s, size, bold, col in rows:
            p.text(g.cx, y, s, col, size, bold=bold)
            y += 15


def render_highlight(p, app, g):
    sc = g.scope
    if not app.sel:
        return
    tags = ("map", "hl")
    for i in app.sel:
        f = sc.features[i]
        r = g.ring_r(f.strand)
        mind = math.degrees(3.0 / max(r, 1.0))
        for s, e in f.gsegs:
            a0 = g.ang(s - 1)
            a1 = a0 + min(359.9, max(mind, (e - s + 1) * g.k))
            if g.arc_vis(a0, a1, r):
                p.arc(g.cx, g.cy, r, a0, a1, HL, g.lw + 5, tags)
    f = sc.features[app.primary if app.primary is not None else app.sel[-1]]
    s, e = f.gsegs[0]
    a = g.ang((s + e) / 2.0)
    x1, y1 = g.xy(a, g.r0 - g.off - g.lw)
    if g.inview(x1, y1):
        x2, y2 = g.xy(a, g.r0 + g.off + g.lw)
        p.line(x1, y1, x2, y2, HL, 1, tags)
    if g.inview(g.cx, g.cy, 0) and g.inner > 20:
        n = len(title_lines(sc, g.inner)) + 3
        y = g.cy + n * 7.5 + 14
        extra = ("  (+%d)" % (len(app.sel) - 1)) if len(app.sel) > 1 else ""
        p.text(g.cx, y, f.id + extra, HL, 10, bold=True, tags=tags)
        p.text(g.cx, y + 14, "%d..%d (%s)" % (f.start, f.end,
                                              "+" if f.strand > 0 else "-"),
               HL, 9, tags=tags)


def render_legend(p, app, x, y):
    for col, label in app.legend_entries():
        p.rect(x, y - 5, x + 10, y + 5, col, tags=("legend",))
        p.text(x + 16, y, label, "#333333", 9, anchor="w", tags=("legend",))
        y += 14


# ----------------------------------------------------------- circular view

class CircleView:
    def __init__(self, app, canvas):
        self.app, self.c = app, canvas
        self.p = Painter(canvas)
        self.reset_all()
        self._pending = False
        self._press = None
        self._drag = False
        self.tip_idx = None
        canvas.bind("<Configure>", lambda e: self.schedule())
        canvas.bind("<ButtonPress-1>", self.on_press)
        canvas.bind("<B1-Motion>", self.on_drag)
        canvas.bind("<ButtonRelease-1>", self.on_release)
        canvas.bind("<Motion>", self.on_hover)
        canvas.bind("<Leave>", lambda e: self.clear_tip())
        canvas.bind("<Enter>", lambda e: canvas.focus_set())
        canvas.bind("<MouseWheel>", self.on_wheel)
        canvas.bind("<Button-4>", self.on_wheel)
        canvas.bind("<Button-5>", self.on_wheel)
        canvas.bind("<Double-Button-1>", self.on_double)
        for key in ("plus", "equal"):
            canvas.bind("<%s>" % key, lambda e: self.zoom_by(1.4))
        canvas.bind("<minus>", lambda e: self.zoom_by(1 / 1.4))
        canvas.bind("<Key-0>", lambda e: self.reset_view())

    # -- state

    def reset_all(self):
        self.z, self.ox, self.oy, self.rot = 1.0, 0.0, 0.0, 0.0

    def reset_view(self):
        self.z, self.ox, self.oy = 1.0, 0.0, 0.0
        self.schedule()

    def size(self):
        return max(1, self.c.winfo_width()), max(1, self.c.winfo_height())

    def geo(self):
        w, h = self.size()
        base = max(60.0, min(w, h) / 2.0 - 62)
        return Geo(self.app.scope, w / 2.0 + self.ox, h / 2.0 + self.oy,
                   base * self.z, self.rot, (0, 0, w, h))

    def schedule(self):
        if not self._pending:
            self._pending = True
            self.c.after_idle(self._do)

    def _do(self):
        self._pending = False
        self.draw()

    def zoom_at(self, mx, my, k):
        w, h = self.size()
        nz = max(1.0, min(40.0, self.z * k))
        k = nz / self.z
        cx = mx - (mx - (w / 2.0 + self.ox)) * k
        cy = my - (my - (h / 2.0 + self.oy)) * k
        self.ox, self.oy, self.z = cx - w / 2.0, cy - h / 2.0, nz
        if nz <= 1.0:
            self.ox = self.oy = 0.0
        self.schedule()

    def zoom_by(self, k):
        w, h = self.size()
        self.zoom_at(w / 2.0, h / 2.0, k)

    # -- drawing

    def draw(self):
        c = self.c
        c.delete("all")
        self.tip_idx = None
        if self.app.scope is None:
            w, h = self.size()
            c.create_text(w / 2, h / 2, text="Open a GenBank file (Ctrl-O)",
                          fill="#888888", font=("Helvetica", 14))
            return
        g = self.geo()
        render_circle(self.p, self.app, g)
        render_highlight(self.p, self.app, g)
        if self.app.show_legend.get():
            render_legend(self.p, self.app, 12, 16)
        self.draw_win()

    def draw_highlight(self):
        self.c.delete("hl")
        if self.app.scope is not None:
            render_highlight(self.p, self.app, self.geo())

    def draw_win(self):
        """Mark the detail strip's window on the backbone."""
        self.c.delete("win")
        app = self.app
        if app.scope is None or app.strip is None:
            return
        g = self.geo()
        a0 = g.ang(app.strip.w0)
        a1 = a0 + max(0.4, (app.strip.w1 - app.strip.w0) * g.k)
        if a1 - a0 < 359.9 and g.arc_vis(a0, a1, g.r0):
            self.p.arc(g.cx, g.cy, g.r0, a0, a1, "#111111",
                       min(3.0, g.lw * 0.25 + 1), tags=("win",))

    # -- hit testing

    def hit(self, x, y):
        app = self.app
        if app.scope is None:
            return None
        g = self.geo()
        dx, dy = x - g.cx, y - g.cy
        d = math.hypot(dx, dy)
        if d < 1:
            return None
        cand = []
        if app.show_plus.get() and abs(d - (g.r0 + g.off)) <= g.lw / 2 + 3:
            cand.append(1)
        if app.show_minus.get() and abs(d - (g.r0 - g.off)) <= g.lw / 2 + 3:
            cand.append(-1)
        if not cand:
            return None
        pos = (math.degrees(math.atan2(dx, -dy)) / 360.0 * g.L + g.rot) % g.L
        tol = 3 * g.L / (2 * math.pi * g.r0)
        best, bkey = None, None
        for f in app.vis_feats:
            if f.strand not in cand:
                continue
            for s, e in f.gsegs:
                for q in (pos, pos - g.L, pos + g.L):
                    if s - 1 - tol <= q <= e + tol:
                        # prefer one under the pointer, then the shortest
                        key = (max(s - 1 - q, q - e, 0), e - s)
                        if bkey is None or key < bkey:
                            best, bkey = f.idx, key
        return best

    # -- events

    def clear_tip(self):
        self.c.delete("tip")
        self.tip_idx = None

    def on_press(self, e):
        self.c.focus_set()
        w, h = self.size()
        a0 = math.atan2(e.x - (w / 2.0 + self.ox), -(e.y - (h / 2.0 + self.oy)))
        self._press = (e.x, e.y, self.ox, self.oy, self.rot, a0)
        self._drag = False
        self.clear_tip()

    def on_drag(self, e):
        if self._press is None or self.app.scope is None:
            return
        x0, y0, ox, oy, rot, a0 = self._press
        if not self._drag and math.hypot(e.x - x0, e.y - y0) < 4:
            return
        self._drag = True
        if e.state & 0x1:                                    # Shift: rotate
            w, h = self.size()
            a1 = math.atan2(e.x - (w / 2.0 + self.ox),
                            -(e.y - (h / 2.0 + self.oy)))
            d = (a1 - a0 + math.pi) % (2 * math.pi) - math.pi
            self.rot = (rot - d / (2 * math.pi) * self.app.scope.length) \
                % self.app.scope.length
        else:
            self.ox, self.oy = ox + e.x - x0, oy + e.y - y0
        self.schedule()

    def on_release(self, e):
        was_drag = self._drag
        self._press = None
        self._drag = False
        if was_drag or self.app.scope is None:
            return
        add = bool(e.state & 0x4 or e.state & 0x8)
        self.app.click_feature(self.hit(e.x, e.y), add)

    def on_hover(self, e):
        if self._press is not None or self.app.scope is None:
            return
        idx = self.hit(e.x, e.y)
        if idx != self.tip_idx:
            self.c.delete("tip")
            self.tip_idx = idx
            if idx is not None:
                self.app.show_tip(self.c, e.x, e.y, idx)

    def on_wheel(self, e):
        if self.app.scope is None:
            return
        if getattr(e, "num", 0) == 4:
            d = 120
        elif getattr(e, "num", 0) == 5:
            d = -120
        else:
            d = e.delta
        n = d / 120.0 if abs(d) >= 120 else d / 6.0
        self.zoom_at(e.x, e.y, 1.15 ** n)

    def on_double(self, e):
        if self.app.scope is not None and self.hit(e.x, e.y) is None:
            self.reset_view()


# -------------------------------------------------------------- strip view

BAR_H, LANE_H = 13, 17


class StripView:
    """Linear detail view of a window of the genome."""

    def __init__(self, app, canvas):
        self.app, self.c = app, canvas
        self.w0, self.w1 = 0.0, 20000.0
        self.ya = 84
        self._pending = False
        self._press = None
        self._drag = False
        self.tip_idx = None
        canvas.bind("<Configure>", lambda e: self.schedule())
        canvas.bind("<ButtonPress-1>", self.on_press)
        canvas.bind("<B1-Motion>", self.on_drag)
        canvas.bind("<ButtonRelease-1>", self.on_release)
        canvas.bind("<Motion>", self.on_hover)
        canvas.bind("<Leave>", lambda e: self.clear_tip())
        canvas.bind("<Enter>", lambda e: canvas.focus_set())
        canvas.bind("<MouseWheel>", self.on_wheel)
        canvas.bind("<Button-4>", self.on_wheel)
        canvas.bind("<Button-5>", self.on_wheel)
        canvas.bind("<Double-Button-1>", self.on_double)
        canvas.bind("<Left>", lambda e: self.pan(-0.2))
        canvas.bind("<Right>", lambda e: self.pan(0.2))
        for key in ("plus", "equal"):
            canvas.bind("<%s>" % key, lambda e: self.zoom_at(None, 1.4))
        canvas.bind("<minus>", lambda e: self.zoom_at(None, 1 / 1.4))
        canvas.bind("<Key-0>", lambda e: self.reset())

    def width(self):
        return max(1, self.c.winfo_width())

    def reset(self):
        sc = self.app.scope
        L = sc.length if sc else 20000
        self.set_window(0, min(L, 20000))

    def set_window(self, w0, w1):
        sc = self.app.scope
        if sc is None:
            return
        L = float(sc.length)
        wd = max(min(100.0, L), min(L, w1 - w0))
        w0 = max(0.0, min(w0, L - wd))
        self.w0, self.w1 = w0, w0 + wd
        self.schedule()
        if self.app.circle is not None:
            self.app.circle.draw_win()

    def pan(self, frac):
        wd = self.w1 - self.w0
        self.set_window(self.w0 + frac * wd, self.w1 + frac * wd)

    def zoom_at(self, x, k):
        wd = self.w1 - self.w0
        if x is None:
            x = self.width() / 2.0
        pos = self.w0 + wd * x / self.width()
        nw = wd / k
        self.set_window(pos - (x / self.width()) * nw,
                        pos + (1 - x / self.width()) * nw)

    def schedule(self):
        if not self._pending:
            self._pending = True
            self.c.after_idle(self._do)

    def _do(self):
        self._pending = False
        self.draw()

    # -- drawing

    def lane_top(self, f):
        if f.strand > 0:
            return self.ya - 4 - (f.lane + 1) * LANE_H
        return self.ya + 4 + f.lane * LANE_H

    def draw(self):
        c = self.c
        c.delete("all")
        self.tip_idx = None
        app, sc = self.app, self.app.scope
        if sc is None:
            return
        w, h = self.width(), max(1, c.winfo_height())
        wd = self.w1 - self.w0
        scale = w / wd
        w0, ya, L = self.w0, self.ya, sc.length

        def X(p):
            return (p - w0) * scale

        # ruler
        c.create_line(0, 24, w, 24, fill="#888888")
        step = nice_step(wd * 80.0 / w)
        pos = int(math.ceil(w0 / step)) * step
        while pos <= self.w1:
            x = X(pos)
            c.create_line(x, 24, x, 29, fill="#666666")
            c.create_text(x, 13, text=fmt_tick(pos, step), fill="#555555",
                          font=("Helvetica", 8))
            pos += step
        c.create_line(0, ya, w, ya, fill="#cccccc")
        c.create_text(6, ya - 9, text="+", fill="#999999", anchor="w")
        c.create_text(6, ya + 9, text="-", fill="#999999", anchor="w")

        # record boundaries
        if len(sc.bounds) > 1:
            for name, o, _ in sc.bounds:
                if w0 <= o <= self.w1:
                    x = X(o)
                    c.create_line(x, 30, x, h, fill="#999999", dash=(3, 3))
                    c.create_text(x + 3, h - 10, text=name, anchor="w",
                                  fill="#777777", font=("Helvetica", 8))

        # features
        sel = set(app.sel)
        late = []
        for f in app.vis_feats:
            if (f.gmax < w0 or f.gmin - 1 > self.w1) and \
                    not (len(f.gsegs) > 1 and f.gmax - f.gmin > L / 2):
                continue
            if f.idx in sel:
                late.append(f)
            else:
                self.draw_feat(f, X, w, False)
        for f in late:
            self.draw_feat(f, X, w, True)

        if app.mark is not None and w0 <= app.mark <= self.w1:
            x = X(app.mark)
            c.create_line(x, 26, x, h - 18, fill="#1e8e3e", width=2)
        c.create_text(w - 6, h - 10, anchor="e", fill="#777777",
                      font=("Helvetica", 8),
                      text="%s..%s  (%s)" % (format(int(w0) + 1, ","),
                                             format(int(self.w1), ","),
                                             fmt_bp(wd)))

    def draw_feat(self, f, X, w, selected):
        c = self.c
        col = self.app.feat_color(f)
        top = self.lane_top(f)
        mid = top + BAR_H / 2.0
        gs = f.gsegs
        head_i = len(gs) - 1 if f.strand > 0 else 0
        label = f.qual.get("gene") or f.id
        L = self.app.scope.length
        if len(gs) > 1 and f.gmax - f.gmin <= L / 2:
            ss = sorted(gs)
            for (a, b), (cc, d) in zip(ss, ss[1:]):
                xa, xb = X(b), X(cc - 1)
                if xb > -5 and xa < w + 5 and xb > xa:
                    c.create_line(max(xa, -5), mid, min(xb, w + 5), mid,
                                  fill=col)
        for i, (s, e) in enumerate(gs):
            x0, x1 = X(s - 1), X(e)
            if x1 < -5 or x0 > w + 5:
                continue
            tip = x1 if f.strand > 0 else x0
            head = i == head_i and -6 <= tip <= w + 6
            x0c, x1c = max(x0, -6), min(x1, w + 6)
            x1c = max(x1c, x0c + 2)
            hw = min(8.0, x1c - x0c) if head else 0
            if head and f.strand > 0:
                pts = [x0c, top, x1c - hw, top, x1c, mid, x1c - hw,
                       top + BAR_H, x0c, top + BAR_H]
            elif head:
                pts = [x1c, top, x0c + hw, top, x0c, mid, x0c + hw,
                       top + BAR_H, x1c, top + BAR_H]
            else:
                pts = [x0c, top, x1c, top, x1c, top + BAR_H, x0c, top + BAR_H]
            c.create_polygon(pts, fill=col, outline=HL if selected else "",
                             width=2 if selected else 1)
            if x1c - x0c > len(label) * 6 + 14:
                c.create_text((x0c + x1c) / 2.0, mid, text=label,
                              fill="white", font=("Helvetica", 8, "bold"))

    # -- hit testing

    def hit(self, x, y):
        app = self.app
        if app.scope is None:
            return None
        scale = self.width() / (self.w1 - self.w0)
        pos = self.w0 + x / scale
        tol = 3 / scale
        strand = 1 if y < self.ya else -1
        row = (int((self.ya - 4 - y) // LANE_H) if strand > 0
               else int((y - self.ya - 4) // LANE_H))
        row = max(0, min(2, row))
        found = None
        for f in app.vis_feats:
            if f.strand != strand:
                continue
            for s, e in f.gsegs:
                if s - 1 - tol <= pos <= e + tol:
                    if f.lane == row:
                        return f.idx
                    found = f.idx if found is None else found
        return found

    # -- events

    def clear_tip(self):
        self.c.delete("tip")
        self.tip_idx = None

    def on_press(self, e):
        self.c.focus_set()
        self._press = (e.x, e.y, self.w0, self.w1)
        self._drag = False
        self.clear_tip()

    def on_drag(self, e):
        if self._press is None or self.app.scope is None:
            return
        x0, y0, w0, w1 = self._press
        if not self._drag and abs(e.x - x0) < 4 and abs(e.y - y0) < 4:
            return
        self._drag = True
        d = (e.x - x0) * (w1 - w0) / self.width()
        self.set_window(w0 - d, w1 - d)

    def on_release(self, e):
        was_drag = self._drag
        self._press = None
        self._drag = False
        if was_drag or self.app.scope is None:
            return
        add = bool(e.state & 0x4 or e.state & 0x8)
        self.app.click_feature(self.hit(e.x, e.y), add, source="strip")

    def on_hover(self, e):
        if self._press is not None or self.app.scope is None:
            return
        idx = self.hit(e.x, e.y)
        if idx != self.tip_idx:
            self.c.delete("tip")
            self.tip_idx = idx
            if idx is not None:
                self.app.show_tip(self.c, e.x, e.y, idx)

    def on_wheel(self, e):
        if self.app.scope is None:
            return
        if getattr(e, "num", 0) == 4:
            d = 120
        elif getattr(e, "num", 0) == 5:
            d = -120
        else:
            d = e.delta
        n = d / 120.0 if abs(d) >= 120 else d / 6.0
        self.zoom_at(e.x, 1.2 ** n)

    def on_double(self, e):
        app = self.app
        if app.scope is not None and app.primary is not None:
            app.center_strip(app.scope.features[app.primary], fit=True)


