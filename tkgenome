# ---------------------------------------------------------------- parsing

SEG_RE = re.compile(r"(\d+)(?:(?:\.\.|\^|\.)[<>]?(\d+))?")
REMOTE_RE = re.compile(r"[A-Za-z_][\w.]*:")
SEQ_STRIP = {ord(c): None for c in "0123456789 \t"}
RNA_TYPES = {"tRNA", "rRNA", "tmRNA", "ncRNA", "misc_RNA"}


class Feature:
    __slots__ = ("type", "loc", "segs", "strand", "start", "end", "qual",
                 "quals", "id", "ann", "rec", "off", "gsegs", "gmin", "gmax",
                 "idx", "length", "pseudo", "cls", "lane", "hay")

    def __init__(self):
        self.cls = None
        self.lane = 0
        self.off = 0


class Record:
    def __init__(self):
        self.name = ""
        self.definition = ""
        self.organism = ""
        self.length = 0
        self.seq = ""
        self.features = []

    def finish(self):
        if self.seq:
            self.length = len(self.seq)
        elif not self.length and self.features:
            self.length = max(e for f in self.features for _, e in f.segs)
        counts = {}
        for f in self.features:
            f.rec = self
            f.start, f.end = span(f.segs, self.length)
            f.length = sum(e - s + 1 for s, e in f.segs)
            q = f.qual
            n = counts[f.type] = counts.get(f.type, 0) + 1
            f.id = (q.get("locus_tag") or q.get("gene") or q.get("protein_id")
                    or q.get("old_locus_tag") or "%s_%d" % (f.type, n))
            f.pseudo = "pseudo" in q or "pseudogene" in q
            f.ann = (q.get("product") or q.get("note") or q.get("function")
                     or q.get("gene") or "")
            if f.pseudo:
                f.ann = "(pseudo) " + f.ann
            f.hay = " ".join((f.id, f.type, f.ann, q.get("gene", ""),
                              q.get("product", ""), self.name)).lower()


def span(segs, length):
    """Display start/end of a (possibly joined, possibly origin-spanning)
    location.  The widest circular gap is where the feature is *not*, so a
    feature crossing the origin comes out with start > end."""
    ss = sorted(segs)
    lo = ss[0][0]
    hi = max(e for _, e in ss)
    if len(ss) == 1 or not length:
        return lo, hi
    best, best_i, best_end, maxend = lo + length - hi, -1, 0, ss[0][1]
    for i in range(len(ss) - 1):
        maxend = max(maxend, ss[i][1])
        gap = ss[i + 1][0] - maxend
        if gap > best:
            best, best_i, best_end = gap, i, maxend
    if best_i < 0:
        return lo, hi
    return ss[best_i + 1][0], best_end


def parse_location(loc):
    s = REMOTE_RE.sub("", loc)
    segs = []
    for a, b in SEG_RE.findall(s):
        a = int(a)
        b = int(b) if b else a
        segs.append((min(a, b), max(a, b)))
    return segs, (-1 if "complement" in s else 1)


def make_feature(lines):
    f = Feature()
    f.type = lines[0][5:21].strip()
    loc = lines[0][21:].strip()
    quals = []
    for line in lines[1:]:
        t = line[21:].strip() if line.startswith(" " * 21) else line.strip()
        if t.startswith("/"):
            name, _, val = t[1:].partition("=")
            quals.append([name, [val]])
        elif quals:
            quals[-1][1].append(t)
        else:
            loc += t
    f.loc = loc
    f.segs, f.strand = parse_location(loc)
    if not f.segs:
        return None
    f.qual = {}
    f.quals = []
    for name, parts in quals:
        val = ("" if name == "translation" else " ").join(parts).strip()
        if len(val) >= 2 and val[0] == val[-1] == '"':
            val = val[1:-1].replace('""', '"')
        f.quals.append((name, val))
        f.qual.setdefault(name, val)
    return f


def open_text(path):
    with open(path, "rb") as fh:
        magic = fh.read(2)
    if magic == b"\x1f\x8b":
        return gzip.open(path, "rt", encoding="utf-8", errors="replace")
    return open(path, "r", encoding="utf-8", errors="replace")


def parse_genbank(path):
    records = []
    rec = None
    mode = None
    feat = []
    parts = []

    def flush():
        nonlocal feat
        if feat and rec is not None:
            f = make_feature(feat)
            if f:
                rec.features.append(f)
        feat = []

    def end_record():
        nonlocal rec, parts
        flush()
        if rec is not None:
            rec.seq = "".join(parts).lower()
            rec.finish()
            records.append(rec)
        rec = None
        parts = []

    with open_text(path) as fh:
        for line in fh:
            line = line.rstrip("\r\n")
            if line[:1] not in (" ", ""):
                kw, _, rest = line.partition(" ")
                rest = rest.strip()
                if kw == "LOCUS":
                    end_record()
                    rec = Record()
                    toks = rest.split()
                    rec.name = toks[0] if toks else ""
                    m = re.search(r"(\d+)\s+(?:bp|aa)\b", rest)
                    if m:
                        rec.length = int(m.group(1))
                    mode = "head"
                elif rec is None:
                    continue
                elif kw.startswith("//"):
                    end_record()
                    mode = None
                elif kw == "FEATURES":
                    mode = "feat"
                elif kw == "ORIGIN":
                    flush()
                    mode = "seq"
                elif kw == "DEFINITION":
                    rec.definition = rest
                    mode = "def"
                else:
                    flush()
                    mode = "other"
            elif rec is None:
                continue
            elif mode == "feat":
                if line[5:6].strip():
                    flush()
                    feat = [line]
                elif feat:
                    feat.append(line)
            elif mode == "seq":
                parts.append(line.translate(SEQ_STRIP))
            elif mode == "def":
                rec.definition += " " + line.strip()
            elif mode == "other":
                t = line.strip()
                if t.startswith("ORGANISM") and not rec.organism:
                    rec.organism = t[8:].strip()
    end_record()
    return records


# ---------------------------------------------------------- sequence tools

COMP = str.maketrans("acgtnrykmswbdhvACGTNRYKMSWBDHV",
                     "tgcanyrmkswvhdbTGCANYRMKSWVHDB")
_B = "tcag"
_AA = "FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG"
CODONS = {a + b + c: _AA[16 * i + 4 * j + k]
          for i, a in enumerate(_B) for j, b in enumerate(_B)
          for k, c in enumerate(_B)}
CODONS_4 = dict(CODONS, tga="W")
ALT_STARTS = {"gtg", "ttg", "ctg", "att", "atc", "ata"}


def revcomp(s):
    return s.translate(COMP)[::-1]


def translate(nt, table=11, codon_start=1, partial=False):
    tab = CODONS_4 if table == 4 else CODONS
    nt = nt[max(0, codon_start - 1):].lower()
    aa = [tab.get(nt[i:i + 3], "X") for i in range(0, len(nt) - 2, 3)]
    if aa and not partial and codon_start == 1 and table != 4 \
            and nt[:3] in ALT_STARTS:
        aa[0] = "M"
    if aa and aa[-1] == "*":
        aa.pop()
    return "".join(aa)


def nt_of(f):
    s = f.rec.seq
    if not s:
        return None
    nt = "".join(s[a - 1:b] for a, b in f.segs)
    return revcomp(nt) if f.strand < 0 else nt


def protein_of(f):
    """(protein, computed) for a feature, or None."""
    tr = f.qual.get("translation")
    if tr:
        return tr.replace(" ", ""), False
    if f.type != "CDS":
        return None
    nt = nt_of(f)
    if not nt:
        return None

    def num(key, default):
        try:
            return int(f.qual.get(key, default))
        except ValueError:
            return default
    return translate(nt, num("transl_table", 11), num("codon_start", 1),
                     "<" in f.loc or ">" in f.loc), True


def wrap(s, n=60):
    return "\n".join(s[i:i + n] for i in range(0, len(s), n))


# ------------------------------------------------------------------ scope

class Scope:
    """What is being viewed: one record, or several laid end to end."""

    def __init__(self, records):
        self.records = records
        self.bounds = []
        self.features = []
        off = 0
        for r in records:
            self.bounds.append((r.name, off, r.length))
            for f in r.features:
                f.off = off
                f.gsegs = [(s + off, e + off) for s, e in f.segs]
                f.gmin = min(s for s, _ in f.gsegs)
                f.gmax = max(e for _, e in f.gsegs)
                f.idx = len(self.features)
                self.features.append(f)
            off += r.length
        self.length = off
        self.seq = ("".join(r.seq for r in records)
                    if all(r.seq for r in records) else "")
        first = records[0]
        base = first.organism or first.definition or first.name
        self.title = (base if len(records) == 1
                      else "%s (%d records)" % (base, len(records)))
        self._gc = None

    def gc_bins(self):
        if self._gc is None:
            s, L = self.seq, self.length
            nb = max(1, min(1000, L // 500))
            gcv, sk = [], []
            for i in range(nb):
                a, b = i * L // nb, (i + 1) * L // nb
                w = s[a:b]
                g, c = w.count("g"), w.count("c")
                gcv.append((g + c) / (b - a) if b > a else 0.0)
                sk.append((g - c) / (g + c) if g + c else 0.0)
            mean = (s.count("g") + s.count("c")) / float(L)
            dev = max(abs(v - mean) for v in gcv) or 1e-9
            sdev = max(abs(v) for v in sk) or 1e-9
            self._gc = (nb, gcv, mean, dev, sk, sdev)
        return self._gc


