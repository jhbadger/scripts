class Palette(ttk.Frame):
    def __init__(self, master, app):
        super().__init__(master, padding=6)
        self.app = app
        self.drag = None
        self.types = {}
        self.ns = SimpleNamespace()
        ttk.Label(self, text="Palette", font=("Helvetica", 13, "bold")) \
            .grid(row=0, column=0, columnspan=2, pady=(0, 6))
        small = ("Helvetica", 10)
        for i, t in enumerate(PALETTE):
            cell = tk.Frame(self, width=112, height=58, bd=1, relief="raised")
            cell.grid(row=1 + i // 2, column=i % 2, padx=2, pady=2)
            if t == "Timer":
                sample = tk.Canvas(cell, width=30, height=30,
                                   highlightthickness=0, bd=0,
                                   bg=cell.cget("bg"))
                draw_timer_icon(sample, 2, 2, 26)
                sample.place(relx=0.5, y=4, anchor="n")
            else:
                o = {"type": t, "name": "sample_" + t.lower(), "props": {}}
                sample = make_live(o, cell, self.ns)
                sw, sh = TYPES[t]["size"]
                sample.place(relx=0.5, y=4 if sh > 4 else 16, anchor="n",
                             width=min(sw, 100), height=min(sh, 32))
            cap = tk.Label(cell, text=t, font=small)
            cap.place(relx=0.5, rely=1.0, y=-1, anchor="s")
            for wdg in (cell, sample, cap):
                wdg.bindtags(("Palette", "all"))
                self.types[str(wdg)] = t
        ttk.Label(self, text="Drag onto the window,\nor double-click.",
                  justify="center", foreground="#555") \
            .grid(row=99, column=0, columnspan=2, pady=8)
        r = app.root
        r.bind_class("Palette", "<ButtonPress-1>", self.press)
        r.bind_class("Palette", "<B1-Motion>", self.motion)
        r.bind_class("Palette", "<ButtonRelease-1>", self.release)
        r.bind_class("Palette", "<Double-Button-1>", self.double)

    def press(self, e):
        self.drag = {"type": self.types.get(str(e.widget)),
                     "start": (e.x_root, e.y_root), "ghost": None}

    def motion(self, e):
        d = self.drag
        if not d or not d["type"]:
            return
        if not d["ghost"]:
            if abs(e.x_root - d["start"][0]) + abs(e.y_root - d["start"][1]) < 5:
                return
            g = d["ghost"] = tk.Toplevel(self)
            g.overrideredirect(True)
            try:
                g.attributes("-topmost", True)
            except tk.TclError:
                pass
            tk.Label(g, text=" %s " % d["type"], bg="#ffffd8", fg="black",
                     relief="solid", bd=1, padx=6, pady=3).pack()
        d["ghost"].geometry("+%d+%d" % (e.x_root + 12, e.y_root + 10))

    def release(self, e):
        d, self.drag = self.drag, None
        if d and d["ghost"]:
            d["ghost"].destroy()
            self.app.drop(d["type"], e.x_root, e.y_root)

    def double(self, e):
        t = self.types.get(str(e.widget))
        if t:
            self.app.add_object(t)


def draw_timer_icon(c, x, y, s, tags=()):
    c.create_oval(x, y, x + s, y + s, fill="white", outline="black",
                  width=2, tags=tags)
    cx, cy = x + s / 2, y + s / 2
    c.create_line(cx, cy, cx, y + s * 0.18, width=2, tags=tags)
    c.create_line(cx, cy, x + s * 0.75, cy, width=2, tags=tags)
    c.create_rectangle(cx - 2, y - 4, cx + 2, y, fill="black", tags=tags)


def draw_controller_icon(c, x, y, s, tags=()):
    """A cube, like IB's File's Owner."""
    d = s * 0.3
    c.create_polygon(x, y + d, x + s - d, y + d, x + s - d, y + s, x, y + s,
                     fill="#d9d9d9", outline="black", tags=tags)
    c.create_polygon(x, y + d, x + d, y, x + s, y, x + s - d, y + d,
                     fill="#f2f2f2", outline="black", tags=tags)
    c.create_polygon(x + s - d, y + d, x + s, y, x + s, y + s - d,
                     x + s - d, y + s, fill="#a9a9a9", outline="black",
                     tags=tags)


