        pw.add(self.inspector, weight=0)

        self.src_box = Outline(c, "#5a5a5a")
        self.dst_box = Outline(c, "black", 3)
        for binder in (c.bind, lambda s, f: r.bind_class("Design", s, f)):
            binder("<ButtonPress-1>", self.press)
