            binder("<B1-Motion>", self.motion)
            binder("<ButtonRelease-1>", self.release)
            binder("<Double-Button-1>", self.double)
            for b in (2, 3):
                binder("<ButtonPress-%d>" % b,
                       lambda e: self.press(e, connect=True))
                binder("<B%d-Motion>" % b, self.motion)
                binder("<ButtonRelease-%d>" % b, self.release)
        r.bind_class("Handle", "<ButtonPress-1>", self.handle_press)
        r.bind_class("Handle", "<B1-Motion>", self.motion)
        r.bind_class("Handle", "<ButtonRelease-1>", self.release)
        for seq in ("<Delete>", "<BackSpace>"):
            c.bind(seq, lambda e: self.delete_selection())
        for key, dx, dy in (("Left", -1, 0), ("Right", 1, 0),
                            ("Up", 0, -1), ("Down", 0, 1)):
            c.bind("<%s>" % key, lambda e, dx=dx, dy=dy: self.nudge(dx, dy))
            c.bind("<Shift-%s>" % key,
                   lambda e, dx=dx, dy=dy: self.nudge(dx * GRID, dy * GRID))
        c.bind("<Escape>", lambda e: self.escape())
        for seq in ("<MouseWheel>", "<Shift-MouseWheel>", "<Button-4>",
                    "<Button-5>"):
            r.bind_all(seq, self.wheel)

