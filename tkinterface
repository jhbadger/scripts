class Timer:
    """A non-visual object that sends its action every `interval` ms."""

    def __init__(self, master, interval=1000, repeat=True):
        self.master, self.interval, self.repeat = master, interval, repeat
        self.action = None
        self.ticks = 0
        self._job = None

    @property
    def running(self):
        return self._job is not None

    def start(self):
        if self._job is None:
            self._job = self.master.after(self.interval, self._tick)

    def stop(self):
        if self._job is not None:
            self.master.after_cancel(self._job)
            self._job = None

    def toggle(self):
        if self.running:
            self.stop()
        else:
            self.start()

    def _tick(self):
        self._job = None
        if not self.master.winfo_exists():
            return
        if self.repeat:
            self.start()
        self.ticks += 1
        if self.action:
            self.action()
