def is_visual(o):
    return o["type"] in TYPES and not TYPES[o["type"]].get("nonvisual")


def props_of(o):
    have = o.get("props", {})
    return {p["key"]: have.get(p["key"], p["default"])
            for p in TYPES[o["type"]]["props"]}


def num(v):
    """A number tidied for display / code: 3.0 -> 3."""
    if isinstance(v, float) and v.is_integer():
        return int(v)
    return v


def valid_ident(s):
    return bool(re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", s or "")) \
        and not keyword.iskeyword(s)


