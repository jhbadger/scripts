    def bind_keys(self):
        r = self.root
        keys = {"n": self.new, "o": self.open, "s": self.save,
                "S": self.save_as, "r": self.test_interface,
                "g": self.generate_code, "G": self.show_code}
        if not MAC:
            keys["q"] = self.quit
        for k, f in keys.items():
            r.bind_all("<%s-%s>" % (MOD, k), lambda e, f=f: f())
        for k, op in (("z", "undo"), ("Z", "redo"), ("x", "cut"),
                      ("c", "copy"), ("v", "paste"), ("d", "duplicate"),
                      ("a", "selectall"), ("f", "front"), ("b", "back")):
            r.bind_all("<%s-%s>" % (MOD, k), lambda e, op=op: self.key_edit(op))

    def typing(self):
        """Is the keyboard focus in a text field (rather than the design)?"""
        f = self.root.focus_get()
        return f is not None and f.winfo_class() in (
            "Entry", "TEntry", "Text", "TCombobox", "Spinbox", "TSpinbox")

    def key_edit(self, op):
        if self.typing():
            return        # the text field's own bindings handle it
        self.edit_op(op)

    def menu_edit(self, op):
        f = self.root.focus_get()
        if self.typing():
            ev = {"cut": "<<Cut>>", "copy": "<<Copy>>", "paste": "<<Paste>>",
                  "selectall": "<<SelectAll>>", "undo": "<<Undo>>",
                  "redo": "<<Redo>>"}.get(op)
            if ev:
                f.event_generate(ev)
                return
        self.edit_op(op)

    def edit_op(self, op):
        {"undo": self.undo, "redo": self.redo, "cut": self.cut,
         "copy": self.copy, "paste": self.paste, "duplicate": self.duplicate,
         "selectall": self.select_all,
         "front": lambda: self.restack_sel(True),
         "back": lambda: self.restack_sel(False)}[op]()

    def status(self, text, error=False):
        self.statusbar.configure(text=text,
                                 foreground="#b00000" if error else "")

    def update_title(self):
        name = os.path.basename(self.path) if self.path else "Untitled"
        self.root.title("tkinterface — %s%s" % (name, " •" if self.dirty
                                                   else ""))

    def mode_changed(self):
        if self.mode.get() == "connect":
            self.status("Connect mode: drag from a control to its target, or "
                        "from the Controller to an object.")
            self.canvas.configure(cursor="crosshair")
        else:
            self.status("")
            self.canvas.configure(cursor="")

    # -- the model

    def obj(self, name):
        if name == "controller":
            return {"type": "Controller", "name": "controller"}
        for o in self.doc["objects"]:
            if o["name"] == name:
                return o
        return None

    def type_of(self, name):
        o = self.obj(name)
        return o["type"] if o else None

    def visible(self):
        return [o for o in self.doc["objects"] if is_visual(o)]

    def is_visible(self, name):
        o = self.obj(name)
        return bool(o) and o["type"] in TYPES and is_visual(o)

    def tray_names(self):
        return ["controller"] + [o["name"] for o in self.doc["objects"]
                                 if not is_visual(o)]

    def tray_y(self):
        return FY + self.doc["window"]["height"] + 44

    def icon_rect(self, name):
        i = self.tray_names().index(name)
        x = FX + 10 + i * SLOT + (SLOT - 40) / 2
        y = self.tray_y() + 22
        return (x, y, x + 40, y + 40)

    def rect(self, name):
        """name's rectangle in canvas coordinates."""
        o = self.obj(name)
        if o and o["type"] in TYPES and is_visual(o):
            return (FX + o["x"], FY + o["y"], FX + o["x"] + o["w"],
                    FY + o["y"] + o["h"])
        return self.icon_rect(name)

    def hit_test(self, cx, cy, exclude=None):
        for o in reversed(self.visible()):
            pad = 3 if min(o["w"], o["h"]) < 8 else 0
            x0, y0, x1, y1 = self.rect(o["name"])
            if o["name"] != exclude and x0 - pad <= cx <= x1 + pad \
                    and y0 - pad <= cy <= y1 + pad:
                return o["name"]
        for name in self.tray_names():
            x0, y0, x1, y1 = self.icon_rect(name)
            if name != exclude and x0 - 14 <= cx <= x1 + 14 \
                    and y0 - 4 <= cy <= y1 + 18:
                return name
        return None

    def next_name(self, t):
        base = t.lower()
        taken = {o["name"] for o in self.doc["objects"]}
        n = 1
        while "%s%d" % (base, n) in taken:
            n += 1
        return "%s%d" % (base, n)

    def snapv(self, v):
        return int(round(v / GRID) * GRID) if self.snap.get() else int(v)

    # -- undo

    def snapshot(self):
        return json.dumps(self.doc)

    def push_undo(self, snap=None):
        self.undo_stack.append(snap or self.snapshot())
        del self.undo_stack[:-200]
        self.redo_stack.clear()
        self.dirty = True
        self.update_title()

    def restore(self, snap):
        self.doc = json.loads(snap)
        self.redraw_all()
        self.select([n for n in self.sel if self.obj(n)], commit=False)
        self.dirty = True
        self.update_title()

    def undo(self):
        if not self.undo_stack:
            self.status("Nothing to undo.")
            return
        self.end_inline_edit()
        self.redo_stack.append(self.snapshot())
        self.restore(self.undo_stack.pop())

    def redo(self):
        if not self.redo_stack:
            self.status("Nothing to redo.")
            return
        self.undo_stack.append(self.snapshot())
        self.restore(self.redo_stack.pop())

    # -- drawing

    def redraw_all(self):
        self.src_box.hide()
        self.dst_box.hide()
        for n in list(self.handles):
            self.drop_handles(n)
        for w in self.widgets.values():
            w.destroy()
        self.widgets, self.items = {}, {}
        self.canvas.delete("all")
        self.ns = SimpleNamespace()
        self.draw_form()
        for o in self.visible():
            self.make_widget(o)
        self.draw_tray()
        self.draw_connections()

    def draw_form(self):
        c, win = self.canvas, self.doc["window"]
        W, H = win["width"], win["height"]
        c.delete("form")
        c.create_rectangle(FX + 5, FY - TITLE_H + 5, FX + W + 6, FY + H + 6,
                           fill="#3a3a3a", outline="", tags="form")
        c.create_rectangle(FX - 1, FY - TITLE_H, FX + W, FY, fill="black",
                           outline="black", tags="form")
        for x in (FX + 4, FX + W - 17):
            c.create_rectangle(x, FY - TITLE_H + 4, x + 13, FY - 5,
                               fill="#aaaaaa", outline="#dddddd", tags="form")
        c.create_text(FX + W / 2, FY - TITLE_H / 2, text=win["title"],
                      fill="white", font=("Helvetica", 12, "bold"),
                      tags="form")
        try:
            c.create_rectangle(FX - 1, FY, FX + W, FY + H, outline="black",
                               fill=win["bg"] or self.default_bg, tags="form")
        except tk.TclError:
            c.create_rectangle(FX - 1, FY, FX + W, FY + H, outline="black",
                               fill="#ececec", tags="form")
        if self.snap.get():
            for x in range(GRID * 2, W, GRID * 2):
                c.create_line(FX + x, FY + 1, FX + x, FY + H, fill="#dadada",
                              tags="form")
            for y in range(GRID * 2, H, GRID * 2):
                c.create_line(FX, FY + y, FX + W - 1, FY + y, fill="#dadada",
                              tags="form")
        x, y = FX + W, FY + H
        c.create_rectangle(x, y, x + 12, y + 12, fill="#cfcfcf",
                           outline="black", tags=("form", "resizer"))
        for d in (4, 8):
            c.create_line(x + d, y + 11, x + 11, y + d, tags=("form",
                                                             "resizer"))
        c.tag_lower("form")
        self.update_scrollregion()

    def draw_tray(self):
        c = self.canvas
        c.delete("tray")
        names = self.tray_names()
        y = self.tray_y()
        w = max(self.doc["window"]["width"], len(names) * SLOT + 20)
        c.create_rectangle(FX, y, FX + w, y + 92, fill="#a9a9a9",
                           outline="#555", tags="tray")
        c.create_text(FX + 6, y + 4, anchor="nw", text="Objects",
                      font=("Helvetica", 10, "bold"), fill="#333", tags="tray")
        for name in names:
            x0, y0, x1, y1 = self.icon_rect(name)
            if name in self.sel:
                c.create_rectangle(x0 - 10, y0 - 4, x1 + 10, y1 + 20,
                                   fill="#6f8fbf", outline="", tags="tray")
            if name == "controller":
                draw_controller_icon(c, x0 + 2, y0 + 2, 36, "tray")
                label = self.doc["controller"]["classname"]
            else:
                draw_timer_icon(c, x0 + 4, y0 + 4, 32, "tray")
                label = name
            c.create_text((x0 + x1) / 2, y1 + 9, text=label,
                          font=("Helvetica", 10), tags="tray")
        self.update_scrollregion()

    def update_scrollregion(self):
        win = self.doc["window"]
        w = max(win["width"], len(self.tray_names()) * SLOT + 20)
        self.canvas.configure(scrollregion=(0, 0, FX + w + 80,
                                            self.tray_y() + 140))

    def make_widget(self, o):
        try:
            w = make_live(o, self.canvas, self.ns)
        except Exception as ex:
            w = tk.Label(self.canvas, text="%s: %s" % (o["name"], ex),
                         bg="#ffc0c0", anchor="nw", justify="left")
            self.status("%s can't be built: %s" % (o["name"], ex), error=True)
        self.set_design_tags(w)
        self.widgets[o["name"]] = w
        self.items[o["name"]] = self.canvas.create_window(
            FX + o["x"], FY + o["y"], window=w, anchor="nw",
            width=max(o["w"], 1), height=max(o["h"], 1))

    def set_design_tags(self, w):
        w.bindtags(("Design", "all"))
        w.configure(takefocus=0) if "takefocus" in w.keys() else None
        for ch in w.winfo_children():
            self.set_design_tags(ch)

    def rebuild(self, name):
        """Re-create name's widget from the model (raises if it can't)."""
        o = self.obj(name)
        old = self.widgets.pop(name, None)
        if old is not None:
            old.destroy()
            self.canvas.delete(self.items.pop(name))
        w = make_live(o, self.canvas, self.ns)
        self.set_design_tags(w)
        self.widgets[name] = w
        self.items[name] = self.canvas.create_window(
            FX + o["x"], FY + o["y"], window=w, anchor="nw",
            width=max(o["w"], 1), height=max(o["h"], 1))
        self.restack()

    def restack(self):
        for o in self.visible():
            w = self.widgets.get(o["name"])
            if w is not None:
                tk.Misc.tkraise(w)      # (a Canvas's own lift raises items)
        for hs in self.handles.values():
            for f, _ in hs.values():
                f.lift()
        for box in (self.src_box, self.dst_box):
            for f, _ in box.parts:
                f.lift()
        if self.inline:
            self.inline[0].lift()

    def move_widget(self, o):
        item = self.items.get(o["name"])
        if item:
            self.canvas.coords(item, FX + o["x"], FY + o["y"])
            self.canvas.itemconfigure(item, width=max(o["w"], 1),
                                      height=max(o["h"], 1))

    def place_handles(self):
        want = [n for n in self.sel if self.is_visible(n)]
        for n in list(self.handles):
            if n not in want:
                self.drop_handles(n)
        single = len(want) == 1
        cursors = {"nw": "top_left_corner", "ne": "top_right_corner",
                   "sw": "bottom_left_corner", "se": "bottom_right_corner",
                   "n": "sb_v_double_arrow", "s": "sb_v_double_arrow",
                   "e": "sb_h_double_arrow", "w": "sb_h_double_arrow"}
        for n in want:
            x0, y0, x1, y1 = self.rect(n)
            xm, ym = (x0 + x1) / 2, (y0 + y1) / 2
            spots = {"nw": (x0, y0), "n": (xm, y0), "ne": (x1, y0),
                     "e": (x1, ym), "se": (x1, y1), "s": (xm, y1),
                     "sw": (x0, y1), "w": (x0, ym)}
            hs = self.handles.get(n)
            if hs is None:
                hs = self.handles[n] = {}
                for pos in spots:
                    f = tk.Frame(self.canvas, width=HANDLE, height=HANDLE,
                                 bd=0, highlightthickness=1,
                                 highlightbackground="white")
                    f.bindtags(("Handle", "all"))
                    self.handle_of[str(f)] = (n, pos)
                    hs[pos] = (f, self.canvas.create_window(
                        0, 0, window=f, anchor="nw"))
            for pos, (f, item) in hs.items():
                hx, hy = spots[pos]
                self.canvas.coords(item, hx - HANDLE // 2, hy - HANDLE // 2)
                f.configure(bg="black" if single else "#666666",
                            cursor=cursors[pos] if single else "")
                f.lift()

    def drop_handles(self, n):
        for f, item in self.handles.pop(n, {}).values():
            self.handle_of.pop(str(f), None)
            self.canvas.delete(item)
            f.destroy()

    def draw_connections(self):
        c = self.canvas
        c.delete("conn")
        if self.show_all.get():
            conns = self.doc["connections"]
        else:
            conns = [k for k in self.doc["connections"]
                     if k["src"] in self.sel or k["dst"] in self.sel]
        for k in conns:
            self.draw_connection(k, "conn")
        c.tag_raise("conn")

    def draw_connection(self, k, tag, color=None):
        c = self.canvas
        if not (self.obj(k["src"]) and self.obj(k["dst"])):
            return
        r1, r2 = self.rect(k["src"]), self.rect(k["dst"])
        p1, p2 = edge_point(r1, centre(r2)), edge_point(r2, centre(r1))
        outlet = k.get("kind") == "outlet"
        color = color or ("#1d5e1d" if outlet else "black")
        c.create_line(*p1, *p2, width=2, fill=color, tags=tag,
                      dash=(6, 3) if outlet else ())
        for x, y in (p1, p2):
            c.create_rectangle(x - 3, y - 3, x + 3, y + 3, fill=color,
                               outline="white", tags=tag)
        mx, my = (p1[0] + p2[0]) / 2, (p1[1] + p2[1]) / 2
        label = ("outlet " if outlet else "") + k["action"] + \
            ("" if outlet else ":")
        t = c.create_text(mx, my, text=label, font=("Helvetica", 10),
                          fill="black", tags=tag)
        bb = c.bbox(t)
        c.create_rectangle(bb[0] - 3, bb[1] - 1, bb[2] + 3, bb[3] + 1,
                           fill="#ffffe0", outline=color, tags=tag)
        c.tag_raise(t)

    def flash_connection(self, k):
        self.canvas.delete("flash")
        self.draw_connection(k, "flash", "#c00000")
        if self.flash:
            self.root.after_cancel(self.flash)
        self.flash = self.root.after(1500,
                                     lambda: self.canvas.delete("flash"))

    # -- selection

    def select(self, names, commit=True):
        if commit:
            self.inspector.commit()
        self.sel = list(names)
        self.place_handles()
        self.draw_tray()
        self.draw_connections()
        self.inspector.show(self.sel) if commit else self.inspector_reset()
        self.restack()
        if len(self.sel) == 1 and self.is_visible(self.sel[0]):
            o = self.obj(self.sel[0])
            self.status("%s %s   x %d  y %d  w %d  h %d" % (
                o["type"], o["name"], o["x"], o["y"], o["w"], o["h"]))

    def inspector_reset(self):
        self.inspector.rows = []
        self.inspector.body_text = self.inspector.awake_text = None
        self.inspector.show(self.sel)

    def select_all(self):
        self.select([o["name"] for o in self.visible()])

    def escape(self):
        if self.drag and self.drag["kind"] == "connect":
            self.end_connect()
            self.drag = None
        else:
            self.select([])

    # -- mouse

    def cpoint(self, e):
        c = self.canvas
        return (c.canvasx(e.x_root - c.winfo_rootx()),
                c.canvasy(e.y_root - c.winfo_rooty()))

    def press(self, e, connect=False, shift=False):
        self.end_inline_edit()
        self.canvas.focus_set()
        cx, cy = self.cpoint(e)
        hit = self.hit_test(cx, cy)
        self.drag = None
        if connect or self.mode.get() == "connect":
            if hit:
                self.start_connect(hit)
            return
        if hit is None:
            if "resizer" in self.canvas.gettags("current") or \
                    self.on_resizer(cx, cy):
                win = self.doc["window"]
                self.drag = {"kind": "window", "start": (cx, cy),
                             "orig": (win["width"], win["height"]),
                             "snap": self.snapshot(), "moved": False}
                return
            if not shift and self.sel:
                self.select([])
            self.drag = {"kind": "band", "start": (cx, cy),
                         "base": list(self.sel)}
            return
        if shift:
            self.select([n for n in self.sel if n != hit] if hit in self.sel
                        else self.sel + [hit])
            return
        if hit not in self.sel:
            self.select([hit])
        if self.is_visible(hit):
            self.drag = {"kind": "move", "start": (cx, cy), "primary": hit,
                         "orig": {n: (self.obj(n)["x"], self.obj(n)["y"])
                                  for n in self.sel if self.is_visible(n)},
                         "snap": self.snapshot(), "moved": False}

    def on_resizer(self, cx, cy):
        win = self.doc["window"]
        x, y = FX + win["width"], FY + win["height"]
        return x - 2 <= cx <= x + 14 and y - 2 <= cy <= y + 14

    def handle_press(self, e):
        self.end_inline_edit()
        n, pos = self.handle_of.get(str(e.widget), (None, None))
        if n is None or len(self.sel) != 1:
            return
        o = self.obj(n)
        self.drag = {"kind": "resize", "name": n, "pos": pos,
                     "start": self.cpoint(e),
                     "orig": (o["x"], o["y"], o["w"], o["h"]),
                     "snap": self.snapshot(), "moved": False}

    def motion(self, e):
        d = self.drag
        if not d:
            return
        cx, cy = self.cpoint(e)
        dx, dy = cx - d["start"][0], cy - d["start"][1]
        kind = d["kind"]
        if kind in ("move", "resize", "window") and not d["moved"]:
            if abs(dx) + abs(dy) < 3:
                return
            d["moved"] = True
            self.push_undo(d["snap"])
        if kind == "move":
            px, py = d["orig"][d["primary"]]
            ddx, ddy = self.snapv(px + dx) - px, self.snapv(py + dy) - py
            for n, (x, y) in d["orig"].items():
                o = self.obj(n)
                o["x"], o["y"] = x + ddx, y + ddy
                self.move_widget(o)
            self.place_handles()
            self.draw_connections()
            o = self.obj(d["primary"])
            self.status("x %d  y %d" % (o["x"], o["y"]))
        elif kind == "resize":
            o, pos = self.obj(d["name"]), d["pos"]
            x, y, w, h = d["orig"]
            left, top, right, bottom = x, y, x + w, y + h
            if "w" in pos:
                left = min(self.snapv(x + dx), right - 2)
            if "e" in pos:
                right = max(self.snapv(x + w + dx), left + 2)
            if "n" in pos:
                top = min(self.snapv(y + dy), bottom - 2)
            if "s" in pos:
                bottom = max(self.snapv(y + h + dy), top + 2)
            o["x"], o["y"], o["w"], o["h"] = left, top, right - left, \
                bottom - top
            self.move_widget(o)
            self.place_handles()
            self.draw_connections()
            self.status("w %d  h %d" % (o["w"], o["h"]))
        elif kind == "window":
            win = self.doc["window"]
            win["width"] = max(120, self.snapv(d["orig"][0] + dx))
            win["height"] = max(60, self.snapv(d["orig"][1] + dy))
            self.draw_form()
            self.draw_tray()
            self.draw_connections()
            self.status("window %d × %d" % (win["width"], win["height"]))
        elif kind == "band":
            self.canvas.delete("band")
            self.canvas.create_rectangle(*d["start"], cx, cy, outline="white",
                                         dash=(4, 2), tags="band")
            x0, x1 = sorted((d["start"][0], cx))
            y0, y1 = sorted((d["start"][1], cy))
            inside = [o["name"] for o in self.visible()
                      if self.rect(o["name"])[0] < x1
                      and self.rect(o["name"])[2] > x0
                      and self.rect(o["name"])[1] < y1
                      and self.rect(o["name"])[3] > y0]
            d["now"] = d["base"] + [n for n in inside if n not in d["base"]]
        elif kind == "connect":
            self.connect_motion(cx, cy)

    def release(self, e):
        d, self.drag = self.drag, None
        if not d:
            return
        if d["kind"] == "band":
            self.canvas.delete("band")
            if "now" in d:
                self.select(d["now"])
        elif d["kind"] in ("move", "resize") and d["moved"]:
            self.select(self.sel)
        elif d["kind"] == "window" and d["moved"]:
            self.select(self.sel)
        elif d["kind"] == "connect":
            self.finish_connect(d, e)

    def double(self, e):
        cx, cy = self.cpoint(e)
        hit = self.hit_test(cx, cy)
        if hit == "controller":
            self.inspector.nb.select(0)
            return
        if not hit or not self.is_visible(hit):
            return
        o = self.obj(hit)
        keys = [p["key"] for p in TYPES[o["type"]]["props"]]
        key = "text" if "text" in keys else \
            "value" if o["type"] in ("Entry", "Spinbox", "Combobox") else None
        if not key:
            return
        self.drag = None
        ent = tk.Entry(self.canvas, relief="solid", bd=1)
        ent.insert(0, props_of(o)[key])
        ent.select_range(0, "end")
        x0, y0, x1, y1 = self.rect(hit)
        item = self.canvas.create_window(x0, y0, window=ent, anchor="nw",
                                         width=max(x1 - x0, 80),
                                         height=max(y1 - y0, 24))
        self.inline = (ent, item, hit, key)
        ent.focus_set()
        ent.bind("<Return>", lambda e: (self.end_inline_edit(), "break")[1])
        ent.bind("<Escape>", lambda e: self.end_inline_edit(False))
        ent.bind("<FocusOut>", lambda e: self.end_inline_edit())

    def end_inline_edit(self, keep=True):
        if not self.inline:
            return
        ent, item, name, key = self.inline
        self.inline = None
        text = ent.get()
        self.canvas.delete(item)
        ent.destroy()
        if keep and self.obj(name) and text != props_of(self.obj(name))[key]:
            self.set_prop(name, key, text)
            self.select(self.sel, commit=False)
        self.canvas.focus_set()

    def wheel(self, e):
        w = self.root.winfo_containing(e.x_root, e.y_root)
        if w is None:
            return
        s = str(w)
        if s.startswith(str(self.canvas)):
            target = self.canvas
        elif s.startswith(str(self.inspector.attr.canvas)) and \
                w.winfo_class() not in ("Text", "Listbox", "TCombobox"):
            target = self.inspector.attr.canvas
        else:
            return
        if e.num == 4:
            n = -1
        elif e.num == 5:
            n = 1
        elif abs(e.delta) >= 120:
            n = -int(e.delta / 120)
        else:
            n = -1 if e.delta > 0 else 1
        if e.state & 1:
            target.xview_scroll(n, "units")
        else:
            target.yview_scroll(n, "units")

    # -- connecting

    def start_connect(self, src):
        t = self.type_of(src)
        if src != "controller" and not TYPES[t].get("source"):
            self.status("A %s sends no actions.  Drag from a control (button, "
                        "slider, field, timer …), or from the Controller to "
                        "make an outlet." % t, error=True)
            return
        self.drag = {"kind": "connect", "src": src, "dst": None,
                     "start": centre(self.rect(src))}
        self.src_box.show(self.rect(src))
        self.status("Drag to the target and let go…")

    def valid_target(self, src, dst):
        if dst is None or dst == src:
            return False
        if src == "controller":
            return True
        return dst == "controller" or bool(TYPES[self.type_of(dst)]["actions"])

    def connect_motion(self, cx, cy):
        d = self.drag
        c = self.canvas
        c.delete("rubber")
        dst = self.hit_test(cx, cy, exclude=d["src"])
        if not self.valid_target(d["src"], dst):
            dst = None
        d["dst"] = dst
        if dst:
            self.dst_box.show(self.rect(dst))
            end = edge_point(self.rect(dst), centre(self.rect(d["src"])))
        else:
            self.dst_box.hide()
            end = (cx, cy)
        start = edge_point(self.rect(d["src"]), end)
        c.create_line(*start, *end, width=2, fill="#202020", tags="rubber")
        for x, y in (start, end):
            c.create_rectangle(x - 3, y - 3, x + 3, y + 3, fill="black",
                               outline="white", tags="rubber")
        c.tag_raise("rubber")

    def end_connect(self):
        self.canvas.delete("rubber")
        self.src_box.hide()
        self.dst_box.hide()

    def finish_connect(self, d, e):
        src, dst = d["src"], d.get("dst")
        if not dst:
            self.end_connect()
            self.status("")
            return
        if src == "controller":
            self.end_connect()
            self.make_outlet(dst)
            return
        m = tk.Menu(self.root, tearoff=0)
        if dst == "controller":
            m.add_command(label="Actions of %s"
                          % self.doc["controller"]["classname"],
                          state="disabled")
            for a in self.doc["controller"]["actions"]:
                m.add_command(label="   %s:" % a, command=lambda a=a:
                              self.connect(src, dst, a))
            m.add_separator()
            m.add_command(label="New Action…",
                          command=lambda: self.new_action_connect(src))
            m.add_command(label="quit:   — close the window",
                          command=lambda: self.connect(src, dst, "quit"))
        else:
            m.add_command(label="Actions of %s" % dst, state="disabled")
            for a in TYPES[self.type_of(dst)]["actions"]:
                m.add_command(label="   %s:   — %s" % (a, ACTION_HELP[a]),
                              command=lambda a=a: self.connect(src, dst, a))
        m.bind("<Unmap>", lambda ev: self.root.after(50, self.end_connect))
        try:
            m.tk_popup(e.x_root, e.y_root)
        finally:
            m.grab_release()
        self.root.after(50, self.end_connect) if MAC else None

    def new_action_connect(self, src):
        name = self.ask_action_name()
        if name:
            self.add_action(name, checkpoint=True)
            self.connect(src, "controller", name, checkpoint=False)

    def ask_action_name(self, initial=""):
        while True:
            name = simpledialog.askstring(
                "Action", "Name of the action method:",
                initialvalue=initial, parent=self.root)
            if name is None:
                return None
            name = name.strip().rstrip(":")
            if not valid_ident(name):
                messagebox.showerror("Action", "%r isn't a valid Python "
                                     "name." % name, parent=self.root)
            elif name in self.doc["controller"]["actions"] and \
                    name != initial:
                messagebox.showerror("Action", "There is already an action "
                                     "called %s." % name, parent=self.root)
            elif name in ("awakeFromNib", "ui", "quit") or \
                    name.startswith("__") or name in self.outlet_names():
                messagebox.showerror("Action", "%s is already used by the "
                                     "Controller." % name, parent=self.root)
            else:
                return name
            initial = name

    def outlet_names(self):
        return [c["action"] for c in self.doc["connections"]
                if c.get("kind") == "outlet"]

    def make_outlet(self, dst):
        name = dst
        while True:
            name = simpledialog.askstring(
                "Outlet", "Make a Controller outlet (attribute) that refers "
                "to %s.\n\nOutlet name:" % dst, initialvalue=name,
                parent=self.root)
            if name is None:
                return
            name = name.strip()
            if not valid_ident(name) or name in ("ui", "awakeFromNib") or \
                    name in self.doc["controller"]["actions"]:
                messagebox.showerror("Outlet", "%r can't be used as an "
                                     "outlet name." % name, parent=self.root)
                continue
            break
        self.push_undo()
        self.doc["connections"] = [c for c in self.doc["connections"]
                                   if not (c.get("kind") == "outlet"
                                           and c["action"] == name)]
        self.doc["connections"].append({"src": "controller", "dst": dst,
                                        "action": name, "kind": "outlet"})
        self.after_connect("controller", "Outlet %s now refers to %s."
                           % (name, dst))

    def connect(self, src, dst, action, checkpoint=True):
        self.end_connect()
        k = {"src": src, "dst": dst, "action": action, "kind": "action"}
        if k in self.doc["connections"]:
            self.status("Already connected.")
            return
        if checkpoint:
            self.push_undo()
        self.doc["connections"].append(k)
        self.after_connect(src, "Connected: %s → %s %s:" % (src, dst, action))

    def after_connect(self, src, msg):
        self.select([src])
        self.inspector.nb.select(2)
        self.status(msg)

    def disconnect(self, k):
        self.push_undo()
        self.doc["connections"].remove(k)
        self.select(self.sel)
        self.inspector.nb.select(2)

    def describe(self, k, me):
        if k.get("kind") == "outlet":
            return "outlet %s → %s" % (k["action"], k["dst"])
        if me == k["src"]:
            return "→ %s  %s:" % (k["dst"], k["action"])
        if me == k["dst"]:
            return "← %s  %s:" % (k["src"], k["action"])
        return "%s → %s  %s:" % (k["src"], k["dst"], k["action"])

    # -- changing things

    def drop(self, t, xr, yr):
        w = self.root.winfo_containing(xr, yr)
        if w is None or not str(w).startswith(str(self.canvas)):
            self.status("Drop objects onto the window.")
            return
        c = self.canvas
        cx, cy = c.canvasx(xr - c.winfo_rootx()), c.canvasy(yr - c.winfo_rooty())
        if TYPES[t].get("nonvisual"):
            self.add_object(t)
            return
        win = self.doc["window"]
        dw, dh = TYPES[t]["size"]
        x = min(max(cx - FX - dw / 2, 0), max(win["width"] - dw, 0))
        y = min(max(cy - FY - dh / 2, 0), max(win["height"] - dh, 0))
        self.add_object(t, self.snapv(x), self.snapv(y))

    def add_object(self, t, x=None, y=None):
        self.push_undo()
        dw, dh = TYPES[t].get("size", (0, 0))
        if x is None:
            k = len(self.doc["objects"]) % 8
            x, y = self.snapv(16 + k * 16), self.snapv(16 + k * 16)
        o = {"type": t, "name": self.next_name(t), "x": x, "y": y,
             "w": dw, "h": dh, "anchors": "nw",
             "props": {p["key"]: p["default"] for p in TYPES[t]["props"]}}
        if t == "Radiobutton":
            o["props"]["text"] = "Option %s" % o["name"][len("radiobutton"):]
        self.doc["objects"].append(o)
        if is_visual(o):
            self.make_widget(o)
        self.draw_tray()
        self.select([o["name"]])
        self.canvas.focus_set()
        self.status("Added %s." % o["name"])

    def set_prop(self, name, key, value):
        o = self.obj(name)
        snap = self.snapshot()
        old = copy.deepcopy(o["props"])
        if key == "group" and not valid_ident(value):
            self.status("A group name must be a Python name.", error=True)
            return False
        o["props"][key] = value
        if o["type"] == "Radiobutton" and key == "value" and value:
            for other in self.doc["objects"]:
                if other is not o and other["type"] == "Radiobutton" and \
                        props_of(other)["group"] == props_of(o)["group"]:
                    other["props"]["value"] = False
        if is_visual(o):
            try:
                self.rebuild(name)
            except Exception as ex:
                o["props"] = old
                self.rebuild(name)
                self.status("%s: %s" % (key, ex), error=True)
                return False
            self.place_handles()
        self.push_undo(snap)
        self.status("")
        return True

    def set_geom(self, name, key, value):
        o = self.obj(name)
        if key in ("w", "h") and value < 1:
            return False
        self.push_undo()
        o[key] = value
        self.move_widget(o)
        self.place_handles()
        self.draw_connections()

    def set_anchors(self, name, anchors):
        self.push_undo()
        self.obj(name)["anchors"] = "".join(k for k in "nsew" if k in anchors)

    def set_window(self, key, value):
        win = self.doc["window"]
        if key in ("width", "height") and value < 40:
            return False
        if key == "bg" and value:
            try:
                self.root.winfo_rgb(value)
            except tk.TclError:
                self.status("Unknown colour %r." % value, error=True)
                return False
        self.push_undo()
        win[key] = value
        self.draw_form()
        self.draw_tray()
        self.draw_connections()

    def name_problem(self, new, old=None):
        if not valid_ident(new):
            return "%r isn't a valid Python name." % new
        if new in RESERVED or new.endswith(("_var", "_action")):
            return "%s is reserved." % new
        if new == "controller" or (new != old and self.obj(new)):
            return "There is already an object called %s." % new
        return None

    def rename(self, old, new):
        if new == old:
            return True
        problem = self.name_problem(new, old)
        if problem:
            self.status(problem, error=True)
            return False
        self.push_undo()
        self.obj(old)["name"] = new
        for k in self.doc["connections"]:
            for end in ("src", "dst"):
                if k[end] == old:
                    k[end] = new
        self.sel = [new if n == old else n for n in self.sel]
        self.inspector.name = new
        self.inspector.head.configure(text=new)
        if old in self.widgets:
            self.drop_handles(old)
            self.widgets[new] = self.widgets.pop(old)
            self.items[new] = self.items.pop(old)
            setattr(self.ns, new, getattr(self.ns, old, None))
        self.place_handles()
        self.draw_tray()
        self.draw_connections()
        return True

    def set_classname(self, v):
        if not valid_ident(v):
            self.status("%r isn't a valid class name." % v, error=True)
            return False
        if v in ("Interface", "Timer"):
            self.status("%s is used by the generated code." % v, error=True)
            return False
        self.push_undo()
        self.doc["controller"]["classname"] = v
        self.inspector.head.configure(text=v)
        self.draw_tray()

    def set_awake(self, body):
        if body != self.doc["controller"].get("awake", "pass"):
            self.push_undo()
            self.doc["controller"]["awake"] = body

    def add_action(self, name, checkpoint=True):
        if checkpoint:
            self.push_undo()
        self.doc["controller"]["actions"][name] = default_action_body(name)

    def set_action_body(self, name, body):
        acts = self.doc["controller"]["actions"]
        if name in acts and acts[name] != body:
            self.push_undo()
            acts[name] = body

    def rename_action(self, old, new):
        if old == new:
            return False
        self.push_undo()
        acts = self.doc["controller"]["actions"]
        self.doc["controller"]["actions"] = {
            (new if k == old else k): v for k, v in acts.items()}
        for k in self.doc["connections"]:
            if k["dst"] == "controller" and k["action"] == old:
                k["action"] = new
        self.draw_connections()
        return True

    def remove_action(self, name):
        used = [k for k in self.doc["connections"]
                if k["dst"] == "controller" and k["action"] == name]
        if used and not messagebox.askyesno(
                "Remove Action", "%s is connected to %d control(s).  Remove "
                "it and its connections?" % (name, len(used)),
                parent=self.root):
            return
        self.push_undo()
        del self.doc["controller"]["actions"][name]
        for k in used:
            self.doc["connections"].remove(k)
        self.draw_connections()

    def delete_selection(self):
        names = [n for n in self.sel if n != "controller"]
        if not names:
            return
        self.push_undo()
        self.remove_objects(names)
        self.select([])

    def remove_objects(self, names):
        for n in names:
            self.drop_handles(n)
            w = self.widgets.pop(n, None)
            if w is not None:
                w.destroy()
                self.canvas.delete(self.items.pop(n))
        self.doc["objects"] = [o for o in self.doc["objects"]
                               if o["name"] not in names]
        self.doc["connections"] = [k for k in self.doc["connections"]
                                   if k["src"] not in names
                                   and k["dst"] not in names]
        self.sel = [n for n in self.sel if n not in names]
        self.draw_tray()
        self.draw_connections()

    def nudge(self, dx, dy):
        objs = [self.obj(n) for n in self.sel if self.is_visible(n)]
        if not objs:
            return
        if time.time() - self.last_nudge > 1.0:
            self.push_undo()
        self.last_nudge = time.time()
        for o in objs:
            o["x"] += dx
            o["y"] += dy
            self.move_widget(o)
        self.place_handles()
        self.draw_connections()
        self.select(self.sel, commit=False)

    def copy(self):
        names = [n for n in self.sel if n != "controller"]
        if not names:
            return
        self.clip = {"objects": [copy.deepcopy(self.obj(n)) for n in names],
                     "connections": [copy.deepcopy(k) for k in
                                     self.doc["connections"]
                                     if k["src"] in names + ["controller"]
                                     and k["dst"] in names + ["controller"]
                                     and k.get("kind") != "outlet"]}
        self.status("Copied %d object(s)." % len(names))

    def cut(self):
        self.copy()
        self.delete_selection()

    def paste(self, offset=16):
        if not self.clip:
            return
        self.push_undo()
        rename = {}
        new = []
        for o in copy.deepcopy(self.clip["objects"]):
            old = o["name"]
            o["name"] = self.next_name(o["type"]) if self.obj(old) else old
            rename[old] = o["name"]
            if is_visual(o) and any(
                    (p["x"], p["y"]) == (o["x"], o["y"])
                    for p in self.visible()):
                o["x"] += offset
                o["y"] += offset
            self.doc["objects"].append(o)
            new.append(o)
        rename["controller"] = "controller"
        for k in self.clip["connections"]:
            k = dict(k, src=rename[k["src"]], dst=rename[k["dst"]])
            if k not in self.doc["connections"]:
                self.doc["connections"].append(k)
        for o in new:
            if is_visual(o):
                self.make_widget(o)
        self.restack()
        self.draw_tray()
        self.select([o["name"] for o in new])

    def duplicate(self):
        saved = self.clip
        self.copy()
        self.paste()
        self.clip = saved

    def restack_sel(self, front):
        names = set(self.sel)
        if not names:
            return
        self.push_undo()
        objs = self.doc["objects"]
        chosen = [o for o in objs if o["name"] in names]
        rest = [o for o in objs if o["name"] not in names]
        self.doc["objects"] = rest + chosen if front else chosen + rest
        self.restack()
        self.status("Brought to front." if front else "Sent to back.")

    def align(self, how):
        objs = [self.obj(n) for n in self.sel if self.is_visible(n)]
        need = 1 if how in ("winh", "winv", "default") else 2
        if len(objs) < need:
            self.status("Select %s object%s first."
                        % ("an" if need == 1 else "two or more",
                           "" if need == 1 else "s"), error=True)
            return
        self.push_undo()
        W, H = self.doc["window"]["width"], self.doc["window"]["height"]
        first = self.obj(self.sel[0]) if self.is_visible(self.sel[0]) \
            else objs[0]
        for o in objs:
            if how == "left":
                o["x"] = min(p["x"] for p in objs)
            elif how == "right":
                o["x"] = max(p["x"] + p["w"] for p in objs) - o["w"]
            elif how == "top":
                o["y"] = min(p["y"] for p in objs)
            elif how == "bottom":
                o["y"] = max(p["y"] + p["h"] for p in objs) - o["h"]
            elif how == "hcentre":
                o["x"] = first["x"] + (first["w"] - o["w"]) // 2
            elif how == "vcentre":
                o["y"] = first["y"] + (first["h"] - o["h"]) // 2
            elif how == "winh":
                o["x"] = (W - o["w"]) // 2
            elif how == "winv":
                o["y"] = (H - o["h"]) // 2
            elif how == "width":
                o["w"] = first["w"]
            elif how == "height":
                o["h"] = first["h"]
            elif how == "default":
                o["w"], o["h"] = TYPES[o["type"]]["size"]
            self.move_widget(o)
        self.select(self.sel)

    # -- files

    def ask_save_changes(self):
        """False if the user cancels."""
        if not self.dirty:
            return True
        r = messagebox.askyesnocancel(
            "tkinterface", "Save the changes to %s?"
            % (os.path.basename(self.path) if self.path else "this interface"),
            parent=self.root)
        if r is None:
            return False
        return self.save() if r else True

    def new(self):
        if not self.ask_save_changes():
            return
        self.stop_test()
        self.doc, self.path, self.dirty = new_doc(), None, False
        self.undo_stack.clear()
        self.redo_stack.clear()
        self.sel = []
        self.redraw_all()
        self.select([], commit=False)
        self.update_title()

    def open(self):
        if not self.ask_save_changes():
            return
        p = filedialog.askopenfilename(
            parent=self.root, filetypes=[("tkinterface", "*.tkif"),
                                         ("All files", "*")])
        if p:
            self.load(p)

    def open_document(self, *paths):
        if paths and self.ask_save_changes():
            self.load(paths[0])

    def load(self, path):
        try:
            with open(path) as f:
                doc = json.load(f)
            if doc.get("format") != "tkinterface":
                raise ValueError("not a tkinterface document")
        except (OSError, ValueError) as ex:
            messagebox.showerror("Open", "Can't open %s:\n%s" % (path, ex),
                                 parent=self.root)
            return
        base = new_doc()
        for k in ("window", "controller"):
            base[k].update(doc.get(k, {}))
        base["objects"] = [o for o in doc.get("objects", [])
                           if o.get("type") in TYPES]
        base["connections"] = doc.get("connections", [])
        self.stop_test()
        self.doc, self.path, self.dirty = base, os.path.abspath(path), False
        self.undo_stack.clear()
        self.redo_stack.clear()
        self.sel = []
        self.redraw_all()
        self.select([], commit=False)
        self.update_title()
        self.status("Opened %s." % path)

    def save(self):
        if not self.path:
            return self.save_as()
        self.inspector.commit()
        try:
            with open(self.path, "w") as f:
                json.dump(self.doc, f, indent=1)
                f.write("\n")
        except OSError as ex:
            messagebox.showerror("Save", str(ex), parent=self.root)
            return False
        self.dirty = False
        self.update_title()
        self.status("Saved %s." % self.path)
        return True

    def save_as(self):
        p = filedialog.asksaveasfilename(
            parent=self.root, defaultextension=".tkif",
            initialfile=os.path.basename(self.path) if self.path
            else "untitled.tkif", filetypes=[("tkinterface", "*.tkif")])
        if not p:
            return False
        self.path = os.path.abspath(p)
        return self.save()

    def quit(self):
        self.inspector.commit()
        if self.ask_save_changes():
            self.root.destroy()

    # -- code

    def code(self):
        self.inspector.commit()
        return generate(self.doc, self.path or "")

    def generate_code(self):
        code = self.code()
        base = os.path.splitext(self.path)[0] if self.path else "untitled"
        p = filedialog.asksaveasfilename(
            parent=self.root, defaultextension=".py",
            initialdir=os.path.dirname(base) or None,
            initialfile=os.path.basename(base) + ".py",
            filetypes=[("Python", "*.py"), ("All files", "*")])
        if not p:
            return
        try:
            with open(p, "w") as f:
                f.write(code)
            os.chmod(p, 0o755)
        except OSError as ex:
            messagebox.showerror("Generate Code", str(ex), parent=self.root)
            return
        self.status("Wrote %s." % p)

    def show_code(self, line=None):
        code = self.code()
        top = tk.Toplevel(self.root)
        top.title("Generated code — %s" % self.doc["window"]["title"])
        top.geometry("780x700")
        bar = ttk.Frame(top, padding=4)
        bar.pack(fill="x")
        t = tk.Text(top, font=MONO, wrap="none", undo=False)
        ys = ttk.Scrollbar(top, command=t.yview)
        t.configure(yscrollcommand=ys.set)
        ys.pack(side="right", fill="y")
        t.pack(fill="both", expand=True)
        t.insert("1.0", code)
        highlight(t)
        t.configure(state="disabled")

        def copy_all():
            top.clipboard_clear()
            top.clipboard_append(code)
            self.status("Code copied to the clipboard.")
        ttk.Button(bar, text="Copy", command=copy_all).pack(side="left")
        ttk.Button(bar, text="Save As…", command=self.generate_code) \
            .pack(side="left", padx=4)
        ttk.Button(bar, text="Close", command=top.destroy).pack(side="right")
        if line:
            t.tag_add("error", "%d.0" % line, "%d.end" % line)
            t.tag_configure("error", background="#ffc8c8")
            t.see("%d.0" % line)

    # -- testing

    def test_interface(self):
        self.stop_test()
        code = self.code()
        try:
            compiled = compile(code, "<interface>", "exec")
        except SyntaxError as ex:
            messagebox.showerror("Test Interface", "The controller's code "
                                 "has a syntax error:\n\n%s (line %s)"
                                 % (ex.msg, ex.lineno), parent=self.root)
            self.show_code(ex.lineno)
            return
        con = self.open_console()
        con.write("── testing %s ──\n" % self.doc["window"]["title"])
        ns = {"__name__": "tkinterface_test", "print": con.print}
        top = tk.Toplevel(self.root)
        self.test = top
        self.saved_report = self.root.report_callback_exception
        self.root.report_callback_exception = \
            lambda *exc: con.write("".join(traceback.format_exception(*exc)),
                                   "err")
        top.bind("<Destroy>", lambda e: self.test_ended()
                 if e.widget is top else None)
        try:
            exec(compiled, ns)
            ctl = ns[self.doc["controller"]["classname"]]()
            ns["Interface"](top, ctl)
            x = self.root.winfo_rootx() + 260
            top.geometry("+%d+%d" % (x, self.root.winfo_rooty() + 80))
            top.lift()
            top.focus_force()
        except Exception:
            con.write(traceback.format_exc(), "err")
            self.stop_test()
            return
        self.status("Testing: close the test window to stop.")

    def test_ended(self):
        if self.test is None:
            return
        self.test = None
        self.root.report_callback_exception = self.saved_report
        if self.console and self.console.top.winfo_exists():
            self.console.write("── test ended ──\n\n", "note")
        self.status("Test ended.")

    def stop_test(self):
        if self.test is not None and self.test.winfo_exists():
            self.test.destroy()
        self.test_ended()

    def open_console(self):
        if self.console and self.console.top.winfo_exists():
            self.console.top.deiconify()
            return self.console
        self.console = Console(self)
        return self.console

    def help(self):
        messagebox.showinfo("tkinterface", __doc__.split("Usage:")[0].strip(),
                            parent=self.root)


class Console:
    """Where a test's print() output and tracebacks go."""

    def __init__(self, app):
        self.top = top = tk.Toplevel(app.root)
        top.title("Test Console")
        top.geometry("560x260+%d+%d" % (app.root.winfo_rootx() + 260,
                                         app.root.winfo_rooty() + 520))
        bar = ttk.Frame(top, padding=3)
        bar.pack(fill="x")
        ttk.Button(bar, text="Clear",
                   command=lambda: self.text.delete("1.0", "end")) \
            .pack(side="left")
        ttk.Button(bar, text="Stop Test", command=app.stop_test) \
            .pack(side="left", padx=4)
        self.text = tk.Text(top, font=MONO, height=10, wrap="word")
        self.text.pack(fill="both", expand=True)
        self.text.tag_configure("err", foreground="#c00000")
        self.text.tag_configure("note", foreground="#777777")

    def write(self, s, tag=None):
        if self.top.winfo_exists():
            self.text.insert("end", s, tag)
            self.text.see("end")

    def print(self, *args, sep=" ", end="\n", file=None, flush=False):
        self.write(sep.join(str(a) for a in args) + end)


def highlight(t):
    """A little Python syntax colouring for the code viewer."""
    t.tag_configure("kw", foreground="#8a1a8a")
    t.tag_configure("str", foreground="#1a6a1a")
    t.tag_configure("com", foreground="#888888")
    t.tag_configure("def", foreground="#1a3aa0")
    text = t.get("1.0", "end-1c")
    pats = [("str", r'"""[\s\S]*?"""|"(?:\\.|[^"\\\n])*"|\'(?:\\.|[^\'\\\n])*\''),
            ("com", r"#[^\n]*"),
            ("kw", r"\b(?:%s)\b" % "|".join(keyword.kwlist)),
            ("def", r"(?<=\bdef )\w+|(?<=\bclass )\w+")]
    taken = []
    for tag, pat in pats:
        for m in re.finditer(pat, text):
            if any(a <= m.start() < b for a, b in taken):
                continue
            if tag in ("str", "com"):
                taken.append((m.start(), m.end()))
            t.tag_add(tag, "1.0+%dc" % m.start(), "1.0+%dc" % m.end())


