class ScrollFrame(ttk.Frame):
    def __init__(self, master):
        super().__init__(master)
        self.canvas = tk.Canvas(self, highlightthickness=0, bd=0)
        sb = ttk.Scrollbar(self, orient="vertical", command=self.canvas.yview)
        self.canvas.configure(yscrollcommand=sb.set)
        self.inner = ttk.Frame(self.canvas, padding=8)
        self.win = self.canvas.create_window(0, 0, window=self.inner,
                                             anchor="nw")
        self.canvas.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        self.inner.bind("<Configure>", lambda e: self.canvas.configure(
            scrollregion=self.canvas.bbox("all")))
        self.canvas.bind("<Configure>", lambda e: self.canvas.itemconfigure(
            self.win, width=e.width))

    def clear(self):
        for c in self.inner.winfo_children():
            c.destroy()
        self.canvas.yview_moveto(0)


class Outline:
    """Four thin frames framing a rectangle on the canvas (canvas lines would
    be hidden behind the embedded widgets)."""

    def __init__(self, canvas, color, t=2):
        self.canvas, self.t = canvas, t
        self.parts = []
        for _ in range(4):
            f = tk.Frame(canvas, bg=color, bd=0, highlightthickness=0)
            f.bindtags(("Design", "all"))
            self.parts.append((f, None))
        self.shown = None

    def show(self, r):
        if r == self.shown:
            return
        self.hide()
        x0, y0, x1, y1 = r[0] - 3, r[1] - 3, r[2] + 3, r[3] + 3
        t = self.t
        boxes = [(x0, y0, x1 - x0, t), (x0, y1 - t, x1 - x0, t),
                 (x0, y0, t, y1 - y0), (x1 - t, y0, t, y1 - y0)]
        self.parts = [(f, self.canvas.create_window(
            x, y, window=f, anchor="nw", width=w, height=h))
            for (f, _), (x, y, w, h) in zip(self.parts, boxes)]
        for f, _ in self.parts:
            f.lift()
        self.shown = r

    def hide(self):
        for f, item in self.parts:
            if item:
                self.canvas.delete(item)
        self.parts = [(f, None) for f, _ in self.parts]
        self.shown = None


class Row:
    """One editable attribute in the Inspector."""

    def __init__(self, get, show, setter, value):
        self.get, self.show, self.setter, self.value = get, show, setter, value

    def apply(self, app):
        try:
            v = self.get()
        except ValueError:
            app.status("That isn't a valid value.", error=True)
            self.show(self.value)
            return
        if v == self.value:
            return
        if self.setter(v) is False:
            self.show(self.value)
        else:
            self.value = v


