def P(key, kind, default, opt=None, choices=None, label=None):
    """A property: kind is str, text, ident, int, float, bool, choice, color
    or font; opt is the Tk option it sets (None for values set otherwise)."""
    return {"key": key, "kind": kind, "default": default, "opt": opt,
            "choices": choices, "label": label or key}


