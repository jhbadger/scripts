def lit(v):
    return repr(num(v))


def ctor_kwargs(o):
    """The keyword arguments o's widget is created with."""
    kw = {}
    for p in TYPES[o["type"]]["props"]:
        if not p["opt"] or p["key"] == "state":
            continue
        v = props_of(o)[p["key"]]
        if v == "" and p["kind"] in ("color", "font"):
            continue
        kw[p["opt"]] = num(v)
    if o["type"] == "Combobox":
        kw["values"] = items_of(o)
    return kw


def items_of(o):
    return [s for s in props_of(o)["items"].splitlines() if s.strip()]


def radio_value(o):
    p = props_of(o)
    return p["choice"] or p["text"]


def widget_lines(o):
    """Python that creates o's widget as self.<name>, child of `master`."""
    t, typ, p = TYPES[o["type"]], o["type"], props_of(o)
    me = "self." + o["name"]
    args = "".join(", %s=%s" % (k, repr(v)) for k, v in ctor_kwargs(o).items())
    out = ["%s = %s(master%s)" % (me, t["cls"], args)]
    if typ == "Spinbox":
        out.append('%s.delete(0, "end")' % me)
    if typ in ("Entry", "Spinbox") and p["value"] != "":
        out.append("%s.insert(0, %r)" % (me, p["value"]))
    elif typ == "Text" and p["value"]:
        out.append('%s.insert("1.0", %r)' % (me, p["value"]))
    elif typ == "Checkbutton":
        out.append("%s.var = tk.BooleanVar(master, value=%r)"
                   % (me, bool(p["value"])))
        out.append("%s.configure(variable=%s.var)" % (me, me))
    elif typ == "Radiobutton":
        g = "self.%s_var" % p["group"]
        out.append("%s.var = %s" % (me, g))
        out.append("%s.configure(variable=%s, value=%r)"
                   % (me, g, radio_value(o)))
        if p["value"]:
            out.append("%s.set(%r)" % (g, radio_value(o)))
    elif typ == "Scale":
        out.append("%s.set(%s)" % (me, lit(p["value"])))
    elif typ == "Listbox" and items_of(o):
        out.append('%s.insert("end", *%r)' % (me, items_of(o)))
    elif typ == "Combobox":
        out.append("%s.set(%r)" % (me, p["value"]))
    if "state" in p and p["state"] != "normal":
        out.append("%s.configure(state=%r)" % (me, p["state"]))
    return out


def place_args(o, W, H):
    """place() arguments honouring o's anchors (its 'springs')."""
    a, x, y, w, h = o.get("anchors", "nw"), o["x"], o["y"], o["w"], o["h"]
    args = []
    for lo, hi, pos, size, total, rel, rsize in (
            ("w", "e", x, w, W, "relx", "relwidth"),
            ("n", "s", y, h, H, "rely", "relheight")):
        p, s = rel[-1], "width" if rel == "relx" else "height"
        if lo in a and hi in a:
            args += ["%s=%d" % (p, pos), "%s=1.0" % rsize,
                     "%s=%d" % (s, size - total)]
        elif hi in a:
            args += ["%s=1.0" % rel, "%s=%d" % (p, pos - total),
                     "%s=%d" % (s, size)]
        elif lo in a:
            args += ["%s=%d" % (p, pos), "%s=%d" % (s, size)]
        else:
            args += ["%s=%.4g" % (rel, pos / total), "%s=%d" % (s, size)]
    return ", ".join(args)


def indent(body, n):
    lines = body.expandtabs(4).rstrip().splitlines()
    if not any(s.strip() for s in lines):
        lines = ["pass"]
    return [(" " * n + s) if s.strip() else "" for s in lines]


def generate(doc, source=""):
    """The whole standalone program for doc."""
    win, ctl = doc["window"], doc["controller"]
    W, H, cls = win["width"], win["height"], ctl["classname"]
    objs = doc["objects"]
    names = {o["name"]: o for o in objs}
    conns = doc["connections"]
    outlets = [c for c in conns if c.get("kind") == "outlet"]
    out = []
    w = out.append
    w("#!/usr/bin/env python3")
    w('"""%s - a Tk interface generated by tkinterface%s.'
      % (win["title"], " from " + os.path.basename(source) if source else ""))
    w("")
    w("The Interface class builds the window and makes its connections; it is")
    w("rewritten each time the code is generated.  Put behaviour in the")
    w("%s class (whose action methods can be edited in tkinterface's" % cls)
    w('Inspector, so they survive regeneration)."""')
    w("")
    w("import tkinter as tk")
    w("from tkinter import ttk")
    w("")
    w(TIMER_CODE)
    w("")
    w("class %s:" % cls)
    w('    """Receives the actions sent by the interface\'s controls."""')
    w("")
    w("    def __init__(self):")
    w("        self.ui = None    # the Interface, set when the window is built")
    for c in outlets:
        w("        self.%s = None    # outlet: %s" % (c["action"], c["dst"]))
    w("")
    w("    def awakeFromNib(self):")
    w('        """Called once the interface is built and connected."""')
    out += indent(ctl.get("awake", "pass"), 8)
    for a, body in ctl["actions"].items():
        w("")
        w("    def %s(self, sender):" % a)
        out += indent(body, 8)
    w("")
    w("")
    w("class Interface:")
    w('    """The window: its objects are attributes, named as in tkinterface."""')
    w("")
    w("    def __init__(self, master, controller):")
    w("        self.master = master")
    w("        self.controller = controller")
    w("        master.title(%r)" % win["title"])
    w('        master.geometry("%dx%d")' % (W, H))
    if not win.get("resizable", True):
        w("        master.resizable(False, False)")
    if win.get("bg"):
        w("        master.configure(bg=%r)" % win["bg"])
    groups = []
    for o in objs:
        if o["type"] == "Radiobutton" and props_of(o)["group"] not in groups:
            groups.append(props_of(o)["group"])
    if groups:
        w("")
        for g in groups:
            w('        self.%s_var = tk.StringVar(master, value="<none>")' % g)
    for o in objs:
        w("")
        if is_visual(o):
            out += ["        " + s for s in widget_lines(o)]
            w("        self.%s.place(%s)" % (o["name"], place_args(o, W, H)))
        else:
            p = props_of(o)
            w("        self.%s = Timer(master, %d, %r)"
              % (o["name"], p["interval"], bool(p["repeat"])))
    sources = [o for o in objs
               if any(c["src"] == o["name"] and c.get("kind") != "outlet"
                      for c in conns)]
    if sources:
        w("")
        w("        # target / action connections")
    for o in sources:
        me, m = "self." + o["name"], "self.%s_action" % o["name"]
        s = TYPES[o["type"]]["source"]
        if s == "command":
            w("        %s.configure(command=%s)" % (me, m))
        elif s == "return":
            w('        %s.bind("<Return>", %s)' % (me, m))
        elif s == "spin":
            w("        %s.configure(command=%s)" % (me, m))
            w('        %s.bind("<Return>", %s)' % (me, m))
        elif s == "click":
            w("        self.on_click(%s, %s)" % (me, m))
        elif s == "timer":
            w("        %s.action = %s" % (me, m))
        else:
            w("        %s.bind(%r, %s)" % (me, s, m))
    w("")
    w("        controller.ui = self")
    for c in outlets:
        w("        controller.%s = self.%s" % (c["action"], c["dst"]))
    w("        controller.awakeFromNib()")
    for o in objs:
        if o["type"] == "Timer" and props_of(o)["autostart"]:
            w("        self.%s.start()" % o["name"])
    for o in sources:
        w("")
        w("    def %s_action(self, *args):" % o["name"])
        w('        """Sent when %s %s."""'
          % (o["name"], SOURCE_HELP[TYPES[o["type"]]["source"]]))
        for c in conns:
            if c["src"] != o["name"] or c.get("kind") == "outlet":
                continue
            s, d = "self." + c["src"], "self." + c["dst"]
            if c["dst"] == "controller":
                if c["action"] == "quit":
                    w("        self.master.destroy()")
                else:
                    w("        self.controller.%s(%s)" % (c["action"], s))
            elif c["dst"] in names:
                w("        " + ACTION_CODE[c["action"]].format(s=s, d=d))
    out += RUNTIME.rstrip().split("\n")
    w("")
    w("")
    w("def main():")
    w("    root = tk.Tk()")
    w("    Interface(root, %s())" % cls)
    w("    root.mainloop()")
    w("")
    w("")
    w('if __name__ == "__main__":')
    w("    main()")
    return "\n".join(out) + "\n"


def make_live(o, master, ns):
    """Build o's widget the way the generated code does, inside master."""
    p = props_of(o)
    if o["type"] == "Radiobutton" and not hasattr(ns, p["group"] + "_var"):
        setattr(ns, p["group"] + "_var", tk.StringVar(master, value="<none>"))
    env = {"tk": tk, "ttk": ttk, "self": ns, "master": master}
    exec("\n".join(widget_lines(o)), env)
    return getattr(ns, o["name"])


def edge_point(r, p):
    """Where the line from the centre of rectangle r towards p leaves r."""
    x0, y0, x1, y1 = r
    cx, cy = (x0 + x1) / 2, (y0 + y1) / 2
    dx, dy = p[0] - cx, p[1] - cy
    if dx == 0 and dy == 0:
        return cx, cy
    tx = (x1 - x0) / 2 / abs(dx) if dx else float("inf")
    ty = (y1 - y0) / 2 / abs(dy) if dy else float("inf")
    t = min(tx, ty, 1)
    return cx + dx * t, cy + dy * t


def centre(r):
    return (r[0] + r[2]) / 2, (r[1] + r[3]) / 2


