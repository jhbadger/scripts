class Inspector(ttk.Frame):
    def __init__(self, master, app):
        super().__init__(master, padding=(6, 6, 6, 0), width=330)
        self.app = app
        self.rows = []
        self.name = None          # the object being inspected
        self.cur_action = None
        self.body_text = None
        self.awake_text = None
        self.head = ttk.Label(self, font=("Helvetica", 13, "bold"))
        self.head.pack(anchor="w")
        self.sub = ttk.Label(self, foreground="#555")
        self.sub.pack(anchor="w", pady=(0, 4))
        self.nb = ttk.Notebook(self)
        self.nb.pack(fill="both", expand=True)
        self.attr = ScrollFrame(self.nb)
        self.size = ttk.Frame(self.nb, padding=8)
        self.conn = ttk.Frame(self.nb, padding=8)
        self.nb.add(self.attr, text="Attributes")
        self.nb.add(self.size, text="Size")
        self.nb.add(self.conn, text="Connections")

    # -- rows

    def commit(self):
        """Apply edits not yet applied (the focus may not have left them)."""
        self.save_body()
        for r in list(self.rows):
            try:
                r.apply(self.app)
            except tk.TclError:
                pass

    def row(self, parent, label, kind, value, setter, choices=None):
        r = parent.grid_size()[1]
        ttk.Label(parent, text=label).grid(row=r, column=0, sticky="nw",
                                           padx=(0, 6), pady=2)
        apply = lambda *_: row.apply(self.app)
        if kind == "bool":
            var = tk.BooleanVar(value=bool(value))
            ttk.Checkbutton(parent, variable=var, command=apply) \
                .grid(row=r, column=1, sticky="w", pady=2)
            row = Row(var.get, var.set, setter, bool(value))
        elif kind == "text":
            t = tk.Text(parent, width=24, height=4, wrap="none", undo=True,
                        font=MONO)
            t.insert("1.0", value)
            t.grid(row=r, column=1, sticky="ew", pady=2)
            t.bind("<FocusOut>", apply)

            def show(v, t=t):
                t.delete("1.0", "end")
                t.insert("1.0", v)
            row = Row(lambda: t.get("1.0", "end-1c"), show, setter, value)
        else:
            var = tk.StringVar(value=str(num(value)))
            if kind == "choice":
                wdg = ttk.Combobox(parent, textvariable=var, values=choices,
                                   state="readonly", width=18)
                wdg.bind("<<ComboboxSelected>>", apply)
            elif kind == "font":
                wdg = ttk.Combobox(parent, textvariable=var, values=FONTS,
                                   width=18)
                wdg.bind("<<ComboboxSelected>>", apply)
            else:
                wdg = ttk.Entry(parent, textvariable=var, width=20)
            wdg.bind("<Return>", apply)
            wdg.bind("<FocusOut>", apply)
            conv = {"int": lambda s: int(float(s)), "float": float}.get(
                kind, lambda s: s.strip() if kind == "ident" else s)
            if kind == "color":
                f = ttk.Frame(parent)
                wdg.destroy()
                wdg = ttk.Entry(f, textvariable=var, width=15)
                wdg.bind("<Return>", apply)
                wdg.bind("<FocusOut>", apply)
                wdg.pack(side="left", fill="x", expand=True)
                sw = tk.Label(f, width=2, relief="solid", bd=1, cursor="hand2")
                sw.pack(side="left", padx=(4, 0))

                def paint(*_, sw=sw):
                    try:
                        sw.configure(bg=var.get() or self.cget_bg())
                    except tk.TclError:
                        pass

                def pick(e, sw=sw):
                    c = colorchooser.askcolor(var.get() or None,
                                              parent=self.app.root)[1]
                    if c:
                        var.set(c)
                        apply()
                var.trace_add("write", paint)
                paint()
                sw.bind("<Button-1>", pick)
                f.grid(row=r, column=1, sticky="ew", pady=2)
            else:
                wdg.grid(row=r, column=1, sticky="ew", pady=2)
            row = Row(lambda: conv(var.get()),
                      lambda v: var.set(str(num(v))), setter,
                      conv(str(num(value))) if kind in ("int", "float")
                      else value)
        parent.columnconfigure(1, weight=1)
        self.rows.append(row)
        return row

    def cget_bg(self):
        return self.app.root.cget("bg")

    def note(self, parent, text):
        ttk.Label(parent, text=text, foreground="#555", wraplength=270,
                  justify="left").grid(row=parent.grid_size()[1], column=0,
                                       columnspan=2, sticky="w", pady=(8, 2))

    # -- showing a selection

    def show(self, sel):
        self.commit()
        self.rows = []
        self.body_text = None
        self.awake_text = None
        self.cur_action = None
        self.attr.clear()
        for f in (self.size, self.conn):
            for c in f.winfo_children():
                c.destroy()
        app, a = self.app, self.attr.inner
        if not sel:
            self.name = None
            self.show_window(a)
        elif len(sel) > 1:
            self.name = None
            self.head.configure(text="%d objects" % len(sel))
            self.sub.configure(text="Layout menu: align, size, stacking")
            self.note(a, "Shift-click to add or remove objects from the "
                      "selection.  Drag any of them to move them together.")
        elif sel[0] == "controller":
            self.name = "controller"
            self.show_controller(a)
        else:
            self.name = sel[0]
            self.show_object(a, app.obj(sel[0]))
        self.show_connections()

    def show_window(self, a):
        app, win = self.app, self.app.doc["window"]
        self.head.configure(text="Window")
        self.sub.configure(text="the window being designed")
        for key, kind, label in (("title", "str", "title"),
                                 ("width", "int", "width"),
                                 ("height", "int", "height"),
                                 ("bg", "color", "background"),
                                 ("resizable", "bool", "resizable")):
            self.row(a, label, kind, win[key],
                     lambda v, k=key: app.set_window(k, v))
        self.note(a, "Drag objects here from the Palette.  Control-drag "
                  "(or right-drag) from a control to another object to "
                  "connect them; from the Controller to an object to make "
                  "an outlet.")
        ttk.Label(self.size, text="Select an object to set its size and "
                  "how it follows the window when it is resized.",
                  wraplength=270, foreground="#555").pack(anchor="w")

    def show_object(self, a, o):
        app = self.app
        self.head.configure(text=o["name"])
        self.sub.configure(text=o["type"] + (" (non-visual)"
                                              if not is_visual(o) else ""))
        self.row(a, "name", "ident", o["name"],
                 lambda v: app.rename(self.name, v))
        p = props_of(o)
        for spec in TYPES[o["type"]]["props"]:
            self.row(a, spec["label"], spec["kind"], p[spec["key"]],
                     lambda v, k=spec["key"]: app.set_prop(self.name, k, v),
                     spec["choices"])
        if o["type"] == "Radiobutton":
            self.note(a, "Radio buttons in the same group turn each other "
                      "off.  The group's value is the value of the one "
                      "that is on.")
        if TYPES[o["type"]].get("source"):
            self.note(a, "Sends its action when it %s."
                      % SOURCE_HELP[TYPES[o["type"]]["source"]])
        if not is_visual(o):
            ttk.Label(self.size, text="A non-visual object: it lives in the "
                      "objects tray, not in the window.", wraplength=270,
                      foreground="#555").pack(anchor="w")
            return
        s = ttk.Frame(self.size)
        s.pack(anchor="w")
        for key in ("x", "y", "w", "h"):
            self.row(s, {"w": "width", "h": "height"}.get(key, key), "int",
                     o[key], lambda v, k=key: app.set_geom(self.name, k, v))
        ttk.Label(self.size, text="Autosizing", font=("Helvetica", 12, "bold")).pack(anchor="w", pady=(14, 4))
        self.springs(o)
        ttk.Label(self.size, wraplength=270, foreground="#555",
                  justify="left", text="Click the struts.  A red strut pins "
                  "that side to the window's edge when the window is "
                  "resized; pin both left and right (or top and bottom) "
                  "and the object stretches.  Unpinned on both sides, it "
                  "keeps its proportional place.").pack(anchor="w", pady=6)

    def springs(self, o):
        c = tk.Canvas(self.size, width=140, height=110, bg="white",
                      highlightthickness=1, highlightbackground="#999")
        c.pack(anchor="w")
        c.create_rectangle(6, 6, 134, 104, outline="#444")
        c.create_rectangle(50, 38, 90, 72, fill="#c8d4e8", outline="#444")
        struts = {"w": (6, 55, 50, 55), "e": (90, 55, 134, 55),
                  "n": (70, 6, 70, 38), "s": (70, 72, 70, 104)}

        def draw():
            c.delete("strut")
            anchors = self.app.obj(self.name).get("anchors", "nw")
            for k, xy in struts.items():
                on = k in anchors
                c.create_line(*xy, width=3 if on else 1,
                              fill="#d01010" if on else "#999",
                              dash=() if on else (3, 3), tags="strut")
                c.create_line(*xy, width=14, fill="", tags=("strut", k))

        def click(e):
            for item in c.find_overlapping(e.x - 2, e.y - 2, e.x + 2, e.y + 2):
                for k in struts:
                    if k in c.gettags(item):
                        o = self.app.obj(self.name)
                        a = o.get("anchors", "nw")
                        a = a.replace(k, "") if k in a else a + k
                        self.app.set_anchors(self.name, a)
                        draw()
                        return
        c.bind("<Button-1>", click)
        draw()

    def show_controller(self, a):
        app, ctl = self.app, self.app.doc["controller"]
        self.head.configure(text=ctl["classname"])
        self.sub.configure(text="the Controller (like IB's File's Owner)")
        self.row(a, "class name", "ident", ctl["classname"],
                 app.set_classname)
        ttk.Label(a, text="def awakeFromNib(self):", font=MONO).grid(
            row=a.grid_size()[1], column=0, columnspan=2, sticky="w",
            pady=(10, 2))
        t = self.code_text(a, 4)
        t.insert("1.0", ctl.get("awake", "pass"))
        t.bind("<FocusOut>", lambda e: self.save_awake(t))
        self.awake_text = t

        ttk.Label(a, text="Actions", font=("Helvetica", 12, "bold")) \
            .grid(row=a.grid_size()[1], column=0, columnspan=2, sticky="w",
                  pady=(12, 2))
        lb = tk.Listbox(a, height=5, exportselection=False, font=MONO)
        lb.grid(row=a.grid_size()[1], column=0, columnspan=2, sticky="ew")
        for name in ctl["actions"]:
            lb.insert("end", name + ":")
        bf = ttk.Frame(a)
        bf.grid(row=a.grid_size()[1], column=0, columnspan=2, sticky="w",
                pady=2)
        self.sig = ttk.Label(a, text="", font=MONO)
        self.sig.grid(row=a.grid_size()[1], column=0, columnspan=2,
                      sticky="w", pady=(6, 2))
        body = self.code_text(a, 9)
        body.configure(state="disabled")
        body.bind("<FocusOut>", lambda e: self.save_body())
        self.body_text, self.action_list = body, lb

        def pick(e=None):
            self.save_body()
            sel = lb.curselection()
            if not sel:
                return
            self.cur_action = lb.get(sel[0])[:-1]
            body.configure(state="normal")
            body.delete("1.0", "end")
            body.insert("1.0", app.doc["controller"]["actions"]
                        .get(self.cur_action, ""))
            body.edit_reset()
            self.sig.configure(text="def %s(self, sender):" % self.cur_action)
        lb.bind("<<ListboxSelect>>", pick)

        def add():
            name = app.ask_action_name()
            if name:
                app.add_action(name)
                lb.insert("end", name + ":")
                lb.selection_clear(0, "end")
                lb.selection_set("end")
                pick()

        def rename():
            if not self.cur_action:
                return
            self.save_body()
            name = app.ask_action_name(self.cur_action)
            if name and app.rename_action(self.cur_action, name):
                i = lb.curselection()[0]
                lb.delete(i)
                lb.insert(i, name + ":")
                lb.selection_set(i)
                self.cur_action = name
                self.sig.configure(text="def %s(self, sender):" % name)
                self.show_connections()

        def remove():
            if not self.cur_action:
                return
            app.remove_action(self.cur_action)
            lb.delete(lb.curselection()[0])
            self.cur_action = None
            body.delete("1.0", "end")
            body.configure(state="disabled")
            self.sig.configure(text="")
            self.show_connections()
        for text, cmd in (("Add…", add), ("Rename…", rename),
                          ("Remove", remove)):
            ttk.Button(bf, text=text, command=cmd).pack(side="left", padx=1)
        if ctl["actions"]:
            lb.selection_set(0)
            pick()

        outlets = [c for c in app.doc["connections"]
                   if c.get("kind") == "outlet"]
        ttk.Label(a, text="Outlets", font=("Helvetica", 12, "bold")) \
            .grid(row=a.grid_size()[1], column=0, columnspan=2, sticky="w",
                  pady=(12, 2))
        self.note(a, "\n".join("self.%s → %s" % (c["action"], c["dst"])
                               for c in outlets) or
                  "None yet: Control-drag from the Controller icon to an "
                  "object to make one.")
        self.note(a, "In actions, sender is the object that sent the "
                  "action; self.ui is the Interface, whose objects are "
                  "attributes (self.ui.label1), and self.ui.value_of(w) / "
                  "self.ui.set_value(w, v) get and set any object's value.  "
                  "print() goes to the test console.")
        ttk.Label(self.size, text="A non-visual object: it lives in the "
                  "objects tray, not in the window.", wraplength=270,
                  foreground="#555").pack(anchor="w")

    def code_text(self, parent, height):
        t = tk.Text(parent, width=34, height=height, wrap="none", undo=True,
                    font=MONO)
        t.grid(row=parent.grid_size()[1], column=0, columnspan=2,
               sticky="ew")
        t.bind("<Tab>", lambda e: (t.insert("insert", "    "), "break")[1])
        return t

    def save_awake(self, t):
        if t.winfo_exists():
            self.app.set_awake(t.get("1.0", "end-1c"))

    def save_body(self):
        t = self.body_text
        if self.name == "controller" and self.awake_text \
                and self.awake_text.winfo_exists():
            self.save_awake(self.awake_text)
        if t is None or not t.winfo_exists() or not self.cur_action:
            return
        self.app.set_action_body(self.cur_action, t.get("1.0", "end-1c"))

    def show_connections(self):
        f = self.conn
        for c in f.winfo_children():
            c.destroy()
        app = self.app
        if self.name:
            conns = [c for c in app.doc["connections"]
                     if self.name in (c["src"], c["dst"])]
        else:
            conns = list(app.doc["connections"])
        ttk.Label(f, text="Connections", font=("Helvetica", 12, "bold")) \
            .pack(anchor="w")
        lb = tk.Listbox(f, height=10, font=MONO, exportselection=False)
        lb.pack(fill="both", expand=True, pady=4)
        for c in conns:
            lb.insert("end", app.describe(c, self.name))
        bf = ttk.Frame(f)
        bf.pack(anchor="w")

        def disconnect():
            for i in reversed(lb.curselection()):
                app.disconnect(conns[i])

        def goto(e=None):
            sel = lb.curselection()
            if sel:
                c = conns[sel[0]]
                other = c["dst"] if c["src"] == self.name else c["src"]
                app.select([other if self.name else c["src"]])
        ttk.Button(bf, text="Disconnect", command=disconnect).pack(side="left")
        ttk.Button(bf, text="Select Other End", command=goto).pack(side="left")
        lb.bind("<Double-Button-1>", goto)
        lb.bind("<<ListboxSelect>>", lambda e: app.flash_connection(
            conns[lb.curselection()[0]]) if lb.curselection() else None)
        ttk.Label(f, wraplength=270, foreground="#555", justify="left",
                  text="Control-drag (or right-drag, or drag in Connect "
                  "mode) from a control to its target.  The target's "
                  "actions pop up when you let go.").pack(anchor="w", pady=6)


# ---------------------------------------------------------------- the application

class App:
    def __init__(self, root, path=None):
        self.root = root
        self.doc = new_doc()
        self.path = None
        self.dirty = False
        self.sel = []
        self.widgets, self.items, self.handles, self.handle_of = {}, {}, {}, {}
        self.undo_stack, self.redo_stack = [], []
        self.clip = None
        self.drag = None
        self.inline = None
        self.test = None
        self.console = None
        self.flash = None
        self.last_nudge = 0
        self.ns = SimpleNamespace()
        self.snap = tk.BooleanVar(value=True)
        self.show_all = tk.BooleanVar(value=False)
        self.mode = tk.StringVar(value="edit")
        root.geometry("1300x820")
        root.minsize(900, 560)
        self.default_bg = tk.Frame(root).cget("bg")
        self.build_ui()
        self.build_menus()
        self.bind_keys()
        root.protocol("WM_DELETE_WINDOW", self.quit)
        set_window_icon(root)
        if MAC:
            root.createcommand("tk::mac::Quit", self.quit)
            # documents opened via the app bundle / Finder
            root.createcommand("::tk::mac::OpenDocument", self.open_document)
        if path and os.path.exists(path):
            self.load(path)
        else:
            if path:
                self.path = os.path.abspath(path)
            self.redraw_all()
            self.select([])
        self.update_title()

    # -- layout

    def build_ui(self):
        r = self.root
        bar = ttk.Frame(r, padding=(6, 4))
        bar.pack(side="top", fill="x")
        ttk.Label(bar, text="Mode:").pack(side="left")
        for text, val in (("Select", "edit"), ("Connect", "connect")):
            ttk.Radiobutton(bar, text=text, value=val, variable=self.mode,
                            command=self.mode_changed).pack(side="left",
                                                            padx=2)
        ttk.Separator(bar, orient="vertical").pack(side="left", fill="y",
                                                   padx=8)
        ttk.Checkbutton(bar, text="Snap to grid", variable=self.snap,
                        command=self.draw_form).pack(side="left")
        ttk.Checkbutton(bar, text="Show all connections",
                        variable=self.show_all,
                        command=self.draw_connections).pack(side="left",
                                                            padx=8)
        ttk.Button(bar, text="Generate Code…",
                   command=self.generate_code).pack(side="right")
