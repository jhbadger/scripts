#!/usr/bin/env python3
"""
txtedit - A zero-dependency, nano-style terminal plain-text editor.
Works out-of-the-box on macOS (Darwin), Ubuntu, RedHat/RHEL, and other UNIX systems.

- Opens any plain-text file (.txt, .md, .log, ...) and creates it if missing.
- Imports Word (.docx) and OpenDocument (.odt) files as raw text: all formatting,
  images and styles are dropped so you can concentrate on the words. The result
  is saved next to the original as <name>.txt; the original is never modified.
- Soft word-wrap (toggle with ^L), search (^W) and search-and-replace (^R) with
  case-sensitivity and regular-expression toggles, undo/redo, line cut/paste,
  go-to-line and a word count.
- Ten colour themes (cycle with ^T), remembered in ~/.config/txtedit/theme or
  forced with the TXTEDIT_THEME environment variable (0-9).
"""

import curses
import locale
import os
import re
import sys
import termios
import unicodedata
import zipfile
import xml.etree.ElementTree as ET
from functools import lru_cache


TAB_WIDTH = 4                      # display width of a tab character
TEXT_EXPORT_EXTS = ('.docx', '.docm', '.dotx', '.dotm', '.odt', '.ott', '.doc')


# --------------------------------------------------------------------------- #
#  Word (.docx) import                                                         #
# --------------------------------------------------------------------------- #

def _local(tag):
    """Strip the XML namespace from a tag: '{uri}body' -> 'body'."""
    return tag.rsplit('}', 1)[-1]


# Sub-elements of a paragraph that must not contribute text
_DOCX_SKIP = {
    'pPr', 'rPr', 'tabs',                 # properties (contain <w:tab/> tab stops!)
    'del', 'delText', 'moveFrom',         # tracked deletions
    'instrText', 'fldChar', 'fldSimple',  # field codes (the result text is kept)
    'footnoteReference', 'endnoteReference',
    'commentReference', 'commentRangeStart', 'commentRangeEnd',
    'bookmarkStart', 'bookmarkEnd', 'proofErr', 'lastRenderedPageBreak',
}


def _docx_para_text(p):
    """Flatten one <w:p> paragraph into a string (may contain '\\n' for <w:br/>)."""
    parts = []

    def rec(e):
        for child in e:
            tag = _local(child.tag)
            if tag in _DOCX_SKIP:
                continue
            if tag == 't':
                parts.append(child.text or '')
            elif tag == 'tab':
                parts.append('\t')
            elif tag in ('br', 'cr'):
                parts.append('\n')
            elif tag == 'noBreakHyphen':
                parts.append('-')
            elif tag == 'softHyphen':
                continue
            elif tag == 'AlternateContent':
                # Text boxes appear twice (Choice + Fallback); keep one copy only.
                choice = next((c for c in child if _local(c.tag) == 'Choice'), None)
                if choice is not None:
                    rec(choice)
            elif tag == 'txbxContent':
                sub = []
                _docx_blocks(child, sub)
                parts.append('\n'.join(sub))
            else:
                rec(child)

    rec(p)
    return ''.join(parts)


def _docx_blocks(elem, out):
    """Walk block-level content (paragraphs, tables, content controls) in order."""
    for child in elem:
        tag = _local(child.tag)
        if tag == 'p':
            out.append(_docx_para_text(child))
        elif tag == 'tbl':
            for tr in child:
                if _local(tr.tag) != 'tr':
                    continue
                cells = []
                for tc in tr:
                    if _local(tc.tag) != 'tc':
                        continue
                    sub = []
                    _docx_blocks(tc, sub)
                    cells.append(' '.join(s for s in sub if s))
                out.append('\t'.join(cells))
        elif tag in ('sectPr', 'tblPr', 'tblGrid', 'trPr', 'tcPr'):
            continue
        else:
            _docx_blocks(child, out)


def read_docx(filepath):
    """Zero-dependency .docx reader: returns the document body as plain text."""
    with zipfile.ZipFile(filepath, 'r') as z:
        if 'word/document.xml' not in z.namelist():
            raise ValueError("Not a Word document (word/document.xml missing).")
        root = ET.fromstring(z.read('word/document.xml'))
    body = next((e for e in root.iter() if _local(e.tag) == 'body'), None)
    if body is None:
        raise ValueError("Word document has no <w:body>.")
    out = []
    _docx_blocks(body, out)
    return '\n'.join(out)


# --------------------------------------------------------------------------- #
#  OpenDocument (.odt) import                                                  #
# --------------------------------------------------------------------------- #

_ODT_SKIP = {'note', 'annotation', 'annotation-end', 'tracked-changes',
             'bookmark', 'bookmark-start', 'bookmark-end', 'soft-page-break',
             'sequence-decls', 'variable-decls', 'user-field-decls', 'forms'}


def _odt_inline(e, parts):
    for child in e:
        tag = _local(child.tag)
        if tag in _ODT_SKIP:
            pass
        elif tag == 's':
            count = next((v for k, v in child.attrib.items() if _local(k) == 'c'), '1')
            try:
                parts.append(' ' * max(1, int(count)))
            except ValueError:
                parts.append(' ')
        elif tag == 'tab':
            parts.append('\t')
        elif tag == 'line-break':
            parts.append('\n')
        else:
            if child.text:
                parts.append(child.text)
            _odt_inline(child, parts)
        if child.tail:
            parts.append(child.tail)


def _odt_para_text(p):
    parts = [p.text or '']
    _odt_inline(p, parts)
    return ''.join(parts)


def _odt_blocks(elem, out):
    for child in elem:
        tag = _local(child.tag)
        if tag in ('p', 'h'):
            out.append(_odt_para_text(child))
        elif tag == 'table-row':
            cells = []
            for tc in child:
                if _local(tc.tag) not in ('table-cell', 'covered-table-cell'):
                    continue
                sub = []
                _odt_blocks(tc, sub)
                cells.append(' '.join(s for s in sub if s))
            out.append('\t'.join(cells))
        elif tag in _ODT_SKIP:
            continue
        else:
            _odt_blocks(child, out)


def read_odt(filepath):
    """Zero-dependency .odt reader: returns the document body as plain text."""
    with zipfile.ZipFile(filepath, 'r') as z:
        if 'content.xml' not in z.namelist():
            raise ValueError("Not an OpenDocument file (content.xml missing).")
        root = ET.fromstring(z.read('content.xml'))
    body = next((e for e in root.iter()
                 if _local(e.tag) == 'text' and 'office' in e.tag), None)
    if body is None:
        raise ValueError("OpenDocument file has no <office:text>.")
    out = []
    _odt_blocks(body, out)
    return '\n'.join(out)


# --------------------------------------------------------------------------- #
#  Loading / saving                                                            #
# --------------------------------------------------------------------------- #

def _split_lines(text):
    """Normalise line endings and split; returns (lines, eol, had_trailing_newline)."""
    eol = '\r\n' if '\r\n' in text else '\n'
    text = text.replace('\r\n', '\n').replace('\r', '\n')
    trailing = text.endswith('\n')
    lines = text.split('\n')
    if trailing:
        lines.pop()
    if not lines:
        lines = ['']
    return lines, eol, trailing


def load_document(filepath):
    """
    Returns (lines, target_path, converted_from, eol, trailing_newline, note).
    Word/ODT files are converted to text and re-targeted to <name>.txt.
    """
    ext = os.path.splitext(filepath)[1].lower()
    note = ""

    if ext in ('.docx', '.docm', '.dotx', '.dotm', '.odt', '.ott'):
        if not os.path.exists(filepath):
            raise FileNotFoundError(f"File not found: {filepath}")
        text = read_odt(filepath) if ext in ('.odt', '.ott') else read_docx(filepath)
        lines, _, _ = _split_lines(text)
        target = os.path.splitext(filepath)[0] + '.txt'
        note = (f"Imported {ext} as plain text ({len(lines)} paragraphs). "
                f"Target: '{os.path.basename(target)}' (^S saves it; original untouched)")
        return lines, target, ext, '\n', True, note

    if ext == '.doc':
        raise ValueError("Legacy binary .doc is not supported; save it as .docx first.")

    if not os.path.exists(filepath):
        return [''], filepath, None, '\n', True, f"New file: {os.path.basename(filepath)}"

    with open(filepath, 'rb') as f:
        data = f.read()
    if b'\x00' in data:
        note = "Warning: file contains binary data (NUL bytes). "
    text = data.decode('utf-8-sig', errors='replace')
    lines, eol, trailing = _split_lines(text)
    return lines, filepath, None, eol, trailing, note


def save_document(filepath, lines, eol='\n', trailing=True):
    ext = os.path.splitext(filepath)[1].lower()
    if ext in TEXT_EXPORT_EXTS:
        filepath = os.path.splitext(filepath)[0] + '.txt'
    text = eol.join(lines) + (eol if trailing else '')
    with open(filepath, 'w', encoding='utf-8', newline='') as f:
        f.write(text)
    return filepath


# --------------------------------------------------------------------------- #
#  Display helpers                                                             #
# --------------------------------------------------------------------------- #

@lru_cache(maxsize=4096)
def cell_width(ch):
    """Number of terminal columns a single character occupies when displayed."""
    if ch == '\t':
        return TAB_WIDTH
    o = ord(ch)
    if o < 32 or o == 127:
        return 2                       # shown as ^X
    if unicodedata.combining(ch):
        return 0
    if unicodedata.east_asian_width(ch) in ('W', 'F'):
        return 2
    return 1


def display_str(ch):
    """What to draw for a single character."""
    if ch == '\t':
        return ' ' * TAB_WIDTH
    o = ord(ch)
    if o < 32:
        return '^' + chr(o + 64)
    if o == 127:
        return '^?'
    return ch


def text_width(text):
    return sum(cell_width(c) for c in text)


@lru_cache(maxsize=8192)
def wrap_line(text, width):
    """
    Soft word-wrap: return a tuple of (start, end) index pairs into `text`,
    each spanning at most `width` display columns. Breaks after whitespace
    when possible, otherwise mid-word.
    """
    n = len(text)
    if n == 0:
        return ((0, 0),)
    width = max(1, width)
    segs = []
    start = 0
    i = 0
    w = 0
    last_space = -1
    while i < n:
        cw = cell_width(text[i])
        if w + cw > width and i > start:
            break_at = last_space + 1 if last_space >= start else i
            segs.append((start, break_at))
            start = break_at
            i = start
            w = 0
            last_space = -1
            continue
        if text[i] in ' \t':
            last_space = i
        w += cw
        i += 1
    segs.append((start, n))
    return tuple(segs)


