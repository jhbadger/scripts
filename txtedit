# --------------------------------------------------------------------------- #
#  Colour themes (cycle with ^T)                                               #
# --------------------------------------------------------------------------- #
# Each theme: (name, description, text (fg, bg), bars (fg, bg), accent (fg, bg))
# Colours are xterm-256 palette indices (-1 = terminal default). On terminals
# with only 8/16 colours they are approximated by to_basic_color().

THEMES = [
    ("Terminal",  "your terminal's own colours",     (-1, -1),   (15, 4),    (0, 11)),
    ("Ocean",     "light blue on navy",              (117, 17),  (17, 117),  (17, 215)),
    ("Midnight",  "soft grey on near-black",         (250, 233), (233, 250), (233, 180)),
    ("Slate",     "muted grey-blue on charcoal",     (146, 235), (235, 146), (235, 222)),
    ("Forest",    "pale green on deep green",        (151, 22),  (22, 151),  (22, 222)),
    ("Amber",     "amber on black, old CRT style",   (214, 232), (232, 214), (232, 227)),
    ("Phosphor",  "green on black, old CRT style",   (84, 232),  (232, 84),  (232, 227)),
    ("Nord",      "frosty white on blue-grey",       (189, 236), (236, 110), (236, 222)),
    ("Gruvbox",   "warm cream on brown-black",       (223, 235), (235, 142), (235, 214)),
    ("Paper",     "dark ink on cream, for daylight", (236, 230), (230, 94),  (236, 221)),
]

THEME_FILE = os.path.join(os.path.expanduser("~"), ".config", "txtedit", "theme")


def to_basic_color(c):
    """Approximate an xterm-256 colour index with one of the 8 basic colours."""
    if c < 0:
        return -1
    if c < 16:
        return c % 8
    if c >= 232:                                   # greyscale ramp
        return 0 if c < 244 else 7
    c -= 16
    r, g, b = c // 36, (c // 6) % 6, c % 6         # 6x6x6 colour cube, levels 0-5
    bits = (1 if r >= 3 else 0) | (2 if g >= 3 else 0) | (4 if b >= 3 else 0)
    if bits == 0 and max(r, g, b) > 0:             # dark shade: keep its dominant hue
        top = max(r, g, b)
        bits = (1 if r == top else 0) | (2 if g == top else 0) | (4 if b == top else 0)
    return bits


def load_theme_index():
    env = os.environ.get("TXTEDIT_THEME")
    for source in (env, None):
        try:
            raw = source if source is not None else open(THEME_FILE).read()
            return int(raw.strip()) % len(THEMES)
        except (OSError, ValueError, TypeError):
            continue
    return 0


def save_theme_index(idx):
    try:
        os.makedirs(os.path.dirname(THEME_FILE), exist_ok=True)
        with open(THEME_FILE, "w") as f:
            f.write(f"{idx}\n")
        return True
    except OSError:
        return False


def show_cursor():
    """Make the cursor visible; silently ignored on terminals that cannot."""
    try:
        curses.curs_set(1)
    except curses.error:
        pass


