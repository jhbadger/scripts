        self.seen_rev = 0
        self.rev_time = 0.0
        self.lsp_rev = 0

        self.cur_line = 0
        self.cur_col = 0
        self.goal_x = None             # remembered x for vertical movement

        self.top_line = 0
        self.top_seg = 0
        self.col_offset = 0            # horizontal scroll when wrap is off
        self.wrap = False
        self.show_numbers = True
        self.gutter_w = 0
        self.width = 80
        self.height = 24

        self.search_query = ""
        self.replace_text = ""
        self.search_case = False
        self.search_regex = False
        self.match = None              # (line, start, end) of highlighted match
        self.bracket_pair = None       # [(line, col), (line, col)]

        self.cut_buffer = []
        self.last_action = None
        self.last_edit_line = -1
        self.undo_stack = []
        self.redo_stack = []

        self.run_args = ""
        self.build_diags = []
        self.build_serial = 0
        self._diag_cache = (None, [])
        self.cursor_screen = (1, 0)
        self.need_draw = True

        self.default_status = ("^S Save | ^W Find | ^B Run | ^T Theme | ^G GoTo | "
                               "^Q Hover | ^] Def | F1 Help | ^X Exit")
        self._status = ""
        self._status_t = 0.0
        self._status_cleared = True

        note = self.load_file(filepath)
        if goto:
            self.cur_line = max(0, min(goto - 1, len(self.lines) - 1))
        self.status_msg = note or ""
        self.init_curses()

    # ---- status message with expiry ----------------------------------------

    @property
    def status_msg(self):
        if self._status and time.monotonic() - self._status_t <= STATUS_TTL:
            return self._status
        return ""

    @status_msg.setter
    def status_msg(self, value):
        self._status = value
        self._status_t = time.monotonic()
        self._status_cleared = not value

    @property
    def dirty(self):
        return self._dirty

    @dirty.setter
    def dirty(self, value):
        if value:
            self.rev += 1
        self._dirty = bool(value)

    # ---- document loading ---------------------------------------------------

    def load_file(self, path, line=0, col=0):
        self.lsp_detach()
        (self.lines, self.eol, self.trailing_nl, note) = load_document(path)
        self.filepath = path
        self._dirty = False
        self.cur_line = max(0, min(line, len(self.lines) - 1))
        self.cur_col = max(0, min(col, len(self.lines[self.cur_line])))
        self.goal_x = None
        self.top_line = self.top_seg = self.col_offset = 0
        self.undo_stack, self.redo_stack = [], []
        self.last_action = None
        self.match = None
        self.build_diags = []
        self.build_serial += 1
        self.hl_states = [None]
        self.lang = detect_language(path, self.lines)
        self.indent_unit = self.detect_indent()
        self.lsp_attach()
        if self.lang:
            note = note or f"{LANG_INFO[self.lang]['name']}: ^B runs the file, F1 for help"
        return note

    def detect_indent(self):
        info = LANG_INFO.get(self.lang)
        default = ' ' * info['indent'] if info else '\t'
        tabs = spaces = 0
        indents = []
        for l in self.lines[:2000]:
            if not l.strip():
                continue
            if l[0] == '\t':
                tabs += 1
            elif l[0] == ' ':
                spaces += 1
                indents.append(len(l) - len(l.lstrip(' ')))
        if tabs > spaces:
            return '\t'
        if os.path.basename(self.filepath) == 'Makefile':
            return '\t'
        deltas = {}
        prev = 0
        for ind in indents:
            d = abs(ind - prev)
            if 2 <= d <= 8:
                deltas[d] = deltas.get(d, 0) + 1
            prev = ind
        if deltas:
            return ' ' * max(deltas, key=lambda k: (deltas[k], -k))
        return default

    def document_text(self):
        return '\n'.join(self.lines) + ('\n' if self.trailing_nl else '')

    # ---- curses setup -------------------------------------------------------

    def tune_tty(self):
        try:
            fd = sys.stdin.fileno()
            attrs = termios.tcgetattr(fd)
            attrs[0] &= ~(termios.IXON | termios.IXOFF)      # free ^S / ^Q
            if hasattr(termios, 'VDISCARD') and termios.VDISCARD < len(attrs[6]):
                attrs[6][termios.VDISCARD] = 0               # free ^O
            if hasattr(termios, 'VLNEXT') and termios.VLNEXT < len(attrs[6]):
                attrs[6][termios.VLNEXT] = 0                 # free ^V
            termios.tcsetattr(fd, termios.TCSANOW, attrs)
        except Exception:
            pass

    def init_curses(self):
        curses.raw()
        show_cursor()
        self.stdscr.keypad(True)
        self.stdscr.timeout(TICK_MS)
        self.has_color = False
        try:
            if curses.has_colors():
                curses.start_color()
                curses.use_default_colors()
                self.has_color = True
        except curses.error:
            self.has_color = False
        self.tune_tty()
        tty_write('\x1b[?2004h')                             # bracketed paste
        self.theme_idx = load_theme_index()
        self.apply_theme(self.theme_idx)

    def apply_theme(self, idx):
        """Install colour pairs for THEMES[idx] and paint the window background."""
        self.theme_idx = idx % len(THEMES)
        name, desc, text, bar, accent, palette = THEMES[self.theme_idx]
        mono = {'kw': curses.A_BOLD, 'type': curses.A_BOLD, 'func': curses.A_NORMAL,
                'str': curses.A_NORMAL, 'com': curses.A_DIM, 'num': curses.A_NORMAL,
                'pre': curses.A_BOLD, 'const': curses.A_BOLD, 'spec': curses.A_BOLD}
        if not self.has_color:
            self.attr_text = curses.A_NORMAL
            self.attr_bar = curses.A_REVERSE
            self.attr_prompt = curses.A_REVERSE | curses.A_BOLD
            self.attr_match = curses.A_REVERSE | curses.A_BOLD
            self.attr_key = curses.A_REVERSE | curses.A_BOLD
            self.attr_syn = dict(mono)
            self.attr_err = curses.A_UNDERLINE | curses.A_BOLD
            self.attr_warn = curses.A_UNDERLINE
            return
        ncolors = curses.COLORS
        conv = (lambda c: c) if ncolors >= 256 else to_basic_color

        def pair(n, fg, bg):
            try:
                curses.init_pair(n, conv(fg), conv(bg))
            except curses.error:
                curses.init_pair(n, -1, -1)
            return curses.color_pair(n)

        self.attr_text = pair(1, text[0], text[1])
        self.attr_bar = pair(3, bar[0], bar[1])
        accent_attr = pair(4, accent[0], accent[1]) | curses.A_BOLD
        self.attr_prompt = accent_attr
        self.attr_match = accent_attr
        self.attr_key = pair(6, bar[1], bar[0]) | curses.A_BOLD
        if palette == 'mono':
            self.attr_syn = dict(mono)
            err_fg, warn_fg = text[0], text[0]
        else:
            pal = PALETTES[palette]
            self.attr_syn = {k: pair(10 + i, pal[k], text[1]) for i, k in enumerate(SYNTAX_KINDS)}
            self.attr_syn['kw'] |= curses.A_BOLD
            err_fg, warn_fg = (196, 220) if palette != 'ansi' else (9, 11)
            if palette == 'light':
                err_fg, warn_fg = 160, 130
        self.attr_err = pair(20, err_fg, text[1]) | curses.A_UNDERLINE | curses.A_BOLD
        self.attr_warn = pair(21, warn_fg, text[1]) | curses.A_UNDERLINE
        self.stdscr.bkgd(' ', self.attr_text)

    def cycle_theme(self, step=1):
        self.apply_theme(self.theme_idx + step)
        name, desc = THEMES[self.theme_idx][0], THEMES[self.theme_idx][1]
        saved = save_theme_index(self.theme_idx)
        self.status_msg = f"Theme {self.theme_idx + 1}/{len(THEMES)}: {name} ({desc})"
        if not self.has_color:
            self.status_msg += " - this terminal has no colour support"
        elif curses.COLORS < 256:
            self.status_msg += " - approximated, terminal reports only 8/16 colours"
        elif not saved:
            self.status_msg += " - could not save preference"

    def update_geometry(self):
        max_y, max_x = self.stdscr.getmaxyx()
        self.gutter_w = (len(str(len(self.lines))) + 2) if self.show_numbers else 0
        self.width = max(1, max_x - 1 - self.gutter_w)
        self.height = max(1, max_y - 3)

    # ---- wrapping / coordinate helpers --------------------------------------

    def segs(self, li):
        text = self.lines[li]
        if self.wrap:
            return wrap_line(text, self.width)
        return ((0, len(text)),)

    def seg_of_col(self, li, col):
        segs = self.segs(li)
        for k, (s, e) in enumerate(segs):
            if col < e:
                return k
        return len(segs) - 1

    def x_of(self, li, start, col):
        return text_width(self.lines[li][start:col])

    def col_from_x(self, li, k, goal):
        segs = self.segs(li)
        s, e = segs[k]
        last = e if k == len(segs) - 1 else max(s, e - 1)
        text = self.lines[li]
        col = s
        x = 0
        while col < last:
            cw = cell_width(text[col])
            if x + cw > goal:
                break
            x += cw
            col += 1
        return col

    def next_visual(self, pos):
        li, k = pos
        if k + 1 < len(self.segs(li)):
            return (li, k + 1)
        if li + 1 < len(self.lines):
            return (li + 1, 0)
        return None

    def prev_visual(self, pos):
        li, k = pos
        if k > 0:
            return (li, k - 1)
        if li > 0:
            return (li - 1, len(self.segs(li - 1)) - 1)
        return None

    def clamp_cursor(self):
        n = len(self.lines)
        self.cur_line = max(0, min(self.cur_line, n - 1))
        self.cur_col = max(0, min(self.cur_col, len(self.lines[self.cur_line])))

    def ensure_visible(self):
        n = len(self.lines)
        self.top_line = max(0, min(self.top_line, n - 1))
        self.top_seg = max(0, min(self.top_seg, len(self.segs(self.top_line)) - 1))

        cur = (self.cur_line, self.seg_of_col(self.cur_line, self.cur_col))
        top = (self.top_line, self.top_seg)
        if cur < top:
            top = cur
        else:
            pos = top
            rows = 0
            while pos != cur and rows < self.height and pos is not None:
                pos = self.next_visual(pos)
                rows += 1
            if rows >= self.height or pos is None:
                top = cur
                for _ in range(self.height - 1):
                    p = self.prev_visual(top)
                    if p is None:
                        break
                    top = p
        self.top_line, self.top_seg = top

        if self.wrap:
            self.col_offset = 0
        else:
            x = self.x_of(self.cur_line, 0, self.cur_col)
            if x < self.col_offset:
                self.col_offset = x
            elif x >= self.col_offset + self.width:
                self.col_offset = x - self.width + 1

    # ---- syntax state --------------------------------------------------------

    def invalidate(self, line):
        """Lines after `line` may have a different lexer state now."""
        del self.hl_states[max(0, line) + 1:]

    def line_state(self, li):
        if not self.lang:
            return None
        st = self.hl_states
        while len(st) <= li:
            k = len(st) - 1
            st.append(tokenize(self.lang, self.lines[k], st[k])[1])
        return st[li]

    def line_spans(self, li):
        if not self.lang:
            return ()
        return tokenize(self.lang, self.lines[li], self.line_state(li))[0]

    def blank_line(self, li):
        if not self.lang:
            return self.lines[li]
        return blank_code(self.lang, self.lines[li], self.line_state(li))

    # ---- diagnostics ---------------------------------------------------------

    def diagnostics(self):
        """Merged LSP + build diagnostics as (sl, sc, el, ec, severity, message, source)."""
        key = (self.lsp.diag_rev if self.lsp else 0, self.build_serial, self.lsp_uri)
        if self._diag_cache[0] == key:
            return self._diag_cache[1]
        out = list(self.build_diags)
        if self.lsp and self.lsp_uri in self.lsp.diags:
            n = len(self.lines)
            for d in self.lsp.diags[self.lsp_uri]:
                try:
                    r = d['range']
                    sl, el = r['start']['line'], r['end']['line']
                    if sl >= n:
                        continue
                    el = min(el, n - 1)
                    sc = from_utf16(self.lines[sl], r['start']['character'])
                    ec = from_utf16(self.lines[el], r['end']['character'])
                    out.append((sl, sc, el, ec, d.get('severity', 1),
                                d.get('message', '').strip(), d.get('source', 'lsp')))
                except (KeyError, TypeError):
                    continue
        out.sort(key=lambda d: (d[0], d[1]))
        self._diag_cache = (key, out)
        return out

    def diag_attr(self, sev):
        return self.attr_err if sev == 1 else self.attr_warn

    def jump_diagnostic(self, step):
        diags = [d for d in self.diagnostics() if d[4] <= 3]
        if not diags:
            self.status_msg = "No diagnostics."
            return
        here = (self.cur_line, self.cur_col)
        if step > 0:
            cands = [d for d in diags if (d[0], d[1]) > here]
            d = cands[0] if cands else diags[0]
        else:
            cands = [d for d in diags if (d[0], d[1]) < here]
            d = cands[-1] if cands else diags[-1]
        self.cur_line, self.cur_col = d[0], d[1]
        self.goal_x = None
        label = {1: 'error', 2: 'warning', 3: 'info'}.get(d[4], 'hint')
        self.status_msg = f"{label}: {d[5].splitlines()[0] if d[5] else ''}"

    # ---- drawing ------------------------------------------------------------

    def row_attrs(self, li, s, e):
        """Display attribute for each character index in [s, e) of line li."""
        attrs = [curses.A_NORMAL] * (e - s)
        syn = self.attr_syn
        for ss, se, kind in self.line_spans(li):
            if se <= s:
                continue
            if ss >= e:
                break
            a = syn.get(kind, curses.A_NORMAL)
            for j in range(max(ss, s), min(se, e)):
                attrs[j - s] = a
        text = self.lines[li]
        for sl, sc, el, ec, sev, _msg, _src in self.diagnostics():
            if sev > 2 or li < sl or li > el:
                continue
            a = self.diag_attr(sev)
            ds = sc if li == sl else 0
            de = ec if li == el else len(text)
            if de <= ds:
                de = ds + 1
            for j in range(max(ds, s), min(de, e)):
                attrs[j - s] = a
        if self.bracket_pair:
            for bl, bc in self.bracket_pair:
                if bl == li and s <= bc < e:
                    attrs[bc - s] = self.attr_match
        if self.match and self.match[0] == li:
            for j in range(max(self.match[1], s), min(self.match[2], e)):
                attrs[j - s] = self.attr_match
        return attrs

    def render_row(self, y, li, k):
        s, e = self.segs(li)[k]
        text = self.lines[li]
        x = 0 if self.wrap else -self.col_offset
        W = self.width
        g = self.gutter_w

        if g:
            digits = g - 2
            mark = ' '
            mark_attr = curses.A_NORMAL
            if k == 0:
                worst = None
                for d in self.diagnostics():
                    if d[0] <= li <= d[2] and d[4] <= 2 and (worst is None or d[4] < worst):
                        worst = d[4]
                if worst:
                    mark = 'E' if worst == 1 else 'W'
                    mark_attr = self.diag_attr(worst)
                num = str(li + 1).rjust(digits)
            else:
                num = ' ' * digits
            try:
                self.stdscr.addstr(y, 0, mark, mark_attr)
                self.stdscr.addstr(y, 1, num + ' ', self.attr_syn.get('com', curses.A_DIM))
            except curses.error:
                pass

        attrs = self.row_attrs(li, s, e)
        runs = []                      # (display string, attr, display width)
        buf = []
        buf_w = 0
        cur_attr = None
        row_start_x = None
        for idx in range(s, e):
            ch = text[idx]
            cw = cell_width(ch)
            if x < 0 or x + cw > W:    # clipped (horizontal scroll / wide char at edge)
                x += cw
                continue
            attr = attrs[idx - s]
            if attr != cur_attr:
                if buf:
                    runs.append(("".join(buf), cur_attr, buf_w))
                    buf, buf_w = [], 0
                cur_attr = attr
            if row_start_x is None:
                row_start_x = x
            buf.append(display_str(ch))
            buf_w += cw
            x += cw
        if buf:
            runs.append(("".join(buf), cur_attr, buf_w))

        draw_x = g + (row_start_x or 0)
        for string, attr, w in runs:
            try:
                self.stdscr.addstr(y, draw_x, string, attr)
            except curses.error:
                pass
            draw_x += w

    def lsp_label(self):
        if not self.lang:
            return ""
        if self.lsp:
            if self.lsp.state == 'ready':
                return f"LSP {self.lsp.name}"
            if self.lsp.state == 'starting':
                return f"LSP {self.lsp.name}..."
            return "LSP off"
        return f"LSP {self.lsp_note}" if self.lsp_note else ""

    def draw(self):
        self.stdscr.erase()
        max_y, max_x = self.stdscr.getmaxyx()
        if max_y < 6 or max_x < 20:
            try:
                self.stdscr.addstr(0, 0, "Terminal too small!")
            except curses.error:
                pass
            self.stdscr.refresh()
            return
        self.update_geometry()
        self.clamp_cursor()
        self.ensure_visible()
        self.bracket_pair = self.find_bracket_pair()

        total_lines, total_words, total_chars = self.doc_stats()
        diags = self.diagnostics()
        n_err = sum(1 for d in diags if d[4] == 1)
        n_warn = sum(1 for d in diags if d[4] == 2)

        # 1. Title bar
        mod_str = " [Modified]" if self.dirty else ""
        eol = " | CRLF" if self.eol == '\r\n' else ""
        lang = f" | {LANG_INFO[self.lang]['name']}" if self.lang else ""
        lsp = f" | {self.lsp_label()}" if self.lsp_label() else ""
        dg = f" | E{n_err} W{n_warn}" if (n_err or n_warn) else ""
        title = (f" progedit | {os.path.basename(self.filepath)}{mod_str}{lang}"
                 f" | Ln {self.cur_line + 1}/{total_lines}, Col {self.cur_col + 1}"
                 f"{lsp}{dg}{eol} ")
        try:
            self.stdscr.addstr(0, 0, title[:max_x - 1].ljust(max_x - 1), self.attr_bar | curses.A_BOLD)
        except curses.error:
            pass

        # 2. Text area
        pos = (self.top_line, self.top_seg)
        cur = (self.cur_line, self.seg_of_col(self.cur_line, self.cur_col))
        cursor_y = None
        for row in range(self.height):
            if pos is None:
                break
            y = 1 + row
            self.render_row(y, pos[0], pos[1])
            if pos == cur:
                cursor_y = y
            pos = self.next_visual(pos)

        # 3. Status line (with right-aligned permanent L / W / C badge)
        msg = self.status_msg
        if not msg:
            for sl, sc, el, ec, sev, text, src in diags:
                if sl <= self.cur_line <= el and sev <= 3:
                    tag = {1: 'error', 2: 'warning', 3: 'info'}[sev]
                    msg = f"{tag}: {text.splitlines()[0] if text else ''}"
                    break
        msg = msg or self.default_status
        counter_badge = f" [Ln {total_lines} | Wd {total_words} | Ch {total_chars}] "
        avail_msg_w = max(1, (max_x - 1) - len(counter_badge))
        left_status = f" {msg}"[:avail_msg_w].ljust(avail_msg_w)
        status_line = (left_status + counter_badge)[:max_x - 1]
        try:
            self.stdscr.addstr(max_y - 2, 0, status_line.ljust(max_x - 1), self.attr_bar)
        except curses.error:
            pass

        # 4. Nano-style shortcut bar
        shortcuts = [
            ("^S", "Save"), ("^X", "Exit"), ("^W", "Find"), ("^R", "Replace"), ("^B", "Run"),
            ("^Z", "Undo"), ("^K", "Cut"), ("^U", "Paste"), ("^G", "GoTo"), ("^T", "Theme"),
            ("^_", "Comment"), ("F1", "Help"),
        ]
        x_pos = 0
        for key_str, desc in shortcuts:
            if x_pos + len(key_str) + len(desc) + 3 >= max_x:
                break
            try:
                self.stdscr.addstr(max_y - 1, x_pos, key_str, self.attr_key)
                x_pos += len(key_str)
                self.stdscr.addstr(max_y - 1, x_pos, f" {desc}  ", curses.A_NORMAL)
                x_pos += len(desc) + 3
            except curses.error:
                pass

        # 5. Cursor
        if cursor_y is not None:
            seg_start = self.segs(self.cur_line)[cur[1]][0]
            x = self.x_of(self.cur_line, seg_start, self.cur_col)
            if not self.wrap:
                x -= self.col_offset
            x = self.gutter_w + max(0, min(x, self.width - 1))
            self.cursor_screen = (cursor_y, x)
            try:
                self.stdscr.move(cursor_y, x)
            except curses.error:
                pass
        self.stdscr.refresh()

    def show_text(self, title, lines):
        """Full-screen scrollable text viewer."""
        top = 0
        while True:
            self.stdscr.erase()
            max_y, max_x = self.stdscr.getmaxyx()
            body = max(1, max_y - 2)
            wrapped = []
            for l in lines:
                l = l.expandtabs(TAB_WIDTH)
                while len(l) > max_x - 2:
                    wrapped.append(l[:max_x - 2])
                    l = l[max_x - 2:]
                wrapped.append(l)
            top = max(0, min(top, max(0, len(wrapped) - body)))
            try:
                self.stdscr.addstr(0, 0, f" {title} "[:max_x - 1].ljust(max_x - 1), self.attr_bar | curses.A_BOLD)
                for i, l in enumerate(wrapped[top:top + body]):
                    self.stdscr.addstr(1 + i, 1, l[:max_x - 2])
                self.stdscr.addstr(max_y - 1, 0, " Up/Down/PgUp/PgDn scroll, any other key closes "[:max_x - 1],
                                   self.attr_bar)
            except curses.error:
                pass
            self.stdscr.refresh()
            ch = self.read_key()
            if ch is None or ch == curses.KEY_RESIZE:
                continue
            if ch == curses.KEY_UP:
                top -= 1
            elif ch == curses.KEY_DOWN:
                top += 1
            elif ch == curses.KEY_PPAGE:
                top -= body
            elif ch == curses.KEY_NPAGE:
                top += body
            else:
                return

    def show_help(self):
        self.show_text("progedit - help", HELP_LINES)

    # ---- input --------------------------------------------------------------

    def read_key(self):
        """
        Returns an int key code for special/control keys, a str for printable
        text (Unicode-safe), ('ALT', key) for Escape-prefixed sequences, or
        None when nothing arrived within the idle tick.
        """
        if self.pushback:
            return self.pushback.pop()
        try:
            ch = self.stdscr.get_wch()
        except curses.error:
            return None
        if isinstance(ch, str):
            if len(ch) == 1:
                o = ord(ch)
                if o < 32 or o == 127:
                    ch = o
        if ch == 27:
            # Collect an Escape-prefixed sequence (Alt+key, or a CSI/SS3 key
            # sequence that curses did not translate).
            seq = ""
            self.stdscr.nodelay(True)
            try:
                while True:
                    try:
                        nxt = self.stdscr.get_wch()
                    except curses.error:
                        break
                    if not isinstance(nxt, str):
                        return nxt
                    seq += nxt
                    if seq[0] not in '[O':
                        break                      # Alt+<char>
                    if len(seq) >= 2 and 0x40 <= ord(nxt) <= 0x7E and nxt != '[':
                        break                      # final byte of the sequence
                    if len(seq) > 16:
                        break
            finally:
                self.stdscr.timeout(TICK_MS)
            if not seq:
                return 27
            return ESC_SEQUENCES.get(seq, ('ALT', seq))
        return ch

    def abort_requested(self):
        """True if the user pressed Esc / ^C (used while waiting on the language server)."""
        self.stdscr.timeout(0)
        try:
            try:
                ch = self.stdscr.get_wch()
            except curses.error:
                return False
            return ch in ('\x1b', '\x03', 27, 3)
        finally:
            self.stdscr.timeout(TICK_MS)

    def prompt_input(self, label, initial="", extra_keys=None):
        """
        Single-line prompt on the status row. `label` may be a callable so it
        can reflect toggles handled through `extra_keys` {keycode: callback}.
        Returns the string, or None if cancelled (Esc / ^C).
        """
        buf = list(initial)
        cursor = len(buf)
        show_cursor()
        try:
            while True:
                max_y, max_x = self.stdscr.getmaxyx()
                lab = label() if callable(label) else label
                prefix = f" {lab}: "
                avail = max(5, max_x - len(prefix) - 2)
                start_idx = max(0, cursor - avail + 1)
                visible_buf = "".join(buf[start_idx:start_idx + avail])
                try:
                    self.stdscr.addstr(max_y - 2, 0, (prefix + visible_buf)[:max_x - 1].ljust(max_x - 1), self.attr_prompt)
                    self.stdscr.move(max_y - 2, min(max_x - 2, len(prefix) + (cursor - start_idx)))
                except curses.error:
                    pass
                self.stdscr.refresh()

                ch = self.read_key()
                if ch is None or isinstance(ch, tuple):
                    continue
                if extra_keys and ch in extra_keys:
                    extra_keys[ch]()
                    continue
                if ch in (10, 13, curses.KEY_ENTER):
                    return "".join(buf)
                elif ch in (27, 7, 3):
                    return None
                elif ch in (curses.KEY_BACKSPACE, 127, 8):
                    if cursor > 0:
                        buf.pop(cursor - 1)
                        cursor -= 1
                elif ch == curses.KEY_DC:
                    if cursor < len(buf):
                        buf.pop(cursor)
                elif ch == curses.KEY_LEFT:
                    cursor = max(0, cursor - 1)
                elif ch == curses.KEY_RIGHT:
                    cursor = min(len(buf), cursor + 1)
                elif ch in (curses.KEY_HOME, 1):
                    cursor = 0
                elif ch in (curses.KEY_END, 5):
                    cursor = len(buf)
                elif ch == 21:                       # ^U clears the line
                    buf.clear()
                    cursor = 0
                elif ch == curses.KEY_RESIZE:
                    self.draw()
                elif isinstance(ch, str):
                    for c in ch:
                        buf.insert(cursor, c)
                        cursor += 1
        finally:
            show_cursor()

    def ask_key(self, message):
        """Redraw the editor, show `message` on the status row, return one key."""
        self.draw()
        max_y, max_x = self.stdscr.getmaxyx()
        try:
            self.stdscr.addstr(max_y - 2, 0, f" {message}"[:max_x - 1].ljust(max_x - 1), self.attr_prompt)
        except curses.error:
            pass
        self.stdscr.refresh()
        while True:
            ch = self.read_key()
            if ch is None or ch == curses.KEY_RESIZE:
                continue
            if isinstance(ch, tuple):
                return 27
            return ch.lower() if isinstance(ch, str) else ch

    # ---- undo / redo --------------------------------------------------------

    def snapshot(self):
        return (list(self.lines), self.cur_line, self.cur_col)

    def push_undo(self, kind, coalesce=False):
        if coalesce and kind == self.last_action and self.last_edit_line == self.cur_line:
            return
        self.undo_stack.append(self.snapshot())
        limit = 200 if len(self.lines) < 20000 else 30
        if len(self.undo_stack) > limit:
            del self.undo_stack[0]
        self.redo_stack.clear()
        self.last_action = kind
        self.last_edit_line = self.cur_line

    def restore(self, snap):
        self.lines, self.cur_line, self.cur_col = list(snap[0]), snap[1], snap[2]
        self.clamp_cursor()
        self.dirty = True
        self.last_action = None
        self.invalidate(0)

    def undo(self):
        if not self.undo_stack:
            self.status_msg = "Nothing to undo."
            return
        self.redo_stack.append(self.snapshot())
        self.restore(self.undo_stack.pop())
        self.status_msg = f"Undo ({len(self.undo_stack)} left)."

    def redo(self):
        if not self.redo_stack:
            self.status_msg = "Nothing to redo."
            return
        self.undo_stack.append(self.snapshot())
        self.restore(self.redo_stack.pop())
        self.status_msg = "Redo."

    # ---- editing ------------------------------------------------------------

    def insert_text(self, s):
        self.push_undo('type', coalesce=True)
        line = self.lines[self.cur_line]
        self.lines[self.cur_line] = line[:self.cur_col] + s + line[self.cur_col:]
        self.cur_col += len(s)
        self.last_edit_line = self.cur_line
        self.dirty = True
        self.goal_x = None

    def type_char(self, ch):
        self.insert_text(ch)
        if self.lang and len(ch) == 1:
            self.electric(ch)

    def insert_paste(self, text):
        """Insert pasted text verbatim (no auto-indent)."""
        text = text.replace('\r\n', '\n').replace('\r', '\n')
        if not text:
            return
        self.push_undo('paste_text')
        line = self.lines[self.cur_line]
        parts = text.split('\n')
        before, after = line[:self.cur_col], line[self.cur_col:]
        if len(parts) == 1:
            self.lines[self.cur_line] = before + text + after
            self.cur_col += len(text)
        else:
            new = [before + parts[0]] + parts[1:-1] + [parts[-1] + after]
            self.lines[self.cur_line:self.cur_line + 1] = new
            self.cur_line += len(parts) - 1
            self.cur_col = len(parts[-1])
        self.dirty = True
        self.goal_x = None
        self.status_msg = f"Pasted {len(parts)} line(s)."

    def read_paste(self):
        """Collect text until the bracketed-paste end marker."""
        buf = []
        end = '\x1b[201~'
        self.stdscr.timeout(2000)
        try:
            while True:
                try:
                    ch = self.stdscr.get_wch()
                except curses.error:
                    break
                if isinstance(ch, str):
                    buf.append(ch)
                    if ch == '~' and ''.join(buf[-6:]) == end:
                        del buf[-6:]
                        break
        finally:
            self.stdscr.timeout(TICK_MS)
        return ''.join(buf)

    # ---- indentation ----------------------------------------------------------

    def indent_width(self):
        return TAB_WIDTH if self.indent_unit == '\t' else len(self.indent_unit)

    def dedent_ws(self, ws):
        if ws.endswith('\t'):
            return ws[:-1]
        if ws.strip(' '):
            return ws[:-1]
        return ws[:max(0, len(ws) - self.indent_width())]

    def set_indent(self, li, new_ws):
        line = self.lines[li]
        old = leading_ws(line)
        if old == new_ws:
            return
        self.lines[li] = new_ws + line[len(old):]
        if li == self.cur_line:
            self.cur_col = max(0, self.cur_col + len(new_ws) - len(old))
        self.dirty = True

    def code_part(self, li, col=None):
        b = self.blank_line(li)
        return (b if col is None else b[:col]).rstrip()

    def prev_code_line(self, li):
        for j in range(li - 1, max(-1, li - 200), -1):
            if self.code_part(j).strip():
                return j
        return None

    def indent_after(self, li, col):
        """Whitespace the line created by pressing Enter at (li, col) should start with."""
        base = leading_ws(self.lines[li])
        unit = self.indent_unit
        lang = self.lang
        code = self.code_part(li, col)
        if not code.strip():
            return base
        if lang == 'python':
            if code.endswith((':', '(', '[', '{')):
                return base + unit
            if _PY_DEDENT.match(code):
                return self.dedent_ws(base)
        elif lang in ('c', 'cpp'):
            if code.lstrip().startswith('#'):
                return base
            if code.endswith('{') or _C_CASE.match(code) or _C_CTRL.match(code):
                return base + unit
            if code.endswith(';'):
                pj = self.prev_code_line(li)
                if (pj is not None and _C_CTRL.match(self.code_part(pj))
                        and len(base) > len(leading_ws(self.lines[pj]))):
                    return leading_ws(self.lines[pj])
        elif lang == 'ruby':
            if rb_is_opener(code) or _RB_MID.match(code) or _RB_BRACE_OPEN.search(code):
                return base + unit
        return base

    def ruby_opener_indent(self, li):
        depth = 0
        for j in range(li - 1, max(-1, li - 3000), -1):
            code = self.code_part(j)
            s = code.strip()
            if not s:
                continue
            if re.match(r'end\b', s):
                if not rb_is_opener(re.sub(r'^end\b', '', s).strip()):
                    depth += 1
            elif rb_is_opener(code):
                if depth == 0:
                    return leading_ws(self.lines[j])
                depth -= 1
        return None

    def python_opener_indent(self, li, keyword):
        cur = len(leading_ws(self.lines[li]).expandtabs(TAB_WIDTH))
        for j in range(li - 1, max(-1, li - 3000), -1):
            if not self.code_part(j).strip():
                continue
            ws = leading_ws(self.lines[j])
            if len(ws.expandtabs(TAB_WIDTH)) < cur:
                m = re.match(r'\s*(\w+)', self.code_part(j))
                if m and m.group(1) in _PY_OPENERS[keyword]:
                    return ws
                return None
        return None

    def reindent_keyword_line(self, li):
        """Align else/elif/except/finally (Python), end/else/when/... (Ruby) with their opener."""
        line = self.lines[li]
        if self.lang == 'ruby' and _RB_KEYLINE.match(self.code_part(li)):
            target = self.ruby_opener_indent(li)
        elif self.lang == 'python':
            m = _PY_KEYLINE.match(self.code_part(li))
            if not m:
                return
            target = self.python_opener_indent(li, m.group(1).split()[0].rstrip(':'))
        else:
            return
        if target is not None:
            self.set_indent(li, target)

    def electric(self, ch):
        li = self.cur_line
        before = self.lines[li][:self.cur_col]
        if ch in ')]}' and before.strip() == ch:
            m = self.find_match(li, self.cur_col - 1)
            if m:
                self.set_indent(li, leading_ws(self.lines[m[0]]))
        elif self.lang == 'python' and ch == ':':
            self.reindent_keyword_line(li)
        elif self.lang == 'ruby' and (
                re.fullmatch(r'\s*(?:else|elsif|when|rescue|ensure|in|end)\W', before)
                or (ch.isalnum() and re.fullmatch(r'\s*(?:else|elsif|when|rescue|ensure|end)', before))):
            self.reindent_keyword_line(li)

    def find_match(self, li, col, limit=400):
        """Matching bracket for the one at lines[li][col] (ignoring strings/comments)."""
        pairs = {'(': ')', '[': ']', '{': '}'}
        rev = {v: k for k, v in pairs.items()}
        ch = self.lines[li][col] if col < len(self.lines[li]) else ''
        if self.blank_line(li)[col:col + 1] != ch or (ch not in pairs and ch not in rev):
            return None
        n = len(self.lines)
        if ch in pairs:
            target, step, depth = pairs[ch], 1, 0
            rng = range(li, min(n, li + limit))
        else:
            target, step, depth = rev[ch], -1, 0
            rng = range(li, max(-1, li - limit), -1)
        for j in rng:
            s = self.blank_line(j)
            idxs = range(len(s)) if step > 0 else range(len(s) - 1, -1, -1)
            for k in idxs:
                if j == li and ((step > 0 and k < col) or (step < 0 and k > col)):
                    continue
                c = s[k]
                if c == ch:
                    depth += 1
                elif c == target:
                    depth -= 1
                    if depth == 0:
                        return (j, k)
        return None

    def find_bracket_pair(self):
        if not self.lang:
            return None
        li, col = self.cur_line, self.cur_col
        line = self.lines[li]
        for c in (col, col - 1):
            if 0 <= c < len(line) and line[c] in '()[]{}':
                m = self.find_match(li, c)
                if m:
                    return [(li, c), m]
        return None

    def newline(self):
        li = self.cur_line
        self.push_undo('newline')
        if self.lang:
            self.reindent_keyword_line(li)
        line = self.lines[li]
        col = self.cur_col
        before, after = line[:col], line[col:]
        base = leading_ws(line)
        ind = self.indent_after(li, col) if self.lang else base
        if not before.strip():
            before = ''
        rest = after.lstrip(' \t')
        closer = {'(': ')', '[': ']', '{': '}'}.get(before.rstrip()[-1:])
        if self.lang and closer and rest.startswith(closer):
            self.lines[li:li + 1] = [before, ind, base + rest]
            self.cur_line = li + 1
            self.cur_col = len(ind)
        else:
            self.lines[li:li + 1] = [before, ind + rest]
            self.cur_line = li + 1
            self.cur_col = len(ind)
        self.dirty = True
        self.goal_x = None

    def tab_key(self):
        li, col = self.cur_line, self.cur_col
        line = self.lines[li]
        before = line[:col]
        after = line[col:col + 1]
        if (self.lsp and self.lsp.state != 'dead' and before.strip()
                and (before[-1].isalnum() or before[-1] in '_.')
                and not (after.isalnum() or after == '_')):
            self.complete()
            return
        if self.indent_unit == '\t':
            self.insert_text('\t')
        else:
            w = self.indent_width()
            self.insert_text(' ' * (w - (text_width(before) % w)))

    def dedent_line(self):
        li = self.cur_line
        line = self.lines[li]
        ws = leading_ws(line)
        if not ws:
            return
        self.push_undo('dedent')
        self.set_indent(li, self.dedent_ws(ws))
        self.goal_x = None

    def backspace(self):
        if self.cur_col > 0:
            line = self.lines[self.cur_line]
            before = line[:self.cur_col]
            w = self.indent_width()
            if self.indent_unit != '\t' and before.strip(' ') == '' and w > 1:
                n = ((self.cur_col - 1) % w) + 1
                self.push_undo('backspace', coalesce=True)
                self.lines[self.cur_line] = line[:self.cur_col - n] + line[self.cur_col:]
                self.cur_col -= n
            else:
                self.push_undo('backspace', coalesce=True)
                self.lines[self.cur_line] = line[:self.cur_col - 1] + line[self.cur_col:]
                self.cur_col -= 1
        elif self.cur_line > 0:
            self.push_undo('join')
            prev = self.lines[self.cur_line - 1]
            self.cur_col = len(prev)
            self.lines[self.cur_line - 1] = prev + self.lines.pop(self.cur_line)
            self.cur_line -= 1
        else:
            return
        self.last_edit_line = self.cur_line
        self.dirty = True
        self.goal_x = None

    def delete_char(self):
        line = self.lines[self.cur_line]
        if self.cur_col < len(line):
            self.push_undo('delete', coalesce=True)
            self.lines[self.cur_line] = line[:self.cur_col] + line[self.cur_col + 1:]
        elif self.cur_line + 1 < len(self.lines):
            self.push_undo('join')
            self.lines[self.cur_line] = line + self.lines.pop(self.cur_line + 1)
        else:
            return
        self.dirty = True
        self.goal_x = None

    def toggle_comment(self):
        info = LANG_INFO.get(self.lang)
        if not info:
            self.status_msg = "No comment syntax known for this file type."
            return
        mark = info['comment']
        li = self.cur_line
        line = self.lines[li]
        ws = leading_ws(line)
        body = line[len(ws):]
        self.push_undo('comment')
        if body.startswith(mark):
            rest = body[len(mark):]
            if rest.startswith(' '):
                rest = rest[1:]
            new = ws + rest
        else:
            new = ws + mark + ' ' + body if body else ws + mark + ' '
        self.cur_col = max(0, min(len(new), self.cur_col + len(new) - len(line)))
        self.lines[li] = new
        self.dirty = True
        self.goal_x = None

    def cut_line(self):
        if self.last_action != 'cut':
            self.cut_buffer = []
        self.push_undo('cut', coalesce=True)
        self.cut_buffer.append(self.lines.pop(self.cur_line))
        if not self.lines:
            self.lines = ['']
        self.cur_line = min(self.cur_line, len(self.lines) - 1)
        self.cur_col = 0
        self.last_edit_line = self.cur_line
        self.dirty = True
        self.goal_x = None
        self.status_msg = f"Cut {len(self.cut_buffer)} line(s). ^U pastes them."

    def paste_lines(self):
        if not self.cut_buffer:
            self.status_msg = "Cut buffer is empty (use ^K first)."
            return
        self.push_undo('paste')
        self.lines[self.cur_line:self.cur_line] = list(self.cut_buffer)
        self.cur_line += len(self.cut_buffer)
        self.cur_col = 0
        self.dirty = True
        self.goal_x = None
        self.status_msg = f"Pasted {len(self.cut_buffer)} line(s)."

    # ---- movement -----------------------------------------------------------

    def move_left(self):
        if self.cur_col > 0:
            self.cur_col -= 1
        elif self.cur_line > 0:
            self.cur_line -= 1
            self.cur_col = len(self.lines[self.cur_line])
        self.goal_x = None

    def move_right(self):
        if self.cur_col < len(self.lines[self.cur_line]):
            self.cur_col += 1
        elif self.cur_line + 1 < len(self.lines):
            self.cur_line += 1
            self.cur_col = 0
        self.goal_x = None

    def _vertical(self, direction):
        k = self.seg_of_col(self.cur_line, self.cur_col)
        if self.goal_x is None:
            self.goal_x = self.x_of(self.cur_line, self.segs(self.cur_line)[k][0], self.cur_col)
        pos = self.next_visual((self.cur_line, k)) if direction > 0 else self.prev_visual((self.cur_line, k))
        if pos is None:
            return False
        self.cur_line, k = pos
        self.cur_col = self.col_from_x(self.cur_line, k, self.goal_x)
        return True

    def move_up(self):
        self._vertical(-1)

    def move_down(self):
        self._vertical(+1)

    def page(self, direction):
        step = max(1, self.height - 1)
        for _ in range(step):
            if not self._vertical(direction):
                break
            top = (self.top_line, self.top_seg)
            nxt = self.next_visual(top) if direction > 0 else self.prev_visual(top)
            if nxt is not None:
                self.top_line, self.top_seg = nxt

    def home_key(self):
        """Smart Home: first non-blank, then column 0."""
        ws = len(leading_ws(self.lines[self.cur_line]))
        self.cur_col = ws if self.cur_col != ws else 0
        self.goal_x = None

    def goto_line(self):
        ans = self.prompt_input(f"Go to line (1-{len(self.lines)}, or line:col)", "")
        if not ans:
            self.status_msg = "Go to cancelled."
            return
        m = re.match(r'^\s*(\d+)\s*(?:[:,]\s*(\d+))?\s*$', ans)
        if not m:
            self.status_msg = "Enter a line number, e.g. 42 or 42:7."
            return
        self.cur_line = max(0, min(int(m.group(1)) - 1, len(self.lines) - 1))
        col = int(m.group(2)) - 1 if m.group(2) else 0
        self.cur_col = max(0, min(col, len(self.lines[self.cur_line])))
        self.goal_x = None
        self.status_msg = f"Line {self.cur_line + 1}."

    # ---- search & replace ---------------------------------------------------

    def _search_label(self, verb):
        def label():
            case = "Case" if self.search_case else "NoCase"
            mode = "Regex" if self.search_regex else "Literal"
            return f"{verb} [{case} | {mode}] (^T case, ^R regex, Esc cancel)"
        return label

    def _search_toggles(self):
        def toggle_case():
            self.search_case = not self.search_case

        def toggle_regex():
            self.search_regex = not self.search_regex
        return {20: toggle_case, 18: toggle_regex}

    def _compile_search(self):
        if not self.search_query:
            return None
        flags = 0 if self.search_case else re.IGNORECASE
        pattern = self.search_query if self.search_regex else re.escape(self.search_query)
        try:
            return re.compile(pattern, flags)
        except re.error as e:
            self.status_msg = f"Invalid regex: {e}"
            return None

    def _find_forward(self, pat, line, col):
        n = len(self.lines)
        if col <= len(self.lines[line]):
            m = pat.search(self.lines[line], col)
            if m:
                return (line, m.start(), m.end(), False)
        for k in range(1, n + 1):
            i = (line + k) % n
            m = pat.search(self.lines[i])
            if m:
                return (i, m.start(), m.end(), line + k >= n)
        return None

    def _find_backward(self, pat, line, col):
        n = len(self.lines)

        def last_before(text, limit):
            found = None
            for m in pat.finditer(text):
                if m.start() < limit:
                    found = m
                else:
                    break
            return found

        m = last_before(self.lines[line], col)
        if m:
            return (line, m.start(), m.end(), False)
        for k in range(1, n + 1):
            i = (line - k) % n
            m = last_before(self.lines[i], len(self.lines[i]) + 1)
            if m:
                return (i, m.start(), m.end(), line - k < 0)
        return None

    def search(self, prompt_new=True, backward=False):
        if prompt_new or not self.search_query:
            q = self.prompt_input(self._search_label("Search"), self.search_query, self._search_toggles())
            if not q:
                self.status_msg = "Search cancelled."
                return
            self.search_query = q
        pat = self._compile_search()
        if pat is None:
            return

        if backward:
            res = self._find_backward(pat, self.cur_line, self.cur_col)
        else:
            line, col = self.cur_line, self.cur_col + 1
            pre_wrapped = False
            if col > len(self.lines[line]):
                line, col = line + 1, 0
                if line >= len(self.lines):
                    line, pre_wrapped = 0, True
            res = self._find_forward(pat, line, col)
            if res:
                res = (res[0], res[1], res[2], res[3] or pre_wrapped)

        if res:
            li, s, e, wrapped = res
            self.cur_line, self.cur_col = li, s
            self.goal_x = None
            self.match = (li, s, e)
            shown = self.search_query if len(self.search_query) < 30 else self.search_query[:27] + "..."
            self.status_msg = f"Found '{shown}' at line {li + 1}, col {s + 1}" + (" (wrapped around)" if wrapped else "")
        else:
            self.status_msg = f"'{self.search_query}' not found."

    def replace(self):
        q = self.prompt_input(self._search_label("Replace: search for"), self.search_query, self._search_toggles())
        if not q:
            self.status_msg = "Replace cancelled."
            return
        self.search_query = q
        pat = self._compile_search()
        if pat is None:
            return
        rep = self.prompt_input("Replace with (Enter accepts, Esc cancels)", self.replace_text)
        if rep is None:
            self.status_msg = "Replace cancelled."
            return
        self.replace_text = rep

        n = len(self.lines)
        start_line, start_col = self.cur_line, self.cur_col
        # Visit: rest of the current line, every following line (wrapping
        # around), and finally the untouched part of the current line before
        # the cursor. Each entry is (line, start_pos, limit) with limit the
        # exclusive upper bound for match starts (None = whole line).
        order = [(start_line, start_col, None)]
        order += [((start_line + k) % n, 0, None) for k in range(1, n)]
        order.append((start_line, 0, start_col))

        count = 0
        replace_all = False
        aborted = False
        pushed = False
        for li, pos, limit in order:
            if aborted:
                break
            while True:
                text = self.lines[li]
                if pos > len(text):
                    break
                m = pat.search(text, pos)
                if not m or (limit is not None and m.start() >= limit):
                    break
                try:
                    new = m.expand(rep) if self.search_regex else rep
                except (re.error, IndexError, KeyError) as e:
                    self.status_msg = f"Bad replacement: {e}"
                    self.match = None
                    return
                empty = (m.end() == m.start())
                if not replace_all:
                    self.cur_line, self.cur_col = li, m.start()
                    self.match = (li, m.start(), m.end())
                    ans = self.ask_key(f"Replace this match? [y]es [n]o [a]ll [q]uit   ({count} replaced so far)")
                    if ans in ('q', 27, 3, 24):
                        aborted = True
                        break
                    if ans == 'a':
                        replace_all = True
                    elif ans != 'y':
                        pos = m.end() + (1 if empty else 0)
                        continue
                if not pushed:
                    self.push_undo('replace')
                    pushed = True
                self.lines[li] = text[:m.start()] + new + text[m.end():]
                self.dirty = True
                count += 1
                self.cur_line, self.cur_col = li, m.start() + len(new)
                pos = m.start() + len(new) + (1 if empty else 0)
                if limit is not None:
                    limit += len(new) - (m.end() - m.start())

        self.invalidate(0)
        self.match = None
        self.goal_x = None
        self.status_msg = f"Replaced {count} occurrence(s)." + (" Stopped." if aborted else "")

    # ---- misc commands ------------------------------------------------------

    def word_count(self):
        words = sum(len(l.split()) for l in self.lines)
        chars = sum(len(l) for l in self.lines) + max(0, len(self.lines) - 1)
        nonblank = sum(1 for l in self.lines if l.strip())
        self.status_msg = (f"{words} words | {chars} characters | {len(self.lines)} lines "
                           f"({nonblank} non-blank)")

    def doc_stats(self):
        """Return (lines, words, chars) using cached per-line stats."""
        words = 0
        chars = 0
        for l in self.lines:
            w, c = line_stats(l)
            words += w
            chars += c
        total_lines = len(self.lines)
        chars += max(0, total_lines - 1)  # include newline characters
        return total_lines, words, chars

    def toggle_wrap(self):
        self.wrap = not self.wrap
        self.top_seg = 0
        self.col_offset = 0
        self.goal_x = None
        self.status_msg = f"Word-wrap {'on' if self.wrap else 'off'}."

    def toggle_numbers(self):
        self.show_numbers = not self.show_numbers
        self.status_msg = f"Line numbers {'on' if self.show_numbers else 'off'}."

    def save_prompt(self, quick=False):
        if quick:
            target = self.filepath
        else:
            target = self.prompt_input("Save file as (Enter to confirm, Esc to cancel)", self.filepath)
            if not target:
                self.status_msg = "Save cancelled."
                return False
        try:
            saved = save_document(target, self.lines, self.eol, self.trailing_nl)
        except Exception as e:
            self.status_msg = f"Error saving: {e}"
            return False
        self.dirty = False
        self.status_msg = f"Saved {len(self.lines)} lines to '{saved}'."
        if saved != self.filepath:
            self.lsp_detach()
            self.filepath = saved
            self.hl_states = [None]
            self.lang = detect_language(saved, self.lines)
            self.lsp_attach()
        elif self.lsp:
            self.lsp_flush()
            self.lsp.save(self.lsp_uri)
        return True

    # ---- language server integration ---------------------------------------

    def lsp_attach(self):
        self.lsp, self.lsp_uri, self.lsp_note = None, None, ''
        self._diag_cache = (None, [])
        if not self.lsp_enabled or not self.lang:
            return
        cmd = find_lsp_command(self.lang)
        if not cmd:
            self.lsp_note = 'none'
            return
        root = find_project_root(self.filepath)
        key = (tuple(cmd), root)
        client = self.lsp_clients.get(key)
        if client is None or client.state == 'dead':
            client = LspClient(os.path.basename(cmd[0]), cmd, root)
            client.start()
            self.lsp_clients[key] = client
        if client.state == 'dead':
            self.lsp_note = 'failed'
            return
        self.lsp = client
        self.lsp_uri = path_to_uri(self.filepath)
        client.open(self.lsp_uri, LANG_INFO[self.lang]['lsp_id'], self.document_text())
        self.lsp_rev = self.seen_rev = self.rev
        self.rev_time = time.monotonic()

    def lsp_detach(self):
        if getattr(self, 'lsp', None) and self.lsp.state != 'dead':
            self.lsp.close(self.lsp_uri)
        self.lsp, self.lsp_uri = None, None

    def lsp_flush(self):
        if self.lsp and self.rev != self.lsp_rev:
            self.lsp.change(self.lsp_uri, self.document_text())
            self.lsp_rev = self.rev

    def lsp_shutdown(self):
        for c in self.lsp_clients.values():
            c.stop()

    def tick(self):
        """Idle housekeeping: server messages, debounced didChange, status expiry."""
        now = time.monotonic()
        for c in self.lsp_clients.values():
            if c.poll():
                self.need_draw = True
        if self.rev != self.seen_rev:
            self.seen_rev = self.rev
            self.rev_time = now
        if self.lsp and self.rev != self.lsp_rev and now - self.rev_time >= 0.3:
            self.lsp_flush()
        if not self._status_cleared and now - self._status_t > STATUS_TTL:
            self._status_cleared = True
            self.need_draw = True

    def lsp_request(self, method, extra=None):
        """Synchronous position-based request; returns the result or None (status set)."""
        client = self.lsp
        if not client:
            self.status_msg = ("No language server for this file type"
                               + (" (install pylsp, clangd, solargraph...)" if self.lang else "") + ".")
            return None
        if client.state == 'dead':
            self.status_msg = f"Language server stopped: {client.error}"
            return None
        self.lsp_flush()
        if client.state == 'starting':
            self.status_msg = "Waiting for language server (Esc cancels)..."
            self.draw()
        line = self.lines[self.cur_line]
        params = {'textDocument': {'uri': self.lsp_uri},
                  'position': {'line': self.cur_line, 'character': to_utf16(line, self.cur_col)}}
        params.update(extra or {})
        result, err = client.request_sync(method, params, abort=self.abort_requested)
        if err:
            self.status_msg = f"Language server: {err}"
            return None
        return result if result is not None else []

    def complete(self):
        result = self.lsp_request('textDocument/completion')
        if result is None:
            return
        raw = result.get('items', []) if isinstance(result, dict) else result
        line = self.lines[self.cur_line]
        start = self.cur_col
        while start > 0 and (line[start - 1].isalnum() or line[start - 1] == '_'):
            start -= 1
        items = []
        for it in raw:
            label = it.get('label', '')
            text = it.get('insertText') or label
            edit = it.get('textEdit')
            estart = None
            if isinstance(edit, dict):
                r = edit.get('range') or edit.get('insert')
                if r and r['start']['line'] == self.cur_line:
                    estart = from_utf16(line, r['start']['character'])
                    text = edit.get('newText', text)
            if it.get('insertTextFormat') == 2:
                text = re.sub(r'\$\{\d+:([^}]*)\}|\$\{\d+\}|\$\d+', lambda m: m.group(1) or '', text)
            items.append({'label': label.strip(), 'text': text, 'start': estart,
                          'detail': (it.get('detail') or '').splitlines()[0] if it.get('detail') else '',
                          'sort': it.get('sortText') or label,
                          'filter': (it.get('filterText') or label).lower()})
        items.sort(key=lambda i: i['sort'])
        word = line[start:self.cur_col]
        shown = self._filter_completions(items, word)
        if not shown:
            self.status_msg = "No completions."
            return
        if len(shown) == 1:
            self._apply_completion(shown[0], start)
            return
        self.completion_menu(items, start)

    @staticmethod
    def _filter_completions(items, word):
        w = word.lower()
        hits = [i for i in items if i['filter'].startswith(w)]
        if not hits and w:
            hits = [i for i in items if w in i['filter']]
        return hits[:300]

    def _apply_completion(self, item, word_start):
        li = self.cur_line
        line = self.lines[li]
        start = item['start'] if item['start'] is not None and item['start'] <= self.cur_col else word_start
        self.push_undo('complete')
        self.lines[li] = line[:start] + item['text'] + line[self.cur_col:]
        self.cur_col = start + len(item['text'])
        self.dirty = True
        self.goal_x = None

    def completion_menu(self, items, start):
        sel = top = 0
        while True:
            line = self.lines[self.cur_line]
            word = line[start:self.cur_col]
            shown = self._filter_completions(items, word)
            if not shown:
                return
            sel = max(0, min(sel, len(shown) - 1))
            self.draw()
            max_y, max_x = self.stdscr.getmaxyx()
            rows = min(8, len(shown))
            cy, cx = self.cursor_screen
            below = cy + 1 + rows <= max_y - 3
            y0 = cy + 1 if below else max(1, cy - rows)
            if sel < top:
                top = sel
            elif sel >= top + rows:
                top = sel - rows + 1
            label_w = min(max(len(i['label']) for i in shown[top:top + rows]), 40)
            width = min(max_x - 2, label_w + 2 + 28)
            x0 = max(0, min(cx - (self.cur_col - start), max_x - 1 - width))
            for r in range(rows):
                it = shown[top + r]
                text = f" {it['label']:<{label_w}}  {it['detail']}"[:width].ljust(width)
                attr = self.attr_prompt if top + r == sel else self.attr_bar
                try:
                    self.stdscr.addstr(y0 + r, x0, text, attr)
                except curses.error:
                    pass
            try:
                self.stdscr.move(cy, cx)
            except curses.error:
                pass
            self.stdscr.refresh()
            ch = self.read_key()
            if ch is None:
                continue
            if ch == curses.KEY_UP:
                sel = (sel - 1) % len(shown)
            elif ch == curses.KEY_DOWN:
                sel = (sel + 1) % len(shown)
            elif ch == curses.KEY_PPAGE:
                sel = max(0, sel - rows)
            elif ch == curses.KEY_NPAGE:
                sel = min(len(shown) - 1, sel + rows)
            elif ch in (10, 13, 9, curses.KEY_ENTER):
                self._apply_completion(shown[sel], start)
                return
            elif ch in (27, 3, 7):
                return
            elif isinstance(ch, str) and (ch.isalnum() or ch == '_'):
                self.insert_text(ch)
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                if self.cur_col <= start:
                    return
                self.backspace()
            else:
                self.pushback.append(ch)
                return

    def hover(self):
        result = self.lsp_request('textDocument/hover')
        if not result:
            if result is not None:
                self.status_msg = "No hover information here."
            return

        def flat(c):
            if isinstance(c, str):
                return c
            if isinstance(c, list):
                return '\n\n'.join(flat(x) for x in c)
            if isinstance(c, dict):
                return c.get('value', '')
            return ''
        text = flat(result.get('contents', ''))
        lines = [l for l in text.replace('\r', '').splitlines() if not l.strip().startswith('```')]
        while lines and not lines[-1].strip():
            lines.pop()
        while lines and not lines[0].strip():
            lines.pop(0)
        if not lines:
            self.status_msg = "No hover information here."
            return
        if len(lines) == 1 and len(lines[0]) < 200:
            self.status_msg = lines[0].strip()
            return
        self.show_text("Hover", lines)

    def goto_definition(self):
        result = self.lsp_request('textDocument/definition')
        if result is None:
            return
        locs = result if isinstance(result, list) else [result]
        targets = []
        for loc in locs:
            uri = loc.get('targetUri') or loc.get('uri')
            rng = loc.get('targetSelectionRange') or loc.get('range')
            if uri and rng:
                targets.append((uri, rng['start']['line'], rng['start']['character']))
        if not targets:
            self.status_msg = "No definition found."
            return
        uri, line, ch = targets[0]
        path = uri_to_path(uri)
        if path is None:
            self.status_msg = f"Definition is at {uri}"
            return
        self.jump_stack.append((os.path.abspath(self.filepath), self.cur_line, self.cur_col))
        if not self.jump_to(path, line, ch):
            self.jump_stack.pop()
            return
        self.status_msg = ("Definition" + (f" (1 of {len(targets)}; ^\\ goes back)"
                                           if len(targets) > 1 else " (^\\ goes back)"))

    def jump_to(self, path, line, utf16_col):
        if os.path.abspath(path) != os.path.abspath(self.filepath):
            if not self.confirm_leave():
                return False
            try:
                self.load_file(path)
            except Exception as e:
                self.status_msg = f"Cannot open {path}: {e}"
                return False
        self.cur_line = max(0, min(line, len(self.lines) - 1))
        self.cur_col = from_utf16(self.lines[self.cur_line], utf16_col)
        self.goal_x = None
        return True

    def jump_back(self):
        if not self.jump_stack:
            self.status_msg = "Jump stack is empty."
            return
        path, line, col = self.jump_stack.pop()
        if os.path.abspath(path) != os.path.abspath(self.filepath):
            if not self.confirm_leave():
                self.jump_stack.append((path, line, col))
                return
            try:
                self.load_file(path)
            except Exception as e:
                self.status_msg = f"Cannot open {path}: {e}"
                return
        self.cur_line = max(0, min(line, len(self.lines) - 1))
        self.cur_col = max(0, min(col, len(self.lines[self.cur_line])))
        self.goal_x = None

    def confirm_leave(self):
        if not self.dirty:
            return True
        ans = self.prompt_input("Save changes before switching files? (y/n/Esc)", "y")
        if ans is None:
            return False
        if ans.lower().startswith('y'):
            return self.save_prompt(quick=True)
        return True

    # ---- running programs ---------------------------------------------------

    def suspend(self):
        tty_write('\x1b[?2004l')
        curses.def_prog_mode()
        curses.endwin()

    def resume(self):
        curses.reset_prog_mode()
        self.stdscr.keypad(True)
        self.tune_tty()
        self.stdscr.timeout(TICK_MS)
        tty_write('\x1b[?2004h')
        self.stdscr.clearok(True)
        self.stdscr.refresh()
        self.need_draw = True

    def run_program(self, ask_args=False):
        lang = self.lang
        ext = os.path.splitext(self.filepath)[1].lower()
        if lang not in LANG_INFO:
            self.status_msg = "Don't know how to run this file type (Python, Ruby, C and C++ are supported)."
            return
        if lang in ('c', 'cpp') and ext in HEADER_EXTS:
            self.status_msg = "A header file cannot be run; open the .c/.cpp file instead."
            return
        if ask_args:
            ans = self.prompt_input("Program arguments", self.run_args)
            if ans is None:
                self.status_msg = "Run cancelled."
                return
            self.run_args = ans
        try:
            args = shlex.split(self.run_args)
        except ValueError as e:
            self.status_msg = f"Bad arguments: {e}"
            return
        if self.dirty or not os.path.exists(self.filepath):
            if not self.save_prompt(quick=True):
                return
        path = os.path.abspath(self.filepath)
        cwd = os.path.dirname(path)

        tmpdir = None
        diags = None
        self.suspend()
        try:
            run_cmd = None
            try:
                if lang == 'python':
                    run_cmd = [shutil.which('python3') or sys.executable, path] + args
                elif lang == 'ruby':
                    run_cmd = [shutil.which('ruby') or 'ruby', path] + args
                else:
                    cpp = lang == 'cpp'
                    cc = os.environ.get('CXX' if cpp else 'CC') or next(
                        (c for c in (('c++', 'g++', 'clang++') if cpp else ('cc', 'gcc', 'clang'))
                         if shutil.which(c)), None)
                    if not cc:
                        print("No C/C++ compiler found (install gcc or clang).")
                    else:
                        tmpdir = tempfile.mkdtemp(prefix='progedit-')
                        exe = os.path.join(tmpdir, 'prog')
                        flags = ['-g', '-Wall', '-Wextra'] + shlex.split(
                            os.environ.get('PROGEDIT_CXXFLAGS' if cpp else 'PROGEDIT_CFLAGS', ''))
                        if cpp and not any(f.startswith('-std=') for f in flags):
                            flags.append('-std=c++17')
                        cmd = [cc] + flags + ['-o', exe, path] + ([] if cpp else ['-lm'])
                        print(f"$ {shlex.join(cmd)}", flush=True)
                        r = subprocess.run(cmd, cwd=cwd, stdout=subprocess.PIPE,
                                           stderr=subprocess.STDOUT, text=True, errors='replace')
                        if r.stdout:
                            print(r.stdout, end='' if r.stdout.endswith('\n') else '\n')
                        diags = parse_build_output(r.stdout, path)
                        if r.returncode != 0:
                            print("[compilation failed]")
                        else:
                            run_cmd = [exe] + args
            except FileNotFoundError as e:
                print(f"Cannot start: {e}")
            except KeyboardInterrupt:
                print("^C")

            status = None
            if run_cmd:
                print(f"$ {shlex.join(run_cmd)}", flush=True)
                t0 = time.monotonic()
                try:
                    status = subprocess.run(run_cmd, cwd=cwd).returncode
                except KeyboardInterrupt:
                    status = 130
                except OSError as e:
                    print(f"Cannot start: {e}")
                if status is not None:
                    print(f"\n[exit status {status}, {time.monotonic() - t0:.2f}s]")
            try:
                input("Press Enter to return to the editor...")
            except (EOFError, KeyboardInterrupt):
                pass
        finally:
            if tmpdir:
                shutil.rmtree(tmpdir, ignore_errors=True)
            self.resume()

        if diags is not None:
            self.build_diags = diags
            self.build_serial += 1
            errs = [d for d in diags if d[4] == 1]
            if errs:
                self.cur_line, self.cur_col = errs[0][0], errs[0][1]
                self.status_msg = (f"Build failed: {len(errs)} error(s). "
                                   f"error: {errs[0][5]}  (F8 next)")
            elif diags:
                self.status_msg = f"Built with {len(diags)} warning(s) (F8 to step through)."
            else:
                self.status_msg = "Build succeeded."
        elif status is not None:
            self.status_msg = f"Program exited with status {status}."

    # ---- main loop ----------------------------------------------------------

    def exit_prompt(self):
        """Returns True if the editor should quit."""
        if not self.dirty:
            return True
        ans = self.prompt_input("Save modified text before exiting? (y/n/Esc)", "y")
        if ans is None:
            self.status_msg = "Exit cancelled."
            return False
        if ans.lower().startswith('y'):
            return self.save_prompt(quick=False)
        return ans.lower().startswith('n')

    def run(self):
        while True:
            self.tick()
            if self.need_draw:
                self.draw()
                self.need_draw = False
            ch = self.read_key()
            if ch is None or ch == curses.KEY_RESIZE:
                if ch is not None:
                    self.need_draw = True
                continue
            self.need_draw = True
            self.invalidate(self.cur_line - 1)

            keep_match = ch in (14, 16)
            if not keep_match:
                self.match = None

            if isinstance(ch, tuple):                  # Alt+key
                key = ch[1]
                if key == '/':
                    self.toggle_comment()
                elif key == 'n':
                    self.jump_diagnostic(+1)
                elif key == 'p':
                    self.jump_diagnostic(-1)
                continue

            # Navigation
            if ch == curses.KEY_UP:
                self.move_up()
                self.last_action = None
            elif ch == curses.KEY_DOWN:
                self.move_down()
                self.last_action = None
            elif ch == curses.KEY_LEFT:
                self.move_left()
                self.last_action = None
            elif ch == curses.KEY_RIGHT:
                self.move_right()
                self.last_action = None
            elif ch == curses.KEY_PPAGE:
                self.page(-1)
                self.last_action = None
            elif ch == curses.KEY_NPAGE:
                self.page(+1)
                self.last_action = None
            elif ch == curses.KEY_HOME:
                self.home_key()
                self.last_action = None
            elif ch == 1:                              # ^A
                self.cur_col = 0
                self.goal_x = None
                self.last_action = None
            elif ch in (curses.KEY_END, 5):            # End / ^E
                self.cur_col = len(self.lines[self.cur_line])
                self.goal_x = None
                self.last_action = None
            elif ch == 7:                              # ^G
                self.goto_line()
                self.last_action = None

            # Editing
            elif ch in (10, 13, curses.KEY_ENTER):
                self.newline()
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                self.backspace()
            elif ch == curses.KEY_DC:
                self.delete_char()
            elif ch == 9:                              # Tab
                self.tab_key()
            elif ch == curses.KEY_BTAB:                # Shift-Tab
                self.dedent_line()
            elif ch in (31,):                          # ^_  (Ctrl-/)
                self.toggle_comment()
            elif ch == 11:                             # ^K
                self.cut_line()
            elif ch == 21:                             # ^U
                self.paste_lines()
            elif ch == 26:                             # ^Z
                self.undo()
            elif ch == 25:                             # ^Y
                self.redo()
            elif ch == PASTE_START:
                self.insert_paste(self.read_paste())

            # Search / replace
            elif ch == 23:                             # ^W
                self.search(prompt_new=True)
                self.last_action = None
            elif ch == 14:                             # ^N
                self.search(prompt_new=False)
                self.last_action = None
            elif ch == 16:                             # ^P
                self.search(prompt_new=False, backward=True)
                self.last_action = None
            elif ch == 18:                             # ^R
                self.replace()
                self.last_action = None

            # Programming features
            elif ch in (2, curses.KEY_F5):             # ^B / F5
                self.run_program()
            elif ch in (6, curses.KEY_F6):             # ^F / F6
                self.run_program(ask_args=True)
            elif ch == curses.KEY_F8:
                self.jump_diagnostic(+1)
            elif ch == curses.KEY_F7:
                self.jump_diagnostic(-1)
            elif ch == 0:                              # ^Space
                self.complete()
            elif ch in (17, curses.KEY_F2):            # ^Q
                self.hover()
            elif ch in (29, curses.KEY_F12):           # ^]
                self.goto_definition()
            elif ch == 28:                             # ^\
                self.jump_back()

            # File / view
            elif ch == 19:                             # ^S
                self.save_prompt(quick=True)
            elif ch == 15:                             # ^O
                self.save_prompt(quick=False)
            elif ch == 12:                             # ^L
                self.toggle_wrap()
            elif ch == curses.KEY_F4:
                self.toggle_numbers()
            elif ch == 20:                             # ^T
                self.cycle_theme()
            elif ch == 4:                              # ^D
                self.word_count()
            elif ch == curses.KEY_F1:
                self.show_help()
            elif ch in (24, 3):                        # ^X / ^C
                if self.exit_prompt():
                    break

            # Plain text (including non-ASCII)
            elif isinstance(ch, str):
                self.type_char(ch)


def main():
    argv = sys.argv[1:]
    lsp_enabled = os.environ.get('PROGEDIT_LSP', '1') != '0'
    if '--no-lsp' in argv:
        lsp_enabled = False
        argv.remove('--no-lsp')
    if argv and argv[0] in ('-h', '--help'):
        print("Usage: progedit [--no-lsp] [file[:line]]")
        print("A nano-style terminal editor for programmers: syntax highlighting, auto-indent,")
        print("LSP support and run/compile for Python, Ruby, C and C++ (^B). F1 shows the keys.")
        sys.exit(0)

    filepath = argv[0] if argv else "untitled.txt"
    goto = None
    m = re.match(r'^(.*):(\d+)$', filepath)
    if m and not os.path.exists(filepath):
        filepath, goto = m.group(1), int(m.group(2))
    os.environ.setdefault('ESCDELAY', '25')
    try:
        locale.setlocale(locale.LC_ALL, '')
    except locale.Error:
        pass

    editors = []

    def run(stdscr):
        ed = Editor(stdscr, filepath, lsp_enabled, goto)
        editors.append(ed)
        ed.run()

    try:
        curses.wrapper(run)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        pass
    finally:
        tty_write('\x1b[?2004l')
        for ed in editors:
            ed.lsp_shutdown()


if __name__ == "__main__":
    main()
