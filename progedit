_TOKENS = {'c': _C_TOKEN, 'cpp': _C_TOKEN, 'python': _PY_TOKEN, 'ruby': _RB_TOKEN}
_RB_REGEX_WORDS = {'if', 'unless', 'when', 'and', 'or', 'not', 'while', 'until', 'return',
                   'then', 'puts', 'p', 'print'}
_CLOSERS = {'[': ']', '(': ')', '{': '}', '<': '>'}


def _find_close(text, i, delim):
    """Index just past the first unescaped `delim` at/after i, or -1."""
    n = len(text)
    d = len(delim)
    while i < n:
        if text[i] == '\\':
            i += 2
            continue
        if text.startswith(delim, i):
            return i + d
        i += 1
    return -1


def _rb_regex_ok(text, pos, pct):
    before = text[:pos]
    stripped = before.rstrip()
    if not stripped:
        return True
    if pct:
        return before[-1] in ' \t([{,='
    if stripped[-1] in '(,=~!|&{[;:?<>+-*%^':
        return True
    m = re.search(r'([A-Za-z_]\w*)$', stripped)
    return bool(m and m.group(1) in _RB_REGEX_WORDS)


@lru_cache(maxsize=60000)
def tokenize(lang, text, state):
    """
    Lex one line. `state` is the lexer state at the start of the line (None or a
    tuple describing an unfinished multi-line construct). Returns
    (spans, end_state) where spans is a tuple of (start, end, kind); kinds are
    kw type func str com num pre const spec.
    """
    spans = []
    n = len(text)
    i = 0
    info = LANG_INFO[lang]
    fam = 'c' if lang in ('c', 'cpp') else lang
    words = info['words']

    if state is not None:
        kind = state[0]
        if kind == 'BC':
            j = text.find('*/')
            if j < 0:
                return (((0, n, 'com'),) if n else ()), state
            spans.append((0, j + 2, 'com'))
            i, state = j + 2, None
        elif kind == 'PP':
            if n:
                spans.append((0, n, 'pre'))
            return tuple(spans), (('PP',) if text.rstrip().endswith('\\') else None)
        elif kind == 'TQ':
            j = _find_close(text, 0, state[1])
            if j < 0:
                return (((0, n, 'str'),) if n else ()), state
            spans.append((0, j, 'str'))
            i, state = j, None
        elif kind == 'RB':
            if n:
                spans.append((0, n, 'com'))
            return tuple(spans), (None if text.startswith('=end') else state)
        elif kind == 'HD':
            _, term, flex = state
            if n:
                spans.append((0, n, 'str'))
            done = (text.strip() if flex else text.rstrip()) == term
            return tuple(spans), (None if done else state)
    elif fam == 'ruby' and text.startswith('=begin'):
        return ((0, n, 'com'),), ('RB',)

    pp_cont = False
    if fam == 'c' and i == 0 and state is None:
        m = re.match(r'\s*#', text)
        if m:
            cuts = [p for p in (text.find('//'), text.find('/*')) if p >= 0]
            j = min(cuts) if cuts else n
            if text[m.end() - 1:j].strip():
                spans.append((m.end() - 1, j, 'pre'))
            i = j
            pp_cont = text.rstrip().endswith('\\')

    pat = _TOKENS[lang]
    prev = None                    # previous identifier (for def / class names)
    pending = None                 # heredoc opened on this line (ruby)
    while i < n:
        m = pat.search(text, i)
        if not m:
            break
        kind = m.lastgroup
        s, e = m.start(), m.end()
        if kind == 'com':
            spans.append((s, n, 'com'))
            i = n
            break
        if kind == 'bc':
            k = text.find('*/', e)
            if k < 0:
                spans.append((s, n, 'com'))
                state = ('BC',)
                i = n
                break
            spans.append((s, k + 2, 'com'))
            i = k + 2
            prev = None
            continue
        if kind == 'str' and fam == 'python':
            q = m.group('q')
            k = _find_close(text, e, q)
            if k < 0:
                spans.append((s, n, 'str'))
                if len(q) == 3:
                    state = ('TQ', q)
                i = n
                break
            spans.append((s, k, 'str'))
            i = k
            prev = None
            continue
        if kind in ('str', 'chr'):
            spans.append((s, e, 'str'))
            i = e
            prev = None
            continue
        if kind == 'num':
            spans.append((s, e, 'num'))
            i = e
            prev = None
            continue
        if kind == 'deco':
            if not text[:s].strip():
                spans.append((s, e, 'spec'))
            i = e
            prev = None
            continue
        if kind in ('sym', 'ivar'):
            spans.append((s, e, 'spec'))
            i = e
            prev = None
            continue
        if kind == 'hd':
            term = m.group('hid1') or m.group('hid2')
            if m.group('hid2') and not re.fullmatch(r'[A-Z_][A-Z0-9_]*', term):
                i = s + 2
                continue
            spans.append((s, e, 'spec'))
            pending = ('HD', term, text[s + 2] in '~-')
            i = e
            continue
        if kind in ('pct', 're'):
            if not _rb_regex_ok(text, s, kind == 'pct'):
                i = e
                continue
            if kind == 're':
                k = _find_close(text, e, '/')
            else:
                o = m.group()[-1]
                k = _find_close(text, e, _CLOSERS.get(o, o))
            if k < 0:
                i = e
                continue
            while kind == 're' and k < n and text[k] in 'imxounse':
                k += 1
            spans.append((s, k, 'str'))
            i = k
            prev = None
            continue

        # identifiers
        word = m.group()
        if fam == 'ruby' and word.endswith('!') and text[e:e + 1] == '=':
            word, e = word[:-1], e - 1
        k = words.get(word)
        if k is None:
            if prev == 'def' and fam in ('python', 'ruby'):
                k = 'func'
            elif prev in ('class', 'struct', 'union', 'enum', 'namespace', 'typename', 'module'):
                k = 'type'
            elif fam == 'ruby' and word[0].isupper():
                k = 'const' if word.isupper() and len(word) > 1 else 'type'
            elif fam == 'c' and len(word) > 2 and word.isupper() and '_' in word + 'X':
                k = 'const'
            elif re.match(r'\s*\(', text[e:]):
                k = 'func'
        elif k == 'kw' and prev == 'def' and fam == 'ruby':
            k = 'func'
        if k:
            spans.append((s, e, k))
        i = e
        if fam == 'ruby' and word == 'self' and prev == 'def':
            continue                       # def self.name
        prev = word

    if state is None:
        state = pending or (('PP',) if pp_cont else None)
    return tuple(spans), state


@lru_cache(maxsize=30000)
def blank_code(lang, text, state):
    """The line with strings, comments and preprocessor text replaced by spaces."""
    spans, _ = tokenize(lang, text, state)
    if not spans:
        return text
    chars = list(text)
    for s, e, k in spans:
        if k in ('str', 'com', 'pre'):
            chars[s:e] = ' ' * (e - s)
    return ''.join(chars)


# ---- indentation rules ---------------------------------------------------- #

_RB_OPEN = re.compile(r'^\s*(?:def|class|module|if|unless|while|until|for|case|begin)\b'
                      r'|\bdo(?:\s*\|[^|]*\|)?\s*$'
                      r'|=\s*(?:if|unless|case|begin|while|until)\b'
                      r'|^\s*(?:private|protected|public)\s+def\b')
_RB_MID = re.compile(r'^\s*(?:else|elsif|when|rescue|ensure|in)\b')
_RB_KEYLINE = re.compile(r'^\s*(?:end|else|elsif|when|rescue|ensure|in)\b')
_RB_BRACE_OPEN = re.compile(r'[{(\[]\s*(?:\|[^|]*\|)?\s*$')
_RB_ENDLESS = re.compile(r'^\s*def\s+[\w.?!]+\s*(?:\([^)]*\))?\s*=(?![=~>])')
_PY_DEDENT = re.compile(r'^\s*(?:return|pass|break|continue|raise)\b')
_PY_KEYLINE = re.compile(r'^\s*(else|elif\b.*|except\b.*|finally)\s*:\s*$')
_PY_OPENERS = {'else': ('if', 'elif', 'for', 'while', 'try', 'except'),
               'elif': ('if', 'elif'),
               'except': ('try', 'except'),
               'finally': ('try', 'except', 'else')}
_C_CTRL = re.compile(r'^\s*(?:(?:\}\s*)?else\s+if|if|for|while)\b.*\)\s*$'
                     r'|^\s*(?:\}\s*)?else\s*$|^\s*do\s*$')
_C_CASE = re.compile(r'^\s*(?:case\b.*|default\s*):\s*$')


def rb_is_opener(code):
    s = code.strip()
    if not s or not _RB_OPEN.search(s):
        return False
    if re.search(r'\bend\s*$', s) or _RB_ENDLESS.match(s):
        return False
    if re.search(r'\bthen\b\s*\S', s):
        return False
    return True


