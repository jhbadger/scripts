def detect_language(path, lines):
    base = os.path.basename(path)
    ext = os.path.splitext(base)[1].lower()
    lang = NAME_LANG.get(base) or EXT_LANG.get(ext)
    if lang == 'c' and ext == '.h':
        sample = '\n'.join(lines[:300])
        if re.search(r'^\s*(?:class\s+\w+|namespace\s+\w+|template\s*<|using\s+namespace|'
                     r'public:|private:|protected:)', sample, re.M):
            lang = 'cpp'
    if lang is None and lines and lines[0].startswith('#!'):
        first = lines[0]
        if 'python' in first:
            lang = 'python'
        elif 'ruby' in first:
            lang = 'ruby'
    return lang


