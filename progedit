def to_basic_color(c):
    """Approximate an xterm-256 colour index with one of the 8 basic colours."""
    if c < 0:
        return -1
    if c < 16:
        return c % 8
    if c >= 232:                                   # greyscale ramp
        return 0 if c < 244 else 7
    c -= 16
    r, g, b = c // 36, (c // 6) % 6, c % 6         # 6x6x6 colour cube, levels 0-5
    bits = (1 if r >= 3 else 0) | (2 if g >= 3 else 0) | (4 if b >= 3 else 0)
    if bits == 0 and max(r, g, b) > 0:             # dark shade: keep its dominant hue
        top = max(r, g, b)
        bits = (1 if r == top else 0) | (2 if g == top else 0) | (4 if b == top else 0)
    return bits


def load_theme_index():
    env = os.environ.get("PROGEDIT_THEME")
    for source in (env, None):
        try:
            raw = source if source is not None else open(THEME_FILE).read()
            return int(raw.strip()) % len(THEMES)
        except (OSError, ValueError, TypeError):
            continue
    return 1


