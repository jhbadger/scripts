def find_lsp_command(lang):
    """First installed server for the language (config file wins), or None."""
    try:
        with open(os.path.join(CONFIG_DIR, 'lsp.json')) as f:
            cfg = json.load(f)
        cmd = cfg.get(lang)
        if isinstance(cmd, str):
            cmd = shlex.split(cmd)
        if cmd and shutil.which(cmd[0]):
            return list(cmd)
    except (OSError, ValueError, AttributeError):
        pass
    for cmd in LSP_SERVERS.get(lang, []):
        if shutil.which(cmd[0]):
            return list(cmd)
    return None


def find_project_root(path):
    d = os.path.dirname(os.path.abspath(path))
    cur = d
    while True:
        if any(os.path.exists(os.path.join(cur, m)) for m in ROOT_MARKERS):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            return d
        cur = parent


def path_to_uri(path):
    return 'file://' + quote(os.path.abspath(path))


def uri_to_path(uri):
    u = urlparse(uri)
    return unquote(u.path) if u.scheme == 'file' else None


def to_utf16(line, col):
    if line.isascii():
        return col
    return sum(2 if ord(c) > 0xFFFF else 1 for c in line[:col])


def from_utf16(line, u):
    if line.isascii():
        return min(u, len(line))
    n = 0
    for i, c in enumerate(line):
        if n >= u:
            return i
        n += 2 if ord(c) > 0xFFFF else 1
    return len(line)


class LspClient:
    """Minimal JSON-RPC/LSP client over a subprocess; one reader thread feeds a queue."""

    def __init__(self, name, cmd, root):
        self.name = name
        self.cmd = cmd
        self.root = root
        self.proc = None
        self.q = queue.Queue()
        self.next_id = 1
        self.pending = {}
        self.state = 'starting'            # starting | ready | dead
        self.error = ''
        self.docs = {}                     # uri -> {lang, version, text, sent}
        self.diags = {}                    # uri -> raw diagnostics list
        self.diag_rev = 0
        self.caps = {}

    # ---- transport ----------------------------------------------------------

    def start(self):
        try:
            self.proc = subprocess.Popen(self.cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.DEVNULL, cwd=self.root,
                                         start_new_session=True)
        except OSError as e:
            self.state, self.error = 'dead', str(e)
            return False
        threading.Thread(target=self._reader, daemon=True).start()
        self.request('initialize', {
            'processId': os.getpid(),
            'clientInfo': {'name': 'progedit'},
            'rootUri': path_to_uri(self.root),
            'rootPath': self.root,
            'workspaceFolders': [{'uri': path_to_uri(self.root), 'name': os.path.basename(self.root)}],
            'capabilities': {
                'general': {'positionEncodings': ['utf-16']},
                'workspace': {'workspaceFolders': True, 'configuration': True},
                'textDocument': {
                    'synchronization': {'didSave': True},
                    'publishDiagnostics': {},
                    'completion': {'completionItem': {'snippetSupport': False,
                                                      'documentationFormat': ['plaintext']}},
                    'hover': {'contentFormat': ['plaintext', 'markdown']},
                    'definition': {'linkSupport': True},
                },
            },
        }, self._on_initialized)
        return True

    def _reader(self):
        out = self.proc.stdout
        try:
            while True:
                length = None
                while True:
                    line = out.readline()
                    if not line:
                        raise EOFError
                    line = line.strip()
                    if not line:
                        break
                    if line.lower().startswith(b'content-length:'):
                        length = int(line.split(b':', 1)[1])
                if length is None:
                    continue
                body = out.read(length)
                if len(body) < length:
                    raise EOFError
                self.q.put(json.loads(body))
        except Exception:
            pass
        self.q.put(None)

    def _send(self, msg):
        if self.state == 'dead' or self.proc is None:
            return
        body = json.dumps(msg, separators=(',', ':')).encode('utf-8')
        try:
            self.proc.stdin.write(b'Content-Length: %d\r\n\r\n' % len(body) + body)
            self.proc.stdin.flush()
        except (OSError, ValueError):
            self.state, self.error = 'dead', self.error or 'server exited'

    def notify(self, method, params):
        self._send({'jsonrpc': '2.0', 'method': method, 'params': params})

    def request(self, method, params, cb=None):
        rid = self.next_id
        self.next_id += 1
        self.pending[rid] = cb
        self._send({'jsonrpc': '2.0', 'id': rid, 'method': method, 'params': params})
        return rid

    def poll(self, wait=0.0):
        """Process queued server messages; True if something visible changed."""
        changed = False
        first = True
        while True:
            try:
                msg = self.q.get(timeout=wait) if (first and wait) else self.q.get_nowait()
            except queue.Empty:
                break
            first = False
            if msg is None:
                if self.state != 'dead':
                    self.state, self.error = 'dead', self.error or 'server exited'
                    changed = True
                break
            changed |= self._dispatch(msg)
        return changed

    def _dispatch(self, msg):
        method = msg.get('method')
        if method is not None and 'id' in msg:                    # request from the server
            result = None
            if method == 'workspace/configuration':
                result = [None] * len(msg.get('params', {}).get('items', []))
            self._send({'jsonrpc': '2.0', 'id': msg['id'], 'result': result})
            return False
        if method is not None:                                    # notification
            if method == 'textDocument/publishDiagnostics':
                p = msg.get('params', {})
                self.diags[p.get('uri')] = p.get('diagnostics', [])
                self.diag_rev += 1
                return True
            return False
        cb = self.pending.pop(msg.get('id'), None)                # response
        if cb:
            err = msg.get('error')
            cb(msg.get('result'), err.get('message', 'error') if err else None)
        return False

    def _on_initialized(self, result, error):
        if error or not isinstance(result, dict):
            self.state, self.error = 'dead', error or 'bad initialize reply'
            return
        self.caps = result.get('capabilities', {})
        self.notify('initialized', {})
        self.state = 'ready'
        for uri, d in self.docs.items():
            self._did_open(uri, d)

    # ---- documents ----------------------------------------------------------

    def _did_open(self, uri, d):
        d['sent'] = True
        self.notify('textDocument/didOpen', {'textDocument': {
            'uri': uri, 'languageId': d['lang'], 'version': d['version'], 'text': d['text']}})

    def open(self, uri, lang, text):
        d = self.docs[uri] = {'lang': lang, 'version': 1, 'text': text, 'sent': False}
        if self.state == 'ready':
            self._did_open(uri, d)

    def change(self, uri, text):
        d = self.docs.get(uri)
        if not d:
            return
        d['version'] += 1
        d['text'] = text
        if d['sent']:
            self.notify('textDocument/didChange', {
                'textDocument': {'uri': uri, 'version': d['version']},
                'contentChanges': [{'text': text}]})

    def save(self, uri):
        if self.docs.get(uri, {}).get('sent'):
            self.notify('textDocument/didSave', {'textDocument': {'uri': uri}})

    def close(self, uri):
        d = self.docs.pop(uri, None)
        if d and d['sent']:
            self.notify('textDocument/didClose', {'textDocument': {'uri': uri}})
        if self.diags.pop(uri, None) is not None:
            self.diag_rev += 1

    # ---- synchronous helpers (used for completion / hover / definition) -----

    def wait_ready(self, timeout=6.0, abort=None):
        end = time.monotonic() + timeout
        while self.state == 'starting' and time.monotonic() < end:
            self.poll(0.05)
            if abort and abort():
                return False
        return self.state == 'ready'

    def request_sync(self, method, params, timeout=5.0, abort=None):
        """Returns (result, error)."""
        if not self.wait_ready(timeout, abort):
            return None, 'language server not ready' if self.state != 'dead' else self.error
        box = []
        self.request(method, params, lambda r, e: box.append((r, e)))
        end = time.monotonic() + timeout
        while not box and self.state != 'dead' and time.monotonic() < end:
            self.poll(0.05)
            if abort and abort():
                return None, 'cancelled'
        return box[0] if box else (None, 'timed out')

    def stop(self):
        if self.proc is None:
            return
        try:
            if self.state == 'ready':
                self.request_sync('shutdown', None, timeout=0.6)
                self.notify('exit', None)
            self.proc.stdin.close()
        except Exception:
            pass
        try:
            self.proc.wait(0.4)
        except Exception:
            try:
                self.proc.kill()
            except Exception:
                pass
        self.state = 'dead'


_BUILD_RE = re.compile(r'^(?P<file>[^\s:][^:]*):(?P<line>\d+):(?:(?P<col>\d+):)?\s*'
                       r'(?P<sev>fatal error|error|warning|note):\s*(?P<msg>.*)$')
_SEV_NUM = {'fatal error': 1, 'error': 1, 'warning': 2, 'note': 3}


def parse_build_output(text, path):
    """gcc/clang diagnostics for `path` -> [(line, col, line, col, severity, message, 'build')]."""
    base = os.path.basename(path)
    out = []
    for raw in text.splitlines():
        m = _BUILD_RE.match(raw)
        if not m or os.path.basename(m.group('file')) != base:
            continue
        line = int(m.group('line')) - 1
        col = max(0, int(m.group('col') or 1) - 1)
        out.append((line, col, line, col + 1, _SEV_NUM[m.group('sev')], m.group('msg'), 'build'))
    return out


