def _split_lines(text):
    """Normalise line endings and split; returns (lines, eol, had_trailing_newline)."""
    eol = '\r\n' if '\r\n' in text else '\n'
    text = text.replace('\r\n', '\n').replace('\r', '\n')
    trailing = text.endswith('\n')
    lines = text.split('\n')
    if trailing:
        lines.pop()
    if not lines:
        lines = ['']
    return lines, eol, trailing


def load_document(filepath):
    """Returns (lines, eol, trailing_newline, note)."""
    if os.path.isdir(filepath):
        raise IsADirectoryError(f"{filepath} is a directory")
    if not os.path.exists(filepath):
        return [''], '\n', True, f"New file: {os.path.basename(filepath)}"
    with open(filepath, 'rb') as f:
        data = f.read()
    note = "Warning: file contains binary data (NUL bytes). " if b'\x00' in data else ""
    text = data.decode('utf-8-sig', errors='replace')
    lines, eol, trailing = _split_lines(text)
    return lines, eol, trailing, note


def save_document(filepath, lines, eol='\n', trailing=True):
    text = eol.join(lines) + (eol if trailing else '')
    with open(filepath, 'w', encoding='utf-8', newline='') as f:
        f.write(text)
    return filepath


