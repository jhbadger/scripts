@lru_cache(maxsize=4096)
def line_stats(line):
    """Return (word_count, char_count) for a single line (cached)."""
    return len(line.split()), len(line)


def cell_width(ch):
    """Number of terminal columns a single character occupies when displayed."""
    if ch == '\t':
        return TAB_WIDTH
    o = ord(ch)
    if o < 32 or o == 127:
        return 2                       # shown as ^X
    if unicodedata.combining(ch):
        return 0
    if unicodedata.east_asian_width(ch) in ('W', 'F'):
        return 2
    return 1


def display_str(ch):
    """What to draw for a single character."""
    if ch == '\t':
        return ' ' * TAB_WIDTH
    o = ord(ch)
    if o < 32:
        return '^' + chr(o + 64)
    if o == 127:
        return '^?'
    return ch


def text_width(text):
    return sum(cell_width(c) for c in text)


@lru_cache(maxsize=8192)
def wrap_line(text, width):
    """
    Soft word-wrap: return a tuple of (start, end) index pairs into `text`,
    each spanning at most `width` display columns. Breaks after whitespace
    when possible, otherwise mid-word.
    """
    n = len(text)
    if n == 0:
        return ((0, 0),)
    width = max(1, width)
    segs = []
    start = 0
    i = 0
    w = 0
    last_space = -1
    while i < n:
        cw = cell_width(text[i])
        if w + cw > width and i > start:
            break_at = last_space + 1 if last_space >= start else i
            segs.append((start, break_at))
            start = break_at
            i = start
            w = 0
            last_space = -1
            continue
        if text[i] in ' \t':
            last_space = i
        w += cw
        i += 1
    segs.append((start, n))
    return tuple(segs)


def leading_ws(s):
    return s[:len(s) - len(s.lstrip(' \t'))]


