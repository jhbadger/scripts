DECODE_TABLE: Dict[int, Tuple[str, str, int]] = {
    op: (mnem, mode, cyc) for (mnem, mode), (op, cyc) in OPCODES.items()
}

MNEMONICS = {mnem for (mnem, _mode) in OPCODES}
BRANCH_MNEMONICS = {"BCC", "BCS", "BEQ", "BMI", "BNE", "BPL", "BVC", "BVS"}
ACC_MNEMONICS = {"ASL", "LSR", "ROL", "ROR"}
RMW_MNEMONICS = ACC_MNEMONICS | {"INC", "DEC"}


# =============================================================================
# 2. TWO-PASS 6502 ASSEMBLER
# =============================================================================

DEFAULT_SYMBOLS: Dict[str, int] = {
    "UP":    0xE000,
    "RIGHT": 0xE001,
    "DOWN":  0xE002,
    "LEFT":  0xE003,
    "STAT":  0xE004,
}


class AssemblerError(Exception):
    def __init__(self, line_no: int, message: str):
        super().__init__(f"Line {line_no}: {message}")
        self.line_no = line_no
        self.message = message


@dataclass
class AssembledProgram:
    origin: int
    segments: List[Tuple[int, bytes]]
    line_to_addr: Dict[int, int]
    addr_to_line: Dict[int, int]
    symbols: Dict[str, int]
    instruction_count: int
    byte_count: int


def _strip_comment(line: str) -> str:
    in_quote = False
    quote_char = ""
    for i, ch in enumerate(line):
        if ch in ('"', "'"):
            if not in_quote:
                in_quote = True
                quote_char = ch
            elif quote_char == ch:
                in_quote = False
        elif ch == ";" and not in_quote:
            return line[:i]
    return line


def _parse_number(token: str, symbols: Dict[str, int]) -> Optional[int]:
    token = token.strip()
    if not token:
        return None
    # Low/High byte operators: <SYM, >SYM
    if token.startswith("<"):
        val = _parse_number(token[1:], symbols)
        return (val & 0xFF) if val is not None else None
    if token.startswith(">"):
        val = _parse_number(token[1:], symbols)
        return ((val >> 8) & 0xFF) if val is not None else None
    # Character literal: 'A'
    if len(token) == 3 and token[0] == "'" and token[2] == "'":
        return ord(token[1])
    # Hex: $1A or 0x1A
    if token.startswith("$"):
        try:
            return int(token[1:], 16)
        except ValueError:
            return None
    if token.lower().startswith("0x"):
        try:
            return int(token[2:], 16)
        except ValueError:
            return None
    # Binary: %10101010
    if token.startswith("%"):
        try:
            return int(token[1:], 2)
        except ValueError:
            return None
    # Decimal
    if re.fullmatch(r"-?\d+", token):
        return int(token, 10)
    # Simple + / - expression, left-associative: split on the LAST binary operator
    in_quote = False
    for i in range(len(token) - 1, 0, -1):
        ch = token[i]
        if ch == "'":
            in_quote = not in_quote
            continue
        if in_quote or ch not in "+-":
            continue
        if token[i - 1] in "+-<>#":
            continue  # unary sign, not a binary operator
        left = _parse_number(token[:i], symbols)
        right = _parse_number(token[i + 1:], symbols)
        if left is not None and right is not None:
            return left + right if ch == "+" else left - right
        return None
    # Symbol lookup (case-insensitive)
    up = token.upper()
    if up in symbols:
        return symbols[up]
    return None


def _split_csv_args(text: str) -> List[str]:
    args: List[str] = []
    cur: List[str] = []
    in_quote = False
    qchar = ""
    for ch in text:
        if ch in ('"', "'"):
            if not in_quote:
                in_quote = True
                qchar = ch
            elif qchar == ch:
                in_quote = False
            cur.append(ch)
        elif ch == "," and not in_quote:
            args.append("".join(cur).strip())
            cur = []
        else:
            cur.append(ch)
    if cur:
        args.append("".join(cur).strip())
    return args


def _classify_operand(
    mnem: str, operand: str, symbols: Dict[str, int], pass_num: int
) -> Tuple[str, Optional[int]]:
    op = operand.strip()
    if not op:
        if (mnem, IMP) in OPCODES:
            return IMP, None
        if mnem in ACC_MNEMONICS:
            return ACC, None
        raise ValueError(f"Missing operand for {mnem}")

    if op.upper() == "A" and mnem in ACC_MNEMONICS:
        return ACC, None

    if mnem in BRANCH_MNEMONICS:
        val = _parse_number(op, symbols)
        if val is None and pass_num == 2:
            raise ValueError(f"Undefined branch target '{op}'")
        return REL, val

    # Immediate: #expr
    if op.startswith("#"):
        val = _parse_number(op[1:], symbols)
        if val is None and pass_num == 2:
            raise ValueError(f"Undefined immediate value '{op[1:]}'")
        if val is not None and not (-128 <= val <= 0xFF):
            raise ValueError(f"Immediate value {val} out of range (-128..255)")
        return IMM, val

    # Indirect forms: ($10,X), ($10),Y, ($1234)
    if op.startswith("("):
        m_izx = re.fullmatch(r"\((.+),\s*[Xx]\)", op)
        if m_izx:
            val = _parse_number(m_izx.group(1), symbols)
            if val is None and pass_num == 2:
                raise ValueError(f"Undefined operand '{m_izx.group(1)}'")
            if val is not None and not (0 <= val <= 0xFF):
                raise ValueError(f"(zp,X) pointer ${val:X} is not in zero page")
            return IZX, val
        m_izy = re.fullmatch(r"\((.+)\),\s*[Yy]", op)
        if m_izy:
            val = _parse_number(m_izy.group(1), symbols)
            if val is None and pass_num == 2:
                raise ValueError(f"Undefined operand '{m_izy.group(1)}'")
            if val is not None and not (0 <= val <= 0xFF):
                raise ValueError(f"(zp),Y pointer ${val:X} is not in zero page")
            return IZY, val
        m_ind = re.fullmatch(r"\((.+)\)", op)
        if m_ind:
            val = _parse_number(m_ind.group(1), symbols)
            if val is None and pass_num == 2:
                raise ValueError(f"Undefined operand '{m_ind.group(1)}'")
            return IND, val
        raise ValueError(f"Malformed indirect operand '{op}'")

    # Indexed X or Y
    m_xy = re.fullmatch(r"(.+),\s*([XxYy])", op)
    if m_xy:
        expr, idx = m_xy.group(1).strip(), m_xy.group(2).upper()
        val = _parse_number(expr, symbols)
        if val is None:
            if pass_num == 2:
                raise ValueError(f"Undefined symbol '{expr}'")
            # Forward reference defaults to 16-bit absolute (unless the
            # instruction only has a zero-page indexed form, e.g. STX zp,Y)
            abs_mode, zp_mode = (ABX, ZPX) if idx == "X" else (ABY, ZPY)
            if (mnem, abs_mode) not in OPCODES and (mnem, zp_mode) in OPCODES:
                return zp_mode, None
            return abs_mode, None
        if not (0 <= val <= 0xFFFF):
            raise ValueError(f"Address {val} out of range")
        if 0 <= val <= 0xFF:
            zp_mode = ZPX if idx == "X" else ZPY
            if (mnem, zp_mode) in OPCODES:
                return zp_mode, val
        return (ABX if idx == "X" else ABY), val

    # Direct ZP or ABS
    val = _parse_number(op, symbols)
    if val is None:
        if pass_num == 2:
            raise ValueError(f"Undefined symbol '{op}'")
        return ABS, None
    if not (0 <= val <= 0xFFFF):
        raise ValueError(f"Address {val} out of range")
    if 0 <= val <= 0xFF and (mnem, ZP) in OPCODES and mnem not in ("JMP", "JSR"):
        return ZP, val
    return ABS, val


def assemble(source: str, default_org: int = 0x0600) -> AssembledProgram:
    symbols: Dict[str, int] = dict(DEFAULT_SYMBOLS)
    lines = source.splitlines()

    # Pass 1: collect labels, constants, and compute instruction sizes
    pc = default_org
    parsed_lines: List[Tuple[int, str, str, int]] = []  # (line_no, kind, payload, addr)
    pass1_modes: Dict[int, str] = {}  # line_no -> addressing mode sized in pass 1
    entry: Optional[int] = None

    for line_no, raw in enumerate(lines, start=1):
        clean = _strip_comment(raw).strip()
        if not clean:
            continue

        # Handle label prefix(es) like "LOOP:" or "LOOP: LDA #$01"
        while True:
            m_lbl = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*:(.*)$", clean)
            if not m_lbl:
                break
            lbl = m_lbl.group(1).upper()
            if lbl in DEFAULT_SYMBOLS:
                raise AssemblerError(line_no, f"'{lbl}' is a reserved port name")
            if lbl in symbols:
                raise AssemblerError(line_no, f"Duplicate label '{lbl}'")
            symbols[lbl] = pc
            clean = m_lbl.group(2).strip()
            if not clean:
                break

        if not clean:
            continue

        # Constant assignment: NAME = EXPR or NAME EQU EXPR
        m_eq = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*(?:=|\bEQU\b)\s*(.+)$", clean, re.IGNORECASE)
        if m_eq:
            name = m_eq.group(1).upper()
            if name in DEFAULT_SYMBOLS:
                raise AssemblerError(line_no, f"'{name}' is a reserved port name")
            val = _parse_number(m_eq.group(2), symbols)
            if val is None:
                raise AssemblerError(line_no, f"Cannot evaluate constant '{m_eq.group(2)}'")
            symbols[name] = val & 0xFFFF
            continue

        # Directives
        parts = clean.split(None, 1)
        head = parts[0].upper()
        rest = parts[1].strip() if len(parts) > 1 else ""

        if head in (".ORG", "ORG"):
            val = _parse_number(rest, symbols)
            if val is None:
                raise AssemblerError(line_no, f"Invalid .ORG address '{rest}'")
            pc = val & 0xFFFF
            continue

        if head in (".BYTE", ".DB", "DCB"):
            items = _split_csv_args(rest)
            size = 0
            for item in items:
                if len(item) >= 2 and item[0] == '"' and item[-1] == '"':
                    size += len(item) - 2
                else:
                    size += 1
            parsed_lines.append((line_no, "BYTE", rest, pc))
            pc = (pc + size) & 0xFFFF
            continue

        if head in (".WORD", ".DW"):
            items = _split_csv_args(rest)
            parsed_lines.append((line_no, "WORD", rest, pc))
            pc = (pc + 2 * len(items)) & 0xFFFF
            continue

        # Instruction
        if head not in MNEMONICS:
            raise AssemblerError(line_no, f"Unknown instruction or directive '{parts[0]}'")
        try:
            mode, _ = _classify_operand(head, rest, symbols, pass_num=1)
        except ValueError as exc:
            raise AssemblerError(line_no, str(exc)) from exc

        if (head, mode) not in OPCODES:
            raise AssemblerError(line_no, f"Unsupported addressing mode for {head} ({mode})")

        parsed_lines.append((line_no, "INSN", f"{head} {rest}".strip(), pc))
        pass1_modes[line_no] = mode
        if entry is None:
            entry = pc
        pc = (pc + MODE_SIZE[mode]) & 0xFFFF

    # Execution starts at a START label if present, else the first instruction.
    if "START" in symbols:
        entry = symbols["START"]
    if entry is None:
        entry = default_org

    # Pass 2: emit machine code
    segments: List[Tuple[int, bytearray]] = []
    line_to_addr: Dict[int, int] = {}
    addr_to_line: Dict[int, int] = {}
    insn_count = 0
    total_bytes = 0

    def emit_bytes(addr: int, data: bytes) -> None:
        nonlocal total_bytes
        total_bytes += len(data)
        if segments and segments[-1][0] + len(segments[-1][1]) == addr:
            segments[-1][1].extend(data)
        else:
            segments.append((addr, bytearray(data)))

    for line_no, kind, payload, addr in parsed_lines:
        line_to_addr[line_no] = addr
        addr_to_line[addr] = line_no

        if kind == "BYTE":
            out = bytearray()
            for item in _split_csv_args(payload):
                if len(item) >= 2 and item[0] == '"' and item[-1] == '"':
                    out.extend(item[1:-1].encode("ascii", errors="replace"))
                else:
                    val = _parse_number(item, symbols)
                    if val is None:
                        raise AssemblerError(line_no, f"Undefined byte value '{item}'")
                    out.append(val & 0xFF)
            emit_bytes(addr, bytes(out))
            continue

        if kind == "WORD":
            out = bytearray()
            for item in _split_csv_args(payload):
                val = _parse_number(item, symbols)
                if val is None:
                    raise AssemblerError(line_no, f"Undefined word value '{item}'")
                out.append(val & 0xFF)
                out.append((val >> 8) & 0xFF)
            emit_bytes(addr, bytes(out))
            continue

        # INSN
        parts = payload.split(None, 1)
        mnem = parts[0].upper()
        rest = parts[1].strip() if len(parts) > 1 else ""
        try:
            mode, val = _classify_operand(mnem, rest, symbols, pass_num=2)
        except ValueError as exc:
            raise AssemblerError(line_no, str(exc)) from exc

        # Pass 1 sized forward references as 16-bit; keep that size so that
        # later addresses (labels) stay correct even if the value fits in ZP.
        widen = {ZP: ABS, ZPX: ABX, ZPY: ABY}
        p1 = pass1_modes.get(line_no)
        if p1 in (ABS, ABX, ABY) and mode in widen and widen[mode] == p1:
            mode = p1

        if (mnem, mode) not in OPCODES:
            raise AssemblerError(line_no, f"Invalid addressing mode {mode} for {mnem}")

        opcode, _ = OPCODES[(mnem, mode)]
        insn_count += 1

        if mode in (IMP, ACC):
            emit_bytes(addr, bytes([opcode]))
        elif mode == REL:
            assert val is not None
            offset = val - (addr + 2)
            if not (-128 <= offset <= 127):
                raise AssemblerError(line_no, f"Branch target out of range ({offset})")
            emit_bytes(addr, bytes([opcode, offset & 0xFF]))
        elif MODE_SIZE[mode] == 2:
            assert val is not None
            emit_bytes(addr, bytes([opcode, val & 0xFF]))
        else:
            assert val is not None
            emit_bytes(addr, bytes([opcode, val & 0xFF, (val >> 8) & 0xFF]))

    return AssembledProgram(
        origin=entry,
        segments=[(a, bytes(b)) for a, b in segments],
        line_to_addr=line_to_addr,
        addr_to_line=addr_to_line,
        symbols=symbols,
        instruction_count=insn_count,
        byte_count=total_bytes,
    )


# =============================================================================
# 3. 6502 CPU EMULATOR WITH BLOCKING MEMORY-MAPPED PORT I/O
# =============================================================================

PORT_UP    = 0xE000
PORT_RIGHT = 0xE001
PORT_DOWN  = 0xE002
PORT_LEFT  = 0xE003
PORT_STAT  = 0xE004

PORT_NAMES = {0: "UP", 1: "RIGHT", 2: "DOWN", 3: "LEFT"}

FLAG_C = 0x01
FLAG_Z = 0x02
FLAG_I = 0x04
FLAG_D = 0x08
FLAG_B = 0x10
FLAG_U = 0x20
FLAG_V = 0x40
FLAG_N = 0x80


class PortBlocked(Exception):
    """Raised when a 6502 instruction blocks on a port read or write."""
    def __init__(self, direction: int, is_write: bool, value: int = 0):
        self.direction = direction  # 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT
        self.is_write = is_write
        self.value = value


class CpuFault(Exception):
    """Raised for a programming error that stops a node (shown as ERR)."""


@dataclass
class LinkChannel:
    """Synchronous single-byte TIS-100-style channel between two endpoints.

    Changes made during a tick only become visible to the other side on the
    next tick, so transfer latency does not depend on the order in which the
    grid steps its nodes.
    """
    name: str
    writer_has_data: bool = False
    value: int = 0
    consumed: bool = False
    written_at: int = -1
    consumed_at: int = -1
    now: int = 0  # current tick, set by GridMachine.step()

    def reset(self) -> None:
        self.writer_has_data = False
        self.value = 0
        self.consumed = False
        self.written_at = -1
        self.consumed_at = -1
        self.now = 0

    def readable(self) -> bool:
        return self.writer_has_data and not self.consumed and self.written_at < self.now


class InputStreamChannel:
    """External puzzle input stream feeding a node port."""
    def __init__(self, name: str, data: List[int]):
        self.name = name
        self.initial_data = list(data)
        self.index = 0

    def has_data(self) -> bool:
        return self.index < len(self.initial_data)

    def read_byte(self) -> Optional[int]:
        if self.index < len(self.initial_data):
            val = self.initial_data[self.index] & 0xFF
            self.index += 1
            return val
        return None

    def reset(self) -> None:
        self.index = 0


class OutputStreamChannel:
    """External puzzle output stream collecting bytes from a node port."""
    def __init__(self, name: str, expected: List[int]):
        self.name = name
        self.expected = [x & 0xFF for x in expected]
        self.received: List[int] = []

    def write_byte(self, val: int) -> None:
        self.received.append(val & 0xFF)

    def is_satisfied(self) -> bool:
        return self.received == self.expected

    def reset(self) -> None:
        self.received.clear()


class Cpu6502Node:
    def __init__(self, node_id: int, origin: int = 0x0600):
        self.node_id = node_id
        self.origin = origin
        self.mem = bytearray(65536)
        self.A = 0
        self.X = 0
        self.Y = 0
        self.SP = 0xFF
        self.PC = origin
        self.P = FLAG_U | FLAG_I
        self.cycles = 0
        self.halted = False
        self.state = "IDLE"  # IDLE, RUN, READ, WRITE, HALT, ERR
        self.blocked_dir: Optional[int] = None
        self.error_msg: Optional[str] = None
        self.source: str = ""
        self.program: Optional[AssembledProgram] = None

        # Port bindings: direction (0..3) -> LinkChannel / InputStreamChannel / OutputStreamChannel
        self.in_ports: Dict[int, object] = {}
        self.out_ports: Dict[int, object] = {}

    def load_source(self, source: str) -> None:
        self.source = source
        self.error_msg = None
        if not source.strip():
            self.program = None
            self.reset()
            return
        try:
            self.program = assemble(source, default_org=self.origin)
        except AssemblerError as exc:
            self.program = None
            self.error_msg = str(exc)
            self.state = "ERR"
            return
        self.reset()

    def reset(self) -> None:
        self.mem[:] = b"\x00" * 65536
        self.A = 0
        self.X = 0
        self.Y = 0
        self.SP = 0xFF
        self.P = FLAG_U | FLAG_I
        self.cycles = 0
        self.halted = False
        self.blocked_dir = None
        if self.error_msg:
            self.state = "ERR"
            self.PC = self.origin
            return
        if self.program and self.program.segments:
            for addr, data in self.program.segments:
                self.mem[addr:addr + len(data)] = data
            self.PC = self.program.origin
            self.state = "RUN"
        else:
            self.PC = self.origin
            self.state = "IDLE"

    # --- Flag helpers ---
    def _set_zn(self, val: int) -> int:
        val &= 0xFF
        if val == 0:
            self.P |= FLAG_Z
        else:
            self.P &= ~FLAG_Z
        if val & 0x80:
            self.P |= FLAG_N
        else:
            self.P &= ~FLAG_N
        return val

    def _set_flag(self, flag: int, cond: bool) -> None:
        if cond:
            self.P |= flag
        else:
            self.P &= ~flag

    def _get_flag(self, flag: int) -> bool:
        return bool(self.P & flag)

    # --- Memory & Port I/O ---
    def _port_status(self) -> int:
        stat = 0
        for d in range(4):
            ch = self.in_ports.get(d)
            if isinstance(ch, InputStreamChannel) and ch.has_data():
                stat |= (1 << d)
            elif isinstance(ch, LinkChannel) and ch.readable():
                stat |= (1 << d)
        return stat

    def read(self, addr: int) -> int:
        addr &= 0xFFFF
        if PORT_UP <= addr <= PORT_LEFT:
            d = addr - PORT_UP
            ch = self.in_ports.get(d)
            if isinstance(ch, InputStreamChannel):
                val = ch.read_byte()
                if val is None:
                    raise PortBlocked(d, is_write=False)
                return val
            if isinstance(ch, LinkChannel):
                if ch.readable():
                    ch.consumed = True
                    ch.consumed_at = ch.now
                    return ch.value & 0xFF
                raise PortBlocked(d, is_write=False)
            if ch is None and isinstance(self.out_ports.get(d), OutputStreamChannel):
                raise CpuFault(f"Read from {PORT_NAMES[d]}, which is an output stream")
            # Unconnected port blocks forever
            raise PortBlocked(d, is_write=False)
        if addr == PORT_STAT:
            return self._port_status()
        return self.mem[addr]

    def write(self, addr: int, val: int) -> None:
        addr &= 0xFFFF
        val &= 0xFF
        if PORT_UP <= addr <= PORT_LEFT:
            d = addr - PORT_UP
            ch = self.out_ports.get(d)
            if isinstance(ch, OutputStreamChannel):
                ch.write_byte(val)
                return
            if isinstance(ch, LinkChannel):
                if ch.consumed and ch.consumed_at < ch.now:
                    # Handshake completed!
                    ch.writer_has_data = False
                    ch.consumed = False
                    return
                if not ch.writer_has_data:
                    ch.value = val
                    ch.writer_has_data = True
                    ch.consumed = False
                    ch.written_at = ch.now
                raise PortBlocked(d, is_write=True, value=val)
            if ch is None and isinstance(self.in_ports.get(d), InputStreamChannel):
                raise CpuFault(f"Write to {PORT_NAMES[d]}, which is an input stream")
            # Unconnected port blocks forever
            raise PortBlocked(d, is_write=True, value=val)
        self.mem[addr] = val

    def read16(self, addr: int) -> int:
        lo = self.read(addr)
        hi = self.read((addr + 1) & 0xFFFF)
        return lo | (hi << 8)

    def _push(self, val: int) -> None:
        self.mem[0x0100 + self.SP] = val & 0xFF
        self.SP = (self.SP - 1) & 0xFF

    def _pop(self) -> int:
        self.SP = (self.SP + 1) & 0xFF
        return self.mem[0x0100 + self.SP]

    def _adc(self, val: int) -> None:
        c = 1 if self._get_flag(FLAG_C) else 0
        total = self.A + val + c
        overflow = (~(self.A ^ val) & (self.A ^ total) & 0x80) != 0
        self._set_flag(FLAG_V, overflow)
        if self._get_flag(FLAG_D):
            lo = (self.A & 0x0F) + (val & 0x0F) + c
            hi = (self.A >> 4) + (val >> 4)
            if lo > 9:
                lo += 6
                hi += 1
            if hi > 9:
                hi += 6
            self._set_flag(FLAG_C, hi > 0x0F)
            self.A = self._set_zn(((hi & 0x0F) << 4) | (lo & 0x0F))
            return
        self._set_flag(FLAG_C, total > 0xFF)
        self.A = self._set_zn(total)

    def _sbc(self, val: int) -> None:
        if not self._get_flag(FLAG_D):
            self._adc(val ^ 0xFF)
            return
        borrow = 0 if self._get_flag(FLAG_C) else 1
        diff = self.A - val - borrow
        overflow = ((self.A ^ val) & (self.A ^ diff) & 0x80) != 0
        lo = (self.A & 0x0F) - (val & 0x0F) - borrow
        hi = (self.A >> 4) - (val >> 4)
        if lo < 0:
            lo -= 6
            hi -= 1
        if hi < 0:
            hi -= 6
        self._set_flag(FLAG_C, diff >= 0)
        self._set_flag(FLAG_V, overflow)
        self.A = self._set_zn(((hi & 0x0F) << 4) | (lo & 0x0F))

    def _cmp(self, reg: int, val: int) -> None:
        diff = reg - val
        self._set_flag(FLAG_C, reg >= val)
        self._set_zn(diff)

    def step(self) -> bool:
        """Execute one 6502 instruction. Returns True if instruction completed."""
        if self.state in ("IDLE", "HALT", "ERR") or self.halted:
            return False

        saved_pc = self.PC
        opcode = self.mem[self.PC]
        if opcode not in DECODE_TABLE:
            self.error_msg = f"Illegal opcode ${opcode:02X} at ${self.PC:04X}"
            self.state = "ERR"
            return False

        mnem, mode, base_cycles = DECODE_TABLE[opcode]
        self.PC = (self.PC + 1) & 0xFFFF

        # Resolve effective address
        eff_addr = 0
        if mode == IMM:
            eff_addr = self.PC
            self.PC = (self.PC + 1) & 0xFFFF
        elif mode == ZP:
            eff_addr = self.mem[self.PC]
            self.PC = (self.PC + 1) & 0xFFFF
        elif mode == ZPX:
            eff_addr = (self.mem[self.PC] + self.X) & 0xFF
            self.PC = (self.PC + 1) & 0xFFFF
        elif mode == ZPY:
            eff_addr = (self.mem[self.PC] + self.Y) & 0xFF
            self.PC = (self.PC + 1) & 0xFFFF
        elif mode == ABS:
            lo = self.mem[self.PC]
            hi = self.mem[(self.PC + 1) & 0xFFFF]
            eff_addr = lo | (hi << 8)
            self.PC = (self.PC + 2) & 0xFFFF
        elif mode == ABX:
            lo = self.mem[self.PC]
            hi = self.mem[(self.PC + 1) & 0xFFFF]
            eff_addr = ((lo | (hi << 8)) + self.X) & 0xFFFF
            self.PC = (self.PC + 2) & 0xFFFF
        elif mode == ABY:
            lo = self.mem[self.PC]
            hi = self.mem[(self.PC + 1) & 0xFFFF]
            eff_addr = ((lo | (hi << 8)) + self.Y) & 0xFFFF
            self.PC = (self.PC + 2) & 0xFFFF
        elif mode == IND:
            lo = self.mem[self.PC]
            hi = self.mem[(self.PC + 1) & 0xFFFF]
            ptr = lo | (hi << 8)
            # Classic 6502 page-wrap bug on JMP ($xxFF)
            hi_ptr = (ptr & 0xFF00) | ((ptr + 1) & 0x00FF)
            eff_addr = self.mem[ptr] | (self.mem[hi_ptr] << 8)
            self.PC = (self.PC + 2) & 0xFFFF
        elif mode == IZX:
            zp = (self.mem[self.PC] + self.X) & 0xFF
            self.PC = (self.PC + 1) & 0xFFFF
            eff_addr = self.mem[zp] | (self.mem[(zp + 1) & 0xFF] << 8)
        elif mode == IZY:
            zp = self.mem[self.PC]
            self.PC = (self.PC + 1) & 0xFFFF
            base = self.mem[zp] | (self.mem[(zp + 1) & 0xFF] << 8)
            eff_addr = (base + self.Y) & 0xFFFF
        elif mode == REL:
            off = self.mem[self.PC]
            self.PC = (self.PC + 1) & 0xFFFF
            if off >= 0x80:
                off -= 256
            eff_addr = (self.PC + off) & 0xFFFF

        try:
            self._exec(mnem, mode, eff_addr)
            self.cycles += base_cycles
            self.state = "RUN"
            self.blocked_dir = None
            return True
        except PortBlocked as pb:
            # Roll back PC so the instruction retries on next tick
            self.PC = saved_pc
            self.state = "WRITE" if pb.is_write else "READ"
            self.blocked_dir = pb.direction
            return False
        except CpuFault as fault:
            self.PC = saved_pc
            self.error_msg = f"{fault} at ${saved_pc:04X}"
            self.state = "ERR"
            return False

    def _exec(self, mnem: str, mode: str, addr: int) -> None:
        if mnem in RMW_MNEMONICS and mode != ACC and PORT_UP <= addr <= PORT_STAT:
            raise CpuFault(f"{mnem} cannot read-modify-write a port")
        if mnem == "LDA":
            self.A = self._set_zn(self.read(addr))
        elif mnem == "LDX":
            self.X = self._set_zn(self.read(addr))
        elif mnem == "LDY":
            self.Y = self._set_zn(self.read(addr))
        elif mnem == "STA":
            self.write(addr, self.A)
        elif mnem == "STX":
            self.write(addr, self.X)
        elif mnem == "STY":
            self.write(addr, self.Y)
        elif mnem == "TAX":
            self.X = self._set_zn(self.A)
        elif mnem == "TAY":
            self.Y = self._set_zn(self.A)
        elif mnem == "TXA":
            self.A = self._set_zn(self.X)
        elif mnem == "TYA":
            self.A = self._set_zn(self.Y)
        elif mnem == "TSX":
            self.X = self._set_zn(self.SP)
        elif mnem == "TXS":
            self.SP = self.X
        elif mnem == "PHA":
            self._push(self.A)
        elif mnem == "PLA":
            self.A = self._set_zn(self._pop())
        elif mnem == "PHP":
            self._push(self.P | FLAG_B | FLAG_U)
        elif mnem == "PLP":
            self.P = (self._pop() & ~FLAG_B) | FLAG_U
        elif mnem == "AND":
            self.A = self._set_zn(self.A & self.read(addr))
        elif mnem == "ORA":
            self.A = self._set_zn(self.A | self.read(addr))
        elif mnem == "EOR":
            self.A = self._set_zn(self.A ^ self.read(addr))
        elif mnem == "BIT":
            v = self.read(addr)
            self._set_flag(FLAG_Z, (self.A & v) == 0)
            self._set_flag(FLAG_V, bool(v & 0x40))
            self._set_flag(FLAG_N, bool(v & 0x80))
        elif mnem == "ADC":
            self._adc(self.read(addr))
        elif mnem == "SBC":
            self._sbc(self.read(addr))
        elif mnem == "CMP":
            self._cmp(self.A, self.read(addr))
        elif mnem == "CPX":
            self._cmp(self.X, self.read(addr))
        elif mnem == "CPY":
            self._cmp(self.Y, self.read(addr))
        elif mnem == "INC":
            v = self._set_zn(self.read(addr) + 1)
            self.write(addr, v)
        elif mnem == "INX":
            self.X = self._set_zn(self.X + 1)
        elif mnem == "INY":
            self.Y = self._set_zn(self.Y + 1)
        elif mnem == "DEC":
            v = self._set_zn(self.read(addr) - 1)
            self.write(addr, v)
        elif mnem == "DEX":
            self.X = self._set_zn(self.X - 1)
        elif mnem == "DEY":
            self.Y = self._set_zn(self.Y - 1)
        elif mnem == "ASL":
            if mode == ACC:
                self._set_flag(FLAG_C, bool(self.A & 0x80))
                self.A = self._set_zn(self.A << 1)
            else:
                v = self.read(addr)
                self._set_flag(FLAG_C, bool(v & 0x80))
                self.write(addr, self._set_zn(v << 1))
        elif mnem == "LSR":
            if mode == ACC:
                self._set_flag(FLAG_C, bool(self.A & 0x01))
                self.A = self._set_zn(self.A >> 1)
            else:
                v = self.read(addr)
                self._set_flag(FLAG_C, bool(v & 0x01))
                self.write(addr, self._set_zn(v >> 1))
        elif mnem == "ROL":
            c = 1 if self._get_flag(FLAG_C) else 0
            if mode == ACC:
                self._set_flag(FLAG_C, bool(self.A & 0x80))
                self.A = self._set_zn((self.A << 1) | c)
            else:
                v = self.read(addr)
                self._set_flag(FLAG_C, bool(v & 0x80))
                self.write(addr, self._set_zn((v << 1) | c))
        elif mnem == "ROR":
            c = 0x80 if self._get_flag(FLAG_C) else 0
            if mode == ACC:
                self._set_flag(FLAG_C, bool(self.A & 0x01))
                self.A = self._set_zn((self.A >> 1) | c)
            else:
                v = self.read(addr)
                self._set_flag(FLAG_C, bool(v & 0x01))
                self.write(addr, self._set_zn((v >> 1) | c))
        elif mnem == "JMP":
            self.PC = addr
        elif mnem == "JSR":
            ret = (self.PC - 1) & 0xFFFF
            self._push((ret >> 8) & 0xFF)
            self._push(ret & 0xFF)
            self.PC = addr
        elif mnem == "RTS":
            lo = self._pop()
            hi = self._pop()
            self.PC = ((lo | (hi << 8)) + 1) & 0xFFFF
        elif mnem == "RTI":
            self.P = (self._pop() & ~FLAG_B) | FLAG_U
            lo = self._pop()
            hi = self._pop()
            self.PC = lo | (hi << 8)
        elif mnem == "BCC":
            if not self._get_flag(FLAG_C):
                self.PC = addr
                self.cycles += 1
        elif mnem == "BCS":
            if self._get_flag(FLAG_C):
                self.PC = addr
                self.cycles += 1
        elif mnem == "BEQ":
            if self._get_flag(FLAG_Z):
                self.PC = addr
                self.cycles += 1
        elif mnem == "BNE":
            if not self._get_flag(FLAG_Z):
                self.PC = addr
                self.cycles += 1
        elif mnem == "BMI":
            if self._get_flag(FLAG_N):
                self.PC = addr
                self.cycles += 1
        elif mnem == "BPL":
            if not self._get_flag(FLAG_N):
                self.PC = addr
                self.cycles += 1
        elif mnem == "BVC":
            if not self._get_flag(FLAG_V):
                self.PC = addr
                self.cycles += 1
        elif mnem == "BVS":
            if self._get_flag(FLAG_V):
                self.PC = addr
                self.cycles += 1
        elif mnem == "CLC":
            self._set_flag(FLAG_C, False)
        elif mnem == "SEC":
            self._set_flag(FLAG_C, True)
        elif mnem == "CLD":
            self._set_flag(FLAG_D, False)
        elif mnem == "SED":
            self._set_flag(FLAG_D, True)
        elif mnem == "CLI":
            self._set_flag(FLAG_I, False)
        elif mnem == "SEI":
            self._set_flag(FLAG_I, True)
        elif mnem == "CLV":
            self._set_flag(FLAG_V, False)
        elif mnem == "NOP":
            pass
        elif mnem == "BRK":
            self.halted = True
            self.state = "HALT"

    def status_flags_str(self) -> str:
        bits = [
            ("N", FLAG_N), ("V", FLAG_V), ("-", FLAG_U), ("B", FLAG_B),
            ("D", FLAG_D), ("I", FLAG_I), ("Z", FLAG_Z), ("C", FLAG_C),
        ]
        return "".join(ch if (self.P & fl) else "." for ch, fl in bits)


# =============================================================================
# 4. MULTI-NODE GRID & PUZZLE ENGINE
# =============================================================================

@dataclass
class TestCase:
    name: str
    inputs: Dict[str, List[int]]   # e.g. {"IN.A": [...], "IN.B": [...]}
    outputs: Dict[str, List[int]]  # e.g. {"OUT.A": [...]}


@dataclass
class Puzzle:
    number: int
    title: str
    description: List[str]
    in_map: Dict[str, Tuple[int, int]]   # stream_name -> (node_id, port_dir)
    out_map: Dict[str, Tuple[int, int]]  # stream_name -> (node_id, port_dir)
    tests: List[TestCase]
    starter_code: Dict[int, str]
    reference_solution: Dict[int, str]


class GridMachine:
    """2x2 Grid of 6502 nodes:
       [0] <-> [1]
        ^       ^
        v       v
       [2] <-> [3]
    """
    def __init__(self, puzzle: Puzzle, test_idx: int = 0,
                 tests: Optional[List[TestCase]] = None):
        self.puzzle = puzzle
        self.tests: List[TestCase] = tests if tests is not None else puzzle.tests
        self.test_idx = test_idx
        self.stall_ticks = 0
        self.nodes: List[Cpu6502Node] = [Cpu6502Node(i) for i in range(4)]
        self.links: Dict[Tuple[int, int], LinkChannel] = {}
        self.in_streams: Dict[str, InputStreamChannel] = {}
        self.out_streams: Dict[str, OutputStreamChannel] = {}
        self.ticks = 0

        self._wire_grid()
        self.load_test(test_idx)

    def _wire_grid(self) -> None:
        # Bidirectional links: (src, dir) -> (dst, opposite_dir)
        # Directions: 0=UP, 1=RIGHT, 2=DOWN, 3=LEFT
        edges = [
            (0, 1, 1, 3), (1, 3, 0, 1),  # 0 <-> 1
            (2, 1, 3, 3), (3, 3, 2, 1),  # 2 <-> 3
            (0, 2, 2, 0), (2, 0, 0, 2),  # 0 <-> 2
            (1, 2, 3, 0), (3, 0, 1, 2),  # 1 <-> 3
        ]
        for src, sdir, dst, ddir in edges:
            ch = LinkChannel(f"N{src}.{PORT_NAMES[sdir]}->N{dst}")
            self.links[(src, sdir)] = ch
            self.nodes[src].out_ports[sdir] = ch
            self.nodes[dst].in_ports[ddir] = ch

    def load_test(self, test_idx: int) -> None:
        self.test_idx = test_idx
        tc = self.tests[test_idx]
        self.in_streams.clear()
        self.out_streams.clear()

        # Clear external port bindings first (keep internal links)
        for name, (nid, pdir) in self.puzzle.in_map.items():
            ch = InputStreamChannel(name, tc.inputs.get(name, []))
            self.in_streams[name] = ch
            self.nodes[nid].in_ports[pdir] = ch

        for name, (nid, pdir) in self.puzzle.out_map.items():
            ch = OutputStreamChannel(name, tc.outputs.get(name, []))
            self.out_streams[name] = ch
            self.nodes[nid].out_ports[pdir] = ch

        self.reset()

    def load_code(self, code_map: Dict[int, str]) -> None:
        for nid, src in code_map.items():
            self.nodes[nid].load_source(src)
        self.reset()

    def reset(self) -> None:
        self.ticks = 0
        self.stall_ticks = 0
        for ch in self.links.values():
            ch.reset()
        for ch in self.in_streams.values():
            ch.reset()
        for ch in self.out_streams.values():
            ch.reset()
        for node in self.nodes:
            node.reset()

    def step(self) -> None:
        self.ticks += 1
        for ch in self.links.values():
            ch.now = self.ticks
        # Step all nodes in parallel (each node advances 1 instruction if unblocked)
        progressed = False
        for node in self.nodes:
            if node.step():
                progressed = True
        self.stall_ticks = 0 if progressed else self.stall_ticks + 1

    def is_deadlocked(self) -> bool:
        # A blocked write can still change channel state on its first tick, so
        # only two consecutive ticks with no completed instruction prove a stall.
        return self.stall_ticks >= 2

    def has_errors(self) -> bool:
        return any(n.state == "ERR" for n in self.nodes)

    def is_solved(self) -> bool:
        if not self.out_streams:
            return False
        return all(ch.is_satisfied() for ch in self.out_streams.values())

    def has_wrong_output(self) -> bool:
        """True as soon as any output stream diverges from what is expected."""
        return any(ch.received != ch.expected[:len(ch.received)]
                   for ch in self.out_streams.values())

    # Backwards-compatible name
    is_over_output = has_wrong_output

    def failure_reason(self) -> Optional[str]:
        if self.has_errors():
            return "node error"
        if self.has_wrong_output():
            return "wrong output"
        if self.is_deadlocked():
            return "deadlock"
        return None

    def run_until_done(self, max_ticks: int = 20000) -> Tuple[bool, int]:
        while self.ticks < max_ticks:
            if self.has_errors() or self.has_wrong_output():
                return False, self.ticks
            if self.is_solved():
                return True, self.ticks
            if self.is_deadlocked():
                return False, self.ticks
            self.step()
        return self.is_solved(), self.ticks

    def total_metrics(self) -> Tuple[int, int, int]:
        active_nodes = sum(1 for n in self.nodes if n.program and n.program.instruction_count > 0)
        total_insns = sum(n.program.instruction_count for n in self.nodes if n.program)
        total_cycles = sum(n.cycles for n in self.nodes)
        return total_cycles, active_nodes, total_insns


