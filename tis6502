class TIS6502TUI:
    def __init__(self, stdscr: "curses._CursesWindow"):
        self.stdscr = stdscr
        self.puzzle_idx = 0
        self.active_node = 0
        self.code_buffers: Dict[int, List[str]] = {}
        self.machine: Optional[GridMachine] = None
        self.running = False
        self.status_msg = "Press [e] to edit node, [s] step, [r] run, [t] test all, [h] help."
        self.test_results: Optional[List[Tuple[str, bool, int, int, Optional[str]]]] = None
        self.speed_idx = 0
        self.load_puzzle(0)

    SPEEDS = [1, 4, 16, 64, 256]  # ticks per frame while running

    def load_puzzle(self, idx: int) -> None:
        self.puzzle_idx = idx % len(PUZZLES)
        p = PUZZLES[self.puzzle_idx]
        saved = load_solution(p)
        source = saved if saved is not None else p.starter_code
        self.code_buffers = {
            nid: (source.get(nid, "").splitlines() or [""])
            for nid in range(4)
        }
        self.machine = GridMachine(p, test_idx=0, tests=all_tests(p))
        self._apply_code()
        self.running = False
        self.test_results = None
        origin = "saved solution" if saved is not None else "starter code"
        self.status_msg = f"Loaded Puzzle {p.number}: {p.title} ({origin})"

    def _code_map(self) -> Dict[int, str]:
        return {nid: "\n".join(lines) for nid, lines in self.code_buffers.items()}

    def _apply_code(self) -> None:
        assert self.machine is not None
        self.machine.load_code(self._code_map())

    def _save(self) -> None:
        try:
            save_solution(PUZZLES[self.puzzle_idx], self._code_map())
        except OSError as exc:
            self.status_msg = f"Could not save solution: {exc}"

    def _switch_test(self, delta: int) -> None:
        assert self.machine is not None
        self.running = False
        n = len(self.machine.tests)
        self.machine.load_test((self.machine.test_idx + delta) % n)
        self.status_msg = f"Test case {self.machine.test_idx + 1}/{n}: {self.machine.tests[self.machine.test_idx].name}"

    def _fast_forward(self) -> None:
        assert self.machine is not None
        self.running = False
        ok, ticks = self.machine.run_until_done()
        if ok:
            self.status_msg = f"Test case solved in {ticks} ticks."
        else:
            self.status_msg = f"Stopped after {ticks} ticks: {self.machine.failure_reason() or 'timeout'}."

    def _confirm(self, question: str) -> bool:
        h, w = self.stdscr.getmaxyx()
        self.stdscr.nodelay(False)
        self.stdscr.addnstr(h - 2, 0, f" {question} (y/n) ".ljust(w), w - 1, curses.A_REVERSE)
        self.stdscr.refresh()
        return self.stdscr.getch() in (ord("y"), ord("Y"))

    def _run_all_tests(self) -> None:
        p = PUZZLES[self.puzzle_idx]
        results = run_suite(p, self._code_map())
        self.test_results = results
        if all(ok for _, ok, _, _, _ in results):
            assert self.machine is not None
            _, nodes, insns = self.machine.total_metrics()
            ticks = sum(t for _, _, t, _, _ in results)
            try:
                best = record_score(p, ticks, nodes, insns)
                best_s = f" | best {best['ticks']}t/{best['nodes']}n/{best['insns']}i"
            except OSError:
                best_s = ""
            self.status_msg = f"ALL {len(results)} TESTS PASSED! ticks={ticks} nodes={nodes} insns={insns}{best_s}"
        else:
            failed = sum(1 for _, ok, _, _, _ in results if not ok)
            self.status_msg = f"{failed}/{len(results)} tests failed. Use [ / ] to view a test case."

    def _edit_active_node(self) -> None:
        self.running = False
        lines = list(self.code_buffers[self.active_node])
        if not lines:
            lines = [""]
        row = 0
        col = len(lines[0])
        curses.curs_set(1)
        self.stdscr.nodelay(False)

        while True:
            self.stdscr.erase()
            h, w = self.stdscr.getmaxyx()
            p = PUZZLES[self.puzzle_idx]
            header = f" EDITING NODE {self.active_node} | Puzzle {p.number}: {p.title} | [ESC] Save & Exit "
            self.stdscr.addnstr(0, 0, header.ljust(w), w - 1, curses.A_REVERSE)
            info = " Ports: UP RIGHT DOWN LEFT STAT ($E000-4) | Home/End PgUp/PgDn Del ^K=del line "
            self.stdscr.addnstr(1, 0, info, w - 1, curses.A_DIM)

            max_rows = max(1, h - 4)
            start_r = max(0, row - max_rows + 1)
            for idx in range(start_r, min(len(lines), start_r + max_rows)):
                y = 2 + (idx - start_r)
                prefix = f"{idx + 1:2d} | "
                self.stdscr.addnstr(y, 0, prefix + lines[idx], w - 1)

            self.stdscr.addnstr(h - 1, 0, " Press ESC to assemble & return to grid ", w - 1, curses.A_REVERSE)
            cur_y = 2 + (row - start_r)
            cur_x = min(w - 2, 5 + col)
            self.stdscr.move(cur_y, cur_x)
            self.stdscr.refresh()

            ch = self.stdscr.getch()
            if ch == 27:  # ESC
                break
            elif ch in (curses.KEY_UP,):
                if row > 0:
                    row -= 1
                    col = min(col, len(lines[row]))
            elif ch in (curses.KEY_DOWN,):
                if row < len(lines) - 1:
                    row += 1
                    col = min(col, len(lines[row]))
            elif ch in (curses.KEY_LEFT,):
                if col > 0:
                    col -= 1
                elif row > 0:
                    row -= 1
                    col = len(lines[row])
            elif ch in (curses.KEY_RIGHT,):
                if col < len(lines[row]):
                    col += 1
                elif row < len(lines) - 1:
                    row += 1
                    col = 0
            elif ch in (10, 13, curses.KEY_ENTER):
                cur = lines[row]
                lines[row] = cur[:col]
                lines.insert(row + 1, cur[col:])
                row += 1
                col = 0
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                if col > 0:
                    cur = lines[row]
                    lines[row] = cur[:col - 1] + cur[col:]
                    col -= 1
                elif row > 0:
                    prev_len = len(lines[row - 1])
                    lines[row - 1] += lines.pop(row)
                    row -= 1
                    col = prev_len
            elif ch in (curses.KEY_HOME, 1):  # Home / Ctrl-A
                col = 0
            elif ch in (curses.KEY_END, 5):  # End / Ctrl-E
                col = len(lines[row])
            elif ch == curses.KEY_PPAGE:
                row = max(0, row - max_rows)
                col = min(col, len(lines[row]))
            elif ch == curses.KEY_NPAGE:
                row = min(len(lines) - 1, row + max_rows)
                col = min(col, len(lines[row]))
            elif ch == curses.KEY_DC:  # Delete
                cur = lines[row]
                if col < len(cur):
                    lines[row] = cur[:col] + cur[col + 1:]
                elif row < len(lines) - 1:
                    lines[row] += lines.pop(row + 1)
            elif ch == 11:  # Ctrl-K: delete line
                if len(lines) > 1:
                    lines.pop(row)
                    row = min(row, len(lines) - 1)
                else:
                    lines[0] = ""
                col = min(col, len(lines[row]))
            elif ch == 9:  # Tab -> 4 spaces
                cur = lines[row]
                lines[row] = cur[:col] + "    " + cur[col:]
                col += 4
            elif 32 <= ch <= 126:
                cur = lines[row]
                lines[row] = cur[:col] + chr(ch) + cur[col:]
                col += 1

        curses.curs_set(0)
        self.code_buffers[self.active_node] = lines
        self._apply_code()
        self.test_results = None
        assert self.machine is not None
        node = self.machine.nodes[self.active_node]
        if node.error_msg:
            self.status_msg = f"Node {self.active_node} asm error: {node.error_msg}"
        else:
            self.status_msg = f"Node {self.active_node} assembled OK."
        self._save()

