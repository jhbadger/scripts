# 7. AUTOMATED UNIT & PUZZLE VERIFICATION TESTS
# =============================================================================

class TestTIS6502(unittest.TestCase):
    def test_assembler_and_cpu_basics(self) -> None:
        src = """
        .ORG $0600
        START:
            LDA #$10
            CLC
            ADC #$25
            STA $20
            LDX #3
        LOOP:
            DEX
            BNE LOOP
            BRK
        """
        node = Cpu6502Node(0)
        node.load_source(src)
        self.assertIsNone(node.error_msg)
        for _ in range(50):
            if node.halted:
                break
            node.step()
        self.assertTrue(node.halted)
        self.assertEqual(node.A, 0x35)
        self.assertEqual(node.mem[0x20], 0x35)
        self.assertEqual(node.X, 0)

    def test_subroutine_and_stack(self) -> None:
        src = """
            LDA #$05
            JSR DOUBLE
            BRK
        DOUBLE:
            ASL A
            RTS
        """
        node = Cpu6502Node(0)
        node.load_source(src)
        for _ in range(20):
            if node.halted:
                break
            node.step()
        self.assertTrue(node.halted)
        self.assertEqual(node.A, 0x0A)

    def test_indirect_indexed_and_adc_flags(self) -> None:
        src = """
            LDA #$42
            STA $0210
            LDA #$10
            STA $30
            LDA #$02
            STA $31
            LDY #$00
            LDA ($30),Y
            CLC
            ADC #$FE
            BRK
        """
        node = Cpu6502Node(0)
        node.load_source(src)
        for _ in range(30):
            if node.halted:
                break
            node.step()
        self.assertTrue(node.halted)
        self.assertEqual(node.A, 0x40)
        self.assertTrue(node._get_flag(FLAG_C))

    def test_all_puzzles_reference_solutions(self) -> None:
        for puzzle in PUZZLES:
            tests = all_tests(puzzle)
            self.assertEqual(len(tests), len(puzzle.tests) + HIDDEN_TEST_COUNT)
            for i, tc in enumerate(tests):
                with self.subTest(puzzle=puzzle.title, test=tc.name):
                    gm = GridMachine(puzzle, test_idx=i, tests=tests)
                    gm.load_code(puzzle.reference_solution)
                    self.assertFalse(gm.has_errors(), f"Asm error in puzzle {puzzle.number}")
                    ok, ticks = gm.run_until_done()
                    self.assertTrue(ok, f"Puzzle {puzzle.number} ({tc.name}) failed after {ticks} ticks")

    def test_starter_code_does_not_solve(self) -> None:
        for puzzle in PUZZLES:
            with self.subTest(puzzle=puzzle.number):
                self.assertFalse(all(ok for _, ok, _, _, _ in run_suite(puzzle, puzzle.starter_code)))

    def _run(self, src: str, steps: int = 50) -> Cpu6502Node:
        node = Cpu6502Node(0)
        node.load_source(src)
        for _ in range(steps):
            if node.halted or node.state == "ERR":
                break
            node.step()
        return node

    def test_forward_reference_keeps_pass1_size(self) -> None:
        node = self._run("    LDA FOO\n    LDX #7\n    BRK\nFOO = $10\n")
        self.assertEqual(node.X, 7)
        node = self._run("    LDA FOO,X\n    LDY #3\n    BRK\nFOO = $10\n")
        self.assertEqual(node.Y, 3)

    def test_entry_point(self) -> None:
        self.assertEqual(self._run(".ORG $0800\n    LDA #5\n    BRK\n").A, 5)
        self.assertEqual(self._run("    LDA #1\n    BRK\nSTART:\n    LDA #9\n    BRK\n").A, 9)

    def test_expressions_left_associative(self) -> None:
        syms = assemble("A1 = 10-3-2\nA2 = 10-3+2\nA3 = 'a'+1\n NOP").symbols
        self.assertEqual((syms["A1"], syms["A2"], syms["A3"]), (5, 9, ord("b")))

    def test_assembler_rejects_bad_input(self) -> None:
        for src in (" LDA #300", " LDA ($1234),Y", " LDA ($100,X)", "UP:\n NOP",
                    "DOWN = 5", " FOO", " LDA $10000"):
            with self.subTest(src=src):
                with self.assertRaises(AssemblerError):
                    assemble(src)
        self.assertIn("Unknown instruction", str(self._assemble_err(" FOO $10")))

    @staticmethod
    def _assemble_err(src: str) -> Optional[AssemblerError]:
        try:
            assemble(src)
        except AssemblerError as exc:
            return exc
        return None

    def test_decimal_mode(self) -> None:
        node = self._run(" SED\n CLC\n LDA #$19\n ADC #$28\n STA $10\n"
                         " SEC\n LDA #$42\n SBC #$17\n STA $11\n"
                         " CLC\n LDA #$99\n ADC #$01\n BRK")
        self.assertEqual((node.mem[0x10], node.mem[0x11], node.A), (0x47, 0x25, 0x00))
        self.assertTrue(node._get_flag(FLAG_C))

    def _grid(self, code: Dict[int, str]) -> GridMachine:
        gm = GridMachine(PUZZLES[0])
        gm.load_code({nid: code.get(nid, "") for nid in range(4)})
        return gm

    def test_port_misuse_is_an_error(self) -> None:
        for nid, src in ((0, " LDA #1\n INC UP"), (0, " STA UP"), (2, " LDA DOWN")):
            with self.subTest(src=src):
                gm = self._grid({nid: src})
                for _ in range(5):
                    gm.step()
                self.assertEqual(gm.nodes[nid].state, "ERR")

    def test_link_latency_is_symmetric(self) -> None:
        def latency(a: int, b: int, out: str, inp: str) -> int:
            gm = self._grid({a: f" LDA #9\n STA {out}\n BRK", b: f" LDA {inp}\n BRK"})
            for t in range(1, 30):
                gm.step()
                if gm.nodes[b].halted:
                    return t
            return -1
        self.assertEqual(latency(0, 1, "RIGHT", "LEFT"), latency(1, 0, "LEFT", "RIGHT"))
        self.assertEqual(latency(0, 2, "DOWN", "UP"), latency(2, 0, "UP", "DOWN"))

    def test_deadlock_and_wrong_output_stop_early(self) -> None:
        gm = self._grid({0: "L: LDA RIGHT\n JMP L"})
        ok, ticks = gm.run_until_done()
        self.assertFalse(ok)
        self.assertLess(ticks, 10)
        self.assertEqual(gm.failure_reason(), "deadlock")
        gm = self._grid({0: "L: LDA UP\n STA DOWN\n JMP L", 2: "L: LDA UP\n STA DOWN\n JMP L"})
        ok, ticks = gm.run_until_done()
        self.assertFalse(ok)
        self.assertEqual(gm.failure_reason(), "wrong output")

    def test_save_load_and_scores(self) -> None:
        import tempfile
        old = os.environ.get("TIS6502_HOME")
        with tempfile.TemporaryDirectory() as tmp:
            os.environ["TIS6502_HOME"] = tmp
            try:
                p = PUZZLES[2]
                save_solution(p, p.reference_solution)
                loaded = load_solution(p)
                assert loaded is not None
                for nid in range(4):
                    self.assertEqual(loaded[nid].strip(), p.reference_solution.get(nid, "").strip())
                record_score(p, 100, 4, 20)
                best = record_score(p, 120, 3, 25)
                self.assertEqual(best, {"ticks": 100, "nodes": 3, "insns": 20})
            finally:
                if old is None:
                    os.environ.pop("TIS6502_HOME", None)
                else:
                    os.environ["TIS6502_HOME"] = old


