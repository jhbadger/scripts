    def draw(self) -> None:
        assert self.machine is not None
        self.stdscr.erase()
        h, w = self.stdscr.getmaxyx()
        p = PUZZLES[self.puzzle_idx]

        # Top Bar
        speed = self.SPEEDS[self.speed_idx]
        title = f" TIS-6502 | Puzzle {p.number}/{len(PUZZLES)}: {p.title} | Ticks: {self.machine.ticks} | Speed x{speed} "
        if self.machine.is_solved():
            title += "[SOLVED] "
        self.stdscr.addnstr(0, 0, title.ljust(w), w - 1, curses.A_REVERSE)

        # Left Panel: Puzzle Description & I/O Streams
        left_w = max(28, min(62, w // 3))
        if w - left_w < 54:
            left_w = max(24, w - 54)
        left_inner = max(12, left_w - 2)
        if left_w < w - 1:
            for div_y in range(1, h - 2):
                self.stdscr.addch(div_y, left_w, "|", curses.A_DIM)

        y = 2
        self.stdscr.addnstr(y, 1, "SPECIFICATION:", left_inner, curses.A_BOLD)
        y += 1
        for line in p.description:
            wrapped = textwrap.wrap(line, width=left_inner) or [""]
            for wline in wrapped:
                if y < h - 3:
                    self.stdscr.addnstr(y, 1, wline, left_inner)
                    y += 1

        y += 1
        if y < h - 3:
            tc = self.machine.tests[self.machine.test_idx]
            label = f"TEST {self.machine.test_idx + 1}/{len(self.machine.tests)}: {tc.name}  [ ]"
            self.stdscr.addnstr(y, 1, label, left_inner, curses.A_BOLD)
            y += 1
            best = load_scores().get(str(p.number))
            if best and y < h - 3:
                self.stdscr.addnstr(y, 1, f"BEST: {best.get('ticks')} ticks, {best.get('nodes')} nodes, "
                                          f"{best.get('insns')} insns", left_inner, curses.A_DIM)
                y += 1

        for name, ch in self.machine.in_streams.items():
            vals = ",".join(str(v) for v in ch.initial_data[:8])
            if len(ch.initial_data) > 8:
                vals += ",..."
            for wline in (textwrap.wrap(f"{name} [{ch.index}/{len(ch.initial_data)}]: {vals}", width=left_inner) or [""]):
                if y < h - 3:
                    self.stdscr.addnstr(y, 1, wline, left_inner)
                    y += 1

        for name, ch in self.machine.out_streams.items():
            exp = ",".join(str(v) for v in ch.expected[:7])
            got = ",".join(str(v) for v in ch.received[:7])
            mark = "OK" if ch.is_satisfied() else ".."
            for wline in (textwrap.wrap(f"{name} EXP: {exp}", width=left_inner) or [""]):
                if y < h - 3:
                    self.stdscr.addnstr(y, 1, wline, left_inner)
                    y += 1
            for wline in (textwrap.wrap(f"{name} GOT [{mark}]: {got}", width=left_inner) or [""]):
                if y < h - 3:
                    self.stdscr.addnstr(y, 1, wline, left_inner)
                    y += 1

        if self.test_results and y < h - 3:
            y += 1
            self.stdscr.addnstr(y, 1, "SUITE RESULTS:", left_w - 2, curses.A_BOLD)
            y += 1
            for tname, ok, ticks, _cyc, why in self.test_results:
                if y < h - 3:
                    verdict = "PASS" if ok else f"FAIL: {why}"
                    self.stdscr.addnstr(y, 1, f"  {tname}: {verdict} ({ticks}t)", left_w - 2)
                    y += 1

        # Active Node Debugger Display (A, X, Y, PC, SP, Flags, ZP $10-$17)
        if y + 4 < h - 3:
            y += 1
            anode = self.machine.nodes[self.active_node]
            self.stdscr.addnstr(y, 1, f"DEBUGGER [NODE {self.active_node} - {anode.state}]:", left_inner, curses.A_BOLD)
            y += 1
            regs_line = f"A:${anode.A:02X} ({anode.A:3d})  X:${anode.X:02X} ({anode.X:3d})  Y:${anode.Y:02X} ({anode.Y:3d})"
            for wline in (textwrap.wrap(regs_line, width=left_inner) or [""]):
                if y < h - 3:
                    self.stdscr.addnstr(y, 1, wline, left_inner, curses.A_BOLD)
                    y += 1
            meta_line = f"PC:${anode.PC:04X}  SP:${anode.SP:02X}  P:{anode.status_flags_str()}  CYC:{anode.cycles}"
            for wline in (textwrap.wrap(meta_line, width=left_inner) or [""]):
                if y < h - 3:
                    self.stdscr.addnstr(y, 1, wline, left_inner)
                    y += 1
            zp = " ".join(f"{anode.mem[a]:02X}" for a in range(0x10, 0x18))
            for wline in (textwrap.wrap(f"ZP $10-$17: {zp}", width=left_inner) or [""]):
                if y < h - 3:
                    self.stdscr.addnstr(y, 1, wline, left_inner, curses.A_DIM)
                    y += 1

        # Right Area: 2x2 Node Grid
        grid_x = left_w + 1
        grid_w = max(20, w - grid_x - 1)
        col_w = max(18, grid_w // 2 - 1)
        row_h = max(8, (h - 4) // 2)

        for nid in range(4):
            nx = grid_x + (nid % 2) * (col_w + 1)
            ny = 2 + (nid // 2) * row_h
            node = self.machine.nodes[nid]
            is_act = (nid == self.active_node)

            attr = curses.A_BOLD | curses.A_REVERSE if is_act else curses.A_BOLD
            hdr = f" NODE {nid} [{node.state}] "
            if ny < h - 2 and nx < w - 2:
                self.stdscr.addnstr(ny, nx, hdr.ljust(min(col_w, w - nx - 1)), min(col_w, w - nx - 1), attr)

            reg = f"A:{node.A:02X} X:{node.X:02X} Y:{node.Y:02X} PC:{node.PC:04X} {node.status_flags_str()}"
            if ny + 1 < h - 2 and nx < w - 2:
                self.stdscr.addnstr(ny + 1, nx, reg, min(col_w, w - nx - 1), curses.A_BOLD if is_act else curses.A_NORMAL)

            if node.error_msg:
                if ny + 2 < h - 2 and nx < w - 2:
                    self.stdscr.addnstr(ny + 2, nx, f"ERR: {node.error_msg}", min(col_w, w - nx - 1))
            else:
                cur_line = node.program.addr_to_line.get(node.PC) if node.program else None
                code_lines = self.code_buffers[nid]
                max_code = max(1, min(row_h - 3, h - 4 - ny))
                # Scroll so the executing line stays visible
                first = 0
                if cur_line is not None and len(code_lines) > max_code:
                    first = min(max(0, cur_line - 1 - max_code // 2), len(code_lines) - max_code)
                for li in range(first, min(len(code_lines), first + max_code)):
                    ly = ny + 2 + (li - first)
                    if ly >= h - 2:
                        break
                    marker = ">" if cur_line == li + 1 else " "
                    line_attr = curses.A_REVERSE if cur_line == li + 1 else curses.A_NORMAL
                    self.stdscr.addnstr(ly, nx, f"{marker}{code_lines[li]}", min(col_w, w - nx - 1), line_attr)

        # Bottom Status & Keys
        self.stdscr.addnstr(h - 2, 0, f" {self.status_msg} ".ljust(w), w - 1, curses.A_DIM)
        keys = " [1-4]Node [e]Edit [s]Step [r]Run [+-]Speed [f]FF [[]]Test [x]Reset [t]TestAll [l]Soln [n/p]Puzzle [h]Help [q]Quit "
        self.stdscr.addnstr(h - 1, 0, keys.ljust(w), w - 1, curses.A_REVERSE)
        self.stdscr.refresh()

    def loop(self) -> None:
        curses.curs_set(0)
        while True:
            self.draw()
            self.stdscr.nodelay(self.running)
            if self.running:
                assert self.machine is not None
                if self.machine.is_solved():
                    self.running = False
                    self.status_msg = f"Test case solved in {self.machine.ticks} ticks! Press [t] to run full suite."
                    continue
                why = self.machine.failure_reason()
                if why:
                    self.running = False
                    self.status_msg = f"Execution stopped: {why}."
                    continue
                for _ in range(self.SPEEDS[self.speed_idx]):
                    self.machine.step()
                    if self.machine.is_solved() or self.machine.failure_reason():
                        break
                time.sleep(0.03)

            ch = self.stdscr.getch()
            if ch == -1:
                continue
            elif ch in (ord("q"), ord("Q")):
                break
            elif ch == 9:  # Tab
                self.active_node = (self.active_node + 1) % 4
            elif ch in (ord("1"), ord("2"), ord("3"), ord("4")):
                self.active_node = ch - ord("1")
            elif ch in (ord("e"), ord("E"), 10, 13):
                self._edit_active_node()
            elif ch in (ord("s"), ord("S")):
                self.running = False
                assert self.machine is not None
                self.machine.step()
            elif ch in (ord("r"), ord("R")):
                self.running = not self.running
            elif ch in (ord("x"), ord("X")):
                self.running = False
                assert self.machine is not None
                self.machine.reset()
                self.status_msg = "Simulation reset."
            elif ch in (ord("t"), ord("T")):
                self.running = False
                self._run_all_tests()
            elif ch in (ord("n"), ord("N")):
                self.load_puzzle(self.puzzle_idx + 1)
            elif ch in (ord("p"), ord("P")):
                self.load_puzzle(self.puzzle_idx - 1)
            elif ch in (ord("l"), ord("L")):
                self.running = False
                if not self._confirm("Replace your code with the reference solution?"):
                    self.status_msg = "Kept your code."
                    continue
                p = PUZZLES[self.puzzle_idx]
                self.code_buffers = {
                    nid: (p.reference_solution.get(nid, "").splitlines() or [""])
                    for nid in range(4)
                }
                self._apply_code()
                self.test_results = None
                self._save()
                self.status_msg = "Loaded reference solution. Press [r] or [t] to run!"
            elif ch in (ord("+"), ord("=")):
                self.speed_idx = min(len(self.SPEEDS) - 1, self.speed_idx + 1)
            elif ch in (ord("-"), ord("_")):
                self.speed_idx = max(0, self.speed_idx - 1)
            elif ch in (ord("f"), ord("F")):
                self._fast_forward()
            elif ch == ord("]"):
                self._switch_test(1)
            elif ch == ord("["):
                self._switch_test(-1)
            elif ch in (ord("h"), ord("H"), ord("?")):
                self._show_help()


