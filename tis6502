def main() -> int:
    parser = argparse.ArgumentParser(description="TIS-6502: 6502 Assembly Coding Puzzle Game")
    parser.add_argument("--test", action="store_true", help="Run built-in unit and puzzle verification tests")
    parser.add_argument("--list", action="store_true", help="List all available puzzles")
    parser.add_argument("--puzzle", type=int, default=1, help=f"Puzzle number (1-{len(PUZZLES)}) for --solve")
    parser.add_argument("--solve", action="store_true", help="Run reference solution for --puzzle in CLI")
    args = parser.parse_args()

    if args.test:
        suite = unittest.defaultTestLoader.loadTestsFromTestCase(TestTIS6502)
        runner = unittest.TextTestRunner(verbosity=2)
        res = runner.run(suite)
        return 0 if res.wasSuccessful() else 1

    if args.list:
        for p in PUZZLES:
            print(f"{p.number}. {p.title} - {p.description[0]}")
        return 0

    if args.solve:
        idx = args.puzzle - 1
        if not (0 <= idx < len(PUZZLES)):
            print(f"Invalid puzzle number {args.puzzle}. Choose 1-{len(PUZZLES)}.")
            return 1
        p = PUZZLES[idx]
        print(f"Puzzle {p.number}: {p.title}")
        tests = all_tests(p)
        for i, tc in enumerate(tests):
            gm = GridMachine(p, test_idx=i, tests=tests)
            gm.load_code(p.reference_solution)
            ok, ticks = gm.run_until_done()
            cyc, nodes, insns = gm.total_metrics()
            print(f"  Test '{tc.name}': {'PASS' if ok else 'FAIL'} | ticks={ticks}, cycles={cyc}, nodes={nodes}, insns={insns}")
            for oname, och in gm.out_streams.items():
                print(f"    {oname}: expected={och.expected} got={och.received}")
        return 0

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("TIS-6502 requires an interactive terminal for the TUI. Try --test, --list, or --solve.")
        return 0

    os.environ.setdefault("ESCDELAY", "25")  # make ESC respond immediately
    curses.wrapper(lambda stdscr: TIS6502TUI(stdscr).loop())
    return 0


if __name__ == "__main__":
    sys.exit(main())