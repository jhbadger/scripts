# -----------------------------------------------------------------------------
# Hidden randomized tests: each generator builds inputs and computes the
# expected outputs with a Python reference, so solutions cannot hard-code the
# visible test data. Seeds are fixed per puzzle so scores are reproducible.
# -----------------------------------------------------------------------------

HIDDEN_TEST_COUNT = 3


def _bytes(rng: random.Random, n: int, lo: int = 0, hi: int = 255) -> List[int]:
    return [rng.randint(lo, hi) for _ in range(n)]


def _packets(rng: random.Random, max_len: int = 6) -> List[List[int]]:
    return [_bytes(rng, rng.randint(0, max_len), 1, 255) for _ in range(rng.randint(3, 6))]


def _flatten_packets(pkts: List[List[int]]) -> List[int]:
    out: List[int] = []
    for p in pkts:
        out += p + [0]
    return out


def _map1(f):
    """Single stream IN.A -> OUT.A, element-wise."""
    def gen(rng: random.Random):
        xs = _bytes(rng, rng.randint(8, 16))
        return {"IN.A": xs}, {"OUT.A": [f(x) & 0xFF for x in xs]}
    return gen


def _map2(f):
    """IN.A, IN.B -> OUT.A, pairwise."""
    def gen(rng: random.Random):
        n = rng.randint(6, 12)
        a, b = _bytes(rng, n), _bytes(rng, n)
        return {"IN.A": a, "IN.B": b}, {"OUT.A": [f(x, y) & 0xFF for x, y in zip(a, b)]}
    return gen


def _split(pred):
    """IN.A -> OUT.A when pred(x) is true, else OUT.B."""
    def gen(rng: random.Random):
        xs = _bytes(rng, rng.randint(8, 16))
        return {"IN.A": xs}, {"OUT.A": [x for x in xs if pred(x)],
                              "OUT.B": [x for x in xs if not pred(x)]}
    return gen


def _per_packet(f):
    def gen(rng: random.Random):
        pkts = _packets(rng)
        return {"IN.A": _flatten_packets(pkts)}, {"OUT.A": [f(p) & 0xFF for p in pkts]}
    return gen


def _stateful(f):
    """IN.A -> OUT.A where f(x, prev) uses the previous input (prev starts at 0)."""
    def gen(rng: random.Random):
        xs = _bytes(rng, rng.randint(8, 16))
        prev, out = 0, []
        for x in xs:
            out.append(f(x, prev) & 0xFF)
            prev = x
        return {"IN.A": xs}, {"OUT.A": out}
    return gen


def _gen_prefix_sum(rng: random.Random):
    ds = _bytes(rng, rng.randint(8, 16))
    out, s = [], 0
    for d in ds:
        s = (s + d) & 0xFF
        out.append(s)
    return {"IN.A": ds}, {"OUT.A": out}


def _gen_pair_sort(rng: random.Random):
    pairs = [(rng.randint(0, 255), rng.randint(0, 255)) for _ in range(rng.randint(4, 8))]
    return ({"IN.A": [v for p in pairs for v in p]},
            {"OUT.A": [min(p) for p in pairs], "OUT.B": [max(p) for p in pairs]})


def _gen_rle_decode(rng: random.Random):
    pairs = [(rng.randint(0, 5), rng.randint(0, 255)) for _ in range(rng.randint(3, 7))]
    return ({"IN.A": [v for p in pairs for v in p]},
            {"OUT.A": [v for c, v in pairs for _ in range(c)]})


def _gen_rle_encode(rng: random.Random):
    ins: List[int] = []
    outs: List[int] = []
    for _ in range(rng.randint(2, 3)):  # packets
        prev = None
        for _ in range(rng.randint(1, 4)):  # runs within a packet
            val = rng.randint(1, 255)
            if val == prev:
                val = (val % 255) + 1  # adjacent runs must differ
            cnt = rng.randint(1, 5)
            ins += [val] * cnt
            outs += [cnt, val]
            prev = val
        ins.append(0)
    return {"IN.A": ins}, {"OUT.A": outs}


def _gen_ascii(rng: random.Random):
    xs = [rng.choice([rng.randint(0x20, 0x7E), rng.choice([0x60, 0x61, 0x7A, 0x7B])])
          for _ in range(rng.randint(10, 20))]
    return {"IN.A": xs}, {"OUT.A": [x & 0xDF if 0x61 <= x <= 0x7A else x for x in xs]}


def _gen_divmod(rng: random.Random):
    xs = _bytes(rng, rng.randint(6, 12))
    return {"IN.A": xs}, {"OUT.A": [x // 10 for x in xs], "OUT.B": [x % 10 for x in xs]}


def _gen_fib(rng: random.Random):
    ns = [rng.randint(1, 14) for _ in range(rng.randint(2, 3))]
    out: List[int] = []
    for n in ns:
        a, b = 0, 1
        for _ in range(n):
            out.append(b)
            a, b = b, (a + b) & 0xFF
    return {"IN.A": ns}, {"OUT.A": out}


def _gen_reverse(rng: random.Random):
    pkts = _packets(rng, max_len=10)
    return {"IN.A": _flatten_packets(pkts)}, {"OUT.A": [v for p in pkts for v in reversed(p)]}


def _xor_all(p: List[int]) -> int:
    r = 0
    for v in p:
        r ^= v
    return r


def _lfsr(s: int) -> int:
    return (s >> 1) ^ (0xB8 if s & 1 else 0)


HIDDEN_GENERATORS = {
    1: _map1(lambda x: x * 2),
    2: _map2(lambda a, b: abs(a - b)),
    3: _split(lambda x: x < 100),
    4: _per_packet(sum),
    5: _map1(lambda x: ((x << 4) | (x >> 4))),
    6: _gen_pair_sort,
    7: _map1(lambda x: x ^ 0xFF),
    8: _map1(lambda x: min(200, max(20, x))),
    9: _map1(lambda x: bin(x).count("1")),
    10: _map1(lambda x: int(f"{x:08b}"[::-1], 2)),
    11: _stateful(lambda x, prev: x - prev),
    12: _gen_prefix_sum,
    13: _map2(max),
    14: _stateful(lambda x, prev: (x + prev) >> 1),
    15: _split(lambda x: x % 2 == 0),
    16: _per_packet(len),
    17: _per_packet(lambda p: max(p, default=0)),
    18: _gen_rle_decode,
    19: _gen_rle_encode,
    20: _gen_ascii,
    21: _map2(lambda a, b: a * b),
    22: _gen_divmod,
    23: _gen_fib,
    24: _gen_reverse,
    25: _per_packet(_xor_all),
    26: _map1(_lfsr),
}

_hidden_cache: Dict[int, List[TestCase]] = {}


def hidden_tests(puzzle: Puzzle) -> List[TestCase]:
    if puzzle.number not in _hidden_cache:
        gen = HIDDEN_GENERATORS.get(puzzle.number)
        tests: List[TestCase] = []
        if gen:
            rng = random.Random(6502 * 1000 + puzzle.number)
            for k in range(HIDDEN_TEST_COUNT):
                ins, outs = gen(rng)
                tests.append(TestCase(f"Hidden {k + 1}", ins, outs))
        _hidden_cache[puzzle.number] = tests
    return _hidden_cache[puzzle.number]


def all_tests(puzzle: Puzzle) -> List[TestCase]:
    return list(puzzle.tests) + hidden_tests(puzzle)


def run_suite(puzzle: Puzzle, code_map: Dict[int, str]) -> List[Tuple[str, bool, int, int, Optional[str]]]:
    """Run every visible and hidden test. Returns (name, ok, ticks, cycles, why)."""
    results = []
    for i, tc in enumerate(all_tests(puzzle)):
        gm = GridMachine(puzzle, test_idx=i, tests=all_tests(puzzle))
        gm.load_code(code_map)
        ok, ticks = gm.run_until_done()
        why = None if ok else (gm.failure_reason() or "timeout")
        results.append((tc.name, ok, ticks, sum(n.cycles for n in gm.nodes), why))
    return results


# -----------------------------------------------------------------------------
# Saved solutions & best scores (~/.tis6502, override with $TIS6502_HOME)
# -----------------------------------------------------------------------------

def save_dir() -> str:
    return os.environ.get("TIS6502_HOME") or os.path.join(os.path.expanduser("~"), ".tis6502")


def _solution_path(puzzle: Puzzle) -> str:
    return os.path.join(save_dir(), f"puzzle{puzzle.number:02d}.asm")


def save_solution(puzzle: Puzzle, code_map: Dict[int, str]) -> None:
    os.makedirs(save_dir(), exist_ok=True)
    parts = [f";; TIS-6502 puzzle {puzzle.number}: {puzzle.title}\n"]
    for nid in range(4):
        body = code_map.get(nid, "").rstrip("\n")
        parts.append(f";; NODE {nid}\n{body}\n" if body else f";; NODE {nid}\n")
    with open(_solution_path(puzzle), "w") as fh:
        fh.write("".join(parts))


def load_solution(puzzle: Puzzle) -> Optional[Dict[int, str]]:
    try:
        with open(_solution_path(puzzle)) as fh:
            text = fh.read()
    except OSError:
        return None
    code: Dict[int, List[str]] = {}
    cur: Optional[int] = None
    for line in text.splitlines():
        m = re.fullmatch(r";; NODE ([0-3])\s*", line)
        if m:
            cur = int(m.group(1))
            code[cur] = []
        elif cur is not None:
            code[cur].append(line)
    if not code:
        return None
    return {nid: "\n".join(code.get(nid, [])) for nid in range(4)}


def _scores_path() -> str:
    return os.path.join(save_dir(), "scores.json")


def load_scores() -> Dict[str, Dict[str, int]]:
    try:
        with open(_scores_path()) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def record_score(puzzle: Puzzle, ticks: int, nodes: int, insns: int) -> Dict[str, int]:
    """Keep the best (lowest) value of each metric independently, TIS-100 style."""
    scores = load_scores()
    best = scores.get(str(puzzle.number), {})
    for key, val in (("ticks", ticks), ("nodes", nodes), ("insns", insns)):
        if key not in best or val < best[key]:
            best[key] = val
    scores[str(puzzle.number)] = best
    os.makedirs(save_dir(), exist_ok=True)
    with open(_scores_path(), "w") as fh:
        json.dump(scores, fh, indent=1, sort_keys=True)
    return best


