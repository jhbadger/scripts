#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "mistralai>=2.9,<3",
# ]
# ///
import os
import sys
import argparse
import pickle
from mistralai.client import Mistral

def main():
    api_key = os.environ.get("MISTRAL_API_KEY")
    if not api_key:
        sys.exit("Error: MISTRAL_API_KEY environment variable is not set")

    parser = argparse.ArgumentParser(description='Mistral OCR')
    parser.add_argument('-i', type=str, required=True,
                        help='Input file name or path')
    args = parser.parse_args()
    file = args.i

    if not os.path.isfile(file):
        sys.exit(f"Error: input file not found: {file}")

    client = Mistral(api_key=api_key)

    with open(file, "rb") as f:
        uploaded_pdf = client.files.upload(
            file={
                "file_name": os.path.basename(file),
                "content": f,
            },
            purpose="ocr")
    signed_url = client.files.get_signed_url(file_id=uploaded_pdf.id)

    ocr_response = client.ocr.process(
    model="mistral-ocr-latest",
    document={
        "type": "document_url",
        "document_url": signed_url.url
    },
    include_image_base64=True)
    pkl = os.path.basename(file)+".pkl"
    with open(pkl, 'wb') as outp:
        pickle.dump(ocr_response, outp, pickle.HIGHEST_PROTOCOL)
    print(f"Wrote {pkl}")


if __name__ == '__main__':
    main()
