YTM_SONGS = "EgWKAQIIAWoKEAkQBRAKEAMQBA%3D%3D"
YTM_ALBUMS = "EgWKAQIYAWoKEAkQAxAEEAkQBQ%3D%3D"


def ytm_call(endpoint, body):
    body["context"] = {"client": {"clientName": "WEB_REMIX",
                                  "clientVersion": "1.20250101.01.00",
                                  "hl": "en"}}
    return http_json("https://music.youtube.com/youtubei/v1/%s"
                     "?prettyPrint=false" % endpoint, body,
                     {"Origin": "https://music.youtube.com"})


def ytm_rows(d):
    """(renderer, flex-column texts) for each list row in a response."""
    def walk(o):
        if isinstance(o, dict):
            if "musicResponsiveListItemRenderer" in o:
                yield o["musicResponsiveListItemRenderer"]
            for v in o.values():
                yield from walk(v)
        elif isinstance(o, list):
            for v in o:
                yield from walk(v)

    for r in walk(d):
        cols = []
        for c in r.get("flexColumns", []):
            runs = c.get("musicResponsiveListItemFlexColumnRenderer", {}) \
                    .get("text", {}).get("runs", [])
            cols.append("".join(x.get("text", "") for x in runs))
        yield r, cols


def ytm_songs(text):
    out = []
    for r, cols in ytm_rows(ytm_call("search", {"query": text,
                                                "params": YTM_SONGS})):
        vid = (r.get("playlistItemData") or {}).get("videoId")
        if not vid:
            continue
        title = cols[0] if cols else ""
        parts = [p.strip() for p in (cols[1] if len(cols) > 1 else "")
                 .split(" • ")]
        if parts and parts[0] in ("Song", "Video"):
            parts = parts[1:]
        dur = None
        if parts and re.fullmatch(r"\d+(:\d+)+", parts[-1]):
            dur = parse_time(parts.pop())
        artist = parts[0] if parts else ""
        album = parts[1] if len(parts) > 1 else ""
        out.append(item("YouTube Music", "track", title, artist, album, dur,
                        "https://music.youtube.com/watch?v=" + vid,
                        "https://music.youtube.com/watch?v=" + vid,
                        info=cols[2] if len(cols) > 2 else ""))
    return out


def ytm_albums(text):
    out = []
    for r, cols in ytm_rows(ytm_call("search", {"query": text,
                                                "params": YTM_ALBUMS})):
        bid = r.get("navigationEndpoint", {}).get("browseEndpoint", {}) \
               .get("browseId")
        if not bid or not cols:
            continue
        # "Album • Radiohead • 1997" (or Single / EP)
        parts = [p.strip() for p in (cols[1] if len(cols) > 1 else "")
                 .split(" • ")]
        kind = parts.pop(0) if len(parts) > 2 else "Album"
        year = parts.pop() if parts and re.fullmatch(r"\d{4}", parts[-1]) \
            else ""
        info = year if kind == "Album" else ("%s %s" % (kind, year)).strip()
        out.append(item("YouTube Music", "album", cols[0],
                        " ".join(parts), cols[0], None, "",
                        "https://music.youtube.com/browse/" + bid, bid,
                        info=info))
    return out


def ytm_album_tracks(it):
    d = ytm_call("browse", {"browseId": it["key"]})
    artist = it["artist"]

    def walk(o):
        if isinstance(o, dict):
            if "musicResponsiveHeaderRenderer" in o:
                yield o["musicResponsiveHeaderRenderer"]
            for v in o.values():
                yield from walk(v)
        elif isinstance(o, list):
            for v in o:
                yield from walk(v)

    for h in walk(d):
        runs = h.get("straplineTextOne", {}).get("runs", [])
        artist = "".join(x.get("text", "") for x in runs) or artist
        break
    out = []
    for r, cols in ytm_rows(d):
        vid = (r.get("playlistItemData") or {}).get("videoId")
        if not vid or not cols:
            continue
        dur = None
        for c in r.get("fixedColumns", []):
            runs = c.get("musicResponsiveListItemFixedColumnRenderer", {}) \
                    .get("text", {}).get("runs", [])
            dur = parse_time("".join(x.get("text", "") for x in runs)) or dur
        url = "https://music.youtube.com/watch?v=" + vid
        out.append(item("YouTube Music", "track", cols[0],
                        (cols[1] if len(cols) > 1 else "") or artist,
                        it["title"], dur, url, url))
    return out


def search_ytm(q, cfg):
    text = q.text()
    songs = ytm_songs(text)
    if "title" in q.f:
        return songs
    albums = ytm_albums(text)
    if "album" in q.f:
        return albums + songs
    return songs + albums[:8]


def _ytdlp_search(prefix, q, src, n=25):
    d = run_ytdlp_json(["--flat-playlist", "-J",
                        "%s%d:%s" % (prefix, n, q.text())])
    out = []
    for e in d.get("entries") or []:
        url = e.get("webpage_url") or e.get("url")
        if not url:
            continue
        artist = e.get("uploader") or e.get("channel") or ""
        out.append(item(src, "track", e.get("title"), artist, "",
                        e.get("duration"), url, url,
                        genre=", ".join(e.get("genres") or [])))
    return out


