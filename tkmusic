class App:
    def __init__(self, root, initial=""):
        self.root = root
        self.cfg = self.load_config()
        self.ui_q = queue.Queue()
        self.player = Player()
        self.items = {}              # tree iid -> item
        self.history = []            # stack of (title, items) for Back
        self.view_items = []
        self.view_title = ""
        self.search_id = 0
        self.queue = []              # list of items
        self.qpos = -1
        self.current = None
        self.state = {}
        self.paused = False
        self.seeking = False
        self.failures = 0
        self.play_token = 0
        self.pending = set()
        self.started = 0

        root.title("tkmusic")
        root.geometry(self.cfg.get("geometry", "1150x680"))
        root.minsize(760, 420)
        self.build_ui()
        self.refresh_favourites()
        self.refresh_queue()
        root.protocol("WM_DELETE_WINDOW", self.quit)
        root.after(POLL_MS, self.poll)
        threading.Thread(target=self.bg_find_tools, daemon=True).start()
        if not TOOLS.mpv:
            self.status("mpv was not found - install it (brew install mpv) "
                        "to play anything")
        if initial:
            self.search_var.set(initial)
            self.root.after(100, self.do_search)
        else:
            self.entry.focus_set()

    # ------------------------------------------------------------ config

    def load_config(self):
        try:
            with open(CONFIG) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save_config(self):
        self.cfg["volume"] = int(self.volume.get())
        self.cfg["source"] = self.source_var.get()
        self.cfg["geometry"] = self.root.geometry()
        try:
            tmp = CONFIG + ".tmp"
            with open(tmp, "w") as f:
                json.dump(self.cfg, f, indent=1)
            os.replace(tmp, CONFIG)
        except OSError as e:
            self.status("could not save settings: %s" % e)

