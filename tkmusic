FIELDS = ("artist", "album", "title", "genre")
FIELD_NAMES = {"artist": "artist", "by": "artist", "album": "album",
               "title": "title", "track": "title", "song": "title",
               "genre": "genre", "tag": "genre"}
FIELD_MENU = ["Any field", "Artist", "Album", "Title", "Genre"]


class Query:
    """Search words, optionally split into fields.

    'artist:radiohead album:kid a' searches by artist and album; words
    before the first field go to `default` (a field name, or None for any).
    """

    def __init__(self, text, default=None):
        self.any = ""
        self.f = {}
        parts = re.split(r"(?i)(?:^|\s)(%s):" % "|".join(FIELD_NAMES), text)
        self.add(default, parts[0])
        for name, value in zip(parts[1::2], parts[2::2]):
            # a quoted value ends at its closing quote; words after it
            # go to the default field
            m = re.match(r'\s*"([^"]*)"?(.*)', value, re.S)
            if m:
                value = m.group(1)
                self.add(default, m.group(2))
            self.add(FIELD_NAMES[name.lower()], value)

    def add(self, field, value):
        value = value.strip().strip('"').strip()
        if not value:
            return
        if field:
            self.f[field] = (self.f[field] + " " + value
                             if field in self.f else value)
        else:
            self.any = (self.any + " " + value).strip()

    def text(self):
        """Everything, for sources with no field search of their own."""
        return " ".join([self.any] + [self.f[k] for k in FIELDS
                                      if k in self.f]).strip()

    def __str__(self):
        bits = ['"%s"' % self.any] if self.any else []
        bits += ['%s "%s"' % (k, self.f[k]) for k in FIELDS if k in self.f]
        return ", ".join(bits)


def norm(text):
    text = unicodedata.normalize("NFKD", text or "")
    return "".join(c for c in text if not unicodedata.combining(c)).lower()


def words_in(words, text):
    text = norm(text)
    return all(w in text for w in re.findall(r"\w+", norm(words)))


def field_match(it, field, value):
    """Whether a result fits a field search (for sources without one)."""
    kind = it["kind"]
    if field == "artist":
        who = it["artist"]
        if it["src"] in ("YouTube", "SoundCloud"):
            who += " " + it["title"]     # uploads are often "Artist - Song"
        return words_in(value, who)
    if field == "album":
        if kind in ("album", "item"):
            return words_in(value, it["title"] + " " + it["album"])
        return kind == "track" and words_in(value, it["album"])
    if field == "title":
        return kind == "track" and words_in(value, it["title"])
    if field == "genre":
        return words_in(value, it["genre"])
    return True


