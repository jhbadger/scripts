# ---------------------------------------------------------------- helpers

def http(url, data=None, headers=None, timeout=15):
    h = {"User-Agent": UA}
    h.update(headers or {})
    if isinstance(data, (dict, list)):
        data = json.dumps(data).encode()
        h.setdefault("Content-Type", "application/json")
    elif isinstance(data, str):
        data = data.encode()
    req = urllib.request.Request(url, data=data, headers=h)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


def http_json(url, data=None, headers=None, timeout=15):
    return json.loads(http(url, data, headers, timeout))


def fmt_time(s):
    if s is None or s < 0:
        return ""
    s = int(s)
    if s >= 3600:
        return "%d:%02d:%02d" % (s // 3600, s // 60 % 60, s % 60)
    return "%d:%02d" % (s // 60, s % 60)


def parse_time(t):
    """'3:59', '1:02:03' or '245.3' -> seconds (or None)."""
    if t is None:
        return None
    if isinstance(t, (int, float)):
        return float(t)
    try:
        secs = 0.0
        for part in str(t).strip().split(":"):
            secs = secs * 60 + float(part)
        return secs
    except ValueError:
        return None


def item(src, kind, title, artist="", album="", dur=None, url="", page="",
         key="", info=""):
    return {"src": src, "kind": kind, "title": title or "(untitled)",
            "artist": artist or "", "album": album or "", "dur": dur,
            "url": url, "page": page, "key": key, "info": info}


def run_ytdlp_json(args, timeout=40):
    out = subprocess.run([TOOLS.ytdlp, "--no-update", "--no-warnings"] + args,
                         capture_output=True, text=True, timeout=timeout)
    if out.returncode != 0 and not out.stdout:
        lines = out.stderr.strip().splitlines()
        raise RuntimeError(lines[-1] if lines else "yt-dlp failed")
    return json.loads(out.stdout)


class Tools:
    """Locates mpv and the newest yt-dlp."""

    def __init__(self):
        self.mpv = shutil.which("mpv") or next(
            (p for p in ("/opt/homebrew/bin/mpv", "/usr/local/bin/mpv")
             if os.path.exists(p)), None)
        self.ytdlp = shutil.which("yt-dlp") or "yt-dlp"
        self.ytdlp_version = ""

    def find_ytdlp(self):
        dirs = os.environ.get("PATH", "").split(os.pathsep)
        dirs += ["/opt/homebrew/bin", "/usr/local/bin",
                 os.path.expanduser("~/.local/bin")]
        seen, best = set(), ("", None)
        for d in dirs:
            p = os.path.join(d, "yt-dlp")
            if not os.access(p, os.X_OK):
                continue
            real = os.path.realpath(p)
            if real in seen:
                continue
            seen.add(real)
            try:
                v = subprocess.run([p, "--version"], capture_output=True,
                                   text=True, timeout=20).stdout.strip()
            except (OSError, subprocess.SubprocessError):
                continue
            if v > best[0]:
                best = (v, p)
        if best[1]:
            self.ytdlp_version, self.ytdlp = best


TOOLS = Tools()


# ---------------------------------------------------------------- sources

def search_ytm(q):
    body = {"context": {"client": {"clientName": "WEB_REMIX",
                                   "clientVersion": "1.20250101.01.00",
                                   "hl": "en"}},
            "query": q, "params": "EgWKAQIIAWoKEAkQBRAKEAMQBA%3D%3D"}
    d = http_json("https://music.youtube.com/youtubei/v1/search"
                  "?prettyPrint=false", body,
                  {"Origin": "https://music.youtube.com"})
    out = []

    def walk(o):
        if isinstance(o, dict):
            if "musicResponsiveListItemRenderer" in o:
                yield o["musicResponsiveListItemRenderer"]
            for v in o.values():
                yield from walk(v)
        elif isinstance(o, list):
            for v in o:
                yield from walk(v)

    for r in walk(d):
        vid = (r.get("playlistItemData") or {}).get("videoId")
        if not vid:
            continue
        cols = []
        for c in r.get("flexColumns", []):
            runs = c.get("musicResponsiveListItemFlexColumnRenderer", {}) \
                    .get("text", {}).get("runs", [])
            cols.append("".join(x.get("text", "") for x in runs))
        title = cols[0] if cols else ""
        parts = [p.strip() for p in (cols[1] if len(cols) > 1 else "")
                 .split(" • ")]
        if parts and parts[0] in ("Song", "Video"):
            parts = parts[1:]
        dur = None
        if parts and re.fullmatch(r"\d+(:\d+)+", parts[-1]):
            dur = parse_time(parts.pop())
        artist = parts[0] if parts else ""
        album = parts[1] if len(parts) > 1 else ""
        out.append(item("YouTube Music", "track", title, artist, album, dur,
                        "https://music.youtube.com/watch?v=" + vid,
                        "https://music.youtube.com/watch?v=" + vid,
                        info=cols[2] if len(cols) > 2 else ""))
    return out


def _ytdlp_search(prefix, q, src, n=25):
    d = run_ytdlp_json(["--flat-playlist", "-J", "%s%d:%s" % (prefix, n, q)])
    out = []
    for e in d.get("entries") or []:
        url = e.get("webpage_url") or e.get("url")
        if not url:
            continue
        artist = e.get("uploader") or e.get("channel") or ""
        out.append(item(src, "track", e.get("title"), artist, "",
                        e.get("duration"), url, url))
    return out


def search_yt(q):
    return _ytdlp_search("ytsearch", q, "YouTube")


def search_sc(q):
    return _ytdlp_search("scsearch", q, "SoundCloud")


def search_bc(q):
    d = http_json("https://bandcamp.com/api/bcsearch_public_api/1/"
                  "autocomplete_elastic",
                  {"search_text": q, "search_filter": "", "full_page": False,
                   "fan_id": None})
    out = []
    for r in d.get("auto", {}).get("results", []):
        t = r.get("type")
        if t == "b":
            out.append(item("Bandcamp", "artist", r.get("name"),
                            r.get("name"), "", None, "",
                            r.get("item_url_root"),
                            info=", ".join(r.get("tag_names") or [])))
        elif t == "a":
            out.append(item("Bandcamp", "album", r.get("name"),
                            r.get("band_name"), r.get("name"), None, "",
                            r.get("item_url_path")))
        elif t == "t":
            out.append(item("Bandcamp", "track", r.get("name"),
                            r.get("band_name"), r.get("album_name"), None,
                            "", r.get("item_url_path")))
    return out


def bc_tralbum(page):
    text = http(page)
    m = re.search(r'data-tralbum="([^"]+)"', text)
    if not m:
        return None, text
    return json.loads(html.unescape(m.group(1))), text


def bc_expand(it):
    if it["kind"] == "artist":
        # an artist's /music page is a grid of albums, unless the artist
        # has a single release, in which case it is that album's page
        page = it["page"].rstrip("/")
        if not page.endswith("/music"):
            page += "/music"
        d, text = bc_tralbum(page)
        out = bc_discography(text, it)
        if out or d is None:
            return out
        return bc_tracks(d, page)
    d, text = bc_tralbum(it["page"])
    return bc_tracks(d, it["page"]) if d else []


def bc_tracks(d, page):
    root = re.match(r"https?://[^/]+", page).group(0)
    artist = d.get("artist", "")
    album = (d.get("current") or {}).get("title", "")
    if d.get("item_type") == "track":
        album = ""
    out = []
    for t in d.get("trackinfo", []):
        url = (t.get("file") or {}).get("mp3-128", "")
        link = t.get("title_link")
        tpage = root + link if link else page
        it = item("Bandcamp", "track", t.get("title"),
                  t.get("artist") or artist, album, t.get("duration"),
                  url, tpage, info="" if url else "not streamable")
        out.append(it)
    return out


def bc_discography(text, it):
    root = re.match(r"https?://[^/]+", it["page"]).group(0)
    out, seen = [], set()
    for m in re.finditer(r'<a href="((?:https?://[^"]+)?/(album|track)/[^"]+)"'
                         r'.*?<p class="title">\s*(.*?)\s*(?:<br|</p>)',
                         text, re.S):
        href, kind, title = m.groups()
        url = href if href.startswith("http") else root + href
        if url in seen:
            continue
        seen.add(url)
        title = html.unescape(re.sub(r"<[^>]+>", "", title)).strip()
        out.append(item("Bandcamp", "album" if kind == "album" else "track",
                        title, it["artist"], title if kind == "album" else "",
                        None, "", url))
    m = re.search(r'data-client-items="([^"]+)"', text)
    if m:
        for e in json.loads(html.unescape(m.group(1))):
            url = root + e.get("page_url", "")
            if url in seen:
                continue
            seen.add(url)
            kind = "album" if e.get("type") == "album" else "track"
            out.append(item("Bandcamp", kind, e.get("title"),
                            e.get("artist") or it["artist"],
                            e.get("title") if kind == "album" else "",
                            None, "", url))
    return out


def search_ia(q):
    # matches in title or creator, most downloaded first; failing that,
    # anywhere in the description, most relevant first
    docs = []
    for query, sort in (("(title:(%s) OR creator:(%s))" % (q, q),
                         [("sort[]", "downloads desc")]),
                        ("(%s)" % q, [])):
        params = urllib.parse.urlencode([
            ("q", query + " AND mediatype:(audio OR etree)"),
            ("fl[]", "identifier"), ("fl[]", "title"), ("fl[]", "creator"),
            ("fl[]", "date"), ("rows", "40"), ("output", "json")] + sort)
        d = http_json("https://archive.org/advancedsearch.php?" + params)
        docs = d.get("response", {}).get("docs", [])
        if docs:
            break
    out = []
    for r in docs:
        creator = r.get("creator", "")
        if isinstance(creator, list):
            creator = ", ".join(creator)
        ident = r["identifier"]
        out.append(item("Internet Archive", "item", r.get("title", ident),
                        creator, "", None, "",
                        "https://archive.org/details/" + ident, ident,
                        info=(r.get("date") or "")[:10]))
    return out


IA_FORMATS = ("VBR MP3", "MP3", "128Kbps MP3", "64Kbps MP3", "Ogg Vorbis",
              "Flac", "Apple Lossless Audio", "WAVE")


def ia_expand(it):
    ident = it["key"]
    d = http_json("https://archive.org/metadata/" + urllib.parse.quote(ident))
    md = d.get("metadata", {})
    creator = md.get("creator", it["artist"])
    if isinstance(creator, list):
        creator = ", ".join(creator)
    files = d.get("files", [])
    present = {f.get("format") for f in files}
    fmt = next((f for f in IA_FORMATS if f in present), None)
    if fmt is None:
        return []

    def order(f):
        tr = re.match(r"\d+", str(f.get("track", "")))
        return (int(tr.group(0)) if tr else 9999, f["name"])

    out = []
    for f in sorted((f for f in files if f.get("format") == fmt), key=order):
        title = f.get("title") or os.path.splitext(
            os.path.basename(f["name"]))[0]
        url = "https://archive.org/download/%s/%s" % (
            urllib.parse.quote(ident), urllib.parse.quote(f["name"]))
        out.append(item("Internet Archive", "track", title,
                        f.get("creator") or creator,
                        md.get("title", it["title"]),
                        parse_time(f.get("length")), url, it["page"]))
    return out


RADIO_API = "https://all.api.radio-browser.info/json/stations/search?"


def search_radio(q):
    seen, out = set(), []
    for field in ("name", "tag"):
        params = urllib.parse.urlencode({
            field: q, "limit": 60, "hidebroken": "true",
            "order": "clickcount", "reverse": "true"})
        try:
            rows = http_json(RADIO_API + params, headers={"User-Agent":
                                                          "tkmusic/1.0"})
        except Exception:
            if out:
                break
            raise
        for r in rows:
            if r["stationuuid"] in seen:
                continue
            seen.add(r["stationuuid"])
            info = " ".join(x for x in (
                "%dk" % r["bitrate"] if r.get("bitrate") else "",
                r.get("codec", "")) if x)
            tags = ", ".join(r.get("tags", "").split(",")[:4])
            out.append(item("Radio", "station", r["name"].strip(), tags,
                            r.get("country", ""), None,
                            r.get("url_resolved") or r["url"],
                            r.get("homepage", ""), r["stationuuid"], info))
    return out


class Spotify:
    token = None
    expires = 0

    @staticmethod
    def creds(cfg):
        cid = os.environ.get("SPOTIFY_CLIENT_ID") or cfg.get(
            "spotify_client_id")
        sec = os.environ.get("SPOTIFY_CLIENT_SECRET") or cfg.get(
            "spotify_client_secret")
        return (cid, sec) if cid and sec else None

    @classmethod
    def get(cls, cfg, path):
        if cls.token is None or time.time() > cls.expires - 60:
            cr = cls.creds(cfg)
            if not cr:
                raise RuntimeError(
                    "Spotify needs an API key: create an app at "
                    "developer.spotify.com and put spotify_client_id and "
                    "spotify_client_secret in ~/.tkmusic.json")
            auth = base64.b64encode(("%s:%s" % cr).encode()).decode()
            d = http_json("https://accounts.spotify.com/api/token",
                          "grant_type=client_credentials",
                          {"Authorization": "Basic " + auth,
                           "Content-Type":
                           "application/x-www-form-urlencoded"})
            cls.token = d["access_token"]
            cls.expires = time.time() + d.get("expires_in", 3600)
        return http_json("https://api.spotify.com/v1/" + path,
                         headers={"Authorization": "Bearer " + cls.token})


def sp_track(t, album=None):
    album = album or t.get("album", {}).get("name", "")
    return item("Spotify", "track", t["name"],
                ", ".join(a["name"] for a in t.get("artists", [])), album,
                t.get("duration_ms", 0) / 1000 or None, "",
                t.get("external_urls", {}).get("spotify", ""), t["uri"])


def search_spotify(q, cfg):
    d = Spotify.get(cfg, "search?" + urllib.parse.urlencode(
        {"q": q, "type": "track,album", "limit": 20}))
    out = [sp_track(t) for t in d.get("tracks", {}).get("items", []) if t]
    for a in d.get("albums", {}).get("items", []):
        if a:
            out.append(item("Spotify", "album", a["name"],
                            ", ".join(x["name"] for x in a["artists"]),
                            a["name"], None, "",
                            a.get("external_urls", {}).get("spotify", ""),
                            a["id"], info=(a.get("release_date") or "")[:4]))
    return out


def sp_expand(it, cfg):
    d = Spotify.get(cfg, "albums/%s/tracks?limit=50" % it["key"])
    return [sp_track(t, it["title"]) for t in d.get("items", []) if t]


def url_items(q):
    """Something typed into the search box that looks like a URL."""
    if "bandcamp.com" in q:
        kind = "album" if "/album/" in q else (
            "track" if "/track/" in q else "artist")
        return bc_expand(item("Bandcamp", kind, q, "", "", None, "", q))
    m = re.match(r"https?://archive\.org/details/([^/?#]+)", q)
    if m:
        return ia_expand(item("Internet Archive", "item", m.group(1), "", "",
                              None, "", q, m.group(1)))
    return [item("URL", "track", q, "", "", None, q, q)]


def needs_ytdlp(url):
    host = urllib.parse.urlparse(url).netloc.lower()
    return any(h in host for h in ("youtube.com", "youtu.be", "soundcloud.com"))


def resolve(it, cfg):
    """Return (stream url, fetch-with-yt-dlp?) for a playable item."""
    src = it["src"]
    if src in ("YouTube Music", "YouTube", "SoundCloud"):
        return it["url"], True
    if src == "Bandcamp":
        if it["page"]:
            try:
                d, _ = bc_tralbum(it["page"])
                if d:
                    for t in d.get("trackinfo", []):
                        f = (t.get("file") or {}).get("mp3-128")
                        if f and (len(d["trackinfo"]) == 1 or
                                  t.get("title") == it["title"]):
                            return f, False
            except Exception:
                pass
        if it["url"]:
            return it["url"], False
        raise RuntimeError("Bandcamp does not stream this track")
    if src == "Spotify":
        hits = search_ytm("%s %s" % (it["artist"], it["title"]))
        if not hits:
            raise RuntimeError("no YouTube Music match for this track")
        return hits[0]["url"], True
    return it["url"], needs_ytdlp(it["url"])


