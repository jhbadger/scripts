    def status(self, text):
        self.status_label.config(text=text)

    # ------------------------------------------------------------ threads

    def bg(self, work, done, fail=None):
        """Run work() in a thread; done(result) / fail(exc) on the UI."""
        def run():
            try:
                r = work()
            except Exception as e:      # noqa: BLE001 - reported to the user
                # bind e now: Python deletes it when the except block ends
                self.ui_q.put(lambda e=e: (fail or self.bg_error)(e))
            else:
                self.ui_q.put(lambda: done(r))
        threading.Thread(target=run, daemon=True).start()

    def bg_error(self, e):
        self.status("Error: %s" % e)

    def bg_find_tools(self):
        TOOLS.find_ytdlp()
        v = TOOLS.ytdlp_version
        if not v:
            self.ui_q.put(lambda: self.status(
                "yt-dlp not found: YouTube and SoundCloud will not work"))

    def poll(self):
        # reschedule first, so an error in a callback cannot stop polling
        self.root.after(POLL_MS, self.poll)
        try:
            while True:
                self.ui_q.get_nowait()()
        except queue.Empty:
            pass
        try:
            while True:
                gen, name, data = self.player.events.get_nowait()
                if gen == self.player.gen:
                    self.on_property(name, data)
        except queue.Empty:
            pass
        if self.current is not None:
            rc = self.player.finished()
            if rc is not None:
                self.on_track_end(rc)

    # ------------------------------------------------------------ search

    def do_search(self):
        text = self.search_var.get().strip()
        if not text:
            return
        self.search_id += 1
        sid = self.search_id
        self.history = []
        self.nb.select(0)
        if re.match(r"https?://", text):
            self.pending = set()
            self.show_items("URL", [])
            self.status("Opening %s ..." % text)
            self.bg(lambda: url_items(text),
                    lambda r: self.search_done(sid, "URL", r, 1))
            return
        field = self.field_var.get().lower()
        q = Query(text, None if field not in FIELDS else field)
        if not q.any and not q.f:
            return
        name = self.source_var.get()
        cands = [(n, f) for n, f in SOURCES if f is not None and
                 (n == name or name == "All" and
                  (n != "Spotify" or Spotify.creds(self.cfg)))]
        srcs = [(n, f) for n, f in cands
                if all(k in FIELD_SUPPORT[n] for k in q.f)]
        skipped = [n for n, _ in cands if n not in dict(srcs)]
        self.show_items(str(q), [])
        self.pending = {n for n, _ in srcs}
        self.skip_note = ("%s can't search by %s" % (
            ", ".join(skipped), " and ".join(sorted(q.f)))
            if skipped else "")
        if not srcs:
            self.status(self.skip_note)
            return
        self.status("Searching %s ..." % ", ".join(sorted(self.pending)))
        cfg = self.cfg
        for n, f in srcs:
            self.bg(lambda n=n, f=f: run_search(n, f, q, cfg),
                    lambda r, n=n: self.search_done(sid, n, r, len(srcs)),
                    lambda e, n=n: self.search_failed(sid, n, e))

    def search_done(self, sid, name, results, nsrc):
        if sid != self.search_id:
            return
        self.pending.discard(name)
        if nsrc == 1:
            self.view_items = []
        self.view_items.extend(results)
        self.show_items(self.view_title, self.view_items)
        self.search_status()

    def search_failed(self, sid, name, e):
        if sid != self.search_id:
            return
        self.pending.discard(name)
        self.search_status("%s: %s" % (name, e))

    def search_status(self, extra=""):
        if self.skip_note:
            extra = (extra + "  -  " if extra else "") + self.skip_note
        n = len(self.view_items)
        if self.pending:
            msg = "%d results so far, waiting for %s" % (
                n, ", ".join(sorted(self.pending)))
        else:
            msg = "%d results" % n
        self.status(msg + ("  -  " + extra if extra else ""))

    def show_items(self, title, items):
        self.view_title = title
        self.view_items = items
        self.view_label.config(text=title)
        self.back_btn.config(state="normal" if self.history else "disabled")
        self.fill(self.tree, items, ("title", "artist", "album", "len",
                                     "kind", "src"))

    def fill(self, tree, items, cols):
        sel_first = tree.selection()[:1]
        tree.delete(*tree.get_children())
        for i, it in enumerate(items):
            vals = []
            for c in cols:
                if c == "len":
                    vals.append(fmt_time(it["dur"]) or it.get("info", ""))
                elif c == "kind":
                    vals.append(KIND_NAMES.get(it["kind"], it["kind"]))
                elif c == "src":
                    vals.append(it["src"])
                elif c == "title" and it["kind"] not in PLAYABLE:
                    vals.append(it["title"] + "  ▸")
                else:
                    vals.append(it.get(c, ""))
            iid = "%s-%d" % (str(tree), i)
            dead = it["kind"] == "track" and it.get("info") == \
                "not streamable"
            tree.insert("", "end", iid=iid, values=vals,
                        tags=("dead",) if dead else ())
            self.items[iid] = it
        kids = tree.get_children()
        if kids:
            first = sel_first[0] if sel_first and sel_first[0] in kids \
                else kids[0]
            tree.selection_set(first)
            tree.focus(first)

    def selected(self, tree):
        return [self.items[i] for i in tree.selection() if i in self.items]

    def tree_items(self, tree):
        return [self.items[i] for i in tree.get_children()]

    # ------------------------------------------------------------ actions

    def activate(self, tree):
        sel = self.selected(tree)
        if not sel:
            return "break"
        it = sel[0]
        if tree is self.qtree:
            self.play_index(self.queue.index(it) if it in self.queue else 0)
        elif it["kind"] in PLAYABLE:
            if it["kind"] == "station":
                self.set_queue([it], 0)
            else:
                items = [x for x in self.tree_items(tree)
                         if x["kind"] == "track"]
                self.set_queue(items, items.index(it))
        else:
            self.open_item(it)
        return "break"

    def open_item(self, it, then=None):
        self.nb.select(0)
        self.status("Opening %s ..." % it["title"])
        cfg = self.cfg

        def work():
            if it["src"] == "Bandcamp":
                return bc_expand(it)
            if it["src"] == "Internet Archive":
                return ia_expand(it)
            if it["src"] == "Spotify":
                return sp_expand(it, cfg)
            if it["src"] == "YouTube Music":
                return ytm_album_tracks(it)
            return []

        def done(items):
            if not items:
                self.status("Nothing playable in %s" % it["title"])
                return
            self.search_id += 1
            self.pending = set()
            self.history.append((self.view_title, self.view_items))
            title = it["title"]
            if it["artist"] and it["artist"] != it["title"]:
                title += " - " + it["artist"]
            self.show_items(title, items)
            self.status("%d items" % len(items))
            if then:
                then(items)
        self.bg(work, done)

    def go_back(self):
        if self.history:
            title, items = self.history.pop()
            self.search_id += 1
            self.pending = set()
            self.show_items(title, items)
        return "break"

    def play_all(self):
        items = [x for x in self.view_items if x["kind"] == "track"]
        if items:
            self.set_queue(items, 0)

    def expand_for_queue(self, it, fn):
        """Albums etc. are opened, then fn(tracks) is called."""
        if it["kind"] in PLAYABLE:
            fn([it])
        else:
            self.open_item(it, lambda items: fn(
                [x for x in items if x["kind"] == "track"]))

    def add_queue(self, tree):
        for it in self.selected(tree):
            self.expand_for_queue(it, self.queue_extend)
        return "break"

    def queue_extend(self, items):
        self.queue.extend(items)
        self.refresh_queue()
        self.status("Added %d to the queue" % len(items))
        if self.current is None and items and self.qpos < 0:
            self.play_index(len(self.queue) - len(items))

    def play_next(self, tree):
        for it in reversed(self.selected(tree)):
            def ins(items):
                pos = self.qpos + 1
                self.queue[pos:pos] = items
                self.refresh_queue()
                self.status("%d will play next" % len(items))
            self.expand_for_queue(it, ins)
        return "break"

    def set_queue(self, items, pos):
        self.queue = list(items)
        self.play_index(pos)

    def clear_queue(self):
        self.queue = [self.current] if self.current else []
        self.qpos = 0 if self.current else -1
        self.refresh_queue()

    def queue_remove(self):
        sel = set(self.qtree.selection())
        if not sel:
            return "break"
        keep = []
        for i, iid in enumerate(self.qtree.get_children()):
            if iid in sel:
                if i < self.qpos:
                    self.qpos -= 1
                elif i == self.qpos:
                    self.qpos -= 1     # current keeps playing, not in queue
            else:
                keep.append(self.queue[i])
        self.queue = keep
        self.refresh_queue()
        return "break"

    def refresh_queue(self):
        self.fill(self.qtree, self.queue, ("mark", "title", "artist"))
        kids = self.qtree.get_children()
        if 0 <= self.qpos < len(kids):
            self.qtree.set(kids[self.qpos], "mark", "▶")
            self.qtree.item(kids[self.qpos], tags=("now",))
            self.qtree.see(kids[self.qpos])

    # ------------------------------------------------------------ favourites

    def favourites(self):
        return self.cfg.setdefault("favourites", [])

    def fav_key(self, it):
        return (it["src"], it["kind"], it["page"] or it["url"], it["title"])

    def toggle_favourite(self, tree):
        favs = self.favourites()
        keys = [self.fav_key(f) for f in favs]
        for it in self.selected(tree):
            k = self.fav_key(it)
            if k in keys:
                del favs[keys.index(k)]
                keys.remove(k)
                self.status("Removed %s from favourites" % it["title"])
            else:
                favs.append(dict(it))
                keys.append(k)
                self.status("Added %s to favourites" % it["title"])
        self.refresh_favourites()
        self.save_config()
        return "break"

    def refresh_favourites(self):
        self.fill(self.fav_tree, self.favourites(),
                  ("title", "artist", "kind", "src"))

    # ------------------------------------------------------------ menu

    def popup(self, tree, event):
        iid = tree.identify_row(event.y)
        if not iid:
            return "break"
        if iid not in tree.selection():
            tree.selection_set(iid)
        tree.focus(iid)
        it = self.items[iid]
        m = self.menu
        m.delete(0, "end")
        if tree is self.qtree:
            m.add_command(label="Play", command=lambda: self.activate(tree))
            m.add_command(label="Remove from queue",
                          command=self.queue_remove)
        else:
            if it["kind"] in PLAYABLE:
                m.add_command(label="Play",
                              command=lambda: self.activate(tree))
            else:
                m.add_command(label="Open",
                              command=lambda: self.open_item(it))
                m.add_command(label="Play all", command=lambda: self.
                              expand_for_queue(it, lambda x:
                                               self.set_queue(x, 0)))
            m.add_command(label="Play next   (N)",
                          command=lambda: self.play_next(tree))
            m.add_command(label="Add to queue   (A)",
                          command=lambda: self.add_queue(tree))
        fav = self.fav_key(it) in [self.fav_key(f) for f in self.favourites()]
        m.add_command(label=("Remove from" if fav else "Add to") +
                      " favourites   (F)",
                      command=lambda: self.toggle_favourite(tree))
        m.add_separator()
        if it["page"]:
            m.add_command(label="Open web page",
                          command=lambda: webbrowser.open(it["page"]))
        if it["src"] == "Spotify" and it["key"].startswith("spotify:"):
            m.add_command(label="Open in Spotify app",
                          command=lambda: subprocess.Popen(
                              ["open", it["key"]]))
        m.add_command(label="Copy link", command=lambda: self.copy(
            it["page"] or it["url"]))
        m.tk_popup(event.x_root, event.y_root)
        return "break"

    def copy(self, text):
        self.root.clipboard_clear()
        self.root.clipboard_append(text)
        self.status("Copied %s" % text)

    # ------------------------------------------------------------ playback

    def play_index(self, i):
        if not (0 <= i < len(self.queue)):
            return
        if not TOOLS.mpv:
            self.status("Cannot play: mpv is not installed")
            return
        self.qpos = i
        it = self.queue[i]
        self.refresh_queue()
        self.player.stop()
        self.current = None
        self.state = {}
        self.paused = False
        self.pause_btn.config(text="❚❚")
        self.np_title.config(text=it["title"])
        self.np_sub.config(text=self.sub_text(it, "loading ..."))
        self.pos.set(0)
        self.pos_label.config(text="")
        self.dur_label.config(text=fmt_time(it["dur"]))
        self.root.title("%s - tkmusic" % it["title"])
        self.play_token += 1
        token = self.play_token
        cfg = self.cfg

        def done(r):
            if token != self.play_token:
                return
            url, via = r
            self.current = it
            self.started = time.time()
            self.player.play(url, via, int(self.volume.get()))
            self.np_sub.config(text=self.sub_text(it, "buffering ..."))
            self.status("Playing from %s" % it["src"] +
                        (" (matched on YouTube Music)"
                         if it["src"] == "Spotify" else ""))

        def fail(e):
            if token != self.play_token:
                return
            self.status("Cannot play %s: %s" % (it["title"], e))
            self.np_sub.config(text=self.sub_text(it, "unavailable"))
            self.failures += 1
            if self.failures < 3:
                self.root.after(800, self.next)
        self.bg(lambda: resolve(it, cfg), done, fail)

    def sub_text(self, it, extra=""):
        parts = [x for x in (it["artist"], it["album"]) if x]
        if it["kind"] == "station":
            parts = [x for x in (it.get("info"), it["album"]) if x]
        s = "  —  ".join(parts)
        if extra:
            s = (s + "   " if s else "") + "[" + extra + "]"
        return s

    def on_property(self, name, data):
        self.state[name] = data
        it = self.current
        if it is None:
            return
        if name == "time-pos" and data is not None:
            if self.failures or "[" in self.np_sub.cget("text") and \
                    it["kind"] != "station":
                self.np_sub.config(text=self.sub_text(it))
            self.failures = 0
            self.pos_label.config(text=fmt_time(data))
            dur = self.duration()
            if dur and not self.seeking:
                self.scale.config(to=dur)
                self.pos.set(min(data, dur))
        elif name == "duration":
            self.dur_label.config(text=fmt_time(self.duration()))
        elif name == "pause":
            self.paused = bool(data)
            self.pause_btn.config(text="▶" if self.paused
                                  else "❚❚")
        elif name in ("metadata", "media-title"):
            md = self.state.get("metadata") or {}
            icy = md.get("icy-title")
            if it["kind"] == "station" and icy:
                self.np_sub.config(text="Now: " + icy + "   —  " +
                                   self.sub_text(it))

    def duration(self):
        it = self.current
        if it is None or it["kind"] == "station":
            return None
        d = self.state.get("duration")
        return d if d and d > 0 else it["dur"]

    def on_track_end(self, rc):
        it = self.current
        played = time.time() - self.started
        self.current = None
        failed = rc != 0 or (played < 2 and not self.state.get("time-pos"))
        if failed:
            errs = self.player.errors
            msg = errs[-1] if errs else "exit status %s" % rc
            msg = re.sub(r"^ERROR: (\[\w+\] [\w-]+: )?", "", msg)
            self.status("Cannot play %s: %s" % (it["title"], msg[:200]))
            self.np_sub.config(text=self.sub_text(it, "failed"))
            self.failures += 1
            if self.failures >= 3:
                return
        if it["kind"] == "station":
            if not failed:
                self.np_sub.config(text=self.sub_text(it, "stream ended"))
            return
        if self.qpos + 1 < len(self.queue):
            if failed:
                self.root.after(1500, lambda: self.current is None and
                                self.play_index(self.qpos + 1))
            else:
                self.play_index(self.qpos + 1)
        elif failed:
            self.pause_btn.config(text="\u25b6")
        else:
            self.np_sub.config(text=self.sub_text(it, "finished"))
            self.pause_btn.config(text="▶")
            self.root.title("tkmusic")

    def toggle_pause(self):
        if self.current is None:
            if self.queue:
                self.play_index(max(self.qpos, 0))
            return
        self.player.command("cycle", "pause")

    def next(self):
        if self.qpos + 1 < len(self.queue):
            self.play_index(self.qpos + 1)

    def prev(self):
        if self.current is not None and (self.state.get("time-pos") or 0) > 4:
            self.player.command("seek", 0, "absolute")
        elif self.qpos > 0:
            self.play_index(self.qpos - 1)

    def stop(self):
        self.play_token += 1
        self.player.stop()
        self.current = None
        self.np_sub.config(text="stopped")
        self.pause_btn.config(text="▶")
        self.pos.set(0)
        self.pos_label.config(text="")
        self.root.title("tkmusic")

    def seek_press(self, event):
        self.seeking = True

    def seek_release(self, event):
        self.seeking = False
        if self.current is not None and self.duration():
            self.player.command("seek", self.pos.get(), "absolute")

    def set_volume(self, _=None):
        self.player.command("set_property", "volume", int(self.volume.get()))

    def open_files(self, paths):
        items = [item("File", "track", os.path.basename(p), "",
                      os.path.dirname(os.path.abspath(p)), None,
                      os.path.abspath(p), "") for p in paths]
        if not items:
            return
        if self.current is None:
            self.set_queue(items, 0)
        else:
            self.queue_extend(items)

    def quit(self):
        self.play_token += 1
        self.player.stop()
        self.save_config()
        self.root.destroy()


# ------------------------------------------------ icon / macOS app bundle

ICON_NAME = "tkmusic"
ICON_DOC_EXTS = ["mp3", "m4a", "aac", "flac", "ogg", "opus", "wav", "aif",
                 "aiff", "m3u", "m3u8", "pls"]
ICON_DOC_NAME = "Audio file or playlist"
ICON_DOC_ROLE = "Viewer"
ICON_TOP = (236, 64, 122)
ICON_BOTTOM = (94, 53, 177)
ICON_WHITE = (255, 255, 255)
ICON_HEADS = ((0.33, 0.71), (0.66, 0.64))      # note head centres


def icon_beam_y(x):
    return 0.27 - (x - 0.405) * 0.07 / 0.37


def icon_art(x, y):
    """A pair of beamed eighth notes on a pink-to-purple tile."""
    a = math.radians(-22)
    for cx, cy in ICON_HEADS:
        dx, dy = x - cx, y - cy
        u = dx * math.cos(a) - dy * math.sin(a)
        v = dx * math.sin(a) + dy * math.cos(a)
        if (u / 0.115) ** 2 + (v / 0.082) ** 2 <= 1:
            return ICON_WHITE
    by = icon_beam_y(x)
    for (cx, cy) in ICON_HEADS:                  # stems
        if cx + 0.075 <= x <= cx + 0.107 and by <= y <= cy:
            return ICON_WHITE
    if 0.405 <= x <= 0.767 and by <= y <= by + 0.095:      # beam
        return ICON_WHITE
    t = min(max(y, 0.0), 1.0)
    return tuple(int(ICON_TOP[i] + (ICON_BOTTOM[i] - ICON_TOP[i]) * t)
                 for i in range(3))


def icon_rr(x, y, x0, y0, x1, y1, r):
    """True inside the rounded rectangle (x0,y0)-(x1,y1) with corner radius r."""
    cx = min(max(x, x0 + r), x1 - r)
    cy = min(max(y, y0 + r), y1 - r)
    return math.hypot(x - cx, y - cy) <= r


def icon_seg(x, y, x0, y0, x1, y1):
    """Distance from (x, y) to the segment (x0,y0)-(x1,y1)."""
    dx, dy = x1 - x0, y1 - y0
    t = max(0.0, min(1.0, ((x - x0) * dx + (y - y0) * dy) /
                     (dx * dx + dy * dy)))
    return math.hypot(x - x0 - t * dx, y - y0 - t * dy)


def icon_sample(x, y):
    """RGB of the icon at (x, y) in the unit square, or None (transparent)."""
    if not icon_rr(x, y, 0.0, 0.0, 1.0, 1.0, 0.2):
        return None
    return icon_art(x, y)


def icon_render_png(size):
    n = 4 if size <= 256 else 2
    rows = []
    for py in range(size):
        row = bytearray([0])                     # PNG filter type 0
        for px in range(size):
            ra = ga = ba = aa = 0
            for sy in range(n):
                for sx in range(n):
                    c = icon_sample((px + (sx + 0.5) / n) / size,
                                    (py + (sy + 0.5) / n) / size)
                    if c:
                        ra += c[0]
                        ga += c[1]
                        ba += c[2]
                        aa += 1
            if aa:
                row += bytes((ra // aa, ga // aa, ba // aa,
                              255 * aa // (n * n)))
            else:
                row += b"\0\0\0\0"
        rows.append(bytes(row))

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
    return (b"\x89PNG\r\n\x1a\n" +
            chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 6, 0, 0, 0)) +
            chunk(b"IDAT", zlib.compress(b"".join(rows), 9)) +
            chunk(b"IEND", b""))


# ICNS entry types holding PNG data, with the pixel size of each
ICON_ICNS_TYPES = [(b"icp4", 16), (b"icp5", 32), (b"ic11", 32), (b"ic12", 64),
                   (b"ic07", 128), (b"ic13", 256), (b"ic08", 256),
                   (b"ic14", 512), (b"ic09", 512)]


def icon_make_icns():
    """An .icns file written directly (no iconutil needed)."""
    pngs = {}
    body = b""
    for tag, size in ICON_ICNS_TYPES:
        if size not in pngs:
            pngs[size] = icon_render_png(size)
        body += tag + struct.pack(">I", len(pngs[size]) + 8) + pngs[size]
    return b"icns" + struct.pack(">I", len(body) + 8) + body


def icon_build_app(dest):
    """Build a macOS <name>.app bundle (with icon) in dest."""
    app = os.path.join(dest, ICON_NAME + ".app")
    if os.path.exists(app):
        shutil.rmtree(app)
    macos = os.path.join(app, "Contents", "MacOS")
    res = os.path.join(app, "Contents", "Resources")
    os.makedirs(macos)
    os.makedirs(res)
    shutil.copy(os.path.abspath(__file__), os.path.join(res, ICON_NAME + ".py"))
    launcher = os.path.join(macos, ICON_NAME)
    with open(launcher, "w") as fh:
        fh.write('#!/bin/sh\nexec "%s" "$(dirname "$0")/../Resources/%s.py" '
                 '"$@"\n' % (sys.executable, ICON_NAME))
    os.chmod(launcher, 0o755)
    with open(os.path.join(res, ICON_NAME + ".icns"), "wb") as fh:
        fh.write(icon_make_icns())
    info = {
        "CFBundleName": ICON_NAME,
        "CFBundleDisplayName": ICON_NAME,
        "CFBundleIdentifier": "org.badgerjh." + ICON_NAME,
        "CFBundleExecutable": ICON_NAME,
        "CFBundleIconFile": ICON_NAME,
        "CFBundlePackageType": "APPL",
        "CFBundleShortVersionString": "1.0",
        "NSHighResolutionCapable": True,
    }
    if ICON_DOC_EXTS:
        info["CFBundleDocumentTypes"] = [{
            "CFBundleTypeName": ICON_DOC_NAME,
            "CFBundleTypeRole": ICON_DOC_ROLE,
            "CFBundleTypeExtensions": ICON_DOC_EXTS}]
    with open(os.path.join(app, "Contents", "Info.plist"), "wb") as fh:
        plistlib.dump(info, fh)
    return app


def icon_args(args):
    """Handle --build-app [DIR] and --icon-png SIZE [OUT]; True if handled."""
    if args[:1] == ["--build-app"]:
        print(icon_build_app(args[1] if len(args) > 1 else
                             os.path.dirname(os.path.abspath(__file__))))
        return True
    if args[:1] == ["--icon-png"] and len(args) >= 2:
        with open(args[2] if len(args) > 2 else ICON_NAME + ".png", "wb") as fh:
            fh.write(icon_render_png(int(args[1])))
        return True
    return False


