# ---------------------------------------------------------------- player

class Player:
    """One mpv process per track, controlled through its JSON IPC socket."""

    def __init__(self):
        self.events = queue.Queue()
        self.gen = 0
        self.procs = []
        self.mpv = None
        self.sock = None
        self.lock = threading.Lock()
        self.errors = []

    def play(self, url, via_ytdlp, volume, start=0):
        self.stop()
        self.gen += 1
        gen = self.gen
        path = "/tmp/tkmusic-%d-%d.sock" % (os.getpid(), gen)
        try:
            os.unlink(path)
        except OSError:
            pass
        args = [TOOLS.mpv, "--no-video", "--force-window=no",
                "--input-terminal=no", "--term-osd=no",
                "--msg-level=all=error", "--volume=%d" % volume,
                "--input-ipc-server=" + path, "--cache=yes",
                "--demuxer-max-bytes=256MiB", "--demuxer-max-back-bytes=256MiB",
                "--script-opts=ytdl_hook-ytdl_path=" + TOOLS.ytdlp]
        if start:
            args.append("--start=%d" % start)
        self.errors = []
        if via_ytdlp:
            y = subprocess.Popen(
                [TOOLS.ytdlp, "--no-update", "-q", "--no-warnings",
                 "-f", "bestaudio/best", "-o", "-", url],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                stdin=subprocess.DEVNULL)
            m = subprocess.Popen(args + ["-"], stdin=y.stdout,
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.PIPE)
            y.stdout.close()
            self.procs = [m, y]
            self._collect(y.stderr)
        else:
            m = subprocess.Popen(args + ["--", url], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.PIPE)
            self.procs = [m]
        self.mpv = m
        self._collect(m.stderr)
        threading.Thread(target=self._reader, args=(gen, path, m),
                         daemon=True).start()

    def _collect(self, stream):
        errors = self.errors

        def run():
            for line in stream:
                line = line.decode("utf-8", "replace").strip()
                if line:
                    errors.append(line)
                    del errors[:-5]
        threading.Thread(target=run, daemon=True).start()

    def _reader(self, gen, path, proc):
        s = socket.socket(socket.AF_UNIX)
        for _ in range(200):
            if gen != self.gen or proc.poll() is not None:
                return
            try:
                s.connect(path)
                break
            except OSError:
                time.sleep(0.05)
        else:
            return
        with self.lock:
            if gen != self.gen:
                s.close()
                return
            self.sock = s
        for i, p in enumerate(("time-pos", "duration", "pause", "metadata",
                               "media-title", "seekable",
                               "partially-seekable")):
            self.command("observe_property", i + 1, p)
        f = s.makefile("rb")
        try:
            for line in f:
                if gen != self.gen:
                    break
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if ev.get("event") == "property-change":
                    self.events.put((gen, ev["name"], ev.get("data")))
        except OSError:
            pass
        finally:
            try:
                os.unlink(path)
            except OSError:
                pass

    def command(self, *args):
        with self.lock:
            if self.sock is None:
                return
            try:
                self.sock.sendall((json.dumps({"command": list(args)}) +
                                   "\n").encode())
            except OSError:
                pass

    def finished(self):
        """None while playing, else the mpv exit code."""
        if self.mpv is None:
            return None
        return self.mpv.poll()

    def stop(self):
        self.gen += 1
        with self.lock:
            if self.sock is not None:
                try:
                    self.sock.close()
                except OSError:
                    pass
            self.sock = None
        for p in self.procs:
            if p.poll() is None:
                p.terminate()
        for p in self.procs:
            try:
                p.wait(timeout=2)
            except subprocess.TimeoutExpired:
                p.kill()
        self.procs = []
        self.mpv = None


