def bc_tralbum(page):
    text = http(page)
    m = re.search(r'data-tralbum="([^"]+)"', text)
    if not m:
        return None, text
    return json.loads(html.unescape(m.group(1))), text


def bc_expand(it):
    if it["kind"] == "artist":
        # an artist's /music page is a grid of albums, unless the artist
        # has a single release, in which case it is that album's page
        page = it["page"].rstrip("/")
        if not page.endswith("/music"):
            page += "/music"
        d, text = bc_tralbum(page)
        out = bc_discography(text, it)
        if out or d is None:
            return out
        return bc_tracks(d, page)
    d, text = bc_tralbum(it["page"])
    return bc_tracks(d, it["page"]) if d else []


def bc_tracks(d, page):
    root = re.match(r"https?://[^/]+", page).group(0)
    artist = d.get("artist", "")
    album = (d.get("current") or {}).get("title", "")
    if d.get("item_type") == "track":
        album = ""
    out = []
    for t in d.get("trackinfo", []):
        url = (t.get("file") or {}).get("mp3-128", "")
        link = t.get("title_link")
        tpage = root + link if link else page
        it = item("Bandcamp", "track", t.get("title"),
                  t.get("artist") or artist, album, t.get("duration"),
                  url, tpage, info="" if url else "not streamable")
        out.append(it)
    return out


def bc_discography(text, it):
    root = re.match(r"https?://[^/]+", it["page"]).group(0)
    out, seen = [], set()
    for m in re.finditer(r'<a href="((?:https?://[^"]+)?/(album|track)/[^"]+)"'
                         r'.*?<p class="title">\s*(.*?)\s*(?:<br|</p>)',
                         text, re.S):
        href, kind, title = m.groups()
        url = href if href.startswith("http") else root + href
        if url in seen:
            continue
        seen.add(url)
        title = html.unescape(re.sub(r"<[^>]+>", "", title)).strip()
        out.append(item("Bandcamp", "album" if kind == "album" else "track",
                        title, it["artist"], title if kind == "album" else "",
                        None, "", url))
    m = re.search(r'data-client-items="([^"]+)"', text)
    if m:
        for e in json.loads(html.unescape(m.group(1))):
            url = root + e.get("page_url", "")
            if url in seen:
                continue
            seen.add(url)
            kind = "album" if e.get("type") == "album" else "track"
            out.append(item("Bandcamp", kind, e.get("title"),
                            e.get("artist") or it["artist"],
                            e.get("title") if kind == "album" else "",
                            None, "", url))
    return out


def search_ia(q, cfg):
    if q.f:
        # fielded: creator = artist, title = album, subject = genre
        terms = ["(%s)" % q.any] if q.any else []
        for field, ia in (("artist", "creator"), ("album", "title"),
                          ("genre", "subject")):
            if field in q.f:
                terms.append("%s:(%s)" % (ia, q.f[field]))
        tries = ((" AND ".join(terms), [("sort[]", "downloads desc")]),)
    else:
        # matches in title or creator, most downloaded first; failing
        # that, anywhere in the description, most relevant first
        tries = (("(title:(%s) OR creator:(%s))" % (q.any, q.any),
                  [("sort[]", "downloads desc")]), ("(%s)" % q.any, []))
    docs = []
    for query, sort in tries:
        params = urllib.parse.urlencode([
            ("q", query + " AND mediatype:(audio OR etree)"),
            ("fl[]", "identifier"), ("fl[]", "title"), ("fl[]", "creator"),
            ("fl[]", "date"), ("rows", "40"), ("output", "json")] + sort)
        d = http_json("https://archive.org/advancedsearch.php?" + params)
        docs = d.get("response", {}).get("docs", [])
        if docs:
            break
    out = []
    for r in docs:
        creator = r.get("creator", "")
        if isinstance(creator, list):
            creator = ", ".join(creator)
        ident = r["identifier"]
        out.append(item("Internet Archive", "item", r.get("title", ident),
                        creator, r.get("title", ident), None, "",
                        "https://archive.org/details/" + ident, ident,
                        info=(r.get("date") or "")[:10]))
    return out


IA_FORMATS = ("VBR MP3", "MP3", "128Kbps MP3", "64Kbps MP3", "Ogg Vorbis",
              "Flac", "Apple Lossless Audio", "WAVE")


def ia_expand(it):
    ident = it["key"]
    d = http_json("https://archive.org/metadata/" + urllib.parse.quote(ident))
    md = d.get("metadata", {})
    creator = md.get("creator", it["artist"])
    if isinstance(creator, list):
        creator = ", ".join(creator)
    files = d.get("files", [])
    present = {f.get("format") for f in files}
    fmt = next((f for f in IA_FORMATS if f in present), None)
    if fmt is None:
        return []

    def order(f):
        tr = re.match(r"\d+", str(f.get("track", "")))
        return (int(tr.group(0)) if tr else 9999, f["name"])

    out = []
    for f in sorted((f for f in files if f.get("format") == fmt), key=order):
        title = f.get("title") or os.path.splitext(
            os.path.basename(f["name"]))[0]
        url = "https://archive.org/download/%s/%s" % (
            urllib.parse.quote(ident), urllib.parse.quote(f["name"]))
        out.append(item("Internet Archive", "track", title,
                        f.get("creator") or creator,
                        md.get("title", it["title"]),
                        parse_time(f.get("length")), url, it["page"]))
    return out


RADIO_API = "https://all.api.radio-browser.info/json/stations/search?"


def search_radio(q, cfg):
    if "genre" in q.f:
        tries = [{"tag": q.f["genre"], "name": q.any} if q.any
                 else {"tag": q.f["genre"]}]
    else:
        tries = [{"name": q.any}, {"tag": q.any}]
    seen, out = set(), []
    for t in tries:
        params = urllib.parse.urlencode(dict(
            t, limit=60, hidebroken="true", order="clickcount",
            reverse="true"))
        try:
            rows = http_json(RADIO_API + params, headers={"User-Agent":
                                                          "tkmusic/1.0"})
        except Exception:
            if out:
                break
            raise
        for r in rows:
            if r["stationuuid"] in seen:
                continue
            seen.add(r["stationuuid"])
            info = " ".join(x for x in (
                "%dk" % r["bitrate"] if r.get("bitrate") else "",
                r.get("codec", "")) if x)
            tags = ", ".join(r.get("tags", "").split(",")[:4])
            out.append(item("Radio", "station", r["name"].strip(), tags,
                            r.get("country", ""), None,
                            r.get("url_resolved") or r["url"],
                            r.get("homepage", ""), r["stationuuid"], info,
                            genre=r.get("tags", "")))
    return out


class Spotify:
    token = None
    expires = 0

    @staticmethod
    def creds(cfg):
        cid = os.environ.get("SPOTIFY_CLIENT_ID") or cfg.get(
            "spotify_client_id")
        sec = os.environ.get("SPOTIFY_CLIENT_SECRET") or cfg.get(
            "spotify_client_secret")
        return (cid, sec) if cid and sec else None

    @classmethod
    def get(cls, cfg, path):
        if cls.token is None or time.time() > cls.expires - 60:
            cr = cls.creds(cfg)
            if not cr:
                raise RuntimeError(
                    "Spotify needs an API key: create an app at "
                    "developer.spotify.com and put spotify_client_id and "
                    "spotify_client_secret in ~/.tkmusic.json")
            auth = base64.b64encode(("%s:%s" % cr).encode()).decode()
            d = http_json("https://accounts.spotify.com/api/token",
                          "grant_type=client_credentials",
                          {"Authorization": "Basic " + auth,
                           "Content-Type":
                           "application/x-www-form-urlencoded"})
            cls.token = d["access_token"]
            cls.expires = time.time() + d.get("expires_in", 3600)
        return http_json("https://api.spotify.com/v1/" + path,
                         headers={"Authorization": "Bearer " + cls.token})


def sp_track(t, album=None):
    album = album or t.get("album", {}).get("name", "")
    return item("Spotify", "track", t["name"],
                ", ".join(a["name"] for a in t.get("artists", [])), album,
                t.get("duration_ms", 0) / 1000 or None, "",
                t.get("external_urls", {}).get("spotify", ""), t["uri"])


def search_spotify(q, cfg):
    text = " ".join([q.any] + ['%s:"%s"' % ("track" if k == "title" else k,
                                            q.f[k])
                               for k in FIELDS if k in q.f]).strip()
    types = "track" if "title" in q.f else "track,album"
    d = Spotify.get(cfg, "search?" + urllib.parse.urlencode(
        {"q": text, "type": types, "limit": 20}))
    out = [sp_track(t) for t in d.get("tracks", {}).get("items", []) if t]
    for a in d.get("albums", {}).get("items", []):
        if a:
            out.append(item("Spotify", "album", a["name"],
                            ", ".join(x["name"] for x in a["artists"]),
                            a["name"], None, "",
                            a.get("external_urls", {}).get("spotify", ""),
                            a["id"], info=(a.get("release_date") or "")[:4]))
    return out


def sp_expand(it, cfg):
    d = Spotify.get(cfg, "albums/%s/tracks?limit=50" % it["key"])
    return [sp_track(t, it["title"]) for t in d.get("items", []) if t]


def url_items(q):
    """Something typed into the search box that looks like a URL."""
    if "bandcamp.com" in q:
        kind = "album" if "/album/" in q else (
            "track" if "/track/" in q else "artist")
        return bc_expand(item("Bandcamp", kind, q, "", "", None, "", q))
    m = re.match(r"https?://archive\.org/details/([^/?#]+)", q)
    if m:
        return ia_expand(item("Internet Archive", "item", m.group(1), "", "",
                              None, "", q, m.group(1)))
    return [item("URL", "track", q, "", "", None, q, q)]


def needs_ytdlp(url):
    host = urllib.parse.urlparse(url).netloc.lower()
    return any(h in host for h in ("youtube.com", "youtu.be", "soundcloud.com"))


def resolve(it, cfg):
    """Return (stream url, fetch-with-yt-dlp?) for a playable item."""
    src = it["src"]
    if src in ("YouTube Music", "YouTube", "SoundCloud"):
        return it["url"], True
    if src == "Bandcamp":
        if it["page"]:
            try:
                d, _ = bc_tralbum(it["page"])
                if d:
                    for t in d.get("trackinfo", []):
                        f = (t.get("file") or {}).get("mp3-128")
                        if f and (len(d["trackinfo"]) == 1 or
                                  t.get("title") == it["title"]):
                            return f, False
            except Exception:
                pass
        if it["url"]:
            return it["url"], False
        raise RuntimeError("Bandcamp does not stream this track")
    if src == "Spotify":
        hits = ytm_songs("%s %s" % (it["artist"], it["title"]))
        if not hits:
            raise RuntimeError("no YouTube Music match for this track")
        return hits[0]["url"], True
    return it["url"], needs_ytdlp(it["url"])


SOURCES = [
    ("All", None),
    ("YouTube Music", search_ytm),
    ("YouTube", search_yt),
    ("SoundCloud", search_sc),
    ("Bandcamp", search_bc),
    ("Internet Archive", search_ia),
    ("Radio", search_radio),
    ("Spotify", search_spotify),
]

# The fields each source can search: "native" ones are searched by the
# source itself, "filter" ones by searching all the words and keeping the
# results whose field matches.
FIELD_SUPPORT = {
    "YouTube Music": {"artist": "filter", "album": "filter",
                      "title": "filter"},
    "YouTube": {"artist": "filter", "title": "filter"},
    "SoundCloud": {"artist": "filter", "title": "filter", "genre": "filter"},
    "Bandcamp": {"artist": "filter", "album": "filter", "title": "filter"},
    "Internet Archive": {"artist": "native", "album": "native",
                         "genre": "native"},
    "Radio": {"genre": "native"},
    "Spotify": {"artist": "native", "album": "native", "title": "native",
                "genre": "native"},
}


def run_search(name, fn, q, cfg):
    results = fn(q, cfg)
    for field, value in q.f.items():
        if FIELD_SUPPORT[name].get(field) == "filter":
            results = [it for it in results if field_match(it, field, value)]
    return results


# ---------------------------------------------------------------- player

class Player:
    """One mpv process per track, controlled through its JSON IPC socket."""

    def __init__(self):
        self.events = queue.Queue()
        self.gen = 0
        self.procs = []
        self.mpv = None
        self.sock = None
        self.lock = threading.Lock()
        self.errors = []

    def play(self, url, via_ytdlp, volume, start=0):
        self.stop()
        self.gen += 1
        gen = self.gen
        path = "/tmp/tkmusic-%d-%d.sock" % (os.getpid(), gen)
        try:
            os.unlink(path)
        except OSError:
            pass
        args = [TOOLS.mpv, "--no-video", "--force-window=no",
                "--input-terminal=no", "--term-osd=no",
                "--msg-level=all=error", "--volume=%d" % volume,
                "--input-ipc-server=" + path, "--cache=yes",
                "--demuxer-max-bytes=256MiB", "--demuxer-max-back-bytes=256MiB",
                "--script-opts=ytdl_hook-ytdl_path=" + TOOLS.ytdlp]
        if start:
            args.append("--start=%d" % start)
        self.errors = []
        if via_ytdlp:
            y = subprocess.Popen(
                [TOOLS.ytdlp, "--no-update", "-q", "--no-warnings",
                 "-f", "bestaudio/best", "-o", "-", url],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                stdin=subprocess.DEVNULL)
            m = subprocess.Popen(args + ["-"], stdin=y.stdout,
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.PIPE)
            y.stdout.close()
            self.procs = [m, y]
            self._collect(y.stderr)
        else:
            m = subprocess.Popen(args + ["--", url], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.PIPE)
            self.procs = [m]
        self.mpv = m
        self._collect(m.stderr)
        threading.Thread(target=self._reader, args=(gen, path, m),
                         daemon=True).start()

    def _collect(self, stream):
        errors = self.errors

        def run():
            for line in stream:
                line = line.decode("utf-8", "replace").strip()
                if line:
                    errors.append(line)
                    del errors[:-5]
        threading.Thread(target=run, daemon=True).start()

    def _reader(self, gen, path, proc):
        s = socket.socket(socket.AF_UNIX)
        for _ in range(200):
            if gen != self.gen or proc.poll() is not None:
                return
            try:
                s.connect(path)
                break
            except OSError:
                time.sleep(0.05)
        else:
            return
        with self.lock:
            if gen != self.gen:
                s.close()
                return
            self.sock = s
        for i, p in enumerate(("time-pos", "duration", "pause", "metadata",
                               "media-title", "seekable",
                               "partially-seekable")):
            self.command("observe_property", i + 1, p)
        f = s.makefile("rb")
        try:
            for line in f:
                if gen != self.gen:
                    break
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if ev.get("event") == "property-change":
                    self.events.put((gen, ev["name"], ev.get("data")))
        except OSError:
            pass
        finally:
            try:
                os.unlink(path)
            except OSError:
                pass

    def command(self, *args):
        with self.lock:
            if self.sock is None:
                return
            try:
                self.sock.sendall((json.dumps({"command": list(args)}) +
                                   "\n").encode())
            except OSError:
                pass

    def finished(self):
        """None while playing, else the mpv exit code."""
        if self.mpv is None:
            return None
        return self.mpv.poll()

    def stop(self):
        self.gen += 1
        with self.lock:
            if self.sock is not None:
                try:
                    self.sock.close()
                except OSError:
                    pass
            self.sock = None
        for p in self.procs:
            if p.poll() is None:
                p.terminate()
        for p in self.procs:
            try:
                p.wait(timeout=2)
            except subprocess.TimeoutExpired:
                p.kill()
        self.procs = []
        self.mpv = None


