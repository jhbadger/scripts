def main(argv):
    args = argv[1:]
    if icon_args(args):
        return
    root = tk.Tk()
    if args and all(os.path.isfile(a) for a in args):
        App(root, files=args)
    else:
        App(root, " ".join(args))
    root.mainloop()


if __name__ == "__main__":
    main(sys.argv)
